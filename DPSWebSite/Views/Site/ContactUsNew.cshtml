
@{
    ViewBag.Title = "Contact Us";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
@*<link href="https://unpkg.com/cirrus-ui"
      type="text/css"
      rel="stylesheet" />*@
<style>
    .contact-main-container .hero .hero-body {
        padding: 0px;
    }

    .contact-main-container .space.xlarge {
        padding: 0px;
        height: 0px;
    }
    .contact-main-container .contact-form {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        border: 1px solid #ccc;
        padding: 10px;
        box-sizing: border-box;
        margin-bottom: 30px;
        -webkit-box-shadow: 0 0 10px 0 #3333338f;
        box-shadow: 0 0 10px 0 #b9b37e;
        margin-top: 30px;
        background: #fff;
    }
    .contact-main-container .form-group {
        border: 1px solid #014828;
        display: flex;
        display: -ms-flexbox;
        margin: 0.5rem 0;
    }

    .contact-main-container div.top-background {
        height: 315px;
        background-size: cover !important;
        background-position: center center !important;
    }
    .contact-main-container span.icon i {
        font-size: 17px;
    }
    .contact-main-container div.top-background iframe {
        height: 100%;
    }
    .contact-main-container div.top-background {
        border-bottom: 2px solid #014828;
    }
    .contact-main-container .divider {
        border-top: 0.05rem solid rgb(1 72 40);
        height: 0.1rem;
        margin: 1.8rem 0 1.6rem;
        position: relative;
    }
    .contact-main-container .padded p.u-text-center {
        color: #014828;
        font-size: 14px;
        color: #014828;
        font-size: 14px;
        line-height: 2;
        margin-bottom: 1rem;
        text-align: center !important;
    }
    .contact-main-container .form-group .form-group-label span.icon i {
        color: #014828;
    }
    .contact-main-container .btn-group.u-pull-right button.btn-info {
        background: #014828;
        padding: 5px 25px;
        font-size: 12px;
    }
    .contact-main-container input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]):not([type=reset]), select {
        font-size: 15px;
        height: 35px;
        width: 100%;
        border: 0pc;
        padding: 0px 15px;
    }
    .contact-main-container textarea, textarea[type=text] {
        font-size: 16px;
        border: 1px solid #014828;
        width: 100%;
        height: 100px;
        padding:10px;
    }
    .contact-main-container {
        background: url(https://i.pinimg.com/originals/84/a5/f1/84a5f1a03629dcc48efa7115b53f3bd6.jpg);
        background-size: 25px;
    }
        .contact-main-container .form-group .form-group-label {
            height: 35px;
            border-right: 2px solid #014828 !important;
            height: 35px;
            border-right: 2px solid #014828 !important;
            background-color: var(--cirrus-form-group-bg);
            border: 1px solid #dee2e6;
            border-radius: 0.2rem;
            color: var(--cirrus-form-group-fg);
            margin: 0;
            padding: 0.8rem;
            user-select: none;
        }
        .contact-main-container .input-focused, input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]):not([type=reset]):focus, input[type=text].input-focused, select:focus, textarea:focus, textarea[type=text]:focus {
            border-color: #014828db;
            box-shadow: 0 0 0 0.2rem rgb(1 72 40 / 26%), inset 0 1px 8px rgb(0 0 0 / 7%);
        }
        .contact-main-container .padded > h1.u-text-center.u-font-alt {
            color: #014828;
        }
        .contact-main-container .padded > h1.u-text-center.u-font-alt {
            font-family: Montserrat,sans-serif;
            font-size: 3rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 1rem;
            letter-spacing: .025rem;
            color: #014828;
            text-align: center !important;
        }
        .contact-main-container .icon {
            display: inline-block;
            text-align: center;
            width: 1.5rem;
            vertical-align: baseline;
        }
        .contact-main-container input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]):not([type=reset]), .contact-main-container select {
            width: 100%;
            border: 1px solid #dee2e6;
            border-radius: 3px;
            font-family: 'Nunito Sans';
            font-size: var(--font-size-m);
            letter-spacing: .02rem;
            transition: .3s;
            outline: 0;
            padding: 0.85rem 1.1rem;
        }
        .contact-main-container .form-group .form-group-input:last-child:not(:first-child) {
            border-top-left-radius: 0 !important;
            border-bottom-left-radius: 0 !important;
            margin-left: -1px;
            z-index: 0;
        }
        .contact-main-container .padded {
            display: table;
            width: 100%;
        }
    .contact-main-container .btn-group.u-pull-right {
        float: right;
    }
        .contact-main-container .contact-details {
            margin: 30px;
            background: #fff;
            padding: 30px;
            -webkit-box-shadow: 0 0 10px 0 #3333338f;
            box-shadow: 0 0 10px 0 #b9b37e;
        }
            .contact-main-container .contact-details .deatils {
                border-bottom: 1px dotted #014828;
                padding: 10px;
            }
                .contact-main-container .contact-details .deatils span {
                    display: inline-block;
                    margin-bottom: 10px;
                }
                    .contact-main-container .contact-details .deatils span i {
                        font-size: 27px;
                        color: #014828;
                    }
                .contact-main-container .contact-details .deatils p {
                    margin-bottom: 0px;
                }
                .contact-main-container .contact-details .deatils:last-child {
                    border: none;
                }
    
</style>


<div class="contact-main-container">
    <div class="container">
        <div class="row">
            <div class="col-sm-5">
                <div class="contact-form">
                    <div class="">
                        <div style="margin: auto">
                            <form class=" p-0" method="post">
                                <div class="contact-body p-0">
                                    <div class=" p-0 level fill-height">
                                        <div class="col">
                                            <div class="space xlarge"></div>
                                            <div class="padded">
                                                <h1 class="u-text-center u-font-alt">Contact Us</h1>
                                                <div class="divider"></div>
                                                <p class="u-text-center">We are happy to help you.</p>
                                                <div class="divider"></div>

                                                <div class="form-group">
                                                    <label class="form-group-label">
                                                        <span class="icon">
                                                            <i class="icon-user"></i>
                                                        </span>
                                                    </label>
                                                    <input type="text" class="form-group-input" placeholder="Enter your name" ng-model="ConName" />
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-group-label">
                                                        <span class="icon">
                                                            <i class="icon-envelope"></i>
                                                        </span>
                                                    </label>
                                                    <input type="email" class="form-group-input" placeholder="Enter your email" ng-model="ConEmail" />
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-group-label">
                                                        <span class="icon">
                                                            <i class="icon-mobile-phone"></i>
                                                        </span>
                                                    </label>
                                                    <input type="text" class="form-group-input" placeholder="Enter your contact no." ng-model="ConContact" />
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-group-label">
                                                        <span class="icon">
                                                            <i class="icon-envelope"></i>
                                                        </span>
                                                    </label>
                                                    <input type="text" class="form-group-input" placeholder="Enter your address" ng-model="ConAddress" />
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-group-label">
                                                        <span class="icon">
                                                            <i class="icon-envelope"></i>
                                                        </span>
                                                    </label>
                                                    <input type="text" class="form-group-input" placeholder="Enter your Subject" ng-model="ConSubject" />
                                                </div>

                                                @*<div class="form-section section-inline">
                                            <div class="section-body ">
                                                <div class="form-group col-6 pl-0">
                                                    <label class="form-group-label">
                                                        <span class="icon">
                                                            <i class="icon-calendar"></i>
                                                        </span>
                                                    </label>
                                                    <input type="date" class="form-group-input" placeholder="Enter your birthday (or not)" />
                                                </div>
                                                <div class="form-group col-6 pr-0">
                                                    <label class="form-group-label">
                                                        <span class="icon">
                                                            <i class="icon-list"></i>
                                                        </span>
                                                    </label>
                                                    <select class="select form-group-input" placeholder="Choose one">
                                                        <option>Bug Report</option>
                                                        <option>Feature Request</option>
                                                        <option>Other</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>*@

                                                <textarea placeholder="Tell us what's wrong" ng-model="Discription"></textarea>

                                                @*<div class="form-ext-control form-ext-checkbox">
                                            <input id="check1" class="form-ext-input" type="checkbox">
                                            <label class="form-ext-label" for="check1">Send me a copy.</label>
                                        </div>*@

                                                <div class="space"></div>

                                                <div class="btn-group u-pull-right">
                                                    <button class="btn-info" id="btnSave" type="button" value="Save" name="saveButton" ng-model="Save"
                                                            ng-init='Save="Save"' ng-click="SendEmail(ConName,ConContact,ConEmail,ConAddress,Discription,ConSubject,Save)">
                                                        Send
                                                    </button>
                                                </div>

                                            </div>
                                            <div class="space xlarge"></div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-7">

                <div class="contact-details">
                    <div class="deatils">
                        <span>
                            <i class="icon-phone" aria-hidden="true"></i>
                        </span>
                        <p>PHONE</p>
                        <p>{{ContactUsPageData[0].BodyContentMobileNoText}}</p>
                    </div>
                    <div class="deatils">
                        <span>
                            <i class="icon-map-marker"></i>
                        </span>
                        <p>ADDRESS</p>
                        <p>
                            {{ContactUsPageData[0].BodyContentAddressText}}
                        </p>
                    </div>
                    <div class="deatils">
                        <span>
                            <i class="icon-envelope"></i>
                        </span>
                        <p>E-MAIL</p>
                        <p>{{ContactUsPageData[0].BodyContentEmailText}}</p>
                    </div>
                </div>
            </div>
        </div>
        
        
    </div>
</div>
<div class="top-background">
    <iframe src="https://www.google.com/maps/embed?pb=!1m23!1m12!1m3!1d113996.36473901656!2d80.87027199170308!3d26.763950387307425!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!4m8!3e6!4m0!4m5!1s0x399bfba048fe3bad%3A0x9df033b0db9065e8!2sdps%20eldeco!3m2!1d26.763967599999997!2d80.9403123!5e0!3m2!1sen!2sin!4v1610976902526!5m2!1sen!2sin" width="100%" height="300" frameborder="0" style="border: 0;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
</div>



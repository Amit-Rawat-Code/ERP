@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout21.cshtml";
}

<!---main-website-content-->
<div class="website-main-content" >
    <section class="website-banner">
        <!-- partial:index.partial.html -->

        <div class="Modern-Slider">
            <!-- Item -->
            <div class="item" ng-repeat="BannImg in BannerImage">
                <div class="img-fill">
                    <img src="{{BannImg.BannerImagePath}}" alt="{{BannImg.BannerAltText}}">
                    <div class="info">
                        <div>
                            <h3>{{BannImg.BannerDescription1}}</h3>
                            <h5>{{BannImg.BannerDescription2}}</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section our-core-values">
        <div class="container" ng-repeat="ThemeData in GetThemeData">
            <h3 class="section-title" style="color:#{{ThemeData.BannerBottomLineTextColour}} !important">Our core values</h3>
            <div class="row">
                <div class="col-sm-3">
                    <figure class="stm-action-box__figure_box integrity">
                        <span class="stm-action-box__thumbnail">
                            <img class="" src="../../content/images/homepage/core-values/integrity.jpeg" width="225" height="225" alt="integrity" title="integrity">
                        </span>
                        <span class="stm-action-box__figcaption-title">
                            <span class="stm-action-box__title-text">Integrity</span>
                        </span>
                        <figcaption class="stm-action-box__figcaption_box">
                            <div class="stm-action-box__content-text">
                                We are honest in our actions and speech. We believe in doing what is right. We practice integrity.
                            </div>
                        </figcaption>
                    </figure>
                </div>
                <div class="col-sm-3">

                    <figure class="stm-action-box__figure_box individuality">
                        <span class="stm-action-box__thumbnail">
                            <img class="" src="../../content/images/homepage/core-values/Individuality.jpg" width="390" height="390" alt="Individuality" title="Individuality">
                        </span>
                        <span class="stm-action-box__figcaption-title">
                            <span class="stm-action-box__title-text">Individuality</span>
                        </span>
                        <figcaption class="stm-action-box__figcaption_box">
                            <div class="stm-action-box__content-text">
                                Each child is unique and capable. We train them to embrace their individuality and be just themselves.
                            </div>
                        </figcaption>
                    </figure>


                </div>
                <div class="col-sm-3">
                    <figure class="stm-action-box__figure_box innovation">
                        <span class="stm-action-box__thumbnail">
                            <img class="" src="../../content/images/homepage/core-values/Innovation.jpg" width="390" height="390" alt="Innovation" title="Innovation">
                        </span>
                        <span class="stm-action-box__figcaption-title">
                            <span class="stm-action-box__title-text">Innovation</span>
                        </span>
                        <figcaption class="stm-action-box__figcaption_box">
                            <div class="stm-action-box__content-text">
                                Learning activities, materials, etc. are introduced into the classroom environment that encourages innovation.
                            </div>
                        </figcaption>
                    </figure>
                </div>
                <div class="col-sm-3">
                    <figure class="stm-action-box__figure_box excellence">
                        <span class="stm-action-box__thumbnail">
                            <img class="" src="../../content/images/homepage/core-values/Excellence.jpg" width="390" height="390" alt="Excellence" title="Excellence">
                        </span>
                        <span class="stm-action-box__figcaption-title">
                            <span class="stm-action-box__title-text">Excellence</span>
                        </span>
                        <figcaption class="stm-action-box__figcaption_box">
                            <div class="stm-action-box__content-text">
                                We pursue excellence in education to remain effective by learning constantly and being the best we can be.
                            </div>
                        </figcaption>
                    </figure>
                </div>
            </div>

        </div>

    </section>
    <section class="page-section why-choose-allenkids home-sec">
        <div class="container" ng-repeat="ThemeData in GetThemeData">
            <div class="row">
                <div class="col-sm-7">
                    <h3 class="section-title" style="color:#{{ThemeData.WhyChooseHeadingTextColour}} !important">
                        Why Choose Allenkids?
                    </h3>
                    <p class="discription">
                        Just like no two flowers in the garden are the same, no two children can be the same. Each child is a blossoming bud with its own special fragrance. It is our responsibility as facilitators and parents, to provide them the environment they need to achieve their fullest potential.
                    </p>

                    <div class="row">
                        <div class="col-sm-6 col-xs-6">
                            <div class="image-thumbnail">
                                <img src="../../content/images/homepage/why-choose/Motor-Skill-min.jpg" alt="motor-skill">
                            </div>
                            <div class="skillname">Motor Skills</div>
                        </div>
                        <div class="col-sm-6 col-xs-6">
                            <div class="image-thumbnail">
                                <img src="../../content/images/homepage/why-choose/development-skill-2-1536x2048-min-2.jpg" alt="Language Development">
                            </div>
                            <div class="skillname">Language Development</div>
                        </div>
                        <div class="col-sm-6 col-xs-6">
                            <div class="image-thumbnail">
                                <img src="../../content/images/homepage/why-choose/Peer-Interaction-1536x709-min.jpg" alt="Social Development">
                            </div>
                            <div class="skillname">Social Development</div>
                        </div>
                        <div class="col-sm-6 col-xs-6">
                            <div class="image-thumbnail">
                                <img src="../../content/images/homepage/why-choose/Cognitive-1536x1023-min.jpg" alt="Cognitive Development">
                            </div>
                            <div class="skillname">Cognitive Development</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-5">
                    <div class="why-choose-main-image">
                        <img src="../../content/images/homepage/why-choose/why-choose-main.jpg" alt="why-coose-us">
                    </div>

                </div>
            </div>
        </div>

    </section>

    <!-----------------classes-carousels------------>
    <section class="page-section classes">
        <div class="container" ng-repeat="ThemeData in GetThemeData">
            <h3 class="section-title" style="color:#{{ThemeData.OurProgramsHeadingTextColour}} !important">
                Our Programs
            </h3>
            <div class="classes-carousels">
                <div id="news-slider" class="owl-carousel">
                    <div class="post-slide" ng-repeat="SliderImgs in SliderImages">
                        <div class="post-img">
                            <img style="object-fit:{{SliderImgs.ImageObjectFit}}" height="{{SliderImgs.ImageHeight}}" ng-src="{{SliderImgs.BannerImagePath}}" alt="{{SliderImgs.BannerAltText}}">
                            <a href="#" class="over-layer"><i class="fa fa-link"></i></a>
                        </div>
                        <div class="post-content">
                            <h3 class="post-title" >
                                <a href="#" style="color:#{{ThemeData.OurProgramsSliderHeadingTextColour}} !important">
                                    {{SliderImgs.BannerDescription1}}
                                </a>
                            </h3>
                            <p class="post-description">
                                {{SliderImgs.BannerDescription2}}
                            </p>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section why-choose-allenkids our-program">
        <div class="" ng-repeat="ThemeData in GetThemeData">
            <div class="container">
                <div class="col-sm-5">
                    <div class="why-choose-main-image">
                        <img src="../../content/images/homepage/why-choose/why-choose-main.jpg" alt="why-coose-us">
                    </div>
                </div>
                <div class="col-sm-7">
                    <h3 class="section-title" style="color:#{{ThemeData.ClassesHeadingTextColour}} !important">
                        Classes
                    </h3>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="our-program-box">
                                <div class="icon">
                                    <span class="icon-span">
                                        <img src="../../content/images/homepage/programs/program1.png" alt="program1">
                                    </span>
                                </div>
                                <div class="stm-icon-box__content">
                                    <div class="stm-icon-box__title" style="color:#{{ThemeData.ClassesImageHeadingTextColour}} !important">Playgroup 1 : (2 yrs to 3 yrs)</div>

                                    <div class="stm-icon-box__descr ">We practice an integrated thematic study which aims at enhancing the development and education of children through play.</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="our-program-box">
                                <div class="icon">
                                    <span class="icon-span">
                                        <img src="../../content/images/homepage/programs/program2.png" alt="program1">
                                    </span>
                                </div>
                                <div class="stm-icon-box__content">
                                    <div class="stm-icon-box__title" style="color:#{{ThemeData.ClassesImageHeadingTextColour}} !important">Playgroup 2 ( 3 yrs to 4 yrs)</div>

                                    <div class="stm-icon-box__descr ">Our specially designed curriculum encourages children to develop self- confidence and self -esteem to feel valued as individuals.</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="our-program-box">
                                <div class="icon">
                                    <span class="icon-span">
                                        <img src="../../content/images/homepage/programs/program3.png" alt="program1">
                                    </span>
                                </div>
                                <div class="stm-icon-box__content">
                                    <div class="stm-icon-box__title" style="color:#{{ThemeData.ClassesImageHeadingTextColour}} !important">Nursery</div>

                                    <div class="stm-icon-box__descr ">Children learn different skills like communication and language including listening, speaking and understanding.</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="our-program-box">
                                <div class="icon">
                                    <span class="icon-span">
                                        <img src="../../content/images/homepage/programs/program4.png" alt="program1">
                                    </span>
                                </div>
                                <div class="stm-icon-box__content">
                                    <div class="stm-icon-box__title" style="color:#{{ThemeData.ClassesImageHeadingTextColour}} !important">Preparatory: (Age group 5-6 years)</div>

                                    <div class="stm-icon-box__descr ">A preparatory year is a programme designed to prepare the students for the primary classes.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section classes event">
        <div class="container" ng-repeat="ThemeData in GetThemeData">
            <h3 class="section-title" style="color:#{{ThemeData.EventsHeadingTextColour}} !important">
                Events
            </h3>
            <div class="classes-carousels">
                <div id="news-slider2" class="owl-carousel">
                    <div class="post-slide" ng-repeat="EventsImgs in EventsSliderImages">
                        <div class="post-img">
                            <img style="object-fit:{{EventsImgs.ImageObjectFit}};" height="{{EventsImgs.ImageHeight}}" src="{{EventsImgs.BannerImagePath}}" alt="{{EventsImgs.BannerAltText}}">
                            <a href="" ng-href="{{GetEventUrl(EventsImgs.Code)}}" target="_blank" class="over-layer"><i class="fa fa-link"></i></a>
                        </div>
                        <div class="post-content">
                            <h3 class="post-title">
                                <a style="color:#{{ThemeData.EventsSliderHeadingTextColour}} !important" href="" ng-href="{{GetEventUrl(EventsImgs.Code)}}" target="_blank">{{EventsImgs.BannerDescription1}}</a>
                            </h3>
                            <p class="post-description" ng-bind-html="trustAsHtml(EventsImgs.BannerDescription2)">

                            </p>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section video-background-section">
        <section class="fullsize-video-bg">
            <div class="inner">
                <div>
                    <h1>Welcome to AllenKids!</h1>
                    <p>Where Learning is Serious Fun
                </div>
            </div>
            <div id="video-viewport">
                <video autoplay muted loop>
                    <source src="../../content/video/ALLEN-KIDS-30-SEC-KANPUR.mp4" type="video/mp4" />
                    <source src="https://storage.googleapis.com/coverr-main/webm/Winter-Grass.webm" type="video/webm" />
                </video>
            </div>
        </section>
    </section>


    <section class="page-section winning-laurels-bulletin">
        <div class="container" ng-repeat="ThemeData in GetThemeData">
            <div class="row">
                <div class="col-sm-6">

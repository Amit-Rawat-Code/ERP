                                <div class="img">
                                    <img style="object-fit:{{OurHappyParentsSliderImgs.ImageObjectFit}}" height="{{OurHappyParentsSliderImgs.ImageHeight}}" ng-src="{{OurHappyParentsSliderImgs.BannerImagePath}}" alt="{{OurHappyParentsSliderImgs.BannerAltText}}" />
                                </div>
                                <h2 style="color:#{{ThemeData.OurHappyParentsHeadingTextColour}} !important">
                                {{OurHappyParentsSliderImgs.BannerDescription1}}
                                </h2>
                                <p>
                                    {{OurHappyParentsSliderImgs.BannerDescription2}}
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>

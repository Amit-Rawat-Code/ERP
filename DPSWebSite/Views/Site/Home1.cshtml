                                    <img style="object-fit:"{{WinningLaurelsSliderImgs.ImageObjectFit}}" height="{{WinningLaurelsSliderImgs.ImageHeight}}"  ng-src="{{WinningLaurelsSliderImgs.BannerImagePath}}" alt="{{WinningLaurelsSliderImgs.BannerAltText}}">

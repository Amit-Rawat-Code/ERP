                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <h3 class="section-title" style="color:#{{ThemeData.BulletinHeadingTextColour}} !important">
                        Bulletin
                    </h3>
                    <div class="bullet-in-section">
                        <div class="card panel-default">
                            <div class="card-header"> <i class="icon-signal"></i><b>News</b></div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-xs-12">
                                        <ul class="demo1" style="">
                                            <li class="news-item" ng-repeat="Headline in AllNotice">
                                                <table cellpadding="4">
                                                    <tr>
                                                        <td>
                                                            <img src="../../content/images/homepage/bulletin/1.png" width="60" class="img-circle" />
                                                        </td>
                                                        <td>
                                                            <p>
                                                                <a href="">
                                                                    {{Headline.NoticeHeadline}}
                                                                </a>
                                                            </p>
                                                            <p ng-bind-html="trustAsHtml(Headline.Description)">
                                                            </p>
                                                            <a href="#">Read more...</a>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer"> </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section testimonial-section">
        <div class="container" ng-repeat="ThemeData in GetThemeData">
            <h3 class="section-title" style="color:#{{ThemeData.OurHappyParentsHeadingTextColour}} !important">
                Our Happy Parents
            </h3>
            <div class="main-testi">
                <section id="testim" class="testim">

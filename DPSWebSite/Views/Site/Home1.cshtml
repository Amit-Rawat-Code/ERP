    <section class="page-section facebook-feeds-youtube-contact-form">
        <div class="container" ng-repeat="ThemeData in GetThemeData">
            <div class="row">
                <div class="col-sm-4">
                    <h3  class="section-title" style="color:#{{ThemeData.FacebookfeedssHeadingTextColour}} !important">
                        Facebook feeds
                    </h3>
                    <div class="facebook-feed">
                        <iframe src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fallenkidsswaroopnagar&tabs=timeline&width=340&height=500&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true&appId" width="280"
                                height="340" style="border:none;overflow:hidden;width: 100%;" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>

                    </div>
                </div>
                <div class="col-sm-4">
                    <h3 class="section-title" style="color:#{{ThemeData.YouTubeHeadingTextColour}} !important">
                        YouTube
                    </h3>
                    <div class="youtube-feed">
                        <div class="embed">
                            <div id="yt-embed"></div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <h3 class="section-title" style="color:#{{ThemeData.ContactUsHeadingTextColour}} !important">
                        Contact Us
                    </h3>
                    <div class="contact-form">
                        <form>
                            <div class="form-group">
                                <label for="email">Enquiry For Session:</label>
                                <select id="ddlSession" autocomplete='address-level2' class="form-control"
                                        ng-model="ddlSession" ng-init="GetSession()">
                                    <option value="">Select Session</option>
                                    <option ng-repeat="sl in SessionList" value="{{sl.SessionId}}">{{sl.SessionName}}</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="email">Choose Class:</label>
                                <select class="form-control" id="Class" name="Class" ng-model="Class">
                                    <option value="">Choose your class</option>
                                    <option>PG</option>
                                    <option>Nursery</option>
                                    <option>Prep</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Father/Mother/Guardian Name:</label>
                                <input type="text" class="form-control" placeholder="Enter Your Guardian Name" id="Name" name="Name" ng-model="Name" required>
                            </div>
                            <div class="form-group">
                                <label for="pwd">Enter Contact:</label>
                                <input type="number" id="Contact" name="Contact" ng-model="Contact" class="form-control" onKeyPress="if(this.value.length==10) return false;">
                            </div>
                            <div class="form-group">
                                <label>Your email:</label>
                                <input type="email" class="form-control" placeholder="Enter Your Email" ng-model="Email" required>
                            </div>
                            <button type="button" class="btn btn-default" ng-click="SaveRecord()" name="saveButton" ng-model="Save" ng-init="Save='Save'">Submit</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

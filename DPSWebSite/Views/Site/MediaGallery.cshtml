
@{
    ViewBag.Title = "MediaGallery";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}


<div ng-init="GetAboutUs()" ng-cloak>
    <section class="page-section allenhose-story news-letter Achievement">
        <div class="container" >
            <h3 class="section-title">{{MediaGalleryData[0].AlbumTitle}}</h3>
            <div class="section-title-bottom-line">
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="searchform1">
                            <div class="gallery-searchA">
                                <ul>
                                    @*<li>
                                        <input id="RadioSearchAll" name="filter" ng-model="filter" type="radio" value="ALL Search" ng-change="clearFilter()" ><label for="RadioSearchAll">All Search</label>
                                    </li>*@
                                    <li>
                                        <input id="RadioTitle" name="filter" ng-model="filter" type="radio" value="Title" ng-change="clearFilter()"><label for="RadioTitle">Title</label>
                                    </li>
                                    <li>
                                        <input id="RadioVenue" name="filter" ng-model="filter" type="radio" value="Venue" ng-change="clearFilter()"><label for="RadioVenue">Venue</label>
                                    </li>

                                    <li>
                                        <input id="RadioDescription" name="filter" ng-model="filter" type="radio" value="Description" ng-change="clearFilter()"><label for="RadioDescription">Description</label>
                                    </li>
                                    <li>
                                        <input id="RadioDate" name="filter" ng-model="filter" type="radio" value="EventDate" ng-change="clearFilter()"><label for="RadioDate">Event Date</label>
                                    </li>
                                    <li>
                                        <input id="RadioAcdYear" name="filter" ng-model="filter" type="radio" value="Year" ng-change="clearFilter()"><label for="RadioAcdYear"> Year</label>
                                    </li>

                                    <li class="lastli mLeft">
                                        <div class="searchbox">
                                            <input type="text" class="searchfield d a1" ng-model="searchText[filter]" placeholder="{{filter}}">
                                        </div>
                                </ul>
                            </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 news-letter-box" style="text-align: center;" ng-repeat="data in MediaGalleryData | filter:searchText">
                    <div class="box1">
                        <img src="{{data.MediaFilePath}}" style="max-width:250px">
                        <div class="achibg">
                            <div class="achi-dtl ">
                                <span id="" class="Event">{{data.Title}}</span>
                            </div>
                            <div class="achi-dt2">
                                <b>Newspaper:</b>
                                <span id="" class="EventVenue">{{data.Venue}}</span>
                            </div>
                            <div class="achi-dt2 aCHdate">
                                <b>Published On:</b>
                                <span id="" class="EventDate EventDate1">{{data.EventDate}}</span>
                            </div>
                            <div class="achi-dt2 aCHdate">
                                <b>Updated On:</b>
                                <span id="" class="EventDate EventDate1">{{data.EventDate}}</span>
                            </div>
                            <div class="achi-bg2 mTopAch">
                                <b>Description:</b>
                                <span id="" class="Description"><br />{{data.Description}},&amp;nb...</span>
                            </div>
                        </div>
                        <a href="{{data.PdfFilePath}}" target="_blank">   <button type="button" class="btn btn-primary">Read More</button></a>
                    </div>
                </div>

            </div>
        </div>
        </section>


@{
    ViewBag.Title = "MediaLayout";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<style>
    #more {
        display: none;
    }
</style>

<!---main-website-content-->
<section class="page-section allenhose-story news-letter Achievement">
    <div class="container">
        <div class="master-hdr">
            <h3 class="section-title"><span>{{MediaDetailList[0].MediaTitle}}</span></h3>
        </div>
       
            <div class="row">
                <div class="col-sm-12">
                    <div class="searchform1">
                        <div class="gallery-searchA">
                            <ul>
                                <li>
                                    <input id="RadioHeadline" name="filter" ng-model="filter" type="radio" value="Headline" ng-change="clearFilter()"><label for="RadioTitle">Headline</label>
                                </li>
                                @*<li>
                                    <input id="RadioVenue" name="filter" ng-model="filter" type="radio" value="Venue" ng-change="clearFilter()"><label for="RadioVenue">Venue</label>
                                </li>*@

                                @*<li>
                                    <input id="RadioDescription" name="filter" ng-model="filter" type="radio" value="Description" ng-change="clearFilter()"><label for="RadioDescription">Description</label>
                                 </li>*@
                                <li>
                                    <input id="RadioPublishedDate" name="filter" ng-model="filter" type="radio" value="PublishedDate" ng-change="clearFilter()"><label for="RadioDate">Published Date</label>
                                </li>
                                <li>
                                    <input id="RadioYear" name="filter" ng-model="filter" type="radio" value="Year" ng-change="clearFilter()"><label for="RadioAcdYear"> Year</label>
                                </li>

                                <li class="lastli mLeft">
                                    <div class="searchbox">
                                        <input type="text" class="searchfield d a1" ng-model="searchText[filter]" placeholder="{{filter}}">
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
       
        <div class="row" id="photoG">
            <div class="col-md-3" style="text-align: center;" ng-repeat="ml in MediaDetailList | filter:searchText">
                <div class="news-letter-box">
                    <div class="box1">
                        <img src="" ng-src="{{ml.MediaFilePath}}" style="max-width:180px">
                        <div class="achibg">
                            <div class="achi-dtl ">
                                <span id="" class="Event" title="{{ml.Title.length>20?ml.Title:''}}">{{AdjustLength(ml.Title,20)}}</span>
                            </div>
                            <div class="achi-dtl ">
                                <b>News Paper : </b><br />
                                <span id="" class="Event" >DAINIK JAGRAN INEXT</span>
                            </div>
                            @*<div class="achi-dt2">
                                <b>Venue:</b>
                                <span id="" class="EventVenue" ng-init="VenueReadMore(ml)">{{ml.VenStr}}</span>
                            </div>*@
                            <div class="achi-dt2 aCHdate">
                                <b>Published On:</b>
                                <span id="" class="EventDate EventDate1" title="{{ml.PublishedDate.length>10?ml.PublishedDate:''}}">{{AdjustLength(ml.PublishedDate,10)}}</span>
                            </div>
                            <div class="achi-dt2 aCHdate">
                                <b>Updated On:</b>
                                <span id="" class="EventDate EventDate1" title="{{ml.UpdatedOn.length>10?ml.UpdatedOn:''}}">{{AdjustLength(ml.UpdatedOn,10)}}</span>
                            </div>
                            <div class="achi-bg2 mTopAch">
                                <b>Discription:</b>
                                <p id="read-More" ng-init="DiscriReadMore(ml)">{{AdjustLength(ml.DescStr,25)}}</p>
                            </div>

                        </div>
                        <a href="" ng-href="{{GetMediaNewsUrl(ml.Code,ml.Headline)}}"><button type="button" class="btn btn-primary" id="myBtn">Read More</button></a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script language="javascript" type="text/javascript">

    var showhide = function (val, placeHolder)
    {
        $("#txtDate").val('').attr('placeholder', placeHolder);
        $("#txtsearch1").val('').attr('placeholder', placeHolder);
        $("#txtsearch").val('').attr('placeholder', placeHolder);
        $(".a1").hide();
        $(val).show();
    }
    $(document).ready(function ()
    {

        if ($('#Radioyear').is(':checked')) {
            $(".a1").hide();
            $(".b").show();
        }
        if ($('#RDAllSearch').is(':checked')) {
            $(".a1").hide();
            $(".c").show();
        }
        if ($('#RadioNews').is(':checked')) {

            $(".a1").hide();
            $(".a").show();
        }
        if ($('#RadioDate').is(':checked')) {

            $(".a1").hide();
            $(".d").show();
        }
        if ($('#RadioHeadline').is(':checked')) {

            $(".a1").hide();
            $(".c").show();
        }


    });
</script>
<script type="text/javascript">
    $(function () {
        if ($('#RadioNews').is(':checked')) {
            $("#txtsearch").attr('placeholder', "Enter newspaper name");
        }
        else if ($('#RDAllSearch').is(':checked')) {
            $("#txtsearch1").attr('placeholder', "Enter newspaper name or headline");

        }
        else if ($('#RadioHeadline').is(':checked')) {
            $("#txtsearch1").attr('placeholder', "Enter headline");

        }
        else if ($('#RadioDate').is(':checked')) {
            $("#txtDate").attr('placeholder', "Pick a date");
        }
        //$("#txtsearch1").attr('placeholder', "Enter newspaper name or headline");
        $("#Button1").click(function () {
            var title = $("#txtsearch1").val();
            //var descp = $("#txtdiscription").val();
            var dates = $("#txtDate").val();
            var descp = $("#txtsearch").val();
            if ($('#RadioHeadline').is(':checked')) {
                $("#txtdiscription").removeClass('borderred');
                $("#txtsearch1").removeClass('borderred');
                $("#txtDate").removeClass('borderred');
                $("#txtsearch").removeClass('borderred');
                //$("#txttitle").removeClass('borderred');
                //alert('hi')
                if ((title == "")) {
                    $("#txtsearch1").addClass('borderred');
                    return false;
                }
                else {
                    $("#txtsearch1").removeClass('borderred');
                    return true;
                }
            }
            else if ($('#RadioNews').is(':checked')) {
                $("#txtdiscription").removeClass('borderred');
                $("#txtsearch1").removeClass('borderred');
                $("#txtDate").removeClass('borderred');
                $("#txtsearch").removeClass('borderred');
                alert('hi')
                if ((descp == "")) {
                    $("#txtsearch").addClass('borderred');
                    return false;

                }
                else {
                    $("#txtsearch").removeClass('borderred');
                    return true;
                }
            }
            else if ($('#RadioDate').is(':checked')) {
                $("#txtdiscription").removeClass('borderred');
                $("#txtsearch1").removeClass('borderred');
                $("#txtDate").removeClass('borderred');
                $("#txtsearch").removeClass('borderred');
                //alert('hi')
                if ((dates == "")) {
                    $("#txtDate").addClass('borderred');
                    return false;
                }
                else {
                    $("#txtDate").removeClass('borderred');
                    return true;
                }
            }
        });
        $('#RadioNews,#RadioDate,#RadioHeadline').change(function () {
            $("#txtsearch1").removeClass('borderred');
            $("#txtDate").removeClass('borderred');
            $("#txtsearch").removeClass('borderred');


            $("#txtsearch1").val('').attr('placeholder', "Enter headline");

        });
        $('#RDAllSearch').change(function () {
            $("#txtsearch1").removeClass('borderred');
            $("#txtDate").removeClass('borderred');
            $("#txtsearch").removeClass('borderred');
            $("#txtsearch1").val('').attr('placeholder', "Enter newspaper name or headline");

        });
        $('#Radioyear').change(function () {
            $("#ddlYear").prop("selectedIndex", 0);
        });
    });
</script>



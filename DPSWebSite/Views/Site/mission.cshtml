
@{
    ViewBag.Title = "mission";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!---main-website-content-->
<div class="website-main-content">
    <section class="page-banner-breadcrumbs our-approach">
        <div class="container">
            <div class="breadcrumbs">
                <span class="page-name">AllenKids Swaroopnagar</span><span class="seprator">></span><span class="page-name">Mission</span>
                <h3 class="title-of-page">
                    Our Mission & Vision
                </h3>
            </div>
        </div>
    </section>

    <section class="legacy-section-photo-discription Our-mission">
        <div class="container">
            <div class="col-sm-6">
                <div class="photo-section">

                </div>
            </div>
            <div class="col-sm-6">
                <div class="discription-section">
                    <h3 class="section-title-color big-title">Mission</h3>
                    <p class="discription">
                        To develop in every student an active and creative mind, a sense of understanding and compassion for others, and the courage to act on their beliefs. We stress on the total development of each child: spiritual, moral, intellectual, social, emotional,
                        and physical.
                    </p>
                    <h3 class="section-title-color big-title">Vision</h3>
                    <p class="discription">
                        To provide a stimulating learning environment with technological orientation; which maximizes individual potential and ensures that students of all ability levels are well equipped to meet the challenges of education, work and life.
                    </p>

                </div>
            </div>
        </div>
    </section>

</div>

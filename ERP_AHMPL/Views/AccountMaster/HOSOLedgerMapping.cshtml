
@{
    ViewBag.Title = "HO SO Ledger Mapping";
    ViewBag.TitleList = "HO SO Ledger Mapping";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/HOSOLedgerMappingController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">HO SO Ledger Mapping</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><a href="#"><span>Utility</span></a></li>
                <li> <a href="#"><span>Master</span></a></li>
                <li class="active"><span>HO SO Ledger Mapping</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <div class="col-md-12 col-sm-12 col-xs-12 no-padding">
                                                <div class="input-box">
                                                    <div class="datatable-responsive table-responsive advance-btn-table" ng-init="AddHOSOMapingData();">

                                                        <table class="table table-in-input-box compact table-bordered nowrap dataTable t-mgtb-n">
                                                            <thead>
                                                                <tr>
                                                                    <th class="srno">Sr.No.</th>
                                                                    <th class="text-left">HO Ledger</th>
                                                                    <th class="text-left">Site Name</th>
                                                                    <th class="text-left">Site Ledger</th>
                                                                    <th class="text-center">Action</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="obj in HOSOMapingData" repeat-done>
                                                                    <td>
                                                                        <label ng-model="HOSOMapingData[$index].Srno" ng-bind="HOSOMapingData[$index].Srno=$index+1"></label>
                                                                    </td>
                                                                    <td>
                                                                        <select  id="ddlHOLedger{{$index}}" class="select2 form-control validate" 
                                                                         ng-model="HOSOMapingData[$index].HOLedger" ng-init="GetHOLedger();" >
                                                                            <option value="">Select</option>
                                                                            <option ng-repeat="HOL in HOLedgerList" value="{{HOL.SubCode}}">{{HOL.SubName}}</option>
                                                                        </select>
                                                                    </td>
                                                                    <td>
                                                                        <select   id="ddlSOSite{{$index}}" class="select2 form-control validate"
                                                                                ng-model="HOSOMapingData[$index].SOSite" ng-init="GetSOSite(0);"
                                                                                ng-change="GetSOLedger(HOSOMapingData[$index].SOSite,$index);">
                                                                            <option value="">Select</option>
                                                                            <option ng-repeat="SOS in SOSiteList" value="{{SOS.SiteCode}}">{{SOS.SiteName}}</option> 
                                                                        </select>
                                                                        @*resetRow($index);*@
                                                                    </td>
                                                                    <td>
                                                                        <select   id="ddlSOLedger{{$index}}" class="select2 form-control validate"
                                                                                ng-model="HOSOMapingData[$index].SOLedger">
                                                                            <option value="">Select</option>
                                                                            <option ng-repeat="SOL in HOSOMapingData[$index].SOLedgerList" value="{{SOL.SubCode}}">{{SOL.SubName}}</option>
                                                                        </select>

                                                                    </td>
                                                                    <td class="text-center">

                                                                        <input type="button" id="btnAdd" value="+" class="btn btn-default2" ng-click="AddHOSOMapingData()" data-toggle="tooltip" data-placement="top"
                                                                               ng-if="HOSOMapingData[$index].Srno==HOSOMapingData.length" />
                                                                        <input type="button" class="btn btn-default2" id="btnRemoveCourses" value="-" ng-click="RemoveHOSOMapingData($index);"
                                                                               ng-if="HOSOMapingData.length>1" />
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>

                                                        


                                                        
                                                    </div>
                                                    
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>



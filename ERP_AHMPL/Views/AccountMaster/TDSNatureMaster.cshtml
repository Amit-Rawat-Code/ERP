@{
    ViewBag.Title = "TDS Nature Master";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/TDSCategoryMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">TDS Nature Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><span>Accountancy</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>TDS Nature Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Nature Of Payment <span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtNatureOfPayment", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "NatureOfPayment" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Section Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlTDSSection")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Challan Code<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtChallanCode", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "ChallanCode" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Company/Firm %<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtCompanyFirmPercent", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "CompanyFirmPercent" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Individual %<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtIndividualPercent", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "IndividualPercent" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Limit F.Y.<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtLimitOfFY", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "LimitOfFY" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Limit Single Transaction<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtLimitOfSingleTrans", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "LimitOfSingleTrans" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>
                                    <li>
                                        <span style="background-color: #6ad56a; width: 15px; height: 15px; display: inline-block; border: 1px solid black; margin-bottom: 1px;">&nbsp;</span>
                                        <span style="font-weight:500;color:black">Green color rows in "Entries from ledger which are not reconcile" grid appears on the basis of columns Admission No. , Transaction No. , Settled Amount.</span>
                                    </li>
                                    @*<li>
                                        <span style="background-color: #fff; width: 15px; height: 15px; display: inline-block; border: 1px solid black;">&nbsp;</span>
                                        <span style="font-weight:500;color:black"> White color represents, New records.</span>
                                    </li>*@
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

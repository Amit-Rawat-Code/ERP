<!-- Modal Cleared ModalPopup -->
<div class="modal fade" id="clearedPopupDialogBox" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Details</h4>
            </div>
            <div class="modal-body">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                    <div class="table-responsive" style=" width: 100%; overflow-y: hidden;">
                        <table id="example3" class="table table-striped table-bordered compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Sr.No.</th>
                                    <th>Date</th>
                                    <th>Voucher Type</th>
                                    <th>Number</th>
                                    <th>Status</th>
                                    <th>Particulars</th>
                                    <th>Dr</th>
                                    <th>Cr</th>
                                    <th>Balance</th>
                                    <th>DR/CR</th>
                                </tr>
                            </thead>
                            <tbody>                             
                                <tr ng-repeat="lst in LedgerWiseDetailsList" scroll-div-footer="example3">
                                    <td ng-bind="$index+1"></td>
                                    <td>{{lst.Date}}</td>
                                    <td>{{lst.V_Type}}</td>
                                    <td>{{lst.CvNo}}</td>
                                    <td>{{lst.Status}}</td>
                                    <td ng-bind-html="trustAsHtml(lst.Name)"></td>
                                    <td>{{lst.DebitAmt}}</td>
                                    <td>{{lst.CreditAmt}}</td>
                                    <td>{{lst.Balance}}</td>
                                    <td>{{lst.DRCR}}</td>
                                </tr>                                
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td><input type="text" class="form-control" placeholder="SR.No." /></td>
                                    <td><input type="text" class="form-control" placeholder="Date" /></td>
                                    <td><input type="text" class="form-control" placeholder="Voucher Type" /></td>
                                    <td><input type="text" class="form-control" placeholder="Number" /></td>
                                    <td><input type="text" class="form-control" placeholder="Status" /></td>
                                    <td><input type="text" class="form-control" placeholder="Particulars" /></td>
                                    <td><input type="text" class="form-control" placeholder="Dr" /></td>
                                    <td><input type="text" class="form-control" placeholder="Cr" /></td>
                                    <td><input type="text" class="form-control" placeholder="Balance" /></td>
                                    <td><input type="text" class="form-control" placeholder="DR/CR" /></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
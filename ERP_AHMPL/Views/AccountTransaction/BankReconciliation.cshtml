@{
    ViewBag.Title = "BankReconciliation";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/Scripts/myjslib/BankReconciliationController.js?Ver=@ViewBag.Version"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.8.1/xlsx.full.min.js"></script>
<script src="http://oss.sheetjs.com/js-xlsx/jszip.js"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Bank Reconciliation Excel Upload</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Finance</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Bank Reconcilication Excel Upload</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">

                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Date<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <input ng-disabled="disableDate" class="form-control clear textOnly ng-pristine ng-valid ng-empty ng-touched" id="txtDate" name="txtDate" ng-model="Date" placeholder="" type="date">
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Select Name Of Bank For Excel Format<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <select ng-disabled="disableBank" id="ddlBank" class="select2 form-control validate" ng-init="GeBanksForExcel();" ng-model="Bank" ng-change="GetExcelFormatNo();">
                                                        <option value="">Select Bank</option>
                                                        <option ng-repeat="bank in ExcelBankList" value="{{bank.SubCode}}">{{bank.Name}}</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Select Excel Format No<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <select ng-disabled="disableExcelFormatNo" id="ddlBank" class="select2 form-control validate" ng-model="ExcelFormatNo" ng-change="ShowExcelFormat();">
                                                        <option value="">Select Format</option>
                                                        <option ng-repeat="format in AllExcelFormat" value="{{format.ExcelFormatNo}}">{{format.ExcelFormatNo}}</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15" ng-hide="DownloadExcelFormat">
                                                <a ng-href="{{ExcelFormatPath}}" style="color:navy;font-size:large" download>Download sample Excel File Format</a>
                                            </div>

                                            @*<div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
            <label class="control-label">From Date<span class="vd_red"></span></label>
            <div class="input-box">
                <input ng-disabled="disableFromDate" id="txtFromDate" type="date" class="form-control clear validate"
                       ng-model="FromDate" />
                <div class="text-box-msg-r">
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
            <label class="control-label">To Date<span class="vd_red"></span></label>
            <div class="input-box">
                <input ng-disabled="disableToDate" id="txtToDate" type="date" class="form-control clear validate"
                       ng-model="ToDate" />
                <div class="text-box-msg-r">
                </div>
            </div>
        </div>*@

                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Select Excel File<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <input ng-disabled="disablefileUpload" onchange="angular.element(document).scope().loadFile(this.files)" onclick="this.value=null;" ng-model="fileUpload" id="txtFileUpload" type="file" name="txtFileUpload" class="form-control clear validate" />
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <style>
                                                .red_color {
                                                    background-color: #f5646e;
                                                    color: white !important;
                                                }
                                            </style>
                                            <div class="datatable-responsive table-responsive advance-btn-table no-padding">
                                                <table id="tblExcelDataDetail" class="table compact compact2 table-hover  table-bordered nowrap mgbt-xs-0 height-175 text-center " ng-model="tblExcelDataDetail">
                                                    <thead>
                                                        <tr>
                                                            <th ng-hide="sn">
                                                                S.R.No.
                                                            </th>
                                                            <th ng-hide="header=='Status' || header=='Color'" ng-repeat="(header, value) in UploadExcelRecordsList[0]">
                                                                {{header}}
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="rowData in UploadExcelRecordsList">
                                                            <td class="{{rowData.Color=='red' ? 'red_color' : ''}}"> {{$index+1}}</td>
                                                            <td class="{{rowData.Color=='red' ? 'red_color' : ''}}" ng-hide="header=='Status' || header=='Color'" ng-repeat="(header, value) in UploadExcelRecordsList[0]">
                                                                {{rowData[header]}}
                                                            </td>
                                                            @*<td class="{{rowData.Colour=='red' ? 'red_color' : ''}}"> {{$index+1}}</td>
        <td ng-repeat="cellData in rowData" class="{{rowData.Colour=='red' ? 'red_color' : ''}}">
            {{cellData}}
        </td>*@
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label"><span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <input value="Verify" ng-disabled="btnVerify" type="button" ng-click="VerifyRecords();" ng-model="Verify" id="txtVerify" name="txtVerify" class="btn-me btn-primary hvr-float-shadow" />
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                @Html.Partial("ActionView")
                                            </div>


                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                            <h3 style="text-decoration:underline">Note:</h3>
                            <ol style="margin-left:12px;color:black;font-weight:500">
                                <li>
                                    <span style="background-color: #f5646e; width: 15px; height: 15px; display: inline-block; border: 1px solid black; margin-bottom: 1px;">&nbsp;</span>
                                    <span style="font-weight:500;color:black"> Red color represents, Entries which are already into the system.</span>
                                </li>
                                <li>
                                    <span style="background-color: #fff; width: 15px; height: 15px; display: inline-block; border: 1px solid black;">&nbsp;</span>
                                    <span style="font-weight:500;color:black"> White color represents, New records.</span>
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>
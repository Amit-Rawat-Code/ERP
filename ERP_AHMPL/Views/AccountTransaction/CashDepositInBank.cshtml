@{
    ViewBag.Title = "CashDepositInBank";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/CashDepositInBankController.js?Ver=@ViewBag.Version"></script>
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Cash Deposit In Bank</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Finance</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Cash Deposit In Bank</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <input id="rbCash" type="radio" value="1" ng-model="type" ng-init="type='1'" ng-change="rdShowDiv();" />
                                                <label for="rbCash">Cash</label>
                                                <input id="rbCheque" type="radio" value="2" ng-model="type" ng-change="rdShowDiv();" style="margin-left: 90px" />
                                                <label for="rbCheque">Cheque Or Demand Draft</label>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15" ng-hide="hideLedgerTypeDropDown">
                                                <label class="control-label">Ledger Type<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <select id="ddlLedgerType" class="select2 form-control" ng-init="FillLedgerType();" ng-model="LedgerType" ng-change="FillLedgerDetails();">
                                                        <option value="">--Select--</option>
                                                        <option ng-repeat="bank in LedgerTypeList" value="{{bank.SubCode}}">{{bank.Name}}</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Date Of Deposit<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <input ng-disabled="disableDepositDate" id="txtDepositDate" type="date" class="form-control clear validate"
                                                           ng-model="DepositDate" max="{{MaxDate}}" />
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-6 col-xs-12" ng-hide="divledgerDataList || type=='2'">
                                                <label class="control-label account-book-balance">Account Book Balance : <span class="vd_red" style="font-size: 12px;">{{CashRuningBalance}}</span></label>
                                                &nbsp;| <label class="control-label account-book-balance">Account Cleared Balance : <span class="vd_green" style="font-size: 12px; color: green;">{{ClearedAmount}}</span></label>
                                                &nbsp;| <label class="control-label account-book-balance">Account InProcess Balance : <span class="vd_yellow" style="font-size: 12px; color: orange;">{{InProcessAmount}}</span></label>
                                            </div>
                                        </div>

                                        <div class="row" ng-hide="divledgerDataList">
                                            <div class="col-sm-12 col-md-12 col-xs-12 col-lg-12 mgbt-xs-15">
                                                <div class="table-responsive">
                                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                        <thead>
                                                            <tr>
                                                                <th><input type="checkbox" ng-model="ChkAll" ng-change="CheckALL();" />&nbsp;Select All</th>
                                                                <th>S.No.</th>
                                                                <th>Particulars</th>
                                                                <th>Voucher/Recepit Type</th>
                                                                <th>Voucher/Recepit No.</th>
                                                                <th>Date</th>
                                                                <th>Narration</th>
                                                                <th>Amount</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="obj in LedgerList" class="">
                                                                <td><input type="checkbox" ng-model="obj.checked" ng-init="obj.checked=false" ng-click="FillTotalAmt(obj);" ng-change="UnCheck_ChkAll();" /></td>
                                                                <td ng-bind="obj.Srno=($index+1)"></td>
                                                                <td>{{obj.StudentName}}</td>
                                                                <td>{{obj.V_Type}}</td>
                                                                <td>{{obj.PVNo}}</td>
                                                                <td>{{obj.PVDate}}</td>
                                                                <td>{{obj.VoucherNarr}}</td>
                                                                <td>{{obj.Amount}}</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="row" >

                                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mgbt-xs-15" ng-hide="divLedgerToatal">
                                                <label class="control-label">Total Amount<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <input id="txtTotalAmt" type="text" class="form-control clear" ng-disabled="TotAmt"
                                                           ng-model="TotalAmt" />
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mgbt-xs-15" ng-hide="ledgerPostVoucher">
                                                <label class="control-label">&nbsp;</label>
                                                <div class="input-box">
                                                    <input id="btnPostVoucher" type="button" value="{{postVoucher}}" class="btn-me btn-success" name="postVoucher"
                                                           ng-model="postVoucher" ng-init="postVoucher='Post Voucher'" ng-click="OpenContraVoucherForm();" />
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">&nbsp;</label>
                                                <div class="input-box">
                                                    <a href="" ng-click="ShowPopupDetails();" target="_blank" data-toggle="modal" data-target="#PopupDialogBox">
                                                        <input id="btnShowPopup" type="button" value="Deposit But Not Reconcile" class="btn-me btn-success" name="ShowPopup" ng-model="ShowPopup" />
                                                    </a>

                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                  
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

<!-- Modal Cleared ModalPopup -->
<div class="modal fade" id="PopupDialogBox" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Details</h4>
            </div>
            <div class="modal-body">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                    <div class="table-responsive" style=" width: 100%; overflow-y: hidden;">
                        <table id="example3" class="table table-striped table-bordered compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>S.No.</th>
                                    <th>Particulars</th>
                                    <th>Voucher/Recepit Type</th>
                                    <th>Voucher/Recepit No.</th>
                                    <th>Date</th>
                                    <th>Narration</th>
                                    <th ng-hide="chequeAmt">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="obj in LedgerPopUpList" scroll-div-footer="example3">
                                    <td ng-bind="obj.Srno=($index+1)"></td>
                                    <td>{{obj.StudentName}}</td>
                                    <td>{{obj.V_Type}}</td>
                                    <td>{{obj.PVNo}}</td>
                                    <td>{{obj.PVDate}}</td>
                                    <td>{{obj.VoucherNarr}}</td>
                                    <td ng-hide="chequeAmt">{{obj.Amount}}</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>

                                    <td><input type="text" class="form-control" placeholder="SR.No." /></td>
                                    <td><input type="text" class="form-control" placeholder="Particulars" /></td>
                                    <td><input type="text" class="form-control" placeholder="Voucher/Recepit Type" /></td>
                                    <td><input type="text" class="form-control" placeholder="Voucher/Recepit No." /></td>
                                    <td><input type="text" class="form-control" placeholder="Date" /></td>
                                    <td><input type="text" class="form-control" placeholder="Narration" /></td>
                                    <td ng-hide="chequeAmt"><input type="text" class="form-control" placeholder="Amount" /></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
               
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


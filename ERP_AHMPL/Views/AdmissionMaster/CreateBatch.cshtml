
@{
    ViewBag.Title = "Admission Create Batch";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/CreateBatchController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<style>
    .header {
        position: sticky;
        top: 0;
    }

    .container {
        width: 100%;
        height: 400px;
        overflow: auto;
        padding: 0px;
    }
</style>
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Admission Create Batch</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Admission Create Batch</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">

                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Select Class<span class="vd_red"></span></label>
                                                <div class="input-box chk-validate">
                                                    <div class="toggle-ddl" id="openClass" ng-init="ToogleDDL('openClass','openClass')">
                                                        @*btn-validate*@
                                                        <button class='btn btn-primary select-btn'
                                                                data-ng-click='openClass=!openClass' ng-bind="GetCount(ClassListRespectOfRegistration,'Select Class')">
                                                            Select Months
                                                        </button>
                                                        @*btn-validate*@
                                                        <button class='btn btn-primary dropdown-toggle select-btn-sub'
                                                                data-ng-click='openClass=!openClass'>
                                                            <span class='fa fa-chevron-down'></span>
                                                        </button>
                                                        <div ng-show="openClass" class="ddlMultiple" ng-cloak>
                                                            <div ng-click="ddlCheckAll('ClassListRespectOfRegistration')">
                                                                Check All
                                                                <span class="btn-counts-right">Total Count: {{ClassListRespectOfRegistration.length}}</span>
                                                            </div>
                                                            <div ng-click="ddlUnCheckAll('ClassListRespectOfRegistration')">Uncheck All</div>
                                                            <hr style="margin:0px !important" />

                                                            <table class="table compact table-hover table-striped table-bordered
                                                                   nowrap dataTable t-mgtb-n">
                                                                <thead>
                                                                    <tr>
                                                                        <th>SR .No.</th>
                                                                        <th>Class</th>
                                                                        <th class="text-center">No. of Registration</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <tr ng-repeat="sl in ClassListRespectOfRegistration" class="ng-scope">
                                                                        <td ng-bind="sl.Srno=($index+1)"></td>
                                                                        <td>
                                                                            <input type="checkbox" ng-model="sl.chk" ng-value="sl.Code" ng-disabled="sl.disabled" />
                                                                            {{sl.ClassName}}
                                                                        </td>
                                                                        <td class="text-center">{{sl.NewRegistration}}</td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Order By<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.DropDownList("ddlOrderBy", new List<SelectListItem>{
                                                     new SelectListItem{Text="Select", Value=""},
                                                     new SelectListItem{Text="Name", Value="1"},
                                                     new SelectListItem{Text="Reg. No.", Value="2"}
                                                 },
                                                new { @class = "select2 form-control validate", @ng_model = "OrderBy" })

                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Session<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlSession")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>

                                            </div>
                                            <div class="col-lg-2 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label"><span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <button type="submit" class="btn-me btn-success  hvr-float-shadow" ng-disabled="disableForEdit" ng-click="CollectStudent();">Get Student</button>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">No.of Regd. Student<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <input class="form-control clear textOnly ng-pristine ng-valid ng-empty ng-touched" id="txtNoOfRegdStudent" name="NoOfRegdStudent" ng-disabled="true" ng-model="NoOfRegdStudent" placeholder="" type="text">

                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">No.of Selected Student<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <input class="form-control clear textOnly ng-pristine ng-valid ng-empty ng-touched" id="txtNoOfSelectedStudent"
                                                           name="NoOfSelectedStudent" ng-disabled="true" ng-model="NoOfSelectedStudent" placeholder="" type="text">
                                                    <a href="#" class="btn btn-default float-right" data-toggle="modal" data-target="#myModal-1" style="position: absolute; top: 1px; right: 0px; display: inline-block;">View</a>
                                                    <div ng-hide="true">{{NoOfSelectedStudent=(StudentsList|filter:{chk:true}).length}}</div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">No.of Student Per Batch<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <input class="form-control clear textOnly ng-pristine ng-valid ng-empty ng-touched" id="txtNoOfStudentPerBatch" name="NoOfStudentPerBatch" ng-model="NoOfStudentPerBatch" ng-blur="CalculateBatch()" placeholder="" type="text">
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="TotalBatches>0?true:false">
                                                <h5 class="control-label">Total Created Batches = {{TotalBatches}}</h5>
                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                @Html.Partial("ActionView")
                                                <button id="btnSave" type="button" value="Save" class="btn-me btn-primary hvr-float-shadow" name="saveButton">
                                                    <span id="btnSavetxt">Define time Slot</span>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>
<div class="modal fade" id="myModal" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" ng-click="CalculateBatch()">&times;</button>
                <h4 class="modal-title">Student List</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%;position: sticky;top: 0">
                        <thead>
                            <tr>
                                <th class="header">S.No.</th>
                                <th class="header"><input type="checkbox" ng-model="chkAll_1" ng-change="CheckAll_1()" ng-init="chkAll_1=true" /></th>
                                <th class="header">Reg. No.</th>
                                <th class="header">Class</th>
                                <th class="header">Student Name</th>
                                <th class="header">Father Name</th>
                                <th class="header">Contact No.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="sl in StudentsList">
                                <td>{{$index+1}}</td>
                                <td><input type="checkbox" ng-model="sl.chk" ng-change="UnCheckAll_1()" /></td>
                                <td>{{sl.RegNo}}</td>
                                <td>{{sl.ClassName}}</td>
                                <td>{{sl.StudentName}}</td>
                                <td>{{sl.FatherName}}</td>
                                <td>{{sl.ContactNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" ng-click="CalculateBatch()">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="myModal-1" role="dialog" ng-if="Save=='Save'">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" ng-click="CalculateBatch()">&times;</button>
                <h4 class="modal-title">Student List</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                        <thead>
                            <tr>
                                <th class="header">S.No.</th>
                                <th class="header">Reg. No.</th>
                                <th class="header">Class</th>
                                <th class="header">Student Name</th>
                                <th class="header">Father Name</th>
                                <th class="header">Contact No.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="sl in StudentsList|filter:{chk:true}">
                                <td>{{$index+1}}</td>
                                <td>{{sl.RegNo}}</td>
                                <td>{{sl.ClassName}}</td>
                                <td>{{sl.StudentName}}</td>
                                <td>{{sl.FatherName}}</td>
                                <td>{{sl.ContactNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" ng-click="CalculateBatch()">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="myModal-1" role="dialog" ng-if="Save=='Edit'">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" ng-click="CalculateBatch()">&times;</button>
                <h4 class="modal-title">Student List</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                        <thead>
                            <tr>
                                <th class="header">S.No.</th>
                                <th class="header"><input type="checkbox" ng-model="chkAll_2" ng-change="CheckAll_2()" ng-init="chkAll_2=true" /></th>
                                <th class="header">Reg. No.</th>
                                <th class="header">Class</th>
                                <th class="header">Student Name</th>
                                <th class="header">Father Name</th>
                                <th class="header">Contact No.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="sl in StudentsList">
                                <td>{{$index+1}}</td>
                                <td><input type="checkbox" ng-model="sl.chk" /></td>
                                <td>{{sl.RegNo}}</td>
                                <td>{{sl.ClassName}}</td>
                                <td>{{sl.StudentName}}</td>
                                <td>{{sl.FatherName}}</td>
                                <td>{{sl.ContactNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" ng-click="CalculateBatch()">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    $('#ddlSession').removeClass('validate');
</script>

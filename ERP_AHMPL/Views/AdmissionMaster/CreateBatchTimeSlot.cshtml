
@{
    ViewBag.Title = "Create Batch Time Slot";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/CreateBatchTimeSlotController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Create Batch Time Slot</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Create Batch Time Slot</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">

                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Class<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        <div class="">
                                                            <div class="input-box">
                                                                <div class="checkbox checkbox-primary check-box">
                                                                    <input type="checkbox" ng-disabled="disableForEdit" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassListRespectOfCreatedBatch.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                                    <label>Select All</label>
                                                                </div>
                                                                <div class="text-box-msg-r2" style="font-weight: 500;">
                                                                    Total Selection: <label ng-model="selectedClassCount" ng-bind="selectedClassCount=(ClassListRespectOfCreatedBatch | filter:{'IsActive' : 'true'}).length" class="ng-pristine ng-untouched ng-valid ng-binding ng-not-empty"></label>
                                                                </div>
                                                                <div class="input-box" style="width:100%; background:#484848; position:relative; float:left; color:#fff;">
                                                                    <div class="checkbox checkbox-primary check-box-head">
                                                                        Class
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="" style="position:relative;">
                                                            <div class="slimScrollDiv-height3" id="slimScrollDiv-height2">


                                                                <table class="table compact table-hover table-striped table-bordered nowrap dataTable t-mgtb-n">
                                                                    <tbody>
                                                                        <tr ng-repeat="XL in ClassListRespectOfCreatedBatch">
                                                                            <td class="srno">
                                                                                <div class="checkbox checkbox-primary check-box chech-box-mp-n">
                                                                                    <input type="checkbox" ng-model="XL.IsActive" ng-disabled="disableForEdit" />
                                                                                    <label for=""> </label>
                                                                                </div>
                                                                            </td>
                                                                            <td style="float: left;display:none ">{{XL.Code}}</td>
                                                                            <td> {{XL.ClassName}}</td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>

                                                        </div>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                    <button type="submit" class="btn-me btn-success  hvr-float-shadow" ng-disabled="disableForEdit"
                                                            ng-click="CollectBatches();">
                                                        Get Batches
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <div class="row" ng-cloak ng-if="AssociatedBatchesList.length>0">
                                                    <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Batch Name<span class="vd_red">*</span></label>
                                                        <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                            <thead>
                                                                <tr>
                                                                    <th>S.No.</th>
                                                                    <th>Name of Batch</th>
                                                                    <th class="text-center">view</th>
                                                                    <th class="text-center"> </th>


                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="XL in AssociatedBatchesList">

                                                                    <td>{{$index+1}}</td>
                                                                    <td> {{XL.BatchName}}</td>
                                                                    <td class="text-center">
                                                                        <a href="#" class="btn btn-default" data-toggle="modal" data-target="#myModal" ng-click="BatchDetailList(XL.Code);">View</a>
                                                                    </td>
                                                                    <td>
                                                                        <div class="checkbox checkbox-success text-center">
                                                                            <input type="checkbox" ng-model="XL.IsActive" class="toggle-vis" data-column="16" />
                                                                            <label for=""> </label>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Document Required<span class="vd_red"></span></label>
                                                        @Html.Partial("chkDocument")

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Slot Date<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        <input class="form-control clear textOnly validate" id="txtSlotDate" name="SlotDate" ng-model="SlotDate" type="date">
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Start Time<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        <input class="form-control clear textOnly validate" id="txtStartTime" name="StartTime" ng-model="SlotTime" type="time">
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Duration of Each Batch(In Min.)<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        <input class="form-control clear textOnly validate" id="DurationOfEachBatch" name="StartTime" ng-model="BatchDuration" type="number" min="1">
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Break Between Batches(In Min.)</label>
                                                    <div class="input-box">
                                                        <input class="form-control clear textOnly " id="BreakBetweenBatches" name="StartTime" ng-model="BatchInterval" type="number">
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Written Exam Required</label>
                                                    <div class="input-box">
                                                        @Html.DropDownList("ddlIsWrittenExam", new List<SelectListItem>{
                                                        new SelectListItem{Text="Select", Value=""},
                                                        new SelectListItem{Text="Yes", Value="true"},
                                                        new SelectListItem{Text="No", Value="false"}
                                                    },
                                                   new { @class = "select2 form-control validate", @ng_model = "IsWrittenExam", @ng_init = "IsWrittenExam='false'" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Remark</label>
                                                    <div class="input-box">
                                                        <textarea class="form-control clear textOnly " id="BreakBetweenBatches" name="StartTime" ng-model="Remark" placeholder=""></textarea>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                @Html.Partial("ActionView")
                                                <button id="btnSave" type="button" value="Save" class="btn-me btn-primary hvr-float-shadow" name="saveButton">
                                                    <span id="btnSavetxt">Send Email/SMS</span>
                                                </button>
                                            </div>

                                        </div>
                                            
                                            </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>


<div class="modal fade" id="myModal" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Student List</h4>
            </div>
            <div class="modal-body">
                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Reg. No.</th>
                            <th>Class</th>
                            <th>Student Name</th>
                            <th>Father Name</th>
                            <th>Contact No.</th>
                    </thead>
                    <tbody>
                        <tr ng-repeat="XL in BatchDetailedList">
                            <td>{{$index+1}}.</td>
                            <td>{{XL.RegNo}}</td>
                            <td>{{XL.ClassName}}</td>
                            <td>{{XL.StudentName}}</td>
                            <td>{{XL.FatherName}}</td>
                            <td>{{XL.ContactNo}}</td>
                        </tr>
                    </tbody>

                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-default pull-left" data-toggle="modal" data-target="#myModal2">Add New Student</button>
            </div>
        </div>
    </div>
</div>




<div class="modal fade" id="myModal2" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Add New Student</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                        <label class="control-label">Class<span class="vd_red">*</span></label>
                        <div class="input-box">
                            <select id="ddlFatherOccupation" class="select2 form-control clear newvalidate" ng-init="GetClassesWithRespectOfRegistration()" ng-model="ClassCode" ng-change="CollectStudents(ClassCode);">
                                <option value="">Select Class</option>
                                <option ng-repeat="XL in ClassListRespectOfRegistration" value="{{XL.Code}}">{{XL.ClassName}}</option>
                            </select>
                            <div class="text-box-msg-r">
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                        <label class="control-label">Student<span class="vd_red">*</span></label>
                        <div class="input-box">
                            <select id="ddlFatherOccupation" class="select2 form-control clear newvalidate" ng-model="StudentRegNo">
                                <option value="">Select Student</option>
                                <option ng-repeat="XL in StudentsList" value="{{XL.RegNo}}">{{XL.StudentName}}-{{XL.RegNo}}</option>
                            </select>
                            <div class="text-box-msg-r">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="addnewrecordmclose" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button"  ng-click="AddNewRecord();" class="btn btn-default pull-left">Save</button>
            </div>
        </div>
    </div>
</div>

@{
    ViewBag.Title = "Details of Documents";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/DetailsOfDocumentsController.js?Ver=@ViewBag.Version"></script>
<style>
    .PhysicallyDisable-div select {
        display: table;
        width: auto;
        position: absolute;
        top: 0px;
        left: 0px;
    }

    .PhysicallyDisable-div input {
        padding-left: 90px;
    }
</style>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Details of Documents</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Details of Documents</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">

                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Name<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Name" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Father's Name<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtFatherName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "FatherName" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Course<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtCourse", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Course" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">College/Univ. Roll No.<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtCollegeUniversityRollNo", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "CollegeUniversityRollNo" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Gender<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="PrimaryNo_1" ng-model="PrimaryNo" value="1">
                                                        <label for="PrimaryNo_1"> Male </label>
                                                    </div>
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="WhatsAppNo_1" ng-model="WhatsAppNo" value="1">
                                                        <label for="WhatsAppNo_1"> Female</label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Category<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <div class="checkbox checkbox-primary check-box">
                                                        <input type="checkbox" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassList.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                        <label>General</label>

                                                        
                                                        
                                                    </div>
                                                    <div class="checkbox checkbox-primary check-box">
                                                        <input type="checkbox" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassList.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                        <label>OBC</label>
                                                    </div>
                                                    <div class="checkbox checkbox-primary check-box">
                                                        <input type="checkbox" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassList.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                        <label>Sc</label>
                                                    </div>
                                                    <div class="checkbox checkbox-primary check-box">
                                                        <input type="checkbox" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassList.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                        <label>ST</label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                                </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Contact Number<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtContactNumber", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "ContactNumber" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Yearly Income<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtYearlyIncome", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "YearlyIncome" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Specify If Case of Samaj Kalyan<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <select id="ddlCasteCategory" class="select2 form-control clear validate" ng-model="CasteCategory" ng-init="GetAbbrType();">
                                                        <option value="">Yes</option>
                                                        <option value="">No</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">General/OBC:Partial Reimbursement(If Yes)<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <div class="checkbox checkbox-primary check-box">
                                                        <input type="checkbox" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassList.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                        <label>General/OBC</label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Domicile<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtDomicile", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Domicile" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Total tution fee waiver<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <div class="checkbox checkbox-primary check-box">
                                                        <input type="checkbox" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassList.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                        <label>SC/ST</label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>






                                         


                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">

                                                <table class="table compact table-hover table-striped table-bordered nowrap dataTable t-mgtb-n">
                                                    <thead>
                                                        <tr>
                                                            <th>SNo.</th>
                                                            <th>Descripton Of Document</th>
                                                            <th>Original</th>
                                                            <th>Photocopy</th>
                                                            <th>Certificate No.</th>
                                                            <th>Remarks</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>1</td>
                                                            <td>Certificate</td>
                                                            <td class="text-center">
                                                                <div class="checkbox checkbox-primary ">
                                                                    <input type="checkbox" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassList.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                                    <label></label>
                                                                </div>
                                                            </td>
                                                            <td class="text-center">
                                                                <div class="checkbox checkbox-primary ">
                                                                    <input type="checkbox" ng-model="chkAllClass" ng-bind="chkAllClass=(selectedClassCount==ClassList.length?true:false)" ng-change="AllClass();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
                                                                    <label></label>
                                                                </div>
                                                            </td>
                                                            <td>---</td>
                                                            <td>---</td>                                                          
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                @Html.Partial("ActionView")
                                            </div>

                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>





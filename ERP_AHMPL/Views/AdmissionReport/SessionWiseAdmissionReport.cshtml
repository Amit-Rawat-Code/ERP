@{
    ViewBag.Title = "Sessionwise Admission Report";
    ViewBag.TitleList = "Sort By Column";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}


<script src="../Scripts/myjslib/StudentSessionWiseAdmissionReport.js?Ver=@ViewBag.Version"></script>

<input type="hidden" id="hdnEmployeeCode">
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">@ViewBag.Title</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><span>Admission</span></li>
                <li><span>Report</span></li>
                <li class="active"><span>@ViewBag.Title</span></li>
            </ol>
        </div>
    </div>

    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in">
                                    <form id="user-form">
                                        <div class="section-toggle  col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">

                                            <div class="col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <div class="input-box">
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" ng-model="filter" value="1" ng-init="filter='1'">
                                                            <label for="All">Class Wisw</label>
                                                        </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-9 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Class<span class="vd_red">*</span></label>
                                                        <div class="input-box">
                                                            @Html.Partial("ddlClass")
                                                            <div class="text-box-msg-r">
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            <div class="col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <div class="input-box">
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" ng-model="filter" value="2">
                                                            <label for="Present">Month Wise</label>
                                                        </div>
                                                    </div>
                                                    </div>
                                                    <label class="control-label">Class<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        @Html.Partial("ddlClass")
                                                        <div class="text-box-msg-r">
                                                        </div>

                                                    </div>

                                                </div>
                                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                    @Html.Partial("ActionSearch")
                                                </div>
                                            </div>
</form>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding report-box" id="TabAddHeight" TabAddHeight="41">
                                    <div class="arrow-container animated fadeInDown filter-toggle " ng-click="FilterToggle()">
                                        <div class="arrow-2">
                                            <i class="fa fa-angle-down"></i>
                                        </div>
                                        <div class="arrow-1 animated hinge infinite zoomIn"></div>
                                    </div>
                                    @Html.Partial("GeneralReportGrid")
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
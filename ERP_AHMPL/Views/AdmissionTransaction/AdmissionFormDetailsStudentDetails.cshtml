                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-6 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="IsSibling=='true' && FinalStudentList.length>0">
                                                            <div class="row">
                                                                <div class="col-lg-12 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                    <label class="control-label">Final Student's List<span class="vd_red">*</span></label>
                                                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>S.No.</th>
                                                                                <th>Class</th>
                                                                                <th>Student</th>
                                                                                <th>Gender</th>
                                                                                <th>Father</th>
                                                                                <th>Mother</th>
                                                                                <th>Relation</th>
                                                                                <th></th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            <tr ng-repeat="fsl in FinalStudentList">

                                                                                <td>{{$index+1}}</td>
                                                                                <td>{{fsl.ClassName}}</td>
                                                                                <td>{{fsl.StudentName}}</td>
                                                                                <td>{{fsl.Gender}}</td>
                                                                                <td>{{fsl.FatherName}}</td>
                                                                                <td>{{fsl.MotherName}}</td>
                                                                                <td>
                                                                                    <input ng-model="fsl.Relation" type="text" class="form-control" />
                                                                                </td>
                                                                                <td>
                                                                                    <div class="checkbox checkbox-success text-center">
                                                                                        <input type="checkbox" ng-model="fsl.chk" class="toggle-vis"
                                                                                               ng-click="CreateFinalStudentList(fsl,fsl.StudentCode,fsl.chk);" />
                                                                                        <label for=""> </label>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="form-panel">
                                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                                <h5 class="form-panel-heading">Staff Ward Details<span class="vd_red"></span></h5>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Staff Ward<span class="vd_red"></span></label>
                                                                <div class="input-box">
                                                                    @Html.Partial("ddlDesignation")
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Staff Name<span class="vd_red"></span></label>
                                                                <div class="input-box">
                                                                    <select id="ddlEmployee" class="select2 form-control validate" ng-model="EmployeeCode" ng-init="GetEmployees();" ng-change="GetEmployeeDetails()">
                                                                        <option value="">Select Employee</option>
                                                                        <option ng-repeat="Employee in EmployeesList|filter:{'DesignationCode':DesignationCode}" value="{{Employee.EmployeeCode}}" ng-disabled="!Employee.IsActive">{{Employee.FirstName}} {{Employee.MiddleName}} {{Employee.LastName}}</option>
                                                                    </select>
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>



                                                    <div class="description ml mr mt-n-md">
                                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                                            <ul class="pager wizard">
                                                                <li class="previous">
                                                                    <button id="btnprev" class="btn btn-primary pull-left"><i class="fa fa-caret-left"></i> Previous</button>
                                                                </li>
                                                                <li class="next">
                                                                    <button class="btn btn-primary pull-right">Next <i class="fa fa-caret-right"></i></button>
                                                                </li>
                                                                <li class="finish" style="display: none">
                                                                    @*<button ng-click="RegisterStudent();" class="btn btn-success pull-right">Finish <i class="fa fa-check"></i></button>*@

                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>



                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-center">
                                        @Html.Partial("ActionView")
                                        <button style="margin:5px" id="btnRedirect" type="button" value="Save and Redirect to Concession Mapping" ng-click="CheckSavePermission();SaveRecord(2);" ng-model="Redirect"
                                                @*ng-init="Redirect='Save and Redirect to Concession Mapping'"*@
                                                ng-init="Redirect='Save and Redirect to Admission Fee Deposit'"
                                                class="btn-me btn-primary hvr-float-shadow" name="redirectButton" ng-hide="IsFinalStudent" ng-disabled="disableAdd" ng-show="visibleAdd">
                                            <span id="btnRedirecttxt">{{Redirect}}</span>
                                        </button>
                                    </div>

                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                    @Html.Partial("SearchAngularJs")
                                </div>

                                @Html.Partial("AdmissionPrintForm")

                            </div>

                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal TotalTransferedEnquiry -->
<div class="modal fade" id="FeeDepositDetails" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Fee Deposit Details</h4>
            </div>
            <div class="modal-body">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                    <div class="table-responsive" style=" width: 100%; overflow-y: hidden;">
                        <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>SR.No.</th>
                                    <th>Admission No.</th>
                                    <th>Class</th>
                                    <th>Student</th>
                                    <th>FeeHead Wise Deposit Amount</th>
                                    <th>Receipt No</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="data in FeeDepositDetails">
                                    <td ng-bind="$index+1"></td>
                                    <td>{{data.AdmissionNo}}</td>
                                    <td>{{data.ClassName}}</td>
                                    <td>{{data.StudentName}}</td>
                                    <td>{{data.FeeHeadName}}</td>
                                    <td>{{data.RecpNo}}</td>
                                </tr>
                            </tbody>
                        </table>
                        <p>
                            <strong style="color:black;font-weight:600">Note:</strong> <span style="color:red">Previous class was {{PreviousClassName}},going to Change in Class: {{CurrentClassName}} and the above transactions will also be updated with current class.</span>
                        </p>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



@{
    ViewBag.Title = "Admission Form Details";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/AdmissionFormDetailsController.js?Ver=@ViewBag.Version"></script>

<style>

    .search-feild .input-box input#txtSearchBox {
        padding-left: 90px;
    }
</style>

<input type="hidden" id="Id" name="Id" value="" ng-model="studentDetails.StudentCode" />

<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Admission Form</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Student</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Admission Form</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper collapse in ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                        <div id="wizard" class="form-wizard wizard">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                                <ul class="wizard-navigation nav-justified steps nav nav-pills">
                                                    <li id="li1">
                                                        <a href="#tab1" data-toggle="tab" id="a1">
                                                            <span class="number">1</span>
                                                            <span class="title">Student Details</span>
                                                        </a>
                                                    </li>
                                                    <li id="li2">
                                                        <a href="#tab2" data-toggle="tab" id="a2">
                                                            <span class="number">2</span>
                                                            <span class="title">Guardian Details</span>
                                                        </a>
                                                    </li>
                                                    <li id="li3">
                                                        <a href="#tab3" data-toggle="tab" id="a3">
                                                            <span class="number">3</span>
                                                            <span class="title">Parent Details</span>
                                                        </a>
                                                    </li>
                                                    <li id="li4">
                                                        <a href="#tab4" data-toggle="tab" id="a4">
                                                            <span class="number">4</span>
                                                            <span class="title">Sibling/Ward</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                                <div id="bar" class="progress progress-xs mgtp-xs-20">
                                                    <div class="progress-bar progress-bar-striped active"></div>
                                                </div>

                                            </div>
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                                <div class="tab-content">
                                                    @*Tab Box 1*@

                                                    <div class="tab-pane " id="tab1">
                                                        <div class="row">
                                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">

                                                                    <div class="input-box">
                                                                        <div class="radio radio-primary radio-box">
                                                                            <input type="radio" id="FromMeritList" ng-model="AdmissionSourceType" value="1" class="ng-valid ng-not-empty ng-dirty ng-touched" name="EnquiryType" checked="checked" @*ng-init="AdmissionSourceType='1'"*@>
                                                                            <label for="FromMeritList">From Merit List</label>
                                                                        </div>
                                                                        <div class="radio radio-primary radio-box" ng-if="false">
                                                                            <input type="radio" id="DirectEnquiry" ng-model="AdmissionSourceType" value="0" class="ng-valid ng-not-empty ng-dirty ng-valid-parse ng-touched" name="EnquiryType">
                                                                            <label for="DirectEnquiry">Direct</label>
                                                                        </div>

                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 search-feild">
                                                                    <div class="input-box">
                                                                        <div class="text-box-msg-r" style="left:0px !important">
                                                                            @*<i class="fa fa-search" aria-hidden="true"></i>*@
                                                                            <button class="Srch-btn" ng-click="GetStudents()" style="left:0px !important">Search</button>
                                                                        </div>
                                                                        @Html.TextBox("txtSearchBox", "", new { @class = "form-control", @placeholder = "Search Reg No./Student Name/Mob.No.", @ng_model = "SearchBox", ng_disabled = "IsSearchBoxDisabled" })


                                                                        <label class="text text-danger shift-left-15" ng-click="Show=false"><i class="fa fa-times" aria-hidden="true"></i>Clear</label>


                                                                        @*Table*@
                                                                        <div ng-if="Show" class="searchbox">
                                                                            <table class="table compact table-hover table-striped table-bordered nowrap  dataTable">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th>Reg.No.</th>
                                                                                        <th>Class</th>
                                                                                        <th>Student</th>
                                                                                        <th>Father</th>
                                                                                        <th>Contact</th>
                                                                                        <th></th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    <tr ng-repeat="i in StudentList |
                                                                                        filter:{Filters:SearchBox}" class="data-ctrl">
                                                                                        <td>{{i.RegNo}}</td>
                                                                                        <td>{{i.ClassName}}</td>
                                                                                        <td>{{i.StudentName}}</td>
                                                                                        <td>{{i.FatherName}}</td>
                                                                                        <td>{{i.ContactNo}}</td>
                                                                                        <td class="text-align-right">
                                                                                            <button class="btn btn-dark" ng-click="GetEdit(i.RegNo)">GET DETAIL</button>
                                                                                        </td>
                                                                                    </tr>
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Session<span class="vd_red">*</span></label>
                                                                <div class="input-box">
                                                                    @Html.Partial("ddlSession")
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Class<span class="vd_red">*</span></label>
                                                                <div class="input-box">
                                                                    @Html.Partial("ddlClass")
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Section<span class="vd_red"></span></label>
                                                                <div class="input-box">
                                                                    @Html.Partial("ddlSection")
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Branch<span class="vd_red">*</span></label>
                                                                <div class="input-box">
                                                                    @Html.Partial("ddlBranch")
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Stream<span class="vd_red">*</span></label>
                                                                <div class="input-box">
                                                                    @Html.Partial("ddlStream")
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Medium<span class="vd_red">*</span></label>
                                                                <div class="input-box">
                                                                    @Html.Partial("ddlMedium")
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Board<span class="vd_red">*</span></label>
                                                                <div class="input-box">
                                                                    @Html.Partial("ddlBoards")
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Reg. No.<span class="vd_red">*</span></label>
                                                                <div class="input-box">
                                                                    @Html.TextBox("txtRegNo", "", new { @class = "form-control clear textOnly ", @placeholder = "", @ng_model = "RegNo", ng_disabled = "true" })
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                <label class="control-label">Admission No.<span class="vd_red"></span></label>
                                                                <div class="input-box">
                                                                    @Html.TextBox("txtAdmissionNo", "", new { @class = "form-control clear textOnly ", @placeholder = "", @ng_model = "AdmissionNo", ng_disabled = "true" }) @*ng_disabled = "IsFinalStudent==false"*@
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-xs-12">
                                                                <div class="form-panel">
                                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                                        <h5 class="form-panel-heading">Student Details<span class="vd_red"></span></h5>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">First Name<span class="vd_red">*</span></label>
                                                                        <div class="input-box">
                                                                            @Html.TextBox("txtStudentFirstName", "", new { @class = "form-control clear textOnly validate", @placeholder = "", @ng_model = "FirstName" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Middle Name<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.TextBox("txtStudentMiddleName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "MiddleName" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Last Name<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.TextBox("txtStudentLastName", "", new { @class = "form-control clear textOnly ", @placeholder = "", @ng_model = "LastName" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Date of birth<span class="vd_red">*</span></label>
                                                                        <div class="input-box">
                                                                            <input id="txtDateofEnquiry" type="date" class="form-control clear validate" placeholder=""
                                                                                   ng-model="DOB" />
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Place of birth</label>
                                                                        <div class="input-box">
                                                                            <input id="txtPlaceOfBirth" type="text" class="form-control clear " placeholder=""
                                                                                   ng-model="PlaceOfBirth" />
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Age of the Student as on 31st March 2021<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            <input id="txtAgeOfTheStudent" type="text" class="form-control clear" placeholder=""
                                                                                   ng-model="AgeOnDate" />
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Gender<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.Partial("ddlGender")
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Email<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.TextBox("txtStudentEmail", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "StudentEmail" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Mobile No.<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.TextBox("txtStudentContact", "",
                                                                           new { @class = "form-control clear {{PrimaryNo=='1' || WhatsAppNo=='1'?'validate':''}}", @placeholder = "", @ng_model = "StudentContact", @maxlength = "10", @allow_only_numbers = "" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Aadhar Card No<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.TextBox("txtAadharCardNo", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "AadharCardNo" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Blood Group<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.Partial("ddlBloodGroup")
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Date Of Joining<span class="vd_red">*</span></label>
                                                                        <div class="input-box">
                                                                            <input id="txtDateOfJoining" type="date" class="form-control clear validate" placeholder=""
                                                                                   ng-model="DateOfJoining" ng-init="Date=GetTodayDate()" />
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Date Of Admission<span class="vd_red">*</span></label>
                                                                        <div class="input-box">
                                                                            <input id="txtDateOfAdmission" type="date" class="form-control clear validate" placeholder=""
                                                                                   ng-model="DateOfAdmission" />
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Religion<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.Partial("ddlReligion")
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Caste<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.Partial("ddlCaste")
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Category<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.Partial("ddlCategory")
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Is Ews<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            <div class="radio radio-primary radio-box">
                                                                                <input type="radio" id="IsEwsYes" ng-model="IsEws" value="true">
                                                                                <label for="IsEwsYes">Yes</label>
                                                                            </div>
                                                                            <div class="radio radio-primary radio-box">
                                                                                <input type="radio" id="IsEwsNo" ng-model="IsEws" value="false" ng-init="IsEws='0'">
                                                                                <label for="IsEwsNo">No</label>
                                                                            </div>
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Nationality<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.Partial("ddlNationality")
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Is TC attached<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.DropDownList("ddlIsTC", new List<SelectListItem>{
                                                                                new SelectListItem{Text="Select", Value=""},
                                                                                new SelectListItem{Text="Yes", Value="true"},
                                                                                new SelectListItem{Text="No", Value="false"}
                                                                            },
                                                                                new { @class = "select2 form-control", @ng_model = "IsTC", @ng_init = "IsTC='false'" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Are You Interested In School Transport<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.DropDownList("ddlIsTransport", new List<SelectListItem>{
                                                                                new SelectListItem{Text="Select", Value=""},
                                                                                new SelectListItem{Text="Yes", Value="true"},
                                                                                new SelectListItem{Text="No", Value="false"}
                                                                            },
                                                                                new { @class = "select2 form-control", @ng_model = "IsTransport", @ng_init = "IsTransport='false'" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                                                        <div class="input-box">
                                                                            @Html.Partial("ddlIsActive")
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Withdraw TC<span class="vd_red"></span></label>
                                                                        <div class="input-box">
                                                                            @Html.DropDownList("ddlWithdrawTC", new List<SelectListItem>{
                                                                                new SelectListItem{Text="Select", Value=""},
                                                                                new SelectListItem{Text="Yes", Value="true"},
                                                                                new SelectListItem{Text="No", Value="false"}
                                                                            },
                                                                                new { @class = "select2 form-control", @ng_model = "WithdrawTC", @ng_init = "WithdrawTC='false'", ng_disabled = "true" })
                                                                            <div class="text-box-msg-r">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-xs-12">
                                                                <div class="form-panel">
                                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                                                        <h5 class="form-panel-heading">Student Other Details<span class="vd_red"></span></h5>
                                                                    </div>

                                                                    @*<div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                            <label class="control-label">Optional Subject<span class="vd_red"></span></label>
                                                                            <div class="input-box">
                                                                                @Html.Partial("ddlOptionalSubject")
                                                                                <div class="text-box-msg-r">
                                                                                </div>
                                                                            </div>
                                                                        </div>*@
                                                                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                        <label class="control-label">Optional Subject<span class="vd_red"></span></label>
                                                                        <div class="input-box chk-validate">
                                                                            <div class="toggle-ddl" id="openOptionalSubject" ng-init="ToogleDDL('openOptionalSubject','openOptionalSubject')">
                                                                                @*btn-validate*@
                                                                                <button class='btn btn-primary select-btn'
                                                                                        data-ng-click='openOptionalSubject=!openOptionalSubject' ng-bind="GetCount(OptionalSubjectList,'Select Subject')">
                                                                                    Select Subject
                                                                                </button>
                                                                                @*btn-validate*@
                                                                                <button class='btn btn-primary dropdown-toggle select-btn-sub'
                                                                                        data-ng-click='openOptionalSubject=!openOptionalSubject'>
                                                                                    <span class='fa fa-chevron-down'></span>
                                                                                </button>
                                                                                <div ng-show="openOptionalSubject" class="ddlMultiple" ng-cloak>
                                                                                    <div ng-click="ddlCheckAll('OptionalSubjectList')">
                                                                                        Check All
                                                                                        <span class="btn-counts-right">Total Count: {{OptionalSubjectList.length}}</span>
                                                                                    </div>
                                                                                    <div ng-click="ddlUnCheckAll('OptionalSubjectList')">Uncheck All</div>


@{
    ViewBag.Title = "Entrance Marks Entry Primary Junior";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/EntranceMarksEntryPrimaryJuniorController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Entrance Marks Entry Primary/Junior</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Entrance Marks Entry Primary/Junior</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Class<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlClass")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Batch<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlBatchClassWise")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Total Marks<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("TotalMarks", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "TotalMarks" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-show="StudentsList.length>0">
                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Batch</th>
                                                            <th>Student Name</th>
                                                            <th>Reg. No.</th>
                                                            <th>Father Name</th>
                                                            <th>Max Mark</th>
                                                            <th>Marks Obtained</th>
                                                            <th>Details</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="StuList in StudentsList">
                                                            <td ng-bind="StuList.Srno=($index+1)"
                                                                ng-model="SubjectMarksEntry[$index]" ng-init="SubjectMarksEntry[$index]=[]"></td>
                                                            <td>{{StuList.BatchName}}</td>
                                                            <td>
                                                                {{StuList.StudentName}}
                                                            </td>
                                                            <td>{{StuList.RegNo}}</td>
                                                            <td>{{StuList.FatherName}}</td>
                                                            <td>
                                                                {{StuList.MaxMarks=TotalMarks}}
                                                            </td>
                                                            <td><input type="text" class="form-control" ng-model="StuList.ObtainMarks" /></td>
                                                            <td>
                                                                <input type="button" value="Details" ng-if="StuList.ObtainMarks"
                                                                       ng-click="GetEntranceSubject($index,StuList.ObtainMarks,StuList.RegNo,StuList.StudentName,StuList.BatchName)" />
                                                                @*<a href="#" class="text-success"
                            ng-click="GetEntranceSubject(StuList.ObtainMarks)">Details</a></td>*@
                                                        </tr>

                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="SubjectList.length>0">
                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th colspan="4">
                                                                <span style="font-weight: 500">Student: </span>{{StudentName}} | 
                                                                <span style="font-weight: 500">Reg. No.: </span>{{RegNo}} | 
                                                                <span style="font-weight: 500">Batch: </span>{{BatchName}}
                                                            </th>
                                                        </tr>
                                                        <tr>
                                                            <th>Sr. No.</th>
                                                            <th>Subject</th>
                                                            <th>Max Marks ({{TotalMarks}})</th>
                                                            <th>Obtained Marks ({{ObtainMaxMarks}})</th>

                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="subject in SubjectList">
                                                            <td ng-bind="subject.Srno=($index+1)"></td>
                                                            <td>{{subject.SubjectName}}</td>
                                                            <td>
                                                                <input type="number" class="form-control" ng-model="subject.MaxMarks"
                                                                       ng-blur="CheckObtainMarks(subject,subject.MaxMarks,subject.ObtainMarks)" />
                                                            </td>
                                                            <td>
                                                                <input type="number" class="form-control" ng-model="subject.ObtainMarks"
                                                                       ng-change="CheckObtainMarks(subject,subject.MaxMarks,subject.ObtainMarks)" />
                                                            </td>

                                                        </tr>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td></td>
                                                            <td><b>Total</b></td>
                                                            <td>
                                                                <b>{{$parent.SubjectWiseTotalMaxMarks=Sumoflist('SubjectList','MaxMarks',null,0)}}</b>
                                                            </td>
                                                            <td>
                                                                <b>{{$parent.SubjectWiseTotalObtain=Sumoflist('SubjectList','ObtainMarks',null,0)}}</b>
                                                            </td>
                                                        </tr>

                                                    </tfoot>



                                                </table>

                                                <button id="btnSave" type="button" value="Save" ng-click="SetSubjectMarks()" class="btn-me btn-primary hvr-float-shadow" name="saveButton">
                                                    <span id="btnSavetxt">OK</span>
                                                </button>
                                                <button id="btnClear" type="button" ng-click="ClearMe()" value="Clear" class="btn-me btn-primary hvr-float-shadow" name="clearButton">
                                                    <span id="BtnClear">Clear</span>
                                                </button>
                                                <button id="btnCancel" type="button" ng-click="Cancel()" value="Cancel" class="btn-me btn-primary hvr-float-shadow" name="cancelButton">
                                                    <span id="BtnCancel">Cancel</span>
                                                </button>
                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1 ">
                                                @Html.Partial("ActionView")
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>




@{
    ViewBag.Title = "Send Email & SMS Entrance Merit List";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/Scripts/myjslib/SendEmailSMSForEntranceMeritListController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Send Email & SMS Entrance Merit List</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Admission</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Send Email & SMS Entrance Merit List</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">

                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Current Date<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("txtToDate")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Communication Via.<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <select id="ddlCommunicationVia" class="select2 form-control validate" ng-model="CommunicationVia" ng-change="GetStudentRecord()">
                                                        <option value="">Select</option>
                                                        <option value="S">SMS</option>
                                                        <option value="E">Email</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">

                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Class</th>
                                                            <th>Reg. No.</th>
                                                            <th>Student Name</th>
                                                            <th>Father Name</th>
                                                            <th ng-show="(CommunicationVia=='E'?true:false)">Email ID</th>
                                                            <th ng-show="(CommunicationVia=='S'?true:false)">Mobile No.</th>
                                                            <th class="text-right">
                                                                <div class="checkbox checkbox-success check-box">
                                                                    <input type="checkbox" class="toggle-vis" ng-change="CheckAll(chkSelectAll)" ng-model="chkSelectAll">
                                                                    <label class="">Select All</label>
                                                                </div>
                                                            </th>
                                                            <th>Last Send Date</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="X in studentlist" marge-cell-rowspan>
                                                            <td ng-bind="X.Srno=($index+1)"></td>
                                                            <td>{{X.ClassName}}</td>
                                                            <td>{{X.RegNo}}</td>
                                                            <td>{{X.StudentName}}</td>
                                                            <td>{{X.FatherName}}</td>
                                                            <td ng-show="(CommunicationVia=='E'?true:false)">{{X.EmailId}}</td>
                                                            <td ng-show="(CommunicationVia=='S'?true:false)">{{X.MobileNo}}</td>
                                                            <td>
                                                                <div class="checkbox checkbox-success text-center">
                                                                    <input type="checkbox" ng-model="X.chk" class="toggle-vis" ng-checked="X.chk">
                                                                    <label class="" for=""></label>
                                                                </div>
                                                            </td>
                                                            <td><span ng-bind="X.LastDate"></span></td>
                                                        </tr>
                                                    </tbody>

                                                </table>
                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                <button id="btnSave" type="button" value="Send" class="btn2 btn-common btn-3 btn-3d pe-7s-check" name="saveButton" ng-model="Send" ng-init="Save='Send'" ng-click="CheckSavePermission();SaveRecord()" ng-disabled="disableAdd">
                                                    <span class="triangle-box" title="Send"></span>
                                                    <span id="btnSavetxt" ng-bind="Save">Send</span>
                                                </button>
                                            </div>

                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>



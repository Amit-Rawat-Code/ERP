@{
    ViewBag.Title = "Student Role Assignment";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/StudentRolePageController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<input type="hidden" id="Id" name="Id" value="" ng-model="UserNameListWithoutRole.UserId" />

<style>
    .search-feild .input-box input#txtSearchBox {
        padding-left: 90px;
    }
</style>

<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Student Role Assignment</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Admission</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Student Role Assignment</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper collapse in ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="col-md-4 col-sm-6 col-xs-12 ">
                                        <div class="form-group">
                                            <label class="control-label">Date<span class="vd_red">*</span></label>
                                            <input type="date" id="ApplicableDate" class="form-control validate" ng-model="CurrentDate" />
                                        </div>
                                    </div>

                                    <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                        <label class="control-label">User Type<span class="vd_red">*</span></label>
                                        <div class="input-box">
                                            <select id="ddlGroupId" class="select2 form-control validate" ng-model="UserTypeId" ng-init="GetUserTypes()" ng-disabled="true">
                                                <option value="" selected>Select User Type</option>
                                                <option ng-repeat="LUT in ListedUserTypes" value="{{LUT.UserTypeId}}">{{LUT.UserTypeName}}</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                        <label class="control-label">Student List<span class="vd_red">*</span></label>
                                        <div class="input-box">
                                            <div class="input-box">
                                                <select id="ddlstlist" class="select2 form-control validate" ng-model="StudentList" ng-click="BlankHistoryList();">
                                                    <option value="" selected>Select User List</option>
                                                    <option value="0">Student With Assigned Role</option>
                                                    <option value="1">Student Without Role</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="div1" class="col-lg-8 col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 search-feild" ng-show="StudentList==0">
                                        <label class="control-label">Student Detail With Assigned Role<span class="vd_red">*</span></label>
                                        <div class="input-box">
                                            <div class="text-box-msg-r" style="left:0px !important">
                                                <button class="Srch-btn" ng-click="GetUserDetail()" style="left:0px !important">Search</button>
                                            </div>
                                            @Html.TextBox("txtSearchBox", "", new
                                        {
                                            @class = "form-control",
                                            @placeholder = "Search Reg No./Student Name/Mob.No.",
                                            @ng_model = "SearchBox",
                                            ng_disabled = "IsSearchBoxDisabled",
                                            @autocomplete = "off",
                                            @ng_Click = "GetUserDetail();"
                                        })
                                            <label class="text text-danger shift-left-15" ng-click="Show=false" style="top:1px;"><i class="fa fa-times" aria-hidden="true"></i>Clear</label>
                                            <div ng-if="Show" class="searchbox">
                                                <table class="table compact table-hover table-striped table-bordered nowrap dataTable">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:80px;text-align:center">Sr.No</th>
                                                            <th style="width:80px;text-align:center">User Name</th>
                                                            <th style="width:80px;text-align:center">Profile Name</th>
                                                            <th>Email-ID</th>
                                                            <th>Mobile No</th>
                                                            <th style="width:80px;text-align:center">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="obj in UserNameList |filter:SearchBox" class="data-ctrl">
                                                            <td style="width:80px;text-align:center">{{$index+1}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.UserName}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.ProfileName}}</td>
                                                            <td>{{obj.EmailId}}</td>
                                                            <td>{{obj.MobileNo}}</td>
                                                            <td class="text-align-right">
                                                                <button class="btn btn-dark" ng-click="GetEdit(obj.UserId);GetHistoryDetail();">GET DETAIL</button>
                                                            </td>
                                                        </tr>
                                                        <tr ng-if="UserNameList.length==0"><td colspan="6" class="text-center">No Record Found</td></tr>
                                                    </tbody>                                                   
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="div2" class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="StudentList==0">
                                        <label class="control-label">Current Student Profile</label>
                                        <div class="table-responsive" style=" width: 100%; overflow-y: initial; overflow-x: initial;">
                                            <table class="table table-striped table-bordered compact" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th style="width:80px;text-align:center">User Name</th>
                                                        <th style="width:80px;text-align:center">Profile Name</th>
                                                        <th style="width:80px;text-align:center">Email-ID</th>
                                                        <th style="width:80px;text-align:center">Contact No</th>
                                                        <th style="width:80px;text-align:center">Assign Role</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td style="width:80px;text-align:center">{{UserNameListNew.UserName}}</td>
                                                        <td style="width:80px;text-align:center">{{UserNameListNew.ProfileName}}</td>
                                                        <td style="width:80px;text-align:center">{{UserNameListNew.EmailId}}</td>
                                                        <td style="width:80px;text-align:center">{{UserNameListNew.MobileNo}}</td>
                                                        <td style="width:80px;text-align:center">{{UserNameListNew.Pre_Role}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    @*<div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15"  ng-show="StudentList==1">
                                        <label class="control-label">&nbsp;</label>
                                        <div class="input-box">
                                            <button id="btnView" type="button" value="StudentList" class="btn-me btn-success  hvr-float-shadow" name="StudentListButton"
                                                    data-toggle="collapse" data-target="#CollapseSearchTableList" aria-expanded="false" aria-controls="CollapseSearchTableList"
                                                    ng-click="SearchRecord_WithoutRole()">
                                                <span class="action-txt">StudentList Without Role</span>
                                                <i data-feather="StudentList"></i>
                                            </button>
                                        </div>
                                    </div>*@

                                    <div id="div3" class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 search-feild" ng-show="StudentList==1">
                                        <label class="control-label">Student Detail Without Assigned Role<span class="vd_red">*</span></label>
                                        <div class="input-box">
                                            <div class="text-box-msg-r" style="left:0px !important">
                                                <button class="Srch-btn" ng-click="SearchRecordWithoutRole();" style="left:0px !important">Search</button>
                                            </div>
                                            @Html.TextBox("txtSearchBox1", "", new
                                       {
                                           @class = "form-control",
                                           @placeholder = "Search Reg No./Student Name/Mob.No.",
                                           @ng_model = "SearchBox1",
                                           ng_disabled = "IsSearchBoxDisabled",
                                           @autocomplete = "off",
                                           @ng_Click = "SearchRecordWithoutRole();"
                                       })
                                            <label class="text text-danger shift-left-15" ng-click="Show=false" style="top:1px;"><i class="fa fa-times" aria-hidden="true"></i>Clear</label>
                                            <div ng-if="Show" class="searchbox">
                                                <table class="table compact table-hover table-striped table-bordered nowrap dataTable">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:80px;text-align:center">Sr.No</th>
                                                            <th style="width:80px;text-align:center">Student Name</th>
                                                            <th style="width:80px;text-align:center">StudentID</th>
                                                            <th style="width:80px;text-align:center">Admission No</th>
                                                            <th style="width:80px;text-align:center">Class</th>
                                                            <th style="width:80px;text-align:center">Section</th>
                                                            <th style="width:80px;text-align:center">Father's Name</th>
                                                            <th style="width:80px;text-align:center">Mobile No.</th>
                                                            <th style="width:80px;text-align:center">Email-ID</th>
                                                            <th style="width:80px;text-align:center">Active</th>
                                                            <th style="width:80px;text-align:center">UserId</th>
                                                            <th style="width:80px;text-align:center">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="obj in UserNameListWithoutRole |filter:SearchBox1" class="data-ctrl">
                                                            <td style="width:80px;text-align:center">{{$index+1}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.StudentName}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.StudentID}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.AdmissionNo}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.ClassName}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.SectionName}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.FatherName}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.FatherMobile}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.EmailId}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.IsActive}}</td>
                                                            <td style="width:80px;text-align:center">{{obj.UserId}}</td>
                                                            <td class="text-align-right">
                                                                <button class="btn btn-dark" ng-click="GetEdit1(obj.UserId);GetHistoryDetail();">GET DETAIL</button>
                                                            </td>
                                                        </tr>
                                                        <tr ng-if="UserNameListWithoutRole.length==0"><td colspan="12" class="text-center">No Record Found</td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                                                      
                                    <div id="div4" class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="StudentList==1">
                                        <label class="control-label">Current Student Profile</label>
                                        <div class="table-responsive" style=" width: 100%; overflow-y: initial; overflow-x: initial;">
                                            <table class="table table-striped table-bordered compact" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th style="width:80px;text-align:center">User Name</th>
                                                        <th style="width:80px;text-align:center">Profile Name</th>
                                                        <th style="width:80px;text-align:center">Email-ID</th>
                                                        <th style="width:80px;text-align:center">Contact No</th>
                                                        <th style="width:80px;text-align:center">Assign Role</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td style="width:80px;text-align:center">{{WithoutRoleList.UserName}}</td>
                                                        <td style="width:80px;text-align:center">{{WithoutRoleList.ProfileName}}</td>
                                                        <td style="width:80px;text-align:center">{{WithoutRoleList.EmailId}}</td>
                                                        <td style="width:80px;text-align:center">{{WithoutRoleList.MobileNo}}</td>
                                                        <td style="width:80px;text-align:center"></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div id="div5" class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-if="HistoryListNew.length>0">
                                        <label class="control-label">Student Profile Permission History</label>
                                        <div class="table-responsive" style=" width: 100%; overflow-y: initial; overflow-x: initial;">
                                            <table class="table table-striped table-bordered compact" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th style="width:80px;text-align:center">User Name</th>
                                                        <th style="width:80px;text-align:center">Profile Name</th>
                                                        <th style="width:80px;text-align:center">Assign Role</th>
                                                        <th style="width:80px;text-align:center">Date</th>
                                                        <th style="width:80px;text-align:center">Time</th>
                                                        <th style="width:80px;text-align:center">Remark</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="hl in HistoryListNew">
                                                        <td style="width:80px;text-align:center">{{hl.UserName}}</td>
                                                        <td style="width:80px;text-align:center">{{hl.ProfileName}}</td>
                                                        <td style="width:80px;text-align:center">{{hl.RoleName}}</td>
                                                        <td style="width:80px;text-align:center">{{hl.CRDate}}</td>
                                                        <td style="width:80px;text-align:center">{{hl.CRTime}}</td>
                                                        <td style="width:80px;text-align:center">{{hl.Remark}}</td>
                                                    </tr>
                                                    <tr ng-if="HistoryListNew.length==0"><td colspan="5" class="text-center">Permission History Not Found</td></tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                        <label class="control-label">Change Role<span class="vd_red">*</span></label>
                                        <div class="input-box">
                                            <select id="ddlChangeRole" class="select2 form-control clear validate" ng-model="ChangeRole" ng-init="GetUserRole();">
                                                <option value="">Select Role</option>
                                                <option ng-repeat="role in UserRoleList" value="{{role.RoleId}}">{{role.RoleName}}</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-4 col-sm-6 col-xs-12 ">
                                        <div class="form-group">
                                            <label class="control-label">Assign Role Till Date<span class="vd_red">*</span></label>
                                            <input type="date" ng-model="TillDate" id="TillDate" class="form-control validate" />
                                        </div>
                                    </div>

                                    <div class="col-md-4 col-sm-8 col-xs-12">
                                        <div class="form-group">
                                            <label class="control-label">Remark&nbsp;&nbsp;[250] Character<span class="vd_red">*</span></label>
                                            <textarea id="txtremark" class="form-control clear validate" ng-model="remark" placeholder="Write Remark here.........." style="min-height:80%"></textarea>
                                        </div>
                                    </div>

                                    <div class="col-lg-8 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                        @Html.Partial("ActionSaveSearchClear");
                                    </div>
                                </div>
                                    @Html.Partial("SearchAngularJs")                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
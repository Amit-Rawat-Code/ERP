@{
    ViewBag.Title = "BookChapterMaster";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/BookChapterMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Book Chapter Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Academics</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Book Chapter Master</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="row">
                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Date</label>
                                                <input type="date" ng-model="EntryDate" id="ApplicableDate" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Name Of Book</label>
                                                <select id="ddlNameOfBook" class="select2 form-control clear validate" ng-model="NameOfBook" ng-init="GetAllBookName();" ng-change="GetAllPublication();">
                                                    <option value="">Select Book</option>
                                                    <option ng-repeat="Books in BookNameList" value="{{Books.Code}}">{{Books.NameOfBook}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Publication</label>
                                                <select id="ddlPublication" class="select2 form-control clear validate" ng-model="Publication">
                                                    @*Publication*@
                                                    <option value="">Select Publication</option>
                                                    <option ng-repeat="Publications in PublicationList" value="{{Publications.Code}}">{{Publications.Publication}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <div class="table-responsive" style="overflow-y: hidden;">
                                                    <br />
                                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%" ng-init="AddRow()">
                                                        <thead>
                                                            <tr>
                                                                <th>S.No.</th>
                                                                <th>Chapter</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="obj in ChapterList">
                                                                <td ng-bind="obj.Srno=($index+1)"></td>
                                                                <td>
                                                                    <input class="form-control clear" type="text" ng-model="obj.ChapterName" />
                                                                </td>
                                                                <td>
                                                                    <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow()" ng-if="ChapterList.length==1 || ChapterList.length==obj.Srno" />
                                                                    <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(obj.Srno)" ng-if="ChapterList.length>1" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8 col-sm-6 col-xs-12 ">
                                                @Html.Partial("ActionView")
                                            </div>
                                    </div>
                                </div>
                                @Html.Partial("SearchAngularJs")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    ViewBag.Title = "ClassWiseSubjectWiseBook";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/ClassWiseSubjectWiseBookController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Class Wise Subject Wise Book</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Academics</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Class Wise Subject Wise Book</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody"> 
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="row">
                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Academic Session</label>
                                                @*@Html.Partial("ddlSession")*@
                                                <select ng-disabled="clsSession" id="ddlSession" autocomplete='address-level2' class="select2 form-control validate" ng-model="SessionId" ng-init="GetSession()" ng-change="GetAllClass()">
                                                    @*ddlSession_Change(SessionId)*@
                                                    <option value="">Select Session</option>
                                                    <option ng-repeat="sl in SessionList" value="{{sl.SessionId}}">{{sl.SessionName}}</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Class</label>
                                                <select ng-disabled="clsClass" id="ddlClass" class="select2 form-control clear validate" ng-model="class" ng-init="GetAllClass();" ng-change="GetAllSubject();">
                                                    <option value="">Select Class</option>
                                                    <option ng-repeat="classes in ClassList" value="{{classes.Code}}">{{classes.ClassName}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <label>Subject</label>
                                                <select ng-disabled="clsSubject"  id="ddlSubject" class="select2 form-control clear validate" ng-model="Subject" ng-change="GetAllBook();">
                                                    <option value="">Select Subject</option>
                                                    <option ng-repeat="Subjects in SubjectList" value="{{Subjects.SubjectCode}}">{{Subjects.SubjectName}}</option>
                                                    @*!Subjects.IsDisabled*@
                                                    @*" ng-disabled=" $scope.Save == " Edit""*@
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12">
                                            <div class="input-box">
                                                </
                                                <label>  Book</</label>
                                                <div class="input-box chk-validate">
                                                    <div class="toggle-ddl" id="openBook" ng-init="GetAllBook();ToogleDDL('openBook','openBook')">
                                                        <button class='btn btn-primary select-btn' data-ng-click='openBook=!openBook' ng-bind="GetCount(BookList,'Select Book')">Select Book</button>
                                                        <button class='btn btn-primary dropdown-toggle select-btn-sub' data-ng-click='openBook=!openBook'> <span class='fa fa-chevron-down'></span> </button>
                                                        <div ng-show="openBook" class="ddlMultiple" ng-cloak>
                                                            <div ng-click="ddlCheckAll('BookList');">
                                                                Check All <span class="btn-counts-right">Total Count: {{BookList.length}}</span>
                                                            </div>
                                                            <div ng-click="ddlUnCheckAll('BookList');">Uncheck All</div>
                                                            <hr style="margin:0px !important" />
                                                            <div ng-repeat="Boks in BookList">
                                                                <input type="checkbox" ng-model="Boks.chk" ng-value="Boks.BCode" ng-disabled="Boks.disabled" ng-show="Boks.IsActive" /> {{Boks.NameOfBook}}
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8 col-sm-6 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </div>
                                </div>
                                @Html.Partial("SearchAngularJs")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

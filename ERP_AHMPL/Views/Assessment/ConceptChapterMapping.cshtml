@{
    ViewBag.Title = "Concept Chapter Mapping";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}
<script src="~/Scripts/myjslib/ConceptChapterMappingController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Concept Chapter Mapping</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Academics</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Concept Chapter Mapping</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="row">

                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Academic Session</label>
                                                @*@Html.Partial("ddlSession")*@
                                            <select id="ddlSession" autocomplete='address-level2' class="select2 form-control validate"
                                                    ng-model="SessionId" ng-init="GetSession()" ng-change="GetAllClass()">
                                                @*ddlSession_Change(SessionId)*@
                                                <option value="">Select Session</option>
                                                <option ng-repeat="sl in SessionList" value="{{sl.SessionId}}">{{sl.SessionName}}</option>
                                            </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Class</label>
                                                <select id="ddlClass" class="select2 form-control clear validate" ng-model="class"
                                                        ng-init="GetAllClass();" ng-change="GetAllSubject();">
                                                    <option value="">Select Class</option>
                                                    <option ng-repeat="classes in ClassList" value="{{classes.ClassCode}}">{{classes.ClassName}}</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <label>Subject</label>
                                                <select id="ddlSubject" class="select2 form-control clear validate" ng-model="Subject" ng-change="GetAllBook();">
                                                    <option value="">Select Subject</option>
                                                    <option ng-repeat="Subjects in SubjectList" value="{{Subjects.SubjectCode}}">{{Subjects.SubjectName}}</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <label>Book</label>
                                                <select id="ddlBooks" class="select2 form-control clear validate" ng-model="Books" ng-change="GetAllConcept();GetAllChapter();">
                                                    <option value="">Select Book</option>
                                                    <option ng-repeat="Boks in BookList" value="{{Boks.Code}}" ng-disabled="!Boks.IsDisabled">{{Boks.NameOfBook}}</option>@*ng-disabled="!Boks.IsDisabled"*@
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-md-8 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <div class="table-responsive" style="overflow-y: hidden;"><br />
                                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                        <thead>
                                                            <tr>
                                                                <th>S.No.</th>
                                                                <th>Chapter Name</th>
                                                                <th>Concept Name</th>
                                                                @*<th></th>*@
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="obj in ChapterList" value="{{obj.ChapterCode}}">
                                                                <td ng-bind="obj.Srno=($index+1)"></td>                                                               
                                                                <td ng-model="obj.ChapterCode">{{obj.ChapterName}}</td>
                                                                <td>
                                                                    <select id="ddlConcept" class="select2 form-control clear" ng-model="obj.ConceptCode">
                                                                        <option value="">Select Concept</option>
                                                                        <option ng-repeat="cons in ConceptList" value="{{cons.ID}}">{{cons.ConceptName}}</option>
                                                                    </select>
                                                                </td>                                                                
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-8 col-sm-6 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

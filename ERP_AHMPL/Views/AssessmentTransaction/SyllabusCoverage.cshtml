@{
    ViewBag.Title = "SyllabusCoverage";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/SyllabusCoverageController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Syllabus Coverage</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Academics</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Syllabus Coverage</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="row">
                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Class</label>
                                                <select id="ddlClass" class="select2 form-control clear validate" ng-model="class" ng-init="GetAllClass();" ng-change="GetAllSection();">
                                                    <option value="">Select Class</option>
                                                    <option ng-repeat="classes in ClassList" value="{{classes.Code}}">{{classes.ClassName}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="form-group">
                                                <label>Section</label>
                                                <select id="ddlSection" class="select2 form-control clear validate" ng-model="Section" ng-change="GetAllSubject();">
                                                    <option value="">Select Section</option>
                                                    <option ng-repeat="Section in SectionList" value="{{Section.Code}}">{{Section.SectionName}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12">
                                            <div class="form-group">
                                                <label>Subject</label>
                                                <select id="ddlSubject" class="select2 form-control clear validate" ng-model="Subject" ng-change="GetAllBookChapterPeriodList();">
                                                    <option value="">Select Subject</option>
                                                    <option ng-repeat="Subjects in SubjectList" value="{{Subjects.Code}}">{{Subjects.SubjectName}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12">
                                            <div class="form-group">
                                                <div class="table-responsive" style="overflow-y: hidden;">
                                                    <table id="example2" class="table table-striped table-bordered table-hover compact" style="width:100%">
                                                        <thead>
                                                            <tr>
                                                                <th align="center">S.No.</th>
                                                                <th>Book Name</th>
                                                                <th>Chapter Name</th>
                                                                <th>Assign Periods</th>
                                                                <th style="display:none;">Status</th>
                                                                <th>Total Periods Taken</th>
                                                                <th>Status</th>
                                                                <th>Edit</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="obj in ChapterList" ng-model="ss">
                                                                @*ng-dblclick="GetAllStatus(obj)"*@
                                                                <td align="center" ng-bind="obj.Srno=($index+1)"></td>
                                                                <td>{{obj.NameOfBook}}</td>
                                                                <td ng-model="obj.ChapterID">{{obj.ChapterName}}</td>
                                                                <td>{{obj.NoOfPeriod}}</td>
                                                                <td style="display:none;">{{obj.Status}}</td>
                                                                <td>{{obj.Total_TransID}}</td>
                                                                <td>{{obj.Status_Caption}}</td>
                                                                <td><button ng-click="GetAllStatus(obj)" type="button" value="Edit" class="btn btn-link" name="searchButton" data-toggle="collapse" data-target="#CollapseSearchTableList1" aria-controls="CollapseSearchTableList1">Edit</button></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>                                    
                                </div>
                                @Html.Partial("SearchSyllabusCoverage")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






@{
    ViewBag.Title = "Master Abbreviation";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/Scripts/myjslib/AbbreviationMasterController.js?Ver=@ViewBag.Version"></script>

 <input type="hidden" id="hfId" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark"> Abbreviation List</h5>
        </div>
        <!-- Breadcrumb -->
          <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Abbreviation List</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>


                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>


                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Abbreviation For [Type]<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlAbbrType")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtName", "", new { @class = "form-control clear validate", @ng_model = "AbbrName", @placeholder = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Abbreviation [Short Name]<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtAbbreviation", "", new { @class = "form-control clear validate", @ng_model = "Abbreviation", @placeholder = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Abbreviation Weight<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtAbbreviationWeight", "", new { @class = "form-control clear validate", @ng_model = "AbbreviationWeight", @placeholder = "", allow_decimal_numbers= "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Group of Abbreviation</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtGroupAbbreviation", "", new { @class = "form-control clear", @ng_model = "GroupAbbreviation", @placeholder = "", allow_decimal_numbers = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Deduction of Days</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtDeductionDays", "", new { @class = "form-control clear", @ng_model = "DeductionDays", @placeholder = "", allow_decimal_numbers = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Abbreviation For [Value Type]<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlValueType" ng-model="Valuetype" class="form-control clear validate">
                                                    <option value="">Select</option>
                                                    <option value="L">Lower</option>
                                                    <option value="U">Upper</option>
                                                    <option value="A">Actual</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Remarks<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtRemarks", "", new { @class = "form-control clear", @ng_model = "Remarks", @placeholder = "Remarks" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Display Order<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtDisplayOrder", "", new { @class = "form-control clear validate", @ng_model = "DisplayOrder", @placeholder = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

    </div>

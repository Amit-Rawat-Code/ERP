
@{
    ViewBag.Title = "EmployeeAttendanceDateWiseReport";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}


<script src="~/scripts/myjslib/EmployeeAttendenceDateWiseReportController.js"></script>
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Employee Attendence Datewise Report</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Attendance</span></li>
                <li><span>Report</span></li>
                <li class="active"><span>@ViewBag.Title</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in">
                                        <form id="user-form">
                                            <div class="section-toggle">
                                                <div class="col-md-3 col-sm-3 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">From Date</label>
                                                    <div class="input-box">
                                                        <input class="form-control validate" id="txtFromDate" max="{{endDate}}" min="{{startDate}}" name="txtFromDate" ng-init="SetMaxMinDate()" ng-model="FromDate" type="date" value="" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 col-sm-3 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">To Date</label>
                                                    <div class="input-box">
                                                        <input class="form-control" id="txtToDate" max="{{endDate}}" min="{{startDate}}" name="txtToDate" ng-model="ToDate" type="date" value="" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Attendance</label>
                                                    <div class="input-box">
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" ng-model="filter" value="0" ng-init="filter='0'">
                                                            <label for="All">All</label>
                                                        </div>
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" ng-model="filter" value="1">
                                                            <label for="Present">Present</label>
                                                        </div>
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" ng-model="filter" value="2">
                                                            <label for="Absent">Absent</label>
                                                        </div>
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" ng-model="filter" value="3" >
                                                            <label for="All">Half Day</label>
                                                        </div>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">



                                                    <button type="button" value="Search" class="btn2 btn-common btn-3 btn-3d pe-7s-search"
                                                            ng-model="Search" ng-click="SearchRecord()">
                                                        <span class="triangle-box" title="Search"></span>
                                                        <span>Search </span>
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding report-box" id="TabAddHeight" TabAddHeight="41">
                                    <div class="arrow-container animated fadeInDown filter-toggle " ng-click="FilterToggle()">
                                        <div class="arrow-2">
                                            <i class="fa fa-angle-down"></i>
                                        </div>
                                        <div class="arrow-1 animated hinge infinite zoomIn"></div>
                                    </div>
                                    @Html.Partial("GeneralReportGrid")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>    
@{
    ViewBag.Title = "Employee Leave List";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/EmployeeLeaveApprovalController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Employee Leave List</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Attendance</span></li>
                <li><span>Employee</span></li>
                <li class="active"><span>Employee Leave List</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        @Html.Partial("TableEmployeeLeaveList")

                                    </form>
                                    <button id="btnSearch" type="button" value="Search For Approved Leave" class="btn-me btn-success  hvr-float-shadow" name="searchButton" data-toggle="collapse" data-target="#CollapseSearchTableList" aria-expanded="false" aria-controls="CollapseSearchTableList"
                                            ng-model="Search" ng-click="SearchApprovedRecord();" ng-disabled="disableSearch">
                                        <span class="action-txt">Search</span>
                                        <i data-feather="search"></i>
                                    </button>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row -->
        </div>
    </div>

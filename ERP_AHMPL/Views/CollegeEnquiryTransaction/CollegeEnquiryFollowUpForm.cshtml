
@{
    ViewBag.Title = "CollegeEnquiryFollowUpForm";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/CollegeEnquiryFollowUpFormController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Enquiry Followup Form</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Enquiry Followup Form</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <h3>
                                                General Details<span class="vd_red" ng-if="TransferFromSchool"> Transfer From : {{TransferFromSchool}}</span>
                                                <input type="button" ng-click="BackToDashBoard()" value="Back" class="btn-me btn-primary" style="float: right;" />
                                            </h3>

                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-hide="true">
                                            <label class="control-label">Enquiry For</label>
                                            <div class="input-box">
                                                @Html.Label("lblEnquiryNo", new { @ng_model = "EnquiryFor", @ng_bind = "EnquiryFor" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Session<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSession")

                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Date of Enquiry<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input id="txtDateofEnquiry" type="date" class="form-control clear validate" placeholder=""
                                                       ng-model="DateofEnquiry" @*ng-disabled="true"*@ />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Enquiry Type<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlAllEnquiryType")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Enquiry Source<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlEnquirySource")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">I am<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlIAm")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="LoginAs=='College'">
                                            <label class="control-label">Class of Adm.<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlClass")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="LoginAs=='College'">
                                            <label class="control-label">Stream (if class have streams)<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlStream")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="LoginAs=='School'">
                                            <label class="control-label">Course<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlCollegeCourse")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="LoginAs=='School'">
                                            <label class="control-label">Branch<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlCollegeBranch")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Visitor Name<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtVisitorName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "VisitorName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Father Name<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFatherName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "FatherName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Mother Name<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtMotherName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "MotherName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Occupation<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <select id="ddlOccupation" class="select2 form-control" ng-model="Occupation"
                                                        ng-init="GetOccupation(1);">
                                                    <option value="">Select Occupation</option>
                                                    <option ng-repeat="x in Occupations" value="{{x.OccupationName}}">{{x.OccupationName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Reference<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtReference", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Reference" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <h3>Student Details<span class="vd_red"></span></h3>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">First Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFirstName", "", new { @class = "form-control clear validate textOnly", @placeholder = "", @ng_model = "StudentFirstName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Middle Name<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtMiddleName", "", new { @class = "form-control clear  textOnly", @placeholder = "", @ng_model = "StudentMiddleName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Last Name<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtLastName", "", new { @class = "form-control clear  textOnly", @placeholder = "", @ng_model = "StudentLastName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Date Of Birth<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <input id="txtDateOfBirth" type="date" class="form-control clear" placeholder="" ng-model="DateOfBirth" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Gender<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlGender")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Category<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlCategory")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Email(Student's)<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtStudentdEmail", "", new { @class = "form-control clear emailOnly", @placeholder = "", @ng_model = "StudentdEmail", @onblur = "validateEmail(this)" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Email(Parent's)<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtParentEmail", "", new { @class = "form-control clear emailOnly", @placeholder = "", @ng_model = "ParentEmail", @onblur = "validateEmail(this)" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <div class="phone-number-choice">
                                                <label class="control-label">Student Mobile No.<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtStudentContact", "",
                                                   new { @class = "form-control clear {{PrimaryNo=='1' || WhatsAppNo=='1'?'validate':''}}", @placeholder = "", @ng_model = "StudentContact", @maxlength = "10", @allow_only_numbers = "" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                                <div class="input-box type-choice">
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="PrimaryNo_1" ng-model="PrimaryNo" value="1">
                                                        <label for="PrimaryNo_1"> <i class="icon-mobile-phone"></i> </label>
                                                    </div>
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="WhatsAppNo_1" ng-model="WhatsAppNo" value="1">
                                                        <label for="WhatsAppNo_1"><i class="fa fa-whatsapp" aria-hidden="true"></i></label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <div class="phone-number-choice">
                                                <label class="control-label">Father Mobile No.<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtFatherContact", "",
                                                   new { @class = "form-control clear validate", @placeholder = "", @ng_model = "FatherContact", @maxlength = "10", @allow_only_numbers = "" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                                <div class="input-box type-choice">
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="PrimaryNo_2" ng-model="PrimaryNo" value="2">
                                                        <label for="PrimaryNo_1"> <i class="icon-mobile-phone"></i> </label>
                                                    </div>
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="WhatsAppNo_2" ng-model="WhatsAppNo" value="2">
                                                        <label for="WhatsAppNo_1"><i class="fa fa-whatsapp" aria-hidden="true"></i></label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <div class="phone-number-choice">
                                                <label class="control-label">Mother Mobile No.<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtMotherContact", "",
                                                   new { @class = "form-control clear {{PrimaryNo=='3' || WhatsAppNo=='3'?'validate':''}}", @placeholder = "", @ng_model = "MotherContact", @maxlength = "10", @allow_only_numbers = "" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                                <div class="input-box type-choice">
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="PrimaryNo_3" ng-model="PrimaryNo" value="3">
                                                        <label for="PrimaryNo_1"> <i class="icon-mobile-phone"></i> </label>
                                                    </div>
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="WhatsAppNo_3" ng-model="WhatsAppNo" value="3">
                                                        <label for="WhatsAppNo_1"><i class="fa fa-whatsapp" aria-hidden="true"></i></label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <div class="phone-number-choice">
                                                <label class="control-label">Guardian/Visitor Mobile No.<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtVisitorContact", "",
                                                   new { @class = "form-control clear {{PrimaryNo=='4' || WhatsAppNo=='4'?'validate':''}}", @placeholder = "", @ng_model = "VisitorContact", @maxlength = "10", @allow_only_numbers = "" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                                <div class="input-box type-choice">
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="PrimaryNo_4" ng-model="PrimaryNo" value="4">
                                                        <label for="PrimaryNo_1"> <i class="icon-mobile-phone"></i> </label>
                                                    </div>
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="WhatsAppNo_4" ng-model="WhatsAppNo" value="4">
                                                        <label for="WhatsAppNo_1"><i class="fa fa-whatsapp" aria-hidden="true"></i></label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Address<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtAddress", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Address" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Country<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlCountry")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">State<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlState")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">City<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlCity")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">City Area<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlCityArea")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Sub Area<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtSubArea", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "SubArea" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Pin Code<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPinCode", "", new { @class = "form-control clear numberOnly", @placeholder = "", @ng_model = "PinCode" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Current/Previous School<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtCurrentPreviousSchool", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "CurrentPreviousSchool" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Hostel Required<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.DropDownList("ddlHostalRequired", new List<SelectListItem>{
                                                    new SelectListItem{Text="Select", Value=""},
                                                    new SelectListItem{Text="Yes", Value="true"},
                                                    new SelectListItem{Text="No", Value="false"}
                                                },
                                                    new { @class = "select2 form-control", @ng_model = "HostalRequired", @ng_init = "HostalRequired='false'" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-12 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Remark<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtRemark", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Remark" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-lg-6 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-hide="true">
                                            <label class="control-label">Transfer Enquiry To<span class="vd_red"></span></label>
                                            <div class="input-box" ng-init="GetAssociatedBranches()">
                                                <select id="ddlSchool" ng autocomplete='address-level2' class="select2 form-control"
                                                        ng-model="RelationshipId" ng-change="ddlAssociatedBranches_Change(RelationshipId)" ng-disabled="IsTransferedEnq">
                                                    <option value="">Select School</option>
                                                    @*<option ng-repeat="asl in AssociatedBranches|filter:{RelationshipId:'!'+CurrentRelationshipId}" value="{{asl.RelationshipId}}">
                                                            {{asl.BranchName}}-{{asl.BranchAddress}}
                                                        </option>*@
                                                    <option ng-repeat="asl in AssociatedBranches" value="{{asl.RelationshipId}}">
                                                        {{asl.BranchName}}-{{asl.BranchAddress}}
                                                    </option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-lg-6 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-hide="true">
                                            <label class="control-label">Transfer Enquiry Date<span class="vd_red">{{RelationshipId?'*':''}}</span></label>
                                            <div class="input-box">
                                                <input id="txtTransferEnquiryDate" type="date" class="form-control clear {{RelationshipId?'validate':''}}" placeholder=""
                                                       ng-model="TransferEnquiryDate" ng-change="RenameRemark();" ng-disabled="IsTransferedEnq" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="EnquiryFor=='College'">
                                            <h3>Details of Examination last qualified :<span class="vd_red"></span></h3>
                                        </div>
                                        <div class="col-lg-12 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 " ng-if="EnquiryFor=='College'">
                                            @*<label class="control-label">Remark<span class="vd_red"></span></label>*@
                                            <div class="input-box datatable-responsive table-responsive advance-btn-table">
                                                <table class="table compact table-hover table-striped table-bordered nowrap  dataTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Sr.No.</th>
                                                            <th>Class</th>
                                                            <th>Board/University</th>
                                                            <th>Stream</th>
                                                            <th>Marks Obtained</th>
                                                            <th>Agg %</th>
                                                            <th>% of PCM</th>
                                                            <th>Division</th>
                                                            <th>Year of Passing</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="lqel in LastQualifiedExaminationList">
                                                            <td ng-bind="lqel.Srno=($index+1)"></td>
                                                            <td>
                                                                <input ng-model="lqel.Class" />
                                                            </td>
                                                            <td>
                                                                <input ng-model="lqel.BoardUniversity" />
                                                            </td>
                                                            <td>
                                                                <input ng-model="lqel.Stream" />
                                                            </td>
                                                            <td>
                                                                <input ng-model="lqel.MarksObtained" />
                                                            </td>
                                                            <td>
                                                                <input ng-model="lqel.AggPer" />
                                                            </td>
                                                            <td>
                                                                <input ng-model="lqel.PerOfPCM" />
                                                            </td>
                                                            <td>
                                                                <input ng-model="lqel.Devision" />
                                                            </td>
                                                            <td>
                                                                <input ng-model="lqel.YearOfPassing" />
                                                            </td>
                                                            <td>
                                                                <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow()" ng-if="LastQualifiedExaminationList.length==1 || LastQualifiedExaminationList.length==wa.Srno" />
                                                                <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(lqel.Srno)" ng-if="LastQualifiedExaminationList.length>1" />
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="EnquiryFor=='College'">
                                            <h3>Details of any other competitive Exam (if qualified or appeared) :<span class="vd_red"></span></h3>
                                        </div>

                                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="EnquiryFor=='College'">
                                            <label class="control-label">Name of the Exam:<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtNameoftheExam", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "$parent.NameofExam" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="EnquiryFor=='College'">
                                            <label class="control-label">Rank:<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtRank", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "$parent.Rank", @allow_only_numbers = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1" ng-if="!RelationshipId">
                                            <button id="btnUpdate" type="button" value="Update" class="btn-me btn-primary hvr-float-shadow"
                                                    name="saveButton" ng-model="Update" ng-init="Update='Update Enquiry'" ng-click="UpdateRecord()">
                                                <span id="btnSavetxt" ng-bind="Update">Update Enquiry</span>
                                                <i data-feather="edit"></i>
                                            </button>
                                        </div>


                                        <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1" ng-if="RelationshipId && !IsTransferedEnq">
                                            <button id="btnTransfer" type="button" value="Transfer" class="btn-me btn-primary hvr-float-shadow"
                                                    name="saveButton" ng-init="SendToSchool='Transfer'" ng-click="TransferEnquiry()">
                                                <span id="btnSavetxt" ng-bind="SendToSchool">Transfer</span>
                                                <i data-feather="edit"></i>
                                            </button>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <h3>Enquiry Followup<span class="vd_red"></span></h3>
                                        </div>

                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="!RelationshipId">
                                            <label class="control-label">Followup Category<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.DropDownList("ddlFollowupCategory", new List<SelectListItem>{
                                                   new SelectListItem{Text="Select", Value=""},
                                                   new SelectListItem{Text="A", Value="A"},
                                                   new SelectListItem{Text="B", Value="B"},
                                                   new SelectListItem{Text="C", Value="C"},
                                                   new SelectListItem{Text="X", Value="X"}
                                                   },
                                               new { @class = "select2 form-control newvalidate", @ng_model = "$parent.FollowupCategory" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>



                                        <div class="col-lg-{{FollowupCategory!='X'?'6':'9'}} col-md-4 col-sm-6 col-xs-12 mgbt-xs-15"
                                             ng-if="!RelationshipId">
                                            <label class="control-label">Followup Remark<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFollowUpRemark", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "$parent.FollowUpRemark" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="FollowupCategory!='X' &&
                                             !RelationshipId">
                                            <label class="control-label">Next Followup Date<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input id="txtNextFollowupDate" type="date" class="form-control clear newvalidate" placeholder="" ng-model="$parent.NextFollowupDate" min-date />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            @*<label class="control-label">Remark<span class="vd_red"></span></label>*@
                                            <div class="input-box">
                                                <table class="table compact table-hover table-striped table-bordered nowrap  dataTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Sr.No.</th>
                                                            <th>Action Date</th>
                                                            <th>Followup Date</th>
                                                            <th>Followup Remark</th>
                                                            <th>Category</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="ful in FollowUpList">
                                                            <td ng-bind="$index+1"></td>
                                                            <td ng-bind="ful.ActionDate"></td>
                                                            <td ng-bind="ful.FollowUpDate"></td>
                                                            <td ng-bind="ful.FollowUpRemark"></td>
                                                            <td ng-bind="ful.FollowupCategory"></td>
                                                        </tr>
                                                        <tr ng-if="FollowUpList.length==0">
                                                            <td colspan="5" class="text-center">
                                                                No, Followup Records Found.
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1" ng-if="!RelationshipId">
                                            @Html.Partial("ActionSave")
                                            <input type="button" ng-click="BackToDashBoard()" value="Back" class="btn-me btn-primary hvr-float-shadow" />
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

<script>
    $('#ddlCityArea').removeClass('validate');
    $('#ddlGender').removeClass('validate');
    $('#ddlCollegeBranch').removeClass('validate');
</script>



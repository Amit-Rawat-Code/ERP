
@{
    ViewBag.Title = "Course Setting Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/CollegeCourseSettingController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Course Setting Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Time Table</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Course Setting Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-sm-12 col-md-12 col-xs-12 col-lg-12 mgbt-xs-15">
                                                <div class="table-responsive" style="overflow-y: hidden;">
                                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%" ng-init="AddRow()">
                                                        <thead>
                                                            <tr>
                                                                <th>S.No.</th>
                                                                <th>Course</th>
                                                                <th>Branch</th>
                                                                <th>Semester</th>
                                                                <th>Working Day Per Week</th>
                                                                <th>No. Of Periods in a Day</th>
                                                                <th>No. Of Periods Per Week</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="obj in CourseSettingList ">
                                                                <td ng-bind="obj.Srno=($index+1)"></td>
                                                                <td>
                                                                    <select id="ddlCollegeCourse" class="select2 form-control" ng-model="obj.CourseCode"
                                                                            ng-init="GetCollegeCourse();" ng-change="GetCollegeBranch(obj.CourseCode)">
                                                                        <option value="">Select Course</option>
                                                                        <option ng-repeat="cl in CollegeCourseList" value="{{cl.Code}}" ng-disabled="!cl.IsActive">{{cl.CollegeCourseName}}</option>
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <select id="ddlSelectedForBranch" class="select2 form-control" ng-model="obj.BranchCode" ng-change="ddlBranch_change(obj)">
                                                                        <option value="">Select Branch</option>
                                                                        <option ng-repeat="sb in CollegeBranchList" value="{{sb.Code}}">{{sb.CollegeBranchName}}</option>
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <select id="ddlSemester" class="select2 form-control validate" ng-model="obj.SemesterCode" ng-init="GetSemester(obj)">
                                                                        <option value="">Select </option>
                                                                        <option ng-repeat="sl in obj.SemesterList" value="{{sl.Code}}">{{sl.Semester}}</option>
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <input ng-model="obj.WorkingDayPerWeek" class="form-control clear"
                                                                           ng-keypress="filterValue($event)" maxlength="3"
                                                                           ng-change="obj.NoOfPeriodPerWeek=obj.WorkingDayPerWeek*obj.NoOfPeriodinaDay" />
                                                                </td>
                                                                <td>
                                                                    <input ng-model="obj.NoOfPeriodinaDay" class="form-control clear"
                                                                           ng-keypress="filterValue($event)" maxlength="3"
                                                                           ng-change="obj.NoOfPeriodPerWeek=obj.WorkingDayPerWeek*obj.NoOfPeriodinaDay" />
                                                                </td>
                                                                <td>
                                                                    <input ng-model="obj.NoOfPeriodPerWeek" class="form-control clear"
                                                                           ng-keypress="filterValue($event)" maxlength="3" ng-disabled="true" />
                                                                </td>
                                                                <td>
                                                                    <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow()" ng-if="CourseSettingList.length==1 || CourseSettingList.length==obj.Srno" />
                                                                    <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(obj.Srno)" ng-if="CourseSettingList.length>1" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    </div>
                                                </div>
                                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                    @Html.Partial("ActionView")
                                                </div>

                                            </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>





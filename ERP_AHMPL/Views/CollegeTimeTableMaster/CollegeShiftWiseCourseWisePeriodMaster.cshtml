
@{
    ViewBag.Title = "ShiftWise CourseWise Period Master";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/CollegeShiftWiseCourseWisePeriodMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Shift Course Period Mapping</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>TimeTable</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Shift Course Period Mapping</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15  pull-right">
                                            @*<label class="control-label">Class<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <select id="ddlClass" class="select2 form-control validate" ng-model="Class">
                                                        <option value="">Select Class</option>
                                                        <option ng-repeat="cls in ClassList" value="{{cls.ClassCode}}">{{cls.ClassName}}</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>*@
                                            <label class="control-label">Course<span class="vd_red"></span></label>
                                            <div class="input-box chk-validate">
                                                <div class="toggle-ddl" id="openClass" ng-init="ToogleDDL('openClass','openClass')">
                                                    @*btn-validate*@
                                                    <button class='btn btn-primary select-btn'
                                                            data-ng-click='openClass=!openClass' ng-bind="GetCount(CourseList,'Select Course')">
                                                        Select Course
                                                    </button>
                                                    @*btn-validate*@
                                                    <button class='btn btn-primary dropdown-toggle select-btn-sub'
                                                            data-ng-click='openClass=!openClass'>
                                                        <span class='fa fa-chevron-down'></span>
                                                    </button>
                                                    <div ng-show="openClass" class="ddlMultiple" ng-cloak>
                                                        <div ng-click="ddlCheckAll('CourseList')">
                                                            Check All
                                                            <span class="btn-counts-right">Total Count: {{CourseList.length}}</span>
                                                        </div>
                                                        <div ng-click="ddlUnCheckAll('CourseList')">Uncheck All</div>
                                                        <hr style="margin:0px !important" />
                                                        <div ng-repeat="cls in CourseList">
                                                            <input type="hidden" ng-bind="cls.Srno=($index+1)" />
                                                            <input type="checkbox" ng-model="cls.chk" id="chkCls" ng-value="cls.BranchCode"
                                                                   ng-disabled="cls.disabled" />
                                                            {{cls.CollegeBranchName}}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15  pull-right">
                                            <label class="control-label">Shift<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <select id="ddlShift" class="select2 form-control validate" ng-init="GetShifts();" ng-model="Shift" ng-change="ShiftsWiseCourse();GetAllPeriodByShift();">
                                                    <option value="">Select Shift</option>
                                                    <option ng-repeat="shift in Shifts" value="{{shift.ShiftCode}}">{{shift.ShiftWithTime}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="table-responsive">
                                            <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>S.No.</th>
                                                        <th><input type="checkbox" ng-model="ChkAll" ng-change="CheckALL()" />&nbsp;Select All</th>
                                                        <th>Period Name</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="obj in ShiftPeriodMappingList">
                                                        <td ng-bind="obj.Srno=($index+1)"></td>
                                                        <td><input type="checkbox" ng-model="obj.Chk" /></td>
                                                        <td>{{obj.PeriodName}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1 no-padding">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>




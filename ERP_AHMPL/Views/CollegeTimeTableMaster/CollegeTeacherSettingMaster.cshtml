
@{
    ViewBag.Title = "CollegeTeacherSettingMaster";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/CollegeTeacherSettingController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Teacher Setting Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Time Table</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Teacher Setting Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-sm-12 col-md-12 col-xs-12 col-lg-12 mgbt-xs-15">
                                                <div class="table-responsive" style="overflow-y: hidden;">
                                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%" ng-init="AddRow()">
                                                        <thead>
                                                            <tr>
                                                                <th>S.No.</th>
                                                                <th>Teacher Name</th>
                                                                <th>Father Name</th>
                                                                <th>Id</th>
                                                                <th>Short Name</th>
                                                                <th>Max Period In Week</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="obj in TeacherSettingList" ng-init="GetEmployee(TeacherSettingList[0],0)">
                                                                <td ng-bind="obj.Srno=($index+1)"></td>
                                                                <td>
                                                                    <select id="ddlEmployeeName" class="select2 form-control clear validate" ng-model="TeacherSettingList[$index].EmployeeCode"
                                                                            ng-change="GetEmployeeDetail(TeacherSettingList[$index].EmployeeCode,$index)">
                                                                        <option value="">Select </option>
                                                                        <option ng-repeat="x in obj.TeacherList" value="{{x.EmployeeCode}}">{{x.EmployeeName}}{{' - '+x.EmployeeId}}</option>
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    {{TeacherSettingList[$index].FatherName}}
                                                                </td>
                                                                <td>
                                                                    <input ng-model="TeacherSettingList[$index].EmployeeId" ng-disabled="true" class="form-control clear" />
                                                                </td>
                                                                <td>
                                                                    <input ng-model="TeacherSettingList[$index].DisplayName" ng-disabled="true" class="form-control clear" />
                                                                </td>
                                                                <td>
                                                                    <input type="text" ng-model="TeacherSettingList[$index].MaxPeriodInWeek" class="form-control clear validate" ng-keypress="filterValue($event)" maxlength="3" />
                                                                </td>
                                                                <td>
                                                                    <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow($index)" ng-if="TeacherSettingList.length==1 || TeacherSettingList.length==obj.Srno" />
                                                                    <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(obj.Srno)" ng-if="TeacherSettingList.length>1" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                @Html.Partial("ActionView")
                                            </div>
                                        </div>


                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>







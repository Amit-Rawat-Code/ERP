@{
    ViewBag.Title = "Digital Diary Creation";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/DigitalDiaryCreationController.js?Ver=@ViewBag.Version"></script>
<script src="~/Content/editorbootstrap/tinymce.min.js"></script>
<script src="~/Content/editorbootstrap/tinymce.init.js"></script>
<style>
    .PhysicallyDisable-div select {
        display: table;
        width: auto;
        position: absolute;
        top: 0px;
        left: 0px;
    }

    .PhysicallyDisable-div input {
        padding-left: 90px;
    }
    .search-feild.search-feild-No-Search .input-box input#txtSearchBox {
        padding: 6px 10px;
    }


</style>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Digital Diary Creation</h5>
        </div>


        <!-- Breadcrumb -->


        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Digital Diary Creation</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">

                                    <form id="user-form">
                                        <div class="row">


                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Message For Students<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="MessageFor" ng-model="MessageFor" value="1" name="DiaryFor" class="ng-valid ng-not-empty ng-dirty ng-touched validate">
                                                        <label for="AgainstEnquiry">All</label>
                                                    </div>
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" ng-model="MessageFor" value="2" name="DiaryFor" class="ng-valid ng-not-empty ng-dirty ng-valid-parse ng-touched validate">
                                                        <label for="Direct">Class Wise</label>
                                                    </div>
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="TeacherNotice" ng-model="MessageFor" value="3" name="DiaryFor" class="ng-valid ng-not-empty ng-dirty ng-valid-parse ng-touched validate">
                                                        <label for="Direct">Individual</label>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="MessageFor=='2'||MessageFor=='3'">
                                                <label class="control-label">Class<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlClass")
                                                </div>
                                            </div>
                                        <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15 search-feild search-feild-No-Search" ng-if="MessageFor=='3'">
                                            <label class="control-label">Select Student<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <div class="text-box-msg-r" style="left:0px !important">
                                                </div>
                                                @Html.TextBox("txtSearchBox", "", new { @class = "form-control", @placeholder = "Search Name", @ng_model = "SearchBox", ng_disabled = "IsSearchBoxDisabled" })

                                                <div class="text-box-msg-r">
                                                    <button class="Srch-btn" ng-click="Show=false">X</button>
                                                </div>
                                                @*Table*@
                                                <div ng-if="Show" class="searchbox">
                                                    <table class="table compact table-hover table-striped table-bordered nowrap  dataTable">
                                                        <thead>
                                                            <tr>
                                                                <th>Class</th>
                                                                <th>Name</th>
                                                                <th>Father</th>
                                                                 <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="i in StudentLists | filter:SearchBox" class="data-ctrl">
                                                                <td>{{i.ClassName}}</td>
                                                                <td>{{i.Name}}</td>
                                                                <td>{{i.FatherName}}</td>
                                                                <td class="text-align-right">
                                                                    <input type="checkbox" value="{{i.ID}}" ng-model="i.Chk" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>


                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Want to revert message<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" id="AllNotice" ng-model="MsgRvrt" value="No" name="MsgRvrt" class="ng-valid ng-not-empty ng-dirty ng-touched validate">
                                                        <label for="AgainstEnquiry">No</label>
                                                    </div>
                                                    <div class="radio radio-primary radio-box">
                                                        <input type="radio" ng-model="MsgRvrt" value="Yes" name="MsgRvrt" class="ng-valid ng-not-empty ng-dirty ng-valid-parse ng-touched validate">
                                                        <label for="Direct">Yes</label>
                                                    </div>

                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Title<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtTitle", "", new { @class = "form-control clear textOnly validate", @placeholder = "", @ng_model = "MessageTitle" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-12  col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                                <label class="control-label">Message<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <div class="dropify-loader"></div>
                                                    <input id="TextEditor" type="text" ng-model="Description" name="" class="form-control">
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            @*<div class="col-md-5 col-sm-4 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Attachment<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <div class="dropify-loader"></div>
                                                    <input id="fuStudentPhoto" type="file" class="dropify" data-max-file-size-preview="3M" upload-files>
                                                    <img id="imgStudentPhoto" style="display:none;">

                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>*@




                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                <link href="~/Content/plugins/assets/fonts/feather-icon/feather-icon.css" rel="stylesheet" />
                                                <button id="btnSearch" type="button" value="Search" class="btn-me btn-success  hvr-float-shadow" name="searchButton" data-toggle="collapse"
                                                        data-target="#CollapseSearchTableList" aria-expanded="false" aria-controls="CollapseSearchTableList" ng-model="Search"
                                                        ng-click="CheckSearchPermission();SearchRecord()" ng-disabled="disableSearch" @*ng-show="visibleSearch"*@>
                                                    View Homework List
                                                    <i data-feather="printer"></i>
                                                </button>

                                                <button id="btnSave" type="button" value="Save" class="btn-me btn-primary hvr-float-shadow" name="saveButton" ng-model="Save"
                                                        ng-init="Save='Save'" ng-click="CheckSavePermission();SaveRecord()" ng-disabled="disableAdd">
                                                    <span id="btnSavetxt" ng-bind="Save">SAVE</span>
                                                    <i data-feather="edit"></i>
                                                </button>

                                                <script src="~/Content/plugins/assets/fonts/feather-icon/icons/feather-icon/feather.min.js"></script>
                                                <script src="~/Content/plugins/assets/fonts/feather-icon/icons/feather-icon/feather-icon.js"></script>
                                                <script src="~/Content/plugins/assets/fonts/feather-icon/icons/feather-icon/feather-icon-clipart.js"></script>
                                            </div>



                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>





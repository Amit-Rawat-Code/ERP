
@{
        ViewBag.Title = "ComplainRegister";
        ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
        Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<div id="hdngetstu" style="display:none"  ></div>
<input type="hidden" ng-model="hdnEmpId" id="hdnEmpId" />
<input type="hidden" ng-model="hdnvisitorTransid" id="hdnvisitorTransid" />
<script src="~/Scripts/myjslib/ComplainRegisterController.js?Ver=@ViewBag.Version"></script>
<style>
    .search-feild.search-feild-No-Search .input-box input#txtSearchBox {
        padding: 6px 10px;
    }
</style>
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Complain</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><span>Communication</span></li>
                <li><span>Complain/Query</span></li>
                <li class="active"><span>Complain Register</span></li>
            </ol>
        </div>
    </div>

    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12 no-padding ">
                                            <div class="col-md-6 col-sm-6 col-xs-12 mgbt-xs-15" id="dvclass">
                                                <label class="control-label">Class<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlClass")
                                                </div>
                                            </div>

                                            <div class="col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Section<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlSection")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 search-feild search-feild-No-Search">
                                            <label class="control-label">Select Student<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <div class="text-box-msg-r" style="left:0px !important">
                                                </div>
                                                @Html.TextBox("txtSearchBox", "", new { @class = "form-control", @placeholder = "Search Name", @ng_model = "SearchBox", ng_disabled = "IsSearchBoxDisabled" })

                                                <div class="text-box-msg-r">
                                                    @*<i class="fa fa-search" aria-hidden="true"></i>*@
                                                    <button class="Srch-btn" ng-click="Show=false">X</button>
                                                </div>
                                                @*Table*@
                                                <div ng-if="Show" class="searchbox">
                                                    <table class="table compact table-hover table-striped table-bordered nowrap  dataTable">
                                                        <thead>
                                                            <tr>
                                                                <th>Class</th>
                                                                <th>Name</th>
                                                                <th>Father</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="i in StudentLists | filter:SearchBox" class="data-ctrl">
                                                                <td>{{i.ClassName}}</td>
                                                                <td>{{i.Name}}</td>
                                                                <td>{{i.FatherName}}</td>
                                                                <td class="text-align-right">
                                                                    <input type="checkbox" value="{{i.ID}}" ng-model="i.Chk" />
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>




                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">

                                            <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Message</label>
                                                <div class="input-box">
                                                    <textarea rows="4" id="txtMessage" class="form-control" ng-model="Message"></textarea>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>


                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>

                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript" src="~/Content/Webcam/webcam.min.js"></script>
</div>




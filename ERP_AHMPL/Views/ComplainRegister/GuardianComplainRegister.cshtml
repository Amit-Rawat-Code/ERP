
@{
    ViewBag.Title = "GuardianComplainRegister";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
} 
<script src="~/Scripts/myjslib/guardianDashBoardController.js"></script>
 
<script src="~/Scripts/myjslib/GuardianComplainRegisterController.js?Ver=@ViewBag.Version"></script>
<div id="hdngetstu" style="display:none"></div>
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Complain Register</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Communication</span></li>
                <li><span>Complain/Query</span></li>
                <li class="active"><span>Complain Register</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                            <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Message</label>
                                                <div class="input-box">
                                                    <textarea id="txtMessage" rows="6" class="form-control" ng-model="Message"></textarea>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-12 col-xs-12 mgbt-xs-15" ng-init="BindTeacherList()">
                                                <label class="control-label">Teacher List<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <div class="text-box-msg-search slimScrollDiv-height" id="slimScrollDiv-height">
                                                        <div class="streamline message-nicescroll-bar">
                                                            <table class="table search-table compact table-hover nowrap mgbt-xs-0" ng-repeat="x in records">
                                                                <tr>
                                                                    <td class="check-box-w">
                                                                        <div class="checkbox checkbox-primary check-box">
                                                                            <input id="{{x.EmployeeCode}}" ng-Click="Change(x.EmployeeCode)" type="checkbox" ng-model="chk[x.EmployeeCode]"
                                                                                   ng-checked="chk[x.EmployeeCode]" /><label for=""></label>
                                                                        </div>
                                                                    </td>
                                                                    <td class="avatar-box-w"> <img class="rounded-circle avatar1" ng-src="{{x.EmployeePhoto}}" src="../Content/Photos/default-user.png" /></td>
                                                                    <td style="float: left;display:none ">{{x.EmployeeCode}}</td>
                                                                    <td style="text-align: center;"> {{x.EmployeeDetails}}</td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    </div>
                                                    </div>
                                                </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript" src="~/Content/Webcam/webcam.min.js"></script>
</div>


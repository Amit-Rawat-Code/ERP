            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-20" ng-show="LoginType=='4'">
                <div class="row">
                    <div class="col-md-12">
                        <div class="tabs widget">
                            <div class="shadow-base full-tabs">
                                <ul class="nav nav-tabs widget for-table-behavior sec-d-2 mul_bg-gb">
                                    <li class="active">
                                        <a data-toggle="tab" href="#today-timetable">
                                            <span class="menu-icon"><i class="mdi mdi-calendar-check"></i></span>
                                            Today Time Table
                                            <span class="menu-active"><i class="fa fa-caret-up"></i></span>
                                        </a>
                                    </li>
                                    <li>
                                        <a data-toggle="tab" href="#tomorrow-timetable">
                                            <span class="menu-icon"><i class="mdi mdi-calendar-plus"></i></span>
                                            Tomorrow Time Table
                                            <span class="menu-active"><i class="fa fa-caret-up"></i></span>
                                        </a>
                                    </li>
                                </ul>
                                <div class="tab-content">
                                    <div id="today-timetable" class="tab-pane active">
                                        <div class="content-list content-image menu-action-right h-f-379">
                                            <div class="autohide-scroll-tab-dashboard h-f-379">
                                                <ul class="list-wrapper pd-lr-15">
                                                    <li ng-repeat="todayTimeTable in TodayTimeTableList">
                                                        <div class="period-box" ng-if="todayTimeTable.PeriodType=='StudyPeriod'">
                                                            <div class="period-d">
                                                                <i class="icofont-interface"></i>
                                                                <span><label ng-bind="todayTimeTable.PeriodCount"></label></span>
                                                            </div>
                                                            <div class="clock-d">
                                                                <i class="icofont-wall-clock"></i>
                                                                <span>
                                                                    <label ng-bind="todayTimeTable.FromTime"></label> - <label ng-bind="todayTimeTable.ToTime"></label>
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <div class="period-box lunch-time" ng-if="todayTimeTable.PeriodType=='LunchPeriod'">
                                                            <div class="period-d">
                                                                <i class="icofont-lunch"></i>
                                                            </div>
                                                            <div class="clock-d">
                                                                <span><label ng-bind="todayTimeTable.FromTime"></label> - <label ng-bind="todayTimeTable.ToTime"></label></span>
                                                            </div>
                                                        </div>

                                                        <div class="period-box lunch-time" ng-if="todayTimeTable.PeriodType=='AttendencePeriod'">
                                                            <div class="period-d">
                                                                <i class="icofont-law-document"></i>

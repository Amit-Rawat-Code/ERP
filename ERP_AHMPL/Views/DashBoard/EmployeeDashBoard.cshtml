<script>
    function StudentAttendanceCount() {
        var StudentData = [
                        { name: "Present", y: 58 },
                    { name: "Absent", y: 15 },
                    { name: "Leave", y: 5 },
                    { name: "Not Taken", y: 2 }];
        var colour = ['#43cea2', '#ff5f62', '#4aa7e1', '#ff8d06'];
        var TotalStudent = 80;

            Highcharts.setOptions({
                colors: Highcharts.map(colour, function (color) {
                    return {
                        radialGradient: {
                            cx: 0.5,
                            cy: 0.3,
                            r: 0.7
                        },
                        stops: [
                          [0, color],
                          [1, Highcharts.Color(color).brighten(-0.3).get('rgb')] // darken
                        ]
                    };
                })
            });
            Highcharts.chart('chart33', {
                chart: {
                    type: 'pie',
                    backgroundColor: 'transparent',
                    plotBackgroundColor: null,
                    plotBorderWidth: null,
                    plotShadow: false,
                    options: {
                        enabled: true,
                        alpha: 100,
                        beta: 0
                    }
                },
                exporting: {
                    enabled: false
                },
                credits: {
                    enabled: false
                },
                title: {
                    text: 'Total',
                    align: 'center',
                    verticalAlign: 'middle',
                    y: -30,
                    style: {
                        fontSize: '150%',
                        //color: 'red'
                    }
                },
                subtitle: {
                    text: '<b>' + TotalStudent + '</b>',
                    align: 'center',
                    verticalAlign: 'middle',
                    y: 0,
                    style: {
                        fontSize: '200%',
                        color: '#000'
                    }
                },
                tooltip: {
                    pointFormat: '<b>{series.name}</b> : <b> {point.y} ({point.percentage:.1f}%)</b>'
                },

                plotOptions: {
                    pie: {
                        allowPointSelect: true,
                        cursor: 'pointer',
                        depth: 100,
                        dataLabels: {
                            enabled: true,
                            distance: 5,
                            //format: '<b>{point.name} : {point.y}</b> ({point.percentage:.1f}%)',
                            format: '<b>{point.y}</b> ({point.percentage:.1f}%)',
                            style: {
                                fontSize: 14,
                                //color: '#000',
                                fontWeight: 'normal',
                            }
                        },
                        showInLegend: true,
                        startAngle: 0,
                        endAngle: 360,
                        center: ['50%', '50%'],
                        size: '270'
                    }
                },
                legend: {
                    enabled: true,
                    //layout: 'vertical',
                    //align: 'right',
                    squareSymbol: true,
                },
                series: [{
                    type: 'pie',
                    name: 'Student',
                    innerSize: '60%',
                    colorByPoint: true,
                    data: StudentData,
                    colors: colour,
                    lineWidth: 5
                }]
            });
        }

    $(document).ready(function () {
        StudentAttendanceCount();
    })

</script>
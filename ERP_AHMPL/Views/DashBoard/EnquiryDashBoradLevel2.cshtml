@{
    ViewBag.Title = "Enquiry System";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}


<script src="~/Scripts/myjslib/EnquiryDashboardLavel2Controller.js?Ver=@ViewBag.Version"></script>
<style>


    .checkbox, .radio {
        padding-top: 7px;
        padding-bottom: 0px;
        min-height: 27px;
        margin-top: 0;
        margin-bottom: 0px;
    }

    .pull-left.section-title {
        font-size: 17px;
        padding: 5px 0px;
        color: #212121;
    }

    .filter.pull-right.dashboard-filter table {
        margin: 0;
    }

    .section-title-filter {
        padding: 10px 0px;
        display: table;
    }

    .card h4 {
        font-size: 20px;
        margin-bottom: 0px;
        font-weight: 400;
        color: #fff;
    }

    .card {
        border: 1px solid #484848;
        text-align: center;
        padding: 20px;
        border-radius: 0px;
        transition: all ease-in .5s;
        margin-bottom: 20px;
        color: #fff;
        border-radius: 8px;
        -webkit-box-shadow: 0 1px 11px 0 rgb(136, 136, 136);
        box-shadow: 0 1px 11px 0 rgb(136, 136, 136);
    }

    /*    .card p {
            padding: 20px 0px 0px;
            font-size: 20px;
            color: #fff;
        }*/
    .dataTables_scrollBody {
        overflow: scroll !important;
        height: 400px;
    }

    .card-box-count .card a {
        display: inline-block;
        border-radius: 50%;
        background: #ffff;
        width: 100px;
        height: 100px;
        line-height: 100px;
        margin-top: 10px;
        font-size: 20px;
        -webkit-box-shadow: 0 1px 11px 0 rgb(136 136 136);
        box-shadow: 0 1px 11px 0 rgb(136 136 136);
        text-decoration: underline;
    }

    .card-box-count .card p {
        display: inline-block;
        border-radius: 50%;
        background: #ffff;
        width: 100px;
        height: 100px;
        line-height: 100px;
        margin-top: 10px;
        font-size: 20px;
        -webkit-box-shadow: 0 1px 11px 0 rgb(136 136 136);
        box-shadow: 0 1px 11px 0 rgb(136 136 136);
        color: #000;
    }
</style>


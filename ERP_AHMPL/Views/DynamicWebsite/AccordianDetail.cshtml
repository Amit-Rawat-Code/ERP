
@{
    ViewBag.Title = "AccordianDetail";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}
<style>
    .arrowleft1 {
        position: absolute;
        top: -124px;
        left: 0px;
        display: inline-block;
        cursor: pointer;
    }

    .arrowright1 {
        position: absolute;
        top: -124px;
        right: 0px;
        display: inline-block;
        cursor: pointer;
    }

    table.cbse_table {
        border: 1px solid #2d8a43;
        border-collapse: collapse;
        width: 100%;
        text-align: center;
        font-size: 14px;
    }

        table.cbse_table td {
            border: 1px solid #2d8a43;
            border-collapse: collapse;
            padding: 5px 0px;
        }

    .responsibility_inner p {
        font-size: 14px;
        text-align: justify;
        letter-spacing: 0.5px;
        line-height: 22px;
    }

    .cbse_center_table {
        margin: 0 auto;
        width: 500px;
    }

    .responsibility_inner {
        padding-top: 27px;
    }

    .para_space1 {
        padding: 11px 0px 0px 0px;
    }

    .primary_section {
        margin: 10px auto;
        width: 327px;
        float: none;
        height: 219px;
        text-align: center;
        border: 2px solid #0f4829;
    }

    .tab {
        width: 100%;
        float: left;
    }

        .tab ul li a {
            display: block;
            color: #fff;
        }

        .tab ul li {
            display: inline-block;
            background: #19552d;
            padding: 10px;
            width: 49%;
            color: #fff;
            text-align: center;
        }

    .social_inner p {
        font-size: 14px;
    }

    .slider_1 {
        width: 529px;
        float: left;
        padding-bottom: 20px;
    }

    .slider_2 {
        width: 529px;
        float: left;
        padding-bottom: 20px;
    }

    #rakhi .slides li img {
        border: 2px solid #0f4829;
    }

    .arrow1021 {
        top: -150px;
    }
</style>
<script src="~/Scripts/myjslib/AccordianDetailController.js?Ver=@ViewBag.Version"></script>
<script src="//cdn.ckeditor.com/4.16.1/full/ckeditor.js"></script>
@*<script src="~/Content/ckeditor/ckeditor1.js"></script>*@
<script src="~/Content/ckfinder/ckfinder.js"></script>
<script type="text/javascript">
    $(function () {
        CKEDITOR.replace("EnglishEditor", { customConfig: "/Content/ckeditor/config.js" });

    })
</script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="app-content  my-3 ">
    <div class="side-app">


        <div class="br-pageheader">
            <!-- Title -->
            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
                <h5 class="txt-dark">Create Content</h5>
            </div>
            <!-- Breadcrumb -->
            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                <ol class="breadcrumb">
                    <li><span>Accordian</span></li>
                    <li class="breadcrumb-item">Accordian Detail</li>
                    <li class="breadcrumb-item active" aria-current="page">Create Accordian Content</li>
                </ol>
            </div>

        </div>

        <div class="br-pagebody">
            <div class="">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div class="form-group">
                                    <label>Select Accordian Type</label>
                                    <select id="ddlMenu" class="select2 form-control clear validate" ng-model="AccordianType" ng-init="GetAccordianType();">
                                        <option value="">Select Accordian</option>
                                        <option ng-repeat="ACD in Accordians" value="{{ACD.Code}}">{{ACD.AccordianName}}</option>
                                    </select>

                                </div>
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 mgbt-xs-15">
                                <div class="form-group">
                                    <label>Accordian Content Heading</label>
                                    @Html.TextBox("AccCHeading", "", new { @class = "form-control clear validate", @ng_model = "AccCHeading" })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div class="form-group">
                                    <label>Order By</label>
                                    <input class="form-control validate" type="text" maxlength="2" onkeypress='return event.charCode >= 48 && event.charCode <= 57' id="SequenceNo" ng-model="SequenceNo" />
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div class="form-group">
                                    <label>Status</label>
                                    @Html.Partial("ddlApproved")
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div class="form-group">
                                    <label>Active</label>
                                    @Html.Partial("ddlActive")
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Image Upload</b>
                                            <div class="col-information">
                                                @*<img class="img-fix" id="imgfileInput1" src="~/Content/noimage.png" ng-model="imgfileInput1" ng-src="{{imgfileInput1}}" alt="" width="150" height="150" ng-click="OpenFileUpload1()">*@
                                                <input name="fileInput1" onchange="angular.element(document).scope().fuImageChange1(this)" upload-files type="file" accept="image/jpg,image/png,image/jpeg,image/svg" id="fileInput1" class="form-control" ng-model="fileInput1" multiple />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*<div class="details" ng-repeat="ImageSize in  RecommedSizeImageData">
                                        <b>Recommended Size:</b>&nbsp;
                                        <span style="color:red">{{ImageSize.ContentImageDataDefaultSize}}</span>
                                    </div>*@
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div class="form-group">
                                    <label>Image As Banner ?</label>
                                    @Html.DropDownList("ddlIsBanner", new List<SelectListItem>
                                        {
                                        new SelectListItem{Text="Select", Value=""},
                                        new SelectListItem{Text="Yes", Value="1"},
                                        new SelectListItem{Text="No", Value="0"}
                                        },
                                        new
                                        {
                                            @class = "select2 form-control validate",
                                            @ng_model = "ddlIsBanner",
                                            @ng_init = "ddlIsBanner='1'"
                                        })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div class="form-group">
                                    <label>Image As Slider ?</label>
                                    @Html.DropDownList("ddlIsSlider", new List<SelectListItem>
                                       {
                                       new SelectListItem{Text="Select", Value=""},
                                       new SelectListItem{Text="Yes", Value="1"},
                                       new SelectListItem{Text="No", Value="0"}
                                       },
                                       new
                                       {
                                           @class = "select2 form-control validate",
                                           @ng_model = "ddlIsSlider",
                                           @ng_init = "ddlIsSlider='0'"
                                       })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                <div class="table-responsive" style="overflow-y: hidden;">
                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%" ng-init="AddRow()">
                                        <thead>
                                            <tr>
                                                <th style="text-align: -webkit-center;">Page Sequence No.</th>
                                                <th style="text-align: -webkit-center;">Link Name</th>
                                                <th style="text-align: -webkit-center;">Page Link</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="obj in PLSettingList">
                                                <td style="text-align: -webkit-center;">
                                                    <input ng-model="obj.Srno" class="form-control clear" />
                                                </td>
                                                <td>
                                                    <input ng-model="obj.LinkName" class="form-control clear" />
                                                </td>
                                                <td>
                                                    <input ng-model="obj.PageLink" class="form-control clear" />
                                                </td>
                                                <td>
                                                    <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow()" ng-if="PLSettingList.length==1 || PLSettingList.length==obj.Srno" />
                                                    <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(obj.Srno)" ng-if="PLSettingList.length>1" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Add Body Content</b>
                                            <div class="col-information">
                                                @Html.TextBox("EnglishEditor", "", new { @id = "EnglishEditor", @class = "form-control clear", @ng_model = "EnglishEditor" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                @Html.Partial("ActionView")
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                @Html.Partial("SearchAngularJs")
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>



@{
    ViewBag.Title = "Admin Video Uploading";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.TitleList = "Sort By Column";
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script src="~/scripts/myjslib/AdminVideoUploadController.js"></script>
<input type="hidden" ng-model="hdnVideoTransId" id="hdnVideoTransId" />
<!-- Section: inner-header -->
<div class="app-content  my-3 ">
    <div class="side-app">
        <div class="autohide-scroll autoheightset">

            <div class="br-pageheader">
                <!-- Title -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
                    <h5 class="txt-dark">Upload Album Videos</h5>
                </div>
                <!-- Breadcrumb -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                    <ol class="breadcrumb">
                        <li><span>Album</span></li>
                        <li class="active"><span>Upload Album Videos</span></li>
                    </ol>
                </div>

            </div>

            <div class="br-pagebody">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="collapse in" id="collapseinputbox">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <div class="form-group">
                                                        <label>Select Unit Type</label>
                                                        @Html.Partial("ddlPermUnitType")
                                                    </div>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <div class="form-group">
                                                        <label>Select Unit</label>
                                                        @Html.Partial("ddlPermUnit")
                                                    </div>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <div class="form-group">
                                                        <label>Album Name</label>
                                                        <select id="ddlGalleryType" class="form-control clear validate" ng-change="SetAlbumn()" ng-model="VideoAlbumId" ng-init="AlbumName();">
                                                            <option value="">Select</option>
                                                            @*<option ng-repeat="x in rec" value="{{x.TransId}}|{{x.Title}}">{{x.Title}}</option>*@
                                                            <option ng-repeat="x in rec" value="{{x.TransId}}">{{x.Title}}</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <div class="form-group">
                                                        <label>Discription</label>
                                                        @*<input type="file" accept="image/mp4,image/avi" id="fileInput" onchange="angular.element(this).scope().show(this)" ng-model="fileInput" multiple class="form-control clear validate" />*@
                                                        <input type="text" id="VdoDiscription" ng-model="VdoDiscription" multiple class="form-control clear validate" />
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <div class="form-group">
                                                        <label>Upload Youtube Videos</label>
                                                        @*<input type="file" accept="image/mp4,image/avi" id="fileInput" onchange="angular.element(this).scope().show(this)" ng-model="fileInput" multiple class="form-control clear validate" />*@
                                                        <input type="text" id="vdoUrl" ng-model="vdoUrl" multiple class="form-control clear validate" />
                                                    </div>

                                                    <!--<div>
                                                        <strong>Instructions to Upload Files</strong>
                                                        <ul>
                                                            <li> 1) Upload Multiple Videos in selected Album. </li>
                                                            <li> 2) Use Standard Video Format <br />&nbsp;&nbsp;&nbsp;&nbsp; Resolution (1280 x 720).</li>-->
                                                        @*<li> 3) Album Image Size is not more than 1 Mb</li>*@
                                                        <!--<li> 4) Maximum five Videos upload at a time</li>
                                                        </ul>
                                                    </div>-->
                                                </div>

                                                @*<div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="content-title">Upload Album Icon <span class="red-i">*</span></label>
                                                    <div class="input-box file-i">
                                                        <img id="AlbumIcon" style="display: none;" src="" alt="" />
                                                        <input type="file" onchange="angular.element(this).scope().show(this, '#AlbumIcon')" ng-model="AlbumIcon" class="form-control dropify" id="fileInput" />
                                                        <div class="text-box-msg-r">
                                                            <input type="hidden" id="AlbumIcon" />
                                                        </div>
                                                    </div>
                                                    <div class=" photo-ins">

                                                        <strong>Instructions to Upload Files</strong>
                                                        <ol>
                                                            <li>Upload Multiple images in Album Cover. </li>
                                                            <li>Use Standard photo Format (Width: 640px Height: 480px).</li>
                                                            <li>Album Cover Image Size is not more than 1 Mb</li>

                                                        </ol>
                                                    </div>
                                                </div>*@
                                                @*<div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <div class="form-group">
                                                        <label>Thumb Image Upload</label>
                                                        <input type="file" accept="image/jpg,image/png,image/jpeg" id="fileInput" ng-model="fileInput" class="form-control clear validate" />

                                                    </div>
                                                </div>*@

                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <iframe id="vid_frame" src="" frameborder="0" width="250" height="200"></iframe>
                                                </div>
                                            </div>
                                                <div class="col-md-12 col-sm-12 footer-listad">
                                                    @Html.Partial("ActionView")
                                                </div>
                                            </div>
                                    </div>
                                </div>
                                @Html.Partial("SearchAngularJs")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

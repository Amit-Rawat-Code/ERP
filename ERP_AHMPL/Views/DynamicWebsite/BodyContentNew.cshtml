
@{
    ViewBag.Title = "BodyContent";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/BodyContentNewController.js?Ver=@ViewBag.Version"></script>
<script src="//cdn.ckeditor.com/4.16.1/full/ckeditor.js"></script>
@*<script src="~/Content/ckeditor/ckeditor1.js"></script>*@
<script src="~/Content/ckfinder/ckfinder.js"></script>
<script type="text/javascript">
    $(function () {
        CKEDITOR.replace("EnglishEditor", { customConfig: "/Content/ckeditor/config.js" });

    })
</script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<input type="hidden" ng-model="hfUnitId" id="UnitId" name="UnitId" value="" />
<input type="hidden" ng-model="hfLayoutId" id="LayoutId" name="LayoutCode" value="" />
<input type="hidden" ng-model="hfLayoutPartId" id="LayoutPartId" name="LayoutPartId" value="" />
<input type="hidden" ng-model="hfLayoutPartAbbreviationName" id="LayoutPartAbbreviationName" name="LayoutPartAbbreviationName" value="" />
<input type="hidden" ng-model="hfTabId" id="TabId" name="TabId" value="" />
<input type="hidden" ng-model="hfMenuId" id="MenuId" name="MenuId" value="" />
<input type="hidden" ng-model="hfSubMenuId" id="SubMenuId" name="SubMenuId" value="" />
<div class="app-content  my-3 " ng-init="GetRecommedSize();">
    <div class="side-app">


        <div class="br-pageheader">
            <!-- Title -->
            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
                <h5 class="txt-dark">Create Content New</h5>
            </div>
            <!-- Breadcrumb -->
            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                <ol class="breadcrumb">
                    <li><span>Unit Manager</span></li>
                    <li class="breadcrumb-item">Unit Detail Master</li>
                    <li class="breadcrumb-item active" aria-current="page">Create Content New</li>
                </ol>
            </div>

        </div>

        <div class="br-pagebody">
            <div class="">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Heading Image</b>
                                            <div class="col-information">
                                                <img class="img-fix" id="imgfileInput" src="~/Content/noimage.png" ng-model="imgfileInput" ng-src="{{imgfileInput}}" alt="" width="150" height="150" ng-click="OpenFileUpload()">
                                                <input name="fileInput" onchange="angular.element(document).scope().fuImageChange(this)" upload-files type="file" accept="image/jpg,image/png,image/jpeg,image/svg" id="fileInput" ng-model="fileInput" multiple />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="details" ng-repeat="ImageSize in  RecommedSizeImageData">
                                    <b>Recommended Size:</b>&nbsp;
                                    <span style="color:red">{{ImageSize.HeadingImageDataDefaultSize}}</span>
                                </div>

                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Heading Image Height</b>
                                            <div class="col-information">
                                                <input class="form-control" type="text" maxlength="5" onkeypress='return event.charCode >= 48 && event.charCode <= 57' id="HeadingImageHeight" ng-model="HeadingImageHeight" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Heading Text</b>
                                            <div class="col-information">
                                                @Html.TextBox("HeadingText", "", new { @id = "HeadingText", @class = "form-control clear", @ng_model = "HeadingText" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Image Upload</b>
                                            <div class="col-information">
                                                <img class="img-fix" id="imgfileInput1" src="~/Content/noimage.png" ng-model="imgfileInput1" ng-src="{{imgfileInput1}}" alt="" width="150" height="150" ng-click="OpenFileUpload1()">
                                                <input name="fileInput1" onchange="angular.element(document).scope().fuImageChange1(this)" upload-files type="file" accept="image/jpg,image/png,image/jpeg,image/svg" id="fileInput1" ng-model="fileInput1" multiple />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="details" ng-repeat="ImageSize in  RecommedSizeImageData">
                                    <b>Recommended Size:</b>&nbsp;
                                    <span style="color:red">{{ImageSize.ContentImageDataDefaultSize}}</span>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Image Height</b>
                                            <div class="col-information">
                                                <input class="form-control" type="text" maxlength="5" onkeypress='return event.charCode >= 48 && event.charCode <= 57' id="ImageHeight" ng-model="ImageHeight" />
                                            </div>
                                        </div>
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Image Width</b>
                                            <div class="col-information">
                                                @Html.DropDownList("ImgWidth", new List<SelectListItem>{
                            new SelectListItem{Text="Select", Value=""},
                            new SelectListItem{Text="Image With Full Width", Value="100%"},
                            new SelectListItem{Text="Image With Auto Fits", Value="auto"}
                        },
                            new { @class = "select2 form-control validate", @ng_model = "ImgWidth" })
                                            </div>
                                        </div>
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Image Border</b>
                                            <div class="col-information">
                                                @Html.DropDownList("ImgBorder", new List<SelectListItem>{
                            new SelectListItem{Text="Select", Value=""},
                             new SelectListItem{Text="0px", Value="0px"},
                            new SelectListItem{Text="1px", Value="1px"},
                            new SelectListItem{Text="2px", Value="2px"},
                            new SelectListItem{Text="3px", Value="3px"},
                            new SelectListItem{Text="4px", Value="4px"},
                            new SelectListItem{Text="5px", Value="5px"},
                            new SelectListItem{Text="6px", Value="6px"},
                            new SelectListItem{Text="7px", Value="7px"},
                            new SelectListItem{Text="8px", Value="8px"},
                            new SelectListItem{Text="9px", Value="9px"},
                            new SelectListItem{Text="10px", Value="10px"},
                        },
                            new { @class = "select2 form-control validate", @ng_model = "ImgBorder" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Image object-fit Property</b>
                                            <div class="col-information">
                                                @Html.DropDownList("ImgObjectFits", new List<SelectListItem>{
                             new SelectListItem{Text="Select", Value=""},
                             new SelectListItem{Text="fill", Value="fill"},
                             new SelectListItem{Text="contain", Value="contain"},
                             new SelectListItem{Text="cover", Value="cover"},
                             new SelectListItem{Text="none", Value="none"},
                             new SelectListItem{Text="scale-down", Value="scale-down"}
                         },
                             new { @class = "select2 form-control validate", @ng_model = "ImgObjectFits" })
                                            </div>
                                            <div class="col-information">
                                                <b>Image Border Radius</b>
                                                @Html.DropDownList("ImgBorderRadius", new List<SelectListItem>{
                               new SelectListItem{Text="Select", Value=""},
                               new SelectListItem{Text="0px", Value="0px"},
                               new SelectListItem{Text="1px", Value="1px"},
                               new SelectListItem{Text="2px", Value="2px"},
                               new SelectListItem{Text="3px", Value="3px"},
                               new SelectListItem{Text="4px", Value="4px"},
                               new SelectListItem{Text="5px", Value="5px"},
                               new SelectListItem{Text="6px", Value="6px"},
                               new SelectListItem{Text="7px", Value="7px"},
                               new SelectListItem{Text="8px", Value="8px"},
                               new SelectListItem{Text="9px", Value="9px"},
                               new SelectListItem{Text="10px", Value="10px"},
                           },
                               new { @class = "select2 form-control validate", @ng_model = "ImgBorderRadius" })
                                            </div>
                                            <div class="col-information">
                                                <b>Image As Banner ?</b>
                                                @Html.DropDownList("ddlIsBanner", new List<SelectListItem>
                                                {
                                                new SelectListItem{Text="Select", Value=""},
                                                new SelectListItem{Text="Yes", Value="1"},
                                                new SelectListItem{Text="No", Value="0"}
                                                },
                                                new
                                                {
                                                    @class = "select2 form-control validate",
                                                    @ng_model = "ddlIsBanner",
                                                    @ng_init = "ddlIsBanner='1'"
                                                })
                                            </div>
                                            <div class="col-information">
                                                <b>Image As Slider ?</b>
                                                @Html.DropDownList("ddlIsSlider", new List<SelectListItem>
                                                {
                                                new SelectListItem{Text="Select", Value=""},
                                                new SelectListItem{Text="Yes", Value="1"},
                                                new SelectListItem{Text="No", Value="0"}
                                                },
                                                new
                                                {
                                                    @class = "select2 form-control validate",
                                                    @ng_model = "ddlIsSlider",
                                                    @ng_init = "ddlIsSlider='0'"
                                                })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                <div class="table-responsive" style="overflow-y: hidden;">
                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%" ng-init="AddRow()">
                                        <thead>
                                            <tr>
                                                <th style="text-align: -webkit-center;">Page Sequence No.</th>
                                                <th style="text-align: -webkit-center;">Link Name</th>
                                                <th style="text-align: -webkit-center;">Page Link</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="obj in PLSettingList">
                                                <td style="text-align: -webkit-center;">
                                                    <input ng-model="obj.Srno" class="form-control clear" />
                                                </td>
                                                <td>
                                                    <input ng-model="obj.LinkName" class="form-control clear" />
                                                </td>
                                                <td>
                                                    <input ng-model="obj.PageLink" class="form-control clear" />
                                                </td>
                                                <td>
                                                    <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow()" ng-if="PLSettingList.length==1 || PLSettingList.length==obj.Srno" />
                                                    <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(obj.Srno)" ng-if="PLSettingList.length>1" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tabs-container">
                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                            <b>Body Content</b>
                                            <div class="col-information">
                                                @Html.TextBox("EnglishEditor", "", new { @id = "EnglishEditor", @class = "form-control clear", @ng_model = "EnglishEditor" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                <div id="product-tab">
                                    <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                        <b>Order By</b>
                                        <div class="col-information">
                                            <input class="form-control" type="text" maxlength="2" onkeypress='return event.charCode >= 48 && event.charCode <= 57' id="OrderBy" ng-model="OrderBy" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                @Html.Partial("ActionView")
                            </div>
                            @*<div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-show="showhide">
            <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                <thead>
                    <tr>
                        <th>Sr. No</th>
                        <th>UnitType</th>
                        <th>UnitName</th>
                        <th>Tab Name</th>
                        <th>Menu Name</th>
                        <th>SubMenu Name</th>
                        <th>Body Content Heading Image</th>
                        <th>Body Content Heading</th>
                        <th>Body Content Image Path</th>
                        <th>Body Content</th>
                        <th>Status</th>
                        <th>Active</th>
                        <th>Layout Part Abbreviation Name</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="obj in BodyContentList">
                        <td ng-bind="obj.Srno={{$index+1}}"></td>
                        <td>{{obj.UnitType}}</td>
                        <td>{{obj.UnitName}}</td>
                        <td>{{obj.TabName}}</td>

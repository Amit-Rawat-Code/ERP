                        <td>{{obj.SubMenuName}}</td>
                        <td>{{obj.BodyContentHeadingImgPath}}</td>
                        <td>{{obj.BodyContentHeading}}</td>
                        <td>{{obj.ImgPath}}</td>
                        <td>{{obj.BodyContent}}</td>
                        <td>{{obj.IsApproved}}</td>
                        <td>{{obj.IsActive}}</td>
                        <td>{{obj.LayoutPartAbbreviationName}}</td>
                    </tr>
                </tbody>
            </table>
        </div>*@
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                @Html.Partial("SearchAngularJs")
                            </div>
                        </div>
                        </div>

                </div>
            </div>

        </div>
    </div>
</div>


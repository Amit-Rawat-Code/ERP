
@{
    ViewBag.Title = "LayoutPart";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/LayoutPartController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="app-content  my-3 ">
    <div class="side-app">

        <div class="autohide-scroll autoheightset">

            <div class="br-pageheader">
                <!-- Title -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
                    <h5 class="txt-dark">Define Layout</h5>
                </div>
                <!-- Breadcrumb -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                    <ol class="breadcrumb">
                        <li><span>Unit Manager</span></li>
                        <li class="active"><span>Define Layout</span></li>
                    </ol>
                </div>

            </div>


            <div class="br-pagebody">
                <div class="">
                    <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label>Select Layout</label>
                                        @Html.Partial("ddlLayout")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label>Layout Part</label>
                                        <select id="LayoutPart" name="ddlLayoutPart" class="select2 form-control clear validate" ng-model="LayoutPart" ng-init="GetLayoutPart()">
                                            <option value="">Select Layout Part</option>
                                            <option ng-repeat="LayoutParts in GetAllLayoutParts" value="{{LayoutParts.Code}}">{{LayoutParts.LayoutPartName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label>Layout Link</label>
                                        @Html.TextBox("Link", "", new { @class = "form-control clear validate", @ng_model = "Link", @placeholder = "" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label>Sequence Number</label>
                                        @Html.TextBox("SeqNo", "", new { @class = "form-control clear validate", @ng_model = "SeqNo", @placeholder = "" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label>Status</label>
                                        @Html.Partial("ddlApproved")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label>Active</label>
                                        @Html.Partial("ddlActive")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 ">
                                    <div class="form-group">
                                        <label>Heading Content Image Data Recommended Size</label>
                                        @Html.TextBox("HeadingImageDataDefaultSize", "", new { @class = "form-control clear validate", @ng_model = "HeadingImageDataDefaultSize", @placeholder = "" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 ">
                                    <div class="form-group">
                                        <label>Content Image Data Recommended Size</label>
                                        @Html.TextBox("ContentImageDataDefaultSize", "", new { @class = "form-control clear validate", @ng_model = "ContentImageDataDefaultSize", @placeholder = "" })
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                    @Html.Partial("ActionView")
                                </div>
                                @*<div class="col-md-12 col-sm-12 col-xs-12" ng-show="showhide">
            <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                <thead>
                    <tr>
                        <th>Sr. No</th>
                        <th>Layout Name</th>

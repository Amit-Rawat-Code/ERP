
@{
    ViewBag.Title = "Side Bar On Home Page";
    ViewBag.TitleList = "Sort By Column";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/scripts/myjslib/SideBarOnHomePageController.js?Ver=@ViewBag.Version"></script>
<div class="app-content  my-3 ">
    <div class="side-app">
        <div class="autohide-scroll autoheightset">

            <div class="br-pageheader">
                <!-- Title -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
                    <h5 class="txt-dark"> @ViewBag.Title</h5>
                </div>
                <!-- Breadcrumb -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                    <ol class="breadcrumb">
                        <li><span>Unit Manager</span></li>
                        @*<li class="breadcrumb-item">@ViewBag.Title</li>*@
                        <li class="active"><span>@ViewBag.Title</span></li>
                    </ol>
                </div>

            </div>

            <div class="br-pagebody">
                <div class="">
                    <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Select Unit Type</label>
                                        @Html.Partial("ddlPermUnitType")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Select Unit</label>
                                        @Html.Partial("ddlPermUnit")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Tab Name</label>
                                        @Html.TextBox("TabName", "", new { @class = "form-control clear validate", @ng_model = "TabName", @placeholder = "" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>URL Type</label>
                                        @Html.Partial("ddlURLType")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-model="TargetUnitDiv" ng-hide="TargetUnitDiv" , ng-init="TargetUnitDiv=true">
                                    <div class="form-group">
                                        <label>Target Unit</label>
                                        @Html.Partial("ddlAllUnit")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-model="URLDiv" ng-hide="URLDiv" , ng-init="URLDiv=true">
                                    <div class="form-group">
                                        <label>URL</label>
                                        @Html.TextBox("txtURL", "", new { @class = "form-control clear", @ng_model = "URL", @placeholder = "" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-model="fileInputDiv" ng-hide="fileInputDiv" , ng-init="fileInputDiv=true">
                                    <div class="form-group">
                                        <label>Attachment</label>
                                        <input type="file" accept="image/*,.doc, .docx,.xls,.xlsx,.ppt, .pptx,.txt,.pdf" id="fileInput" ng-model="fileInput" multiple class="form-control file-input clear" />
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Target Layout</label>
                                        @Html.Partial("ddlLayout")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Sequence Number</label>
                                        @Html.TextBox("SeqNo", "", new { @class = "form-control clear validate", @ng_model = "SeqNo", @placeholder = "" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Tab Alignment</label>
                                        @Html.Partial("ddlAlignment")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Status</label>
                                        @Html.Partial("ddlApproved")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Active</label>
                                        @Html.Partial("ddlActive")
                                    </div>
                                </div>
                                
                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                    @Html.Partial("ActionView")
                                </div>

                                @Html.Partial("SearchAngularJs")

                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

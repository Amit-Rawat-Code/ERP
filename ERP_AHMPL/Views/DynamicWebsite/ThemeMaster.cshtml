@{
    ViewBag.Title = "ThemeMaster";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}
<script type="text/javascript" src="@Url.Content("~/Scripts/jscolor.js")"></script>
<script src="~/Scripts/myjslib/ThemeMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />


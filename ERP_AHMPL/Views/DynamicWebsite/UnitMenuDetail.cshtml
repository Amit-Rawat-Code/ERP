
@{
    ViewBag.Title = "UnitMenuDetail";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}


<script src="~/Scripts/myjslib/UnitMenuDetailController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="app-content  my-3 ">
    <div class="side-app">

        <div class="autohide-scroll autoheightset">

            <div class="br-pageheader">
                <!-- Title -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
                    <h5 class="txt-dark">Unit Detail Master</h5>
                </div>
                <!-- Breadcrumb -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                    <ol class="breadcrumb">
                        <li><span>Unit Manager</span></li>
                        <li class="active"><span>Unit Detail Master</span></li>
                    </ol>
                </div>

            </div>
            <div class="br-pagebody">
                <div class="">
                    <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="">
                                        <label>Select Unit Type</label>
                                        @Html.Partial("ddlPermUnitType")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Select Unit</label>
                                        @Html.Partial("ddlPermUnit")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Select Tab</label>
                                        @Html.Partial("ddlTab")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Select Menu</label>
                                        @Html.Partial("ddlMenu")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Select Sub Menu</label>
                                        @Html.Partial("ddlSubMenu")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <label>Select Layout</label>
                                        @Html.Partial("ddlLayout")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                  
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <div class="form-group">
                                        <img class="img-fix" id="imgfileInput" src="~/Content/noimage.png" ng-model="imgfileInput" ng-src="{{imgfileInput}}" alt="" width="150" height="150">
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                    @Html.Partial("ActionView")
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                    @Html.Partial("TableLayoutPart")
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                    @Html.Partial("SearchAngularJs")
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>


        </div>
    </div>


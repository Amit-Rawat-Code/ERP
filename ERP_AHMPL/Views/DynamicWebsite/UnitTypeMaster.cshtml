
@{
    ViewBag.Title = "UnitTypeMaster";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/UnitTypeMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="app-content  my-3 ">
    <div class="side-app">
        <div class="autohide-scroll autoheightset">
            <div class="br-pageheader">
                <!-- Title -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
                    <h5 class="txt-dark">Create Unit Type</h5>
                </div>
                <!-- Breadcrumb -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                    <ol class="breadcrumb">
                        <li><span>Unit Manager</span></li>
                        <li class="active"><span>Create Unit Type</span></li>
                    </ol>
                </div>

            </div>

            <div class="br-pagebody">
                <div class="">
                    <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 ">
                                    <div class="form-group">
                                        <label>Unit Type</label>
                                        @Html.TextBox("UnitType", "", new { @class = "form-control clear validate", @ng_model = "UnitType", @placeholder = "" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 ">
                                    <div class="form-group">
                                        <label>Unit Type Layout</label>
                                        @Html.Partial("ddlLayout")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 ">
                                    <div class="form-group">
                                        <label>Status</label>
                                        @Html.Partial("ddlApproved")
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 ">
                                    <div class="form-group">
                                        <label>Active</label>
                                        @Html.Partial("ddlActive")
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1 ">
                                    @Html.Partial("ActionView")
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 " ng-show="showhide">
                                    <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Sr. No</th>
                                                <th>Layout Name</th>
                                                <th>Unit Type</th>
                                                <th>Status</th>
                                                <th>Is Active</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="obj in UnitTypeMasterList">
                                                <td ng-bind="obj.Srno={{$index+1}}"></td>
                                                <td>{{obj.LayoutName}}</td>
                                                <td>{{obj.UnitType}}</td>
                                                <td>{{obj.IsApproved}}</td>
                                                <td>{{obj.IsActive}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">

                                    @Html.Partial("SearchAngularJs")
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

            </div>
            </div>
        </div>
    </div>


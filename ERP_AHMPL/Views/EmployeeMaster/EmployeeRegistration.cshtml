                                                        <thead>
                                                            <tr>
                                                                <th>Leave Type</th>
                                                                <th>Leave Opening</th>
                                                                <th>Year Leave</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="id in LeaveTypeMasterList">

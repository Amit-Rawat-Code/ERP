                                                            <option value="Part Time">Part Time</option>
                                                            <option value="Temporary">Temporary</option>
                                                        </select>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">MachineId<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtMachineId", "", new { @class = "form-control", @placeholder = "", @ng_model = "employeeDetails.MachineId" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Reference<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtReference", "", new { @class = "form-control", @placeholder = "", @ng_model = "employeeDetails.Reference" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Reference Designation<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        <select id="ddlReferenceDesignation" class="select2 form-control validate" ng-model="employeeDetails.ReferenceDesignation">

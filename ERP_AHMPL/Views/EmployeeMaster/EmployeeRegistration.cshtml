                                                            <option ng-repeat="dl in DesignationList" value="{{dl.Code}}" ng-disabled="!dl.IsActive">
                                                                {{dl.DesignationName}}
                                                            </option>
                                                        </select>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Reference Contact No.<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtReferenceContactNo", "", new { @class = "form-control", @placeholder = "", @ng_model = "employeeDetails.ReferenceContactNo" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Reference Email<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtReferenceEmail", "", new { @class = "form-control", @placeholder = "", @ng_model = "employeeDetails.ReferenceEmail" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Active<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.Partial("ddlActive")
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Resigned<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.DropDownList("ddlIsResigned", new List<SelectListItem>{
                                                             new SelectListItem{Text="Select", Value=""},
                                                             new SelectListItem{Text="Yes", Value="True"},
                                                             new SelectListItem{Text="No", Value="False"}
                                                         },
                                                             new
                                                                  {
                                                                      @class = "select2 form-control validate",
                                                                      @ng_model = "employeeDetails.IsResigned",
                                                                 @ng_init = "employeeDetails.IsResigned='False'",
                                                                 @ng_change = "SetIsResigned()"
                                                                  })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-model="TargetDate" ng-hide="TargetDate" ng-init="TargetDate=true">
                                                    <label class="control-label">Resignation Date<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtResignationDate", "", new { @class = "form-control", @type = "date", @placeholder = "", @ng_model = "employeeDetails.ResignationDate" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-model="TargetRemark" ng-hide="TargetRemark" ng-init="TargetRemark=true">
                                                    <label class="control-label">Resignation Remark<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtResignationRemak", "", new { @class = "form-control", @placeholder = "", @ng_model = "employeeDetails.ResignationRemak" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>

                                                @*Tab Box 3*@
                                                <div class="tab-pane" id="tab3">
                                                    <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Employee Photo<span class="vd_red"></span></label>
                                                        <div class="input-box">
                                                            <input id="fuEmployeePhoto" type="file" name="file" class="dropify" data-max-file-size-preview="3M" onchange="angular.element(this).scope().SelectImage(this, '#imgEmployeePhoto', 'EmployeePhotoPath')" />
                                                            <img id="imgEmployeePhoto" ng-model="employeeDetails.EmployeePhotoPath"
                                                                 src={{employeeDetails.EmployeePhotoPath}} style="display:none" />
                                                            <div class="text-box-msg-r">
                                                            </div>
                                                        </div>
                                                        @*<div class="input-box">
                                                                <input id="fuEmployeePhoto" type="file" name="file" class="dropify" onchange="angular.element(this).scope().SelectImage(this, '#imgEmployeePhoto', 'EmployeePhoto')" />
                                                                <img id="imgEmployeePhotoPath" ng-model="employeeDetails.EmployeePhotoPath" />
                                                                <img id="imgEmployeePhoto" ng-model="employeeDetails.EmployeePhoto" style="display:none;" />
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>*@
                                                    </div>

                                                </div>
                                                @*Tab Box 4*@
                                            <div class="tab-pane" id="tab4">
                                                @*script controller3688.js*@
                                                <div>
                                                    <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Leave Alloted Date<span class="vd_red">*</span></label>
                                                        <div class="input-box">
                                                            @Html.TextBox("txtLeaveAllotedDate", "", new { @class = "form-control clear validate", @type = "date", @placeholder = "", @ng_model = "LeaveAllotedDate" })
                                                            <div class="text-box-msg-r">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="datatable-responsive table-responsive"
                                                     ng-init="GetLeaveTypeMaster();">

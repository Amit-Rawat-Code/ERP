                                                                <div ng-repeat="cls in KRAList">
                                                                    <input type="hidden" ng-bind="cls.Srno=($index+1)" />
                                                                    <input type="checkbox" ng-model="cls.chk" id="chkCls" ng-value="cls.Name"
                                                                           ng-change="ddlClass_Change(cls);" ng-disabled="cls.disabled" />
                                                                    {{cls.Name}}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">

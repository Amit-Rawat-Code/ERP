                                                                    <input type="hidden" ng-model="id.LeaveTypeId" />{{id.AbbrType}}
                                                                </td>
                                                                <td><input type="text" ng-model="id.Opening" class="form-control" maxlength="3" ng-init="id.Opening=0" /></td>
                                                                <td><input type="text" ng-model="id.TotalLeaves" class="form-control" maxlength="3" /></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>


@{
    ViewBag.Title = "SocialMediaPostReport";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

@*<h2>SocialMediaPostReport</h2>*@

<script src="~/scripts/myjslib/SocialMediaPostReportController.js?Ver=@ViewBag.Version"></script>
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">@ViewBag.Title</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>@ViewBag.Title</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                            <div class="col-md-3 col-sm-3 col-xs-12 mgbt-xs-15"></div>
                                            <div class="col-md-3 col-sm-3 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">From Date</label>
                                                <div class="input-box">
                                                    <input class="form-control validate" id="txtFromDate" max="{{endDate}}" min="{{startDate}}" name="txtFromDate" ng-init="SetMaxMinDate()" ng-model="FromDate" type="date" value="" />
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 col-sm-3 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">To Date</label>
                                                <div class="input-box">
                                                    <input class="form-control" id="txtToDate" max="{{endDate}}" min="{{startDate}}" name="txtToDate" ng-model="ToDate" type="date" value="" />
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 col-sm-3 col-xs-12 mgbt-xs-15">
                                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-10 btn1-nM3-1">
                                                    @Html.Partial("ActionSearch")
                                                </div>
                                            </div>
                                        </div>
                                        
                                    </form>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding report-box">
                                <div class="arrow-container animated fadeInDown filter-toggle " ng-click="FilterToggle()">
                                    <div class="arrow-2">
                                        <i class="fa fa-angle-down"></i>
                                    </div>
                                    <div class="arrow-1 animated hinge infinite zoomIn"></div>
                                </div>
                                @Html.Partial("GeneralReportGrid")
                                
                            </div>
                        </div>    
                    </div>
                </div>
            </div>
        </div>
    </div>    
</div>
@{
    ViewBag.Title = "Co Scholastic Group Skill Mapping";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}
<script src="~/Scripts/myjslib/CoScholasticGroupMappingController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Co-Scholastic Group Skill Mapping</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Exam</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Co-Scholastic Group Skill Mapping</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="row">
                                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Class</label>
                                            <div class="input-box">
                                                <select id="ddlClass" class="select2 form-control clear validate" ng-model="class" ng-init="GetAllClass();" ng-change="GetAllExams();">
                                                    <option value="">Select Class</option>
                                                    <option ng-repeat="classes in ClassList" value="{{classes.Code}}">{{classes.ClassName}}</option>
                                                </select>

                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Exam</label>
                                            <div class="input-box">
                                                <select id="ddlExam" class="select2 form-control clear validate" ng-model="exam">
                                                    <option value="">Select Exam</option>
                                                    <option ng-repeat="exam in ExamList" value="{{exam.ExamCode}}">{{exam.ExamName}}</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Report Card Component</label>
                                            <div class="input-box">
                                                <select id="ddlComponent" class="select2 form-control clear validate" ng-model="component">
                                                    <option value="">Select Component</option>
                                                    <option ng-repeat="comp in ComponentList" value="{{comp.Code}}">{{comp.ComponentName}}</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                            <div class="table-responsive" style=" width: 100%; overflow-y: initial; overflow-x: initial;">
                                                <table class="table table-striped table-bordered compact" style="width:100%" ng-init="AddRow()">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Co-Scholastic Skil Name</th>
                                                            <th>Co-Scholastic Group</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="obj in CoScholasticList">
                                                            <td ng-bind="obj.Srno=($index+1)" width="20" align="center"></td>
                                                            <td width="400">
                                                                <div class="input-box">
                                                                    <div class="input-box chk-validate">
                                                                        <div class="toggle-ddl" id="sc_skill" ng-init="GetAllCoSkillName();ToogleDDL('sc_skill','sc_skill')">
                                                                            <button class='btn btn-primary select-btn' data-ng-click='sc_skill=!sc_skill' ng-bind="GetCount(CoSkillNameList,'Select Skills')">Select Skills</button>
                                                                            <button class='btn btn-primary dropdown-toggle select-btn-sub' data-ng-click='sc_skill=!sc_skill'> <span class='fa fa-chevron-down'></span> </button>
                                                                            <div ng-show="sc_skill" class="ddlMultiple" ng-cloak>
                                                                                <div ng-click="ddlCheckAll('CoSkillNameList');">Check All <span class="btn-counts-right">Total Count: {{CoSkillNameList.length}}</span>                                                                                </div>
                                                                                <div ng-click="ddlUnCheckAll('CoSkillNameList');">Uncheck All</div>
                                                                                <hr style="margin:0px !important" />
                                                                                <div ng-repeat="sk in obj.CoSkillNameList">
                                                                                    <input type="checkbox" ng-model="sk.chk" value="{{sk.CoSkillNameCode}}" @*ng-model="obj.CoSkillCode[sk.chk]"*@ /> {{sk.CoSkillName}}                                                                                    
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td width="400">
                                                                <select id="ddlskillgroup" class="select2 form-control clear validate" ng-model="CoSkillGroup">
                                                                    <option value="">Select Group</option>
                                                                    <option ng-repeat="grp in CoSkillGroupList" value="{{grp.CoGroupCode}}" ng-model="obj.CoSkillGroupCode">{{grp.CoSkillGroupName}}</option>
                                                                </select>
                                                            </td>
                                                            <td width="20">
                                                                <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow()" ng-if="CoScholasticList.length==1 || CoScholasticList.length==obj.Srno" />
                                                                <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(obj.Srno)" ng-if="CoScholasticList.length>1" />
                                                            </td>

                                                        </tr>                                                      
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>


                                        <div class="col-md-8 col-sm-6 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </div>
                                </div>
                                @Html.Partial("SearchAngularJs")
                            </div>
                            </div>
                    </div>
                </div>
            </div>
            <!-- Row -->
        </div>
    </div>
</div>



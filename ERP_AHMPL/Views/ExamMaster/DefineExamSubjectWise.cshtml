
@{
    ViewBag.Title = "Define Exam Subject Wise";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/scripts/myjslib/DefineExamSubjectWiseController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-2 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">@ViewBag.Title</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><a href="#"><span>Exam</span></a></li>
                <li><a href="#"><span>Master</span></a></li>
                <li class="active"><span>@ViewBag.Title</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 no-padding">
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Class With Sections<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    <select id="ddlClassSection" class="select2 form-control" ng-model="AllClassSection" ng-init="GetAllClassesWithSections();" ng-change="ddlClass_Change()">
                                                        <option value="">Select Class With Sections</option>
                                                        <option ng-repeat="cl in AllClassSectionList" value="{{cl.Code}}" ng-disabled="!cl.IsActive">{{cl.ClassSectionName}}</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Subject<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    <select id="ddlTeacher" class="select2 form-control validate" ng-model="SubjectCode" >
                                                        <option value="">Select Subject</option>
                                                        <option ng-repeat="subject in SubjectList" value="{{subject.SubjectCode}}">
                                                            {{subject.SubjectName}}
                                                        </option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Term/Group<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    <select id="ddlTeacher" class="select2 form-control validate" ng-model="GroupCode" ng-click="GetAllExamsGroup()" ng-change="ddl_Group_Change(GroupCode)">
                                                        <option value="">Select Term/Group</option>
                                                        <option ng-repeat="group in ExamGroupList" value="{{group.ExamGroupCode}}">{{group.ExamGroupName}}</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Exam<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    <select id="ddlTeacher" class="select2 form-control validate" ng-model="ExamCode" >
                                                        <option value="">Select Exam</option>
                                                        <option ng-repeat="exam in ExamList" value="{{exam.Code}}">
                                                            {{exam.ExamName}}
                                                        </option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Entry Type<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    <select id="ddlTeacher" class="select2 form-control validate" ng-model="EntryType" ng-init="1">
                                                        <option value="">Select Entry Type</option>
                                                        <option value="1">Marks</option>
                                                        <option value="2">Grade</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Max Marks<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    @Html.TextBox("txtMaxMarks", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "MaxMarks" })
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Passing Marks<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    @Html.TextBox("txtPasssingMarks", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "PassingMarks" })
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Report Card Marks(RCM)<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    @Html.TextBox("txtReportCardMark", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "ReportCardMark" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- Row -->
    </div>
</div>



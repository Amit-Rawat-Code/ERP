@{
    ViewBag.Title = "Exam Group To Exam";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/ReportCardPrintController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />

<div class="autohide-scroll autoheightset"  ng-cloak>
    <!--<div class="br-pageheader">-->
    <!-- Title -->
    <!--<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
        <h5 class="txt-dark">Exam Group To Exam</h5>
    </div>-->
    <!-- Breadcrumb -->
    <!--<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Exam</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Exam Group To Exam</span></li>
            </ol>
        </div>
    </div>-->
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                        <label class="control-label">Class</label>
                                        <div class="input-box">
                                            <select id="ddlClass" class="select2 form-control clear validate" ng-model="class" ng-init="GetAllClass();" ng-change="GetAllExams();GetAllSubject();GetStudents();">
                                                <option value="">Select Class</option>
                                                <option ng-repeat="classes in ClassList" value="{{classes.Code}}">{{classes.ClassName}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-12 col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 search-feild"  ng-cloak>
                                        <label class="control-label">Student Detail</label>
                                        <div class="input-box">
                                            <div class="text-box-msg-r" style="left:0px !important">
                                                <button class="Srch-btn" ng-click="GetStudents()" style="left:0px !important">Search</button>
                                            </div>
                                            @Html.TextBox("txtSearchBox", "", new
                                       {
                                           @class = "form-control",
                                           @placeholder = "Search Reg No./Student Name/Mob.No.",
                                           @ng_model = "SearchBox",
                                           ng_disabled = "IsSearchBoxDisabled",
                                           @autocomplete = "off",
                                            @ng_Click = "GetStudents();"
                                       })
                                            <label class="text text-danger shift-left-15" ng-click="Show=false"><i class="fa fa-times" aria-hidden="true"></i>Clear</label>

                                            <div ng-if="Show" class="searchbox">
                                                <table class="table compact table-hover table-striped table-bordered nowrap dataTable">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:50px;text-align:center">Reg.No.</th>
                                                            <th style="width:50px;text-align:center">Class</th>
                                                            <th>Student Name</th>
                                                            <th>Father's Name</th>
                                                            <th>Mother's Name</th>
                                                            <th>Address</th>
                                                            <th>Contact No.</th>
                                                            <th>DOB</th>
                                                            <th>Scholar No.</th>
                                                            <th style="width:50px;text-align:center">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="obj in StudentList |filter:SearchBox" class="data-ctrl">
                                                            <td style="width:50px;text-align:center">{{obj.RegNo}}</td>
                                                            <td style="width:50px;text-align:center">{{obj.ClassName}}</td>
                                                            <td>{{obj.StudentName}}</td>
                                                            <td>{{obj.FatherName}}</td>
                                                            <td>{{obj.MotherName}}</td>
                                                            <td>{{obj.ResidenceAddress}}</td>
                                                            <td>{{obj.Mobile}}</td>
                                                            <td>{{obj.DOB_Print}}</td>
                                                            <td>{{obj.AdmissionNo}}</td>
                                                            <td class="text-align-right">
                                                                <button class="btn btn-dark" ng-click="GetEdit(obj.RegNo)">Print</button>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    @*<div class="row">
                    <input type="button" id="btnprint" value="Print" ng-click="PrintRecord();"/>
                </div>*@

                                </div>

                            </div>
                            @Html.Partial("ReportCardPrinting");

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    ViewBag.Title = "Scholastic Group Skill Mapping";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/ScholasticGroupMappingController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Scholastic Group Skill Mapping</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Exam</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Scholastic Group Skill Mapping</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="row">
                                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Class</label>
                                            <div class="input-box">
                                                <select id="ddlClass" class="select2 form-control clear validate" ng-model="class" ng-init="GetAllClass();" ng-change="GetAllExams();GetAllSubject();">
                                                    <option value="">Select Class</option>
                                                    <option ng-repeat="classes in ClassList" value="{{classes.Code}}">{{classes.ClassName}}</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Exam</label>
                                            <div class="input-box">
                                                <select id="ddlExam" class="select2 form-control clear validate" ng-model="exam">
                                                    <option value="">Select Exam</option>
                                                    <option ng-repeat="exam in ExamList" value="{{exam.Code}}">{{exam.ExamName}}</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Report Card Component</label>
                                            <div class="input-box">
                                                <select id="ddlComponent" class="select2 form-control clear validate" ng-model="component">
                                                    <option value="">Select Component</option>
                                                    <option ng-repeat="comp in ComponentList" value="{{comp.Code}}">{{comp.ComponentName}}</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive" style=" width: 100%; overflow-y: initial; overflow-x:initial;">
                                                <table class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Subject</th>
                                                            <th>Skill Name</th>
                                                            <th>Scholastic Group</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="obj in ScholasticList">
                                                            <td ng-bind="obj.Srno=($index+1)" width="20"></td>
                                                            <td width="400">
                                                                <select id="ddlSubject" class="select2 form-control clear validate" ng-model="obj.SubjectCode" ng-init="LoadSubjects(obj)">
                                                                    <option value="">Select Subject</option>
                                                                    <option ng-repeat="sub in obj.SubjectList" value="{{sub.SubjectCode}}">{{sub.SubjectName}}</option>
                                                                </select>
                                                            </td>
                                                            <td width="400">                                                                
                                                                <div class="input-box">
                                                                    <div class="input-box chk-validate">
                                                                        <div class="toggle-ddl" id="sc_skill" ng-init="LoadAllSkills(obj);ToogleDDL('sc_skill','sc_skill')">
                                                                            <button class='btn btn-primary select-btn' data-ng-click='sc_skill=!sc_skill' ng-bind="GetCount(obj.SkillNameList,'Select Skills')">Select Skills</button>
                                                                            <button class='btn btn-primary dropdown-toggle select-btn-sub' data-ng-click='sc_skill=!sc_skill'> <span class='fa fa-chevron-down'></span> </button>
                                                                            <div ng-show="sc_skill" class="ddlMultiple" ng-cloak>
                                                                                <div ng-click="ddlCheckAll('obj.SkillNameList','ScholasticList', $index);">Check All <span class="btn-counts-right">Total Count: {{obj.SkillNameList.length}}</span></div>
                                                                                <div ng-click="ddlUnCheckAll('obj.SkillNameList','ScholasticList', $index);">Uncheck All</div>
                                                                                <hr style="margin:0px !important" />
                                                                                <div ng-repeat="sk in obj.SkillNameList" ng-model="obj.SkillCode">
                                                                                    <input type="checkbox" ng-model="sk.chk"/> {{sk.SkillName}}
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td width="400">
                                                                <select id="ddlskillgroup" class="select2 form-control clear validate" ng-model="obj.SkillGroupCode" ng-init="LoadSkillGroup(obj)">
                                                                    <option value="">Select Group</option>
                                                                    <option ng-repeat="grp in obj.SkillGroupList" value="{{grp.GroupCode}}">{{grp.SkillGroupName}}</option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow()" ng-if="ScholasticList.length==1 || ScholasticList.length==obj.Srno" />
                                                                <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(obj.Srno)" ng-if="ScholasticList.length>1" />
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>                                        
                                        
                                        <div class="col-md-8 col-sm-6 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </div>
                                </div>
                                @Html.Partial("SearchAngularJs")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row -->
        </div>
    </div>
</div>
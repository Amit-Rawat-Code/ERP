
@{
    ViewBag.Title = "ScholasticSkillType";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/SkillTypeMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Skill Type Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Exam</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Skill Type Master</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="row">
                                        <div class="col-lg-6 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Skill Type Name</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtSkillTypeName", "", new { @class = "form-control clear validate", @ng_model = "SkillTypeName", placeholder = "Skill Type Name" })
                                            </div>
                                        </div>  
                                        <div class="col-lg-6 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Type<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.DropDownList("ddlType", new List<SelectListItem>{
                                                                 new SelectListItem{Text="Select", Value=""},
                                                                 new SelectListItem{Text="S", Value="S"},
                                                                 new SelectListItem{Text="C", Value="C"},
                                                                 new SelectListItem{Text="L", Value="L"}
                                                             },
                                                 new { @class = "select2 form-control validate", @ng_model = "SType"})
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8 col-sm-6 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </div>
                                </div>
                                @Html.Partial("SearchAngularJs")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row -->
        </div>
    </div>
</div>



@{
    ViewBag.Title = "Concession Fee Head Mapping";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/ConcessionFeeHeadMappingController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Concession Fee Head Mapping</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Fee</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Concession Fee Head Mapping</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Concession Head Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlConcessionHeadCode" class="select2 form-control validate" ng-model="ConcessionHeadCode" ng-init="GetConcessionHead();" ng-change="GetExistsConcessionHead(ConcessionHeadCode)">
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in ConcessionHeadList" value="{{x.Code}}">{{x.Name}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>S.No.</th>
                                                        <th>
                                                            Fee Head Name
                                                        </th>
                                                        <th>Discount (%)</th>
                                                        <th>Discount (Amt.)</th>
                                                        <th></th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="obj in ConcessionHeadMappingList">
                                                        <td ng-bind="obj.Srno=($index+1)"></td>
                                                        <td>
                                                            <select id="ddlFeeHead" class="select2 form-control clear" ng-model="ConcessionHeadMappingList[$index].FeeHeadCode" >
                                                                <option value="">Select </option>
                                                                <option ng-repeat="x in FeeHeadList" value="{{x.Code}}">{{x.FeeHeadName}}</option>
                                                            </select>
                                                        </td>
                                                        <td>  <input ng-model="ConcessionHeadMappingList[$index].DiscountPer" class="form-control clear" /></td>
                                                        <td>  <input ng-model="ConcessionHeadMappingList[$index].DiscountAmt" class="form-control clear" /></td>
                                                        <td>
                                                            <input class="btn btn-square btn-primary btn-xs" type="button" value="+" ng-click="AddRow()" ng-if="ConcessionHeadMappingList.length==1 || ConcessionHeadMappingList.length==obj.Srno" />
                                                            <input class="btn btn-square btn-secondary btn-xs" type="button" value="-" ng-click="RemoveRow(obj.Srno)" ng-if="ConcessionHeadMappingList.length>1" />
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>


                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>






@{
    ViewBag.Title = "Concession On Fee Structure";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/ConcessionOnFeeStructureController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Concession On Fee Structure</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Enquiry</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Concession On Fee Structure</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">class<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlClass")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Section<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSection")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Stream<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlStream")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Fee Structure Group<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlFeeStructureGroup" class="select2 form-control clear validate" ng-model="FeeStructureGroupCode" ng-init="GetFeeStructureGroup();"
                                                        ng-change="GetFeestructureWiseMonths();">
                                                    <option value="">Select </option>
                                                    <option ng-repeat="x in GetFeeStructureGroupList" value="{{x.Code}}">{{x.FeeStructureGroupName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Concession Head<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlConcessionhead")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Select Installment<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <div class="">
                                                    <div class="input-box">
                                                        <div class="checkbox checkbox-primary check-box" ng-init="GetInstallment()">
                                                            <input type="checkbox" ng-model="chkAllInstallment" ng-bind="chkAllInstallment=(selectedInstallmentCount==InstallmentList.length?true:false)" ng-change="AllInstallment();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched ng-untouched">
                                                            <label>Select All</label>
                                                        </div>
                                                        <div class="text-box-msg-r2" style="font-size: 10px;font-weight: 500;">
                                                            Total Selection: <label ng-model="selectedInstallmentCount" ng-bind="selectedInstallmentCount=(InstallmentList | filter:{'IsActive' : 'true'}).length" class="ng-pristine ng-untouched ng-valid ng-binding ng-not-empty">0</label>
                                                        </div>
                                                        <div class="input-box" style="width:100%; background:#484848; position:relative; float:left; color:#fff;">
                                                            <div class="checkbox checkbox-primary check-box-head">
                                                                Installments
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="" style="position:relative;">
                                                    <div class="slimScrollDiv-height3" id="slimScrollDiv-height2">
                                                        <table class="table compact table-hover table-striped table-bordered nowrap dataTable t-mgtb-n">
                                                            <tbody>
                                                                <!-- ngRepeat: XL in ClassList -->
                                                                <tr ng-repeat="XL in InstallmentList" class="ng-scope">
                                                                    <td class="ng-binding">{{XL.InstallmentName}}</td>
                                                                    <td class="srno">
                                                                        <div class="checkbox checkbox-primary check-box chech-box-mp-n">
                                                                            <input type="checkbox" ng-model="XL.IsActive" 
                                                                                   class="ng-pristine ng-untouched ng-valid ng-not-empty">
                                                                            <label for=""> </label>
                                                                        </div>
                                                                    </td>


                                                                </tr><!-- end ngRepeat: XL in ClassList -->


                                                            </tbody>
                                                        </table>
                                                    </div>

                                                </div>


                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>


                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>








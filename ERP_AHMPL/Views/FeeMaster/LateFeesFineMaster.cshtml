@{
    ViewBag.Title = "Late Fees Fine Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/LateFeesFineMasterController.js?Ver=@ViewBag.Version"></script>


<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Late Fees Fine Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Enquiry</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Late Fees Fine Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">From Day's<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtFromDays", "", new { @class = "form-control clear", @placeholder = "", @type = "Date", @ng_model = "FromDays" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">To Day's<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtToDays", "", new { @class = "form-control clear", @placeholder = "", @type = "Date", @ng_model = "ToDays" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 ">
                                                <label class="control-label">NO. Of Day Interval<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <select id="ddlNOOfDayInterval" class="select2 form-control clear validate" ng-model="NOOfDayInterval">
                                                        <option value="">Select---</option>
                                                        <option value="">Select---</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 ">
                                                <label class="control-label">Calculating Type<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <select id="ddlCalculatingType" class="select2 form-control clear validate" ng-model="CalculatingType">
                                                        <option value="">Select---</option>
                                                        <option value="">Select---</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Amount</label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtAmount", "", new { @class = "form-control clear validate ", @placeholder = "", @ng_model = "Amount" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>




                                            <div class="col-sm-12">
                                                
                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>From Day's</th>
                                                            <th>To Day's</th>
                                                            <th>No. Of Day Interval</th>
                                                            <th>Amt.Per</th>
                                                            <th>Calculating Type</th>
                                                            <th>Amount</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>1</td>
                                                            <td>7</td>
                                                            <td>7</td>
                                                            <td>Day</td>
                                                            <td>Fixed</td>
                                                            <td>50/-</td>
                                                        </tr>
                                                        <tr>
                                                            <td>1</td>
                                                            <td>7</td>
                                                            <td>7</td>
                                                            <td>Day</td>
                                                            <td>Fixed</td>
                                                            <td>50/-</td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2">
                                                                <label class="control-label">Value Type<span class="vd_red"></span></label>
                                                                <div class="input-box">
                                                                    <select id="ddlValueType" class="select2 form-control clear validate" ng-model="ValueType">
                                                                        <option value="">Select---</option>
                                                                        <option value="">Select---</option>
                                                                    </select>
                                                                    <div class="text-box-msg-r">
                                                                    </div>
                                                                </div>
                                                            </td>                                                           
                                                        </tr>
                                                    </tbody>
                                                </table>



                                            </div>
                                          













                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                @Html.Partial("ActionView")
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>











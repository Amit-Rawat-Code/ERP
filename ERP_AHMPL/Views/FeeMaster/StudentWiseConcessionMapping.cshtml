@{
    ViewBag.Title = "Student Wise Concession Mapping";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/StudentWiseConcessionMappingController.js?Ver=@ViewBag.Version"></script>
<style>
    .input-box.table-responsive.custom-drop-down-css {
        height: 385px;
    }
</style>
<style>
    .ddlMultiple:not(:-internal-list-box) {
        overflow: visible !important;
    }
</style>
<style>
    .multi-attachment-input-box-popup input[type="file"] {
        z-index: -1;
        position: absolute;
        opacity: 0;
    }

    .multi-attachment-input-box-popup .attachment-input-box-s .input-group-addon {
        height: 30px;
    }

    .multi-attachment-input-box-popup:hover {
        position: static;
        box-shadow: none;
    }
</style>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Student Wise Concession Mapping</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Fee</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Student Wise Concession Mapping</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 search-feild">
                                                <label class="control-label"><span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <div class="text-box-msg-r" style="left:0px !important">
                                                        @*<i class="fa fa-search" aria-hidden="true"></i>*@
                                                        <button class="Srch-btn" ng-click="GetStudents(1)" style="left:0px !important">Search</button>
                                                    </div>
                                                    @Html.TextBox("txtSearchBox", "", new { @class = "form-control", @placeholder = "Search Admission No./Student Name/Mob.No.", @ng_model = "SearchBox", ng_disabled = "IsSearchBoxDisabled" })


                                                    <label class="text text-danger shift-left-15" ng-click="Show=false"><i class="fa fa-times" aria-hidden="true"></i>Clear</label>


                                                    @*Table*@
                                                    <div ng-if="Show" class="searchbox" style="height:215px">
                                                        <table class="table compact table-hover table-striped table-bordered nowrap  dataTable">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th>SR.No.</th>
                                                                    <th>Concession</th>
                                                                    <th>Is Final</th>
                                                                    <th>Admission No.</th>
                                                                    <th>Class</th>
                                                                    <th>Student</th>
                                                                    <th>Father</th>
                                                                    <th>Contact</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="i in StudentList | filter:SearchBox" class="data-ctrl">
                                                                    <td class="text-align-right">
                                                                        <button class="btn btn-dark" ng-click="FillStudentDetail(i.StudentCode)" ng-disabled="disabledbtn">GET DETAIL</button>
                                                                    </td>
                                                                    <td>{{$index+1}}</td>
                                                                    <td>{{i.IsConcessionApplied}}</td>
                                                                    <td>{{i.IsFinalStudent}}</td>
                                                                    <td>{{i.AdmissionNo}}</td>
                                                                    <td>{{i.ClassName}}-{{i.SectionName}}</td>
                                                                    <td>{{i.Name}}</td>
                                                                    <td>{{i.FatherName}}</td>
                                                                    <td>{{i.Mobile}}</td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15 ">
                                                <label class="control-label">Class<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlClass")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Section<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlSection")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Student Name<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtStudentName", "", new { @class = "form-control clear validate", @placeholder = "", @type = "text", @ng_model = "StudentName", @ng_disabled = "true" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Admission No.<span class="vd_red">{{IsFinalStd=='true'?'*':''}}</span></label>
                                                <div class="input-box">

                                                    @Html.TextBox("txtAdmissionNo", "", new { @class = "form-control clear {{IsFinalStd=='true'?'validate':''}}", @placeholder = "", @type = "text", @ng_model = "AdmissionNo", @ng_disabled = "true" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Parent/Guardian Name<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtParentName", "", new { @class = "form-control clear validate", @placeholder = "", @type = "text", @ng_model = "ParentName", @ng_disabled = "true" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Contact<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtContact", "", new { @class = "form-control clear", @placeholder = "", @type = "text", @ng_model = "Contact" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Attachment <span class="vd_red" style="font-size: 10px;">Upload [.jpg|.jpeg|.bmp|.doc|.docx|.pdf]</span></label>
                                                <div class="input-box input-box-me max-h-114" ng-init="AddRow()" style="min-height: 0px">
                                                    <div class="multi-attachment-input-box-popup">

                                                        <div class="attachment-input-box-s ng-scope" ng-repeat="attachment in Attachments">
                                                            <div class="input-group-addon ng-scope" ng-show="attachment.FileName==undefined || attachment.FileName==''"><i class="icofont-upload-alt"></i></div>
                                                            <div class="input-group-addon ng-scope" ng-show="attachment.FileName.length>0">
                                                                <a href="" ng-href="{{attachment.FilePath}}" download><i class="icofont-download"></i></a>
                                                            </div>
                                                            <input type="file" ng-show="attachment.FileName==''" ng-click="SetIndex($index)" id=file{{$index}} upload-files multiple>
                                                            <label for=file{{$index}} ng-show="attachment.FileName.length>0" class="form-control input-padding" ng-model="attachment.FileName">
                                                                {{attachment.FileName}}
                                                            </label>
                                                            <label for=file{{$index}} ng-show="attachment.FileName==undefined || attachment.FileName==''" class="form-control input-padding" ng-model="attachment.FileName">
                                                                {{attachment.FileName==''?'Click here for upload file.':attachment.name}}
                                                            </label>
                                                            <div class="input-group-btn input-group-btn-d">
                                                                <input type="submit" class="btn-dec ng-scope" value="-" ng-click="RemoveRow($index)" ng-if="Attachments.length>0 &amp;&amp; Attachments.length!=1">
                                                                <input type="submit" class="btn-add ng-scope" value="+" ng-click="AddRow()" ng-if="$index==Attachments.length-1">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="text-box-msg-r">
                                                        <input type="hidden" id="pdfAttachment" autocomplete="off">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">&nbsp;&nbsp;&nbsp;</label>
                                                <div><input type="button" value="Upload" ng-model="Upload" ng-init="Upload='Upload'" class="btn-me btn-primary" ng-click="ImagesUpload();" style="float: left;" /></div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="false">
                                                <label class="control-label"><span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <input id="chk" type="checkbox" ng-model="chk" ng-change="ReviseNetDiscAmt()" />
                                                    <label for="chk">Apply Concession on Payble Amount</label>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label"><span class="vd_red"></span></label>
                                                <div class="input-box  table-responsive custom-drop-down-css">
                                                    <table class="table compact table-hover table-striped table-bordered nowrap dataTable t-mgtb-n">
                                                        <thead>
                                                            <tr>
                                                                <th>SR.No.</th>
                                                                <th>Installment</th>
                                                                <th>Due Status</th>
                                                                <th>Paid Status</th>
                                                                <th>Applied Concession Head</th>
                                                                <th>Apply Concession Head</th>
                                                                <th>Fee Amount</th>
                                                                <th>Concession Amount</th>
                                                                <th>Payble Amount</th>
                                                                <th>Paid Amount</th>
                                                                <th>Balance Amount</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <!-- ngRepeat: XL in ClassList -->
                                                            <tr ng-repeat="XL in InstallmentList" class="ng-scope">
                                                                <td class="srno" ng-model="XL.index" ng-init="XL.index=$index">
                                                                    {{$index+1}}
                                                                </td>
                                                                <td>{{XL.InstallmentName}}</td>
                                                                <td>{{XL.DueStatus}}</td>
                                                                <td>{{XL.PaidStatus}}</td>
                                                                <td ng-init="GetAppliedConcessionheadsWithInstallment(XL)">
                                                                    <div class="" ng-if="XL.PayableAmt>=0">
                                                                        <div class="input-box chk-validate">
                                                                            <div class="toggle-ddl" id="openConcessionHead"
                                                                                 ng-init="ToogleDDL('openConcessionHead','openConcessionHead')">
                                                                                @*btn-validate*@
                                                                                <button class='btn btn-primary select-btn'
                                                                                        data-ng-click='openConcessionHead=!openConcessionHead'
                                                                                        ng-bind="GetCount(XL.AppliedConcessionheadList,'Select Concession Head')">
                                                                                    Select Concession Head
                                                                                </button>
                                                                                @*btn-validate*@
                                                                                <button class='btn btn-primary dropdown-toggle select-btn-sub'
                                                                                        data-ng-click='openConcessionHead=!openConcessionHead'>
                                                                                    <span class='fa fa-chevron-down'></span>
                                                                                </button>
                                                                                <div ng-show="openConcessionHead" class="ddlMultiple" style="width: 250px;" ng-cloak>
                                                                                    <div ng-click="ddlCheckAll('AppliedConcessionheadList','','InstallmentList',$index)"
                                                                                         ng-if="XL.DueStatus=='No' || XL.PaidStatus=='No'">
                                                                                        Check All
                                                                                        <span class="btn-counts-right">Total Count: {{XL.AppliedConcessionheadList.length}}</span>
                                                                                    </div>
                                                                                    <div ng-click="ddlUnCheckAll('AppliedConcessionheadList','InstallmentList',$index)"
                                                                                         ng-if="XL.DueStatus=='No' || XL.PaidStatus=='No'">Uncheck All</div>
                                                                                    <hr style="margin:0px !important" ng-if="XL.DueStatus=='No' || XL.PaidStatus=='No'" />
                                                                                    <div ng-repeat="chl in XL.AppliedConcessionheadList">
                                                                                        <input type="hidden" ng-model="chl.Srno" ng-init="chl.Srno=($index+1)" />
                                                                                        {{chl.Srno}}
                                                                                        <input type="checkbox" ng-model="chl.chk" ng-value="chl.Code" ng-show="chl.IsActive"
                                                                                               ng-disabled="(XL.DueStatus=='Yes' && XL.PaidStatus=='Yes') || (chk==true &&
                                                                                               ((XL.AppliedConcessionheadList|filter:{Old:'Y',chk:true}).length!=($index+1) && chl.Old=='Y'))"
                                                                                               ng-change="ddlConcessionhead_Change(chl,XL,XL.index);" />
                                                                                        {{chl.ConcessionHeadName}}
                                                                                        @*   <br />{{chl.TransId}}*@<br /><br />
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td ng-init="GetConcessionheadsWithInstallment(XL)">
                                                                    <div class="" ng-if="XL.PayableAmt>=0">
                                                                        <div class="input-box chk-validate">
                                                                            <div class="toggle-ddl" id="openConcessionHead"
                                                                                 ng-init="ToogleDDL('openConcessionHead','openConcessionHead')">
                                                                                @*btn-validate*@
                                                                                <button class='btn btn-primary select-btn'
                                                                                        data-ng-click='openConcessionHead=!openConcessionHead'
                                                                                        ng-bind="GetCount(XL.ConcessionheadList,'Select Concession Head')">
                                                                                    Select Concession Head
                                                                                </button>
                                                                                @*btn-validate*@
                                                                                <button class='btn btn-primary dropdown-toggle select-btn-sub'
                                                                                        data-ng-click='openConcessionHead=!openConcessionHead'>
                                                                                    <span class='fa fa-chevron-down'></span>
                                                                                </button>
                                                                                <div ng-show="openConcessionHead" class="ddlMultiple" style="width: 250px;" ng-cloak>
                                                                                    <div ng-click="ddlCheckAll('ConcessionheadList','','InstallmentList',$index)" ng-if="XL.DueStatus=='No' || XL.PaidStatus=='No'">
                                                                                        Check All
                                                                                        <span class="btn-counts-right">Total Count: {{XL.ConcessionheadList.length}}</span>
                                                                                    </div>
                                                                                    <div ng-click="ddlUnCheckAll('ConcessionheadList','InstallmentList',$index)" ng-if="XL.DueStatus=='No' || XL.PaidStatus=='No'">Uncheck All</div>
                                                                                    <hr style="margin:0px !important" ng-if="XL.DueStatus=='No' || XL.PaidStatus=='No'" />
                                                                                    <div ng-repeat="chl in XL.ConcessionheadList">
                                                                                        <input type="hidden" ng-model="chl.Srno" ng-init="chl.Srno=($index+1)" />
                                                                                        <a href ng-model="chl.chk" ng-value="chl.Code"
                                                                                           ng-if="chl.IsActive" ng-click="ddlConcessionhead_Change1(chl,XL,XL.index);">
                                                                                            <i class="fa fa-long-arrow-left" aria-hidden="true"
                                                                                               ng-hide="XL.DueStatus=='Yes' && XL.PaidStatus=='Yes'"></i>
                                                                                            <i class="fa fa-ban" aria-hidden="true" style="color:red"
                                                                                               ng-show="XL.DueStatus=='Yes' && XL.PaidStatus=='Yes'"></i>
                                                                                        </a>
                                                                                        {{chl.ConcessionHeadName}}
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td>{{XL.PayableAmt}}</td>
                                                                <td>
                                                                    <style>
                                                                        .ds-style {
                                                                            color: blue !important;
                                                                            text-decoration: underline !important;
                                                                        }
                                                                    </style>
                                                                    <a href="#" data-toggle="modal" data-target="#DiscountStructure"
                                                                       ng-click="SetValues(XL);"
                                                                       class="ds-style">
                                                                        {{XL.DiscountAmt}}
                                                                    </a>
                                                                </td>
                                                                <td>{{XL.NetPayableAmt}}</td>
                                                                <td>{{XL.PaidAmt}}</td>
                                                                <td>{{XL.BalanceAmt}}</td>
                                                                <td>
                                                                    <i class="fa fa-unlock" aria-hidden="true" ng-if="(XL.DueStatus=='No' || XL.PaidStatus=='No') && XL.PayableAmt>=0" style="font-size: 25px;"></i>
                                                                    <i class="fa fa-lock" aria-hidden="true" ng-if="XL.DueStatus=='Yes' && XL.PaidStatus=='Yes'" style="font-size: 25px;"></i>
                                                                </td>


                                                            </tr><!-- end ngRepeat: XL in ClassList -->


                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1" style="">
                                                @Html.Partial("ActionSave")
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="DiscountStructure" role="dialog" style="width:100% !important">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Details</h4>
                <input type="hidden" ng-model="hfInstallmentCode" />
                <input type="hidden" ng-model="hfIndex" />
                <input type="hidden" ng-model="hfDueStatus" />
                <input type="hidden" ng-model="hfPaidStatus" />
            </div>
            <div class="modal-body">
                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Installment</th>
                            <th class="text-right">Amount (Rs.)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="obj in ConcessionCalculationList">
                            <td ng-model="obj.Srno" ng-init="obj.Srno=($index+1)">{{obj.Srno}}</td>
                            <td>{{obj.Installment}}</td>
                            <td class="text-right">{{obj.InstallmentAmount}}</td>
                            <td>
                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>S.No.</th>
                                            <th>Due Date</th>
                                            <th>Concession Head</th>
                                            <th>Concession Category</th>
                                            <th>Amount (Rs.)</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="obj1 in obj.ConcessionList">
                                            <td ng-model="obj1.Srno">{{obj1.Srno}}</td>
                                            <td>
                                                <input type="date" ng-model="obj1.PostingDate" ng-init="obj1.PostingDate=ConverDate(obj1.PostingDate)"
                                                       class="form-control" min="{{obj1.Mindate}}" max="{{obj1.Maxdate}}" />
                                            </td>
                                            <td>{{obj1.ConcessionName}}</td>
                                            <td>
                                                <select id="ddlConcessionCategory" class="select2 form-control validate" ng-model="obj1.ConcessionCategoryId" ng-change="CheckConcessionCategory(obj1);">
                                                    <option value="">Select Gender</option>
                                                    <option ng-repeat="ccl in ConcessionCategoryList" value="{{ccl.Id}}">{{ccl.Name}}</option>
                                                </select>
                                                @*@Html.DropDownList("ddlConcessionCategory", new List<SelectListItem>{
        new SelectListItem{Text="Select", Value=""},
        new SelectListItem{Text="Girl Child Disc.", Value="1"},
        new SelectListItem{Text="Sibling Disc.", Value="2"},
        new SelectListItem{Text="Teacher Ward Disc.", Value="3"}
        },
        new { @class = "select2 form-control validate", @ng_model = "obj1.ConcessionCategoryId" })*@<SelectListItem>
                                            </td>
                                            <td class="text-right">{{obj1.TotalAmount}}</td>
                                            <td>
                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Fee Head</th>
                                                            <th>
                                                                Discount Per (%)
                                                            </th>
                                                            <th class="text-right">

                                                                Discount Amt (Rs.)
                                                            </th>
                                                            <th class="text-right" ng-hide="true">Adjustment Amt (Rs.)</th>
                                                            <th class="text-right">Net Disc. Amt (Rs.)</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="obj2 in obj1.FeeHeadList">
                                                            <td ng-model="obj2.Srno" ng-init="obj2.Srno=($index+1)">{{obj2.Srno}}</td>
                                                            <td>{{obj2.FeeHeadName}}</td>
                                                            @*<td>
                            <input type="date" ng-model="obj2.DueDate" class="form-control" />
                        </td>*@
                                                            <td>
                                                                <input type="checkbox" ng-model="obj2.ChkPer"
                                                                       ng-click="obj2.ChkDsc=obj2.ChkPer?false:obj2.ChkDsc" ng-disabled="obj2.IsFromSCFSD" style="display: inline-block; margin-right: 5px;" />
                                                                <input type="text" class="form-control" ng-model="obj2.DiscountPer"
                                                                       ng-change="CalucateAmount(obj1,obj2)" ng-disabled="obj2.IsFromSCFSD || obj2.ChkPer==false" ng-init="InitPer(obj2,obj1.TotalAmount)" style=" display: inline-block; width: 75px;" />
                                                            </td>
                                                            <td>
                                                                <input type="checkbox" ng-model="obj2.ChkDsc"
                                                                       ng-click="obj2.ChkPer=obj2.ChkDsc?false:obj2.ChkPer" ng-disabled="obj2.IsFromSCFSD" style="display: inline-block; margin-right: 5px;" />
                                                                <input type="text" class="form-control text-right" ng-model="obj2.DiscountAmount"
                                                                       ng-change="CalculateNetDiscAmt(obj2,obj1.TotalAmount)"
                                                                       ng-disabled="obj2.IsFromSCFSD || obj2.ChkDsc==false"
                                                                       allow-only-numbers style=" display: inline-block; width: 75px;" />
                                                            </td>
                                                            <td class="text-right" ng-hide="true">
                                                                {{obj2.AdjustmentAmount}}
                                                            </td>
                                                            <td class="text-right" ng-model="obj2.NetDiscAmt" ng-init="obj2.NetDiscAmt=obj2.DiscountAmount+obj2.AdjustmentAmount">
                                                                {{obj2.NetDiscAmt}}
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>

<style>
    .fee-deposit-box-profile .profile-header {
        padding: 10px;
        position: relative;
        height: 71px;
        box-shadow: 0px 5px 12px 0px #a7a7a7, 0px 0px 0px 0px rgb(141 142 143);
    }

        .fee-deposit-box-profile .profile-header .profile-pic {
            margin: 0 auto;
            float: none;
            position: absolute;
        }

    .fee-deposit-box-profile .profile-header {
        padding: 10px;
        background: url(../Content/img/fee-deposit-profile.png);
        background-position: center center;
    }

    .fee-deposit-box-profile .profile-data {
        background: #f2ece0;
        padding-top: 60px;
    }

    .fee-deposit-box-profile .profile-header .profile-pic {
        box-shadow: 0px 5px 12px 0px #999a9b, 0px 0px 0px 0px rgb(139 140 141);
        border: 5px solid #ffffff;
    }

    .profile-box-fee-deposit span.icon i {
        color: #484848;
    }

    lable.feild-title {
        position: absolute;
        left: 35px;
        top: 0px;
        font-weight: 500;
        color: #ffffff;
        font-size: 12px;
        height: 29px;
        line-height: 30px;
        padding-left: 15px;
        width: 114px;
        border-radius: 0px 20px 20px 0px;
        background-position: center center;
        background: #484848;
    }
    .input-icons {
        color: #01090c;
        font-size: 15px;
        line-height: 35px;
        position: absolute;
        top: 1px;
        background: #d6d6d6;
        text-align: center;
        width: 31px;
        left: unset !important;
        right: 1px;
        height: 28px;
        border-left: 1px solid #484848;
    }
</style>

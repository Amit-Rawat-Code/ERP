                                            <h3 style="text-decoration: underline;">Please Select Students to Delete Posted Due Voucher:</h3>
                                            <div id="divExample2" class="table-scroll">
                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Class</th>
                                                            <th>Admission No.</th>
                                                            <th>Student Name</th>
                                                            <th>Father Name</th>
                                                            <th class="text-right">Dr</th>
                                                            <th class="text-right">Cr</th>
                                                            <th></th>
                                                            <th><input type="checkbox" ng-model="ChkAll" ng-init="ChkAll=false" ng-change="CheckUnCheckAll(ChkAll)" /></th>

                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="sl in PostedStudentsList">
                                                            <td>{{$index+1}}.</td>
                                                            <td>{{sl.ClassName}}</td>
                                                            <td>{{sl.AdmissionNo}}</td>
                                                            <td>{{sl.StudentName}}</td>
                                                            <td>{{sl.FatherName}}</td>
                                                            <td class="text-right">{{sl.TotalDrAmt}}</td>
                                                            <td class="text-right">{{sl.TotalCrAmt}}</td>
                                                            <td><a href="#" data-toggle="modal" data-target="#StudentDueLedgerModal" ng-click="GetStudentDueLedger(sl.StudentCode)">View</a></td>
                                                            <td><input type="checkbox" ng-model="sl.Chk" ng-init="sl.Chk=false" ng-change="CheckUnCheck()" /></td>
                                                        </tr>
                                                        <tr ng-if="PostedStudentsList.length==0">
                                                            <td colspan="9" class="text-center">
                                                                No Record(s) found.
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td class="text-right" style="font-weight:bold !important">Total</td>
                                                            <td class="text-right" style="font-weight:bold !important"> {{Sumoflist('PostedStudentsList','TotalDrAmt')}}</td>
                                                            <td class="text-right" style="font-weight:bold !important">{{Sumoflist('PostedStudentsList','TotalCrAmt')}}</td>
                                                            <td></td>
                                                            <td></td>
                                                        </tr>
                                                    </tfoot>

                                                </table>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionSave")
                                            @*<a href="#" class="btn-me btn-primary hvr-float-shadow pull-right" data-toggle="modal" data-target="#myModal"
            ng-click="GetNotStudentsPostedList();">Click Here to check not posted list</a>*@
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @*@Html.Partial("SearchAngularJs")*@
                          
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>


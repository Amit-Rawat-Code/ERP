<div class="modal fade" id="StudentDueLedgerModal" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Student's Due Ledger</h4>
            </div>
            <div class="modal-body">
                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Particulars</th>
                            <th class="text-right">Dr</th>
                            <th class="text-right">Cr</th>
                    </thead>
                    <tbody>
                        <tr ng-repeat="sl in StudentDueLedger">
                            <td>{{$index+1}}.</td>
                            <td>{{sl.Particulars}}</td>
                            <td class="text-right">{{sl.DrAmt}}</td>
                            <td class="text-right">{{sl.CrAmt}}</td>
                        </tr>
                        <tr ng-if="StudentDueLedger.length==0">
                            <td colspan="4" class="text-center">
                                No Record(s) found.
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td></td>
                            <td class="text-center">Total</td>
                            <td class="text-right"> {{Sumoflist('StudentDueLedger','DrAmt')}}</td>
                            <td class="text-right">{{Sumoflist('StudentDueLedger','CrAmt')}}</td>
                        </tr>
                    </tfoot>

                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    $('#ddlActiveParital').removeClass('validate');
</script>





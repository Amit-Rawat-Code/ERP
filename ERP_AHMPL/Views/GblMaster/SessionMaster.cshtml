@{
    ViewBag.Title = "Session Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/SessionMasterController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">

    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Session Master</h5>
        </div>
        <!-- Breadcrumb -->
          <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Session Master</span></li>
            </ol>
        </div>
      
    </div>

    <div class="br-pagebody ">

        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Session Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtSessionText", "", new { @class = "form-control clear validate", @placeholder = "",  @tabindex = "1", @ng_model = "SessionText" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label" >From Date<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input id="txtFromDate" type="date" class="form-control clear validate" placeholder="" ng-model="SessionStartDate"/>

                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">To Date<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input id="txtToDate" type="date" class="form-control clear validate" placeholder="" ng-model="SessionEndDate" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Admission Active For this Session<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.DropDownList("ddlAdmActiveSession", new List<SelectListItem>
                                                {
                                                new SelectListItem{Text="Select", Value=""},
                                                new SelectListItem{Text="Yes", Value="true"},
                                                new SelectListItem{Text="No", Value="false"}
                                                },
                                                new { @class = "select2 form-control validate", @ng_model = "IsAdmActiveSession", @ng_init="IsAdmActiveSession='false'" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")


                                        </div>
                                    </form>
                                </div>
                            </div>

                            @Html.Partial("SearchAngularJs")

                          

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

    </div>

   
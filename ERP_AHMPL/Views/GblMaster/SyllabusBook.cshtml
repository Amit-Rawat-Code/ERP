
@{
    ViewBag.Title = "Syllabus Book";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="@Url.Content("~/Scripts/jspdf.min.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/html2canvas.js")"></script>
<script src="~/Scripts/myjslib/SubjectSubTopicController.js?Ver=@ViewBag.Version"></script>





<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Syllabus Book</h5>
        </div>
        <!-- Breadcrumb -->
          <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Master</span></li>
                <li class="active"><span>Syllabus Book</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Class<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlClass")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Branch<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlBranchChange")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Subject<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSubjectClassBranchWise")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2 col-sm-3 col-xs-6 mgbt-xs-15">
                                            <input id="btnsyllabus" type="button" value="Show Syllabus" class="button2" name="btnsyllabus">
                                        </div>
                                        <div class="col-md-2 col-sm-3 col-xs-6 mgbt-xs-15">
                                            <select id="ddlExport" class="select2 form-control" ng-model="ExportMode" ng-change="Export()">
                                                <option value="">Select Export Mode</option>
                                                <option value="P">Print</option>
                                                <option value="F">PDF</option>
                                            </select>
                                        </div>



                                        <div  class="col-md-12 col-sm-12 col-xs-12" 
                                             ng-init="GetReportHeaderUsingCategory('Syllabus Report')">
                                            <div id="sylsbookdiv" ng-model="SBhData" ng-repeat="header in SBHD">
                                                <div id="ReportHeader" ng-model="ReportHeader" ng-bind-html="ReportHeader"></div>
                                              
                                                <table class="table p-table">
                                                    <tr>
                                                        <td class="no-b">
                                                            <div class="syllabus-box">
                                                                <span>Syllabus of {{header.ClassBranch}}</span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </table>
                                                <table class="table table-syllabus p-table-0 mgbt-xs-0" ng-model="sylsbook">
                                                    <tr ng-repeat="syls in Syllabus">
                                                        <td class="{{syls.Class}}">
                                                            <span> {{syls.Content}}</span>
                                                        </td>
                                                    </tr>
                                                </table>

                                            </div>
                                        </div>

                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>
<script>
    $('#ddlSubjectClassBranchWise').removeClass('validate');
</script>


@{
    ViewBag.Title = "TableDependency";
    ViewBag.TitleList = "Sort By Column";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

 <input type="hidden"   id="hdntbldependency" ng_model="Id" />
<script src="~/Scripts/myjslib/TableDependency.js"></script>
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Table Dependency</h5>
        </div>
        <!-- Breadcrumb -->
          <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>System Define</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Table Dependency</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Base Table<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlBaseTable" class="form-control clear validate" ng-change="LoadBaseFiled()" ng-model="BaseTable" ng-init="LoadBaseTable();">
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in RecordBaseTable" value="{{x.BaseTable}}">{{x.BaseTable}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Base Field<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlBaseField" class="form-control clear validate" ng-change="LoadRefernceTable()"  ng-model="BaseField"  >
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in RecordBaseField" value="{{x.ColumnName}}">{{x.ColumnName}}  {{x.DataType}}({{x.MaxLenth}})</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Reference Table<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlBaseField" class="form-control clear validate" ng-model="ReferenceTable" ng-change="LoadReferenceField()"   >
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in RecordReferenceTable" value="{{x.ReferenceTable}}">{{x.ReferenceTable}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Reference Field<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlBaseField" class="form-control clear validate" ng-model="ReferenceField"  >
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in RecordReferenceField" value="{{x.ColumnName}}">{{x.ColumnName}}  {{x.DataType}}({{x.MaxLenth}})</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" id="dveventdate">
                                            <label class="control-label">Reference Message<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtmsg", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "ReferenceMessage" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" id="dveventdate">
                                            <label class="control-label">Event Type<span class="vd_red">*</span></label>
                                            <div class="input-box">  
                                                <div class="checkbox checkbox-primary check-box">
                                                    <input type="checkbox" ng-model="IsSave" ng-checked="IsSave">
                                                    <label> Save</label>
                                                </div>
                                                <div class="checkbox checkbox-primary check-box">
                                                    <input type="checkbox" id="chkEdit" ng-model="IsEdit" ng-checked="IsEdit">
                                                    <label>Edit</label>
                                                </div>
                                                <div class="checkbox checkbox-primary check-box">
                                                    <input type="checkbox" id="chkDelete" ng-model="IsDelete" ng-checked="IsDelete">
                                                    <label> Delete  </label>
                                                </div>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>   
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>

                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>
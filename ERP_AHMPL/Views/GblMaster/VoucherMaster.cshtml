
@{
    ViewBag.Title = "VoucherMaster";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<div id="hdngetstu"></div>
<script src="~/Scripts/myjslib/VoucherMasterController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<input type="hidden" id="hdnVoucherId" />

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Voucher Master</h5>
        </div>
        <!-- Breadcrumb -->
          <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>System Define</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Voucher Master</span></li>
            </ol>
        </div>
    </div>

    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Category<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlcat" class="form-control clear validate" ng-change="VouchMaster()" ng-model="SeVouchMaster">
                                                    <option value="">Select Category</option>
                                                    <option value="NBADM">For Notice</option>
                                                    <option value="CRADM">For Circular</option>
                                                    <option value="HWADM">For HomeWork</option>
                                                    <option value="PAADM">For Photo Gallery</option>
                                                    <option value="PGADM">For Photo Uploading</option>
                                                    <option value="VAADM">For VIDEO Gallery</option>
                                                    <option value="VUADM">For VIDEO Uploading</option>
                                                    <option value="DAADM">For Diary</option>
                                                    <option value="VISCA">For Visitor</option>
                                                    <option value="EMPAT">For Employee Attendance</option>
                                                    <option value="STDAT">For Student Attendance</option>
                                                    <option value="FRCST">Fee Receipt Cancelation</option>
                                                    <option value="OTHADM">Other Vocuher Master</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Voucher Type<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtVoucherCode", "", new { @class = "form-control clear validate", MaxLength = "5", @placeholder = "", @ng_model= "VoucherType", @ng_disabled = "!enableMe" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Description<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtDescription", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "Description" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Category<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                               @Html.Partial("ddlVoucherCategory")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Nature<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlNature" class="form-control clear validate" ng-model="NatureCode">
                                                    <option value="">Select</option>
                                                    <option value="1">Both</option>
                                                    <option value="2">Session</option>
                                                    <option value="3">FYID</option>

                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Start Number<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtStartNumber", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "StartNumber" })
                                                <div class="text-box-msg-r">
                                                    <span id="errmsg"></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Number System<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlNumberSystem" class="form-control clear validate" ng-model="NumberSystem">
                                                    <option value="">Select</option>
                                                    <option value="Formatted">Formatted</option>
                                                    <option value="Manual">Manual</option>

                                                </select> 
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">To Date<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("txtToDate")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">From Date<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                               @Html.Partial("txtFromDate")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>


@{
    ViewBag.Title = "Employee Leave Status Report";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/scripts/myjslib/EmployeeLeaveStatusReportController.js?Ver=@ViewBag.Version"></script>
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">@ViewBag.Title</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>HR</span></li>
                <li><span>Report</span></li>
                <li class="active"><span>@ViewBag.Title</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">

                                    <div class="section-toggle">
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Employee</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlEmployee")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Department</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlDepartment")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Designation</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlDesignation")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 btn3-nM3-3 mgbt-xs-15">
                                            @Html.Partial("ActionSearch")
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding report-box" id="TabAddHeight" TabAddHeight="41">
                                    <div class="arrow-container animated fadeInDown filter-toggle " ng-click="FilterToggle()">
                                        <div class="arrow-2">
                                            <i class="fa fa-angle-down"></i>
                                        </div>
                                        <div class="arrow-1 animated hinge infinite zoomIn"></div>
                                    </div>
                                    <div>
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                            <div class="collapse" id="CollapseSearchTableList">
                                                <div class="table-heading-box">
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                                        @Html.Partial("_printingTool1")
                                                    </div>
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="overflow-x:auto;">
                                                        <div class="{{DocSize}} {{DocOrientation}}">
                                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding" id="ExportDiv">

                                                                <div id="SetPageMargin">
                                                                    <div class="me-col-12" ng-init="GetReportHeaderUsingCategory('General Report')">
                                                                        <div id="ReportHeader" ng-bind-html="ReportHeader" ng-hide="true"></div>
                                                                        <div id="UpdatePanel">
                                                                            <div class="me-col-12 dt-print-view" ng-show="LeaveStatus.length>0">
                                                                                <h1>@ViewBag.Title</h1>

                                                                                <table id="example2" class="table table-striped table-bordered compact text-center" style="width:100%">
                                                                                    <thead>
                                                                                        <tr>
                                                                                            <th rowspan="2">S.No.</th>
                                                                                            <th rowspan="2">Employee</th>
                                                                                            <th rowspan="2">EployeeId</th>
                                                                                            <th rowspan="2">Father</th>
                                                                                            <th rowspan="2">Department</th>
                                                                                            <th rowspan="2">Designation</th>
                                                                                            <th rowspan="2">DOJ</th>
                                                                                            <th colspan="4" rowspan="1" class="text-center">~~~~Allocate Leaves~~~~</th>
                                                                                            <th colspan="4" rowspan="1" class="text-center">~~~~Consumed Leave~~~~</th>
                                                                                            <th colspan="4" rowspan="1" class="text-center">~~~~Balance Leave~~~~</th>
                                                                                            <th colspan="1" rowspan="2" class="text-center">Balance Leaves</th>
                                                                                            <th colspan="1" rowspan="2" class="text-center">Absent</th>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <th> Allocate EL</th>
                                                                                            <th> Allocate CL</th>
                                                                                            <th> Allocate ML</th>
                                                                                            <th> Allocate SIL</th>
                                                                                            <th> Consumed EL</th>
                                                                                            <th> Consumed CL</th>
                                                                                            <th> Consumed ML</th>
                                                                                            <th> Consumed SIL</th>
                                                                                            <th> Balance EL</th>
                                                                                            <th> Balance CL</th>
                                                                                            <th> Balance ML</th>
                                                                                            <th> Balance SIL</th>
                                                                                        </tr>

                                                                                    </thead>
                                                                                    <tbody>
                                                                                        <tr ng-repeat="ls in LeaveStatus">
                                                                                            <td ng-bind="ls.Srno=($index+1)"></td>
                                                                                            <td>{{ls.EmployeeName}}</td>
                                                                                            <td>{{ls.EmplId}}</td>
                                                                                            <td>{{ls.FatherName}}</td>
                                                                                            <td>{{ls.DepartmentName}}</td>
                                                                                            <td>{{ls.DesignationName}}</td>
                                                                                            <td>{{ls.DOJ}}</td>
                                                                                            <td>{{ls.TL_EL}}</td>
                                                                                            <td>{{ls.TL_CL}}</td>
                                                                                            <td>{{ls.TL_ML}}</td>
                                                                                            <td>{{ls.TL_SIL}}</td>
                                                                                            <td>{{ls.AL_EL}}</td>
                                                                                            <td>{{ls.AL_CL}}</td>
                                                                                            <td>{{ls.AL_ML}}</td>
                                                                                            <td>{{ls.AL_SIL}}</td>
                                                                                            <td>{{ls.BL_EL}}</td>
                                                                                            <td>{{ls.BL_CL}}</td>
                                                                                            <td>{{ls.BL_ML}}</td>
                                                                                            <td>{{ls.BL_SIL}}</td>
                                                                                            <td>{{ls.BalanceLeave}}</td>
                                                                                            <td>{{ls.Absent}}</td>

                                                                                        </tr>
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @*<div>
                @Html.Partial("GeneralReportGrid")
            </div>*@

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>
<script>
    $('#ddlEmployee').removeClass('validate');
    $('#ddlDepartment').removeClass('validate');
    $('#ddlDesignation').removeClass('validate');
</script>
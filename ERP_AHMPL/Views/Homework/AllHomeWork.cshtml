                                                        <div class="tx-list2">
                                                            {{x.TopicName}} - [{{x.SubjectName}}]
                                                        </div>
                                                        <div class="tx-list2-date-w-attach-file">
                                                            <div class="date-format">{{x.SubmissionDate}}</div>


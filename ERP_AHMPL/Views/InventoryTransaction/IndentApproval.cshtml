
@{
    ViewBag.Title = "Indent Approval";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];

}

<style>
    legend {
        -webkit-box-sizing: border-box;
        box-sizing: border-box;
        color: inherit;
        display: table;
        max-width: initial;
        padding: 0;
        white-space: normal;
        width: auto;
        padding: 0 10px !important;
    }
    .input-z-in{
        width: 100% !important;
        font-size: 12px;
        text-transform: capitalize;
        position: absolute;
        z-index: 99;
        overflow: auto;
        height: 170px;
    }
</style>

<script src="~/scripts/myjslib/InventoryIndentApprovalController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset">

                                                                <td>
                                                                    <label id="lblIndentNo" ng-bind="IndentDetList[$index].IndentNo"></label>
                                                                </td>
                                                                <td>
                                                                    <label id="lblIndentDate" ng-bind="IndentDetList[$index].IndentDate"></label>
                                                                </td>

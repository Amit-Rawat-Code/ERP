                                                                         <select id="ddlSupplierCode" class="select2 form-control" ng-model="IndentApprovalDetList[$index].SupplierCode" ng-init="BindSupplier();">
                                                                             <option value="">Select</option>
                                                                             <option ng-repeat="x in SupplierList" value="{{x.SupplierCode}}">{{x.Name}}</option>
                                                                         </select>


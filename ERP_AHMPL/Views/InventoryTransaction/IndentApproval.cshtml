                                <label id="lblColorName" ng-bind="IndentDetList[$index].ColorName"></label>
                            </td>
                            <td ng-if="ModelCodeIsAllowed=='1'">
                                <label id="lblModelName" ng-bind="IndentDetList[$index].ModelName"></label>
                            </td>

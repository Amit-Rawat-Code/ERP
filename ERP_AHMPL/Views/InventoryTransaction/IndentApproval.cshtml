                                                                         <label id="lblStockQtyA" ng-bind="IndentApprovalDetList[$index].StockQty"></label>
                                                                     </td>
                                                                     @*<td>
                                                                            <label id="lblOnOrderQtyA" ng-bind="IndentApprovalDetList[$index].OnOrderQty"></label>
                                                                        </td>*@
                                                                     <td>
                                                                         <label id="lblIndentQtyA" ng-bind="IndentApprovalDetList[$index].IndentQty"></label>
                                                                     </td>
                                                                     <td>
                                                                         <input type="text" class="form-control clear" id="IndentApprovalDetList{{$index}}" ng-model="IndentApprovalDetList[$index].ApproveQty" ng-blur="IsMaxValidate(IndentApprovalDetList[$index].IndentQty,IndentApprovalDetList[$index].ApproveQty,$index)" validate-number-and-decimal-only two-decimal-place />
                                                                     </td>

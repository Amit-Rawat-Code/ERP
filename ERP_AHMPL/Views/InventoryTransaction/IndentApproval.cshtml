                        <select name="ddlPOReq" ng-model="IndentApprovalDetList[$index].POReq" class="form-control">
                            <option value="">Select</option>
                            <option value="Y">Yes</option>
                            <option value="N">No</option>
                        </select>
                    </td>*@

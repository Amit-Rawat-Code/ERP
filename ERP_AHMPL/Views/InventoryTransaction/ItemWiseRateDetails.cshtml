
@{
    ViewBag.Title = "Item Wise Rate Details";
    ViewBag.TitleList = "Sort By Column";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/scripts/myjslib/InventoryItemWiseRateDetailsController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">@ViewBag.Title</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><a href="#"><span>Inventory</span></a></li>
                <li><a href="#"><span>Transaction</span></a></li>
                <li class="active"><span>@ViewBag.Title</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Date<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFromDate", "", new { @class = "form-control validate", @type = "date", @ng_model = "IWR_Date" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Item Category<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlItemCategory" class="select2 form-control validate" ng-model="ItemCategoryCode" ng-init="BindItemCategory();"
                                                        ng-change="BindItemName(ItemCategoryCode);">
                                                    <option value="">Select Category</option>
                                                    <option ng-repeat="itemcategory in ItemCategoryList" value="{{itemcategory.Code}}">{{itemcategory.Name}}</option>
                                                </select>

                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Item Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlItemCategory" class="select2 form-control validate" ng-model="ItemNameCode" ng-init="BindItemName();">
                                                    <option value="">Select Name</option>
                                                    <option ng-repeat="itemname in ItemNameList | filter:{'ItemCategoryCode':ItemCategoryCode}" value="{{itemname.Code}}">{{itemname.ItemName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Specification / Model<span class="vd_red">*</span></label>

                                            <select id="ddlItemCategory" class="select2 form-control validate" ng-model="ModelCode" ng-init="BindItemModel();">
                                                <option value="">Select Model</option>
                                                <option ng-repeat="model in ModelNameList" value="{{model.Code}}">{{model.ModelName}}</option>
                                            </select>
                                            <div class="text-box-msg-r">
                                            </div>

                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Preferred Vender<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPreferredVender", "", new { @class = "form-control clear validate", @placeholder = "Preferred Vender", @ng_model = "PreferredVender" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Vender Address</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtVenderAddress", "", new { @class = "form-control clear", @placeholder = "Vender Address", @ng_model = "VenderAddress" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">State<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlState" class="select2 form-control validate" ng-model="StateCode"
                                                        ng-change="BindCity(StateCode)" ng-init="BindState()">
                                                    <option value="">Select State</option>
                                                    <option ng-repeat="x in Statelist" value="{{x.Code}}">{{x.StateName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">City<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlCity")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Pincode</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPincode", "", new { @class = "form-control clear numbersOnly", @placeholder = "Pincode", @ng_model = "Pincode", @maxlength = "6", @allow_only_numbers = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Mobile No.</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtMobileNo", "", new { @class = "form-control clear numbersOnly ", @placeholder = "Mobile No", @ng_model = "MobileNo", @maxlength = "10", @allow_only_numbers = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Email Id</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtEmailId", "", new { @class = "form-control clear ", @placeholder = "Email Id", @ng_model = "EmailId", @ng_Click = "ValidateEmail(txtEmailId)" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Payment Terms</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPaymentTerms", "", new { @class = "form-control clear ", @placeholder = "Payment Terms", @ng_model = "PaymentTerms" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Basic Price<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtUnitPrice", "", new { @class = "form-control clear validate", @placeholder = "Basic Price", @ng_model = "UnitPrice" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">GST% <span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtGstRate", "", new { @class = "form-control clear validate", @placeholder = "GST %", @ng_model = "GstRate", @ng_change= "CalculateTotalAmount(UnitPrice,GstRate)" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Total Amount <span>(Including GST)</span><span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtTotalAmount", "", new { @class = "form-control clear validate", @placeholder = "Total Amount", @ng_model = "TotalAmount", @ng_disable=true})
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Remark</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtRemark", "", new { @class = "form-control clear", @placeholder = "Remark", @ng_model = "Remark" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

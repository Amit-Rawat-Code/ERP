
@{
    ViewBag.Title = "LeaveApprovalByLevel";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/Scripts/myjslib/LeaveApprovalByLevelController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" id="hfId" name="Id" value="" />
<input type="hidden" id="hfVoucherNo" name="VoucherNo" value="" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Leave Approval Level Wise</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Leave Approval</span></li>
                <li><span>Employee</span></li>
                <li class="active"><span>Leave Approval By Level</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Applicable Date<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input type="date" ng-model="ApplicableDate" id="ApplicableDate" class="form-control" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        @*<div class="clearfix"></div>*@
                                        <div class="col-md-4 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Search Employee<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlEmployee")
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <div class="datatable-responsive table-responsive advance-btn-table">
                                                <table id="tblUserDetails" class="table compact table-hover table-striped table-bordered nowrap ng-scope" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>EMP Name</th>
                                                            <th>Designation</th>
                                                            <th>Department</th>
                                                            <th>Joining Date</th>
                                                            <th>Date Of Birth</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="Detail in EmpDetails">

                                                            <td class="ng-binding">{{Detail.FirstName}} {{Detail.MiddleName}} {{Detail.LastName}}</td>
                                                            <td class="ng-binding">{{Detail.Designation}}</td>
                                                            <td class="ng-binding">{{Detail.Department}}</td>
                                                            <td class="ng-binding">{{Detail.JoiningDate}}</td>
                                                            <td class="ng-binding">{{Detail.DateofBirth}} </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Type of Approval Reg.<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlTypeOfApproval")
                                            </div>
                                        </div>
                                        @*<div class="clearfix"></div>*@
                                        <div class="col-md-4 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="TypeOfApproval=='Single'||TypeOfApproval=='Double' ">
                                            <label class="control-label">First Approval Authority<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlFirstApprovalAuthority")
                                            </div>
                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="TypeOfApproval=='Single'||TypeOfApproval=='Double'">
                                            <div class="datatable-responsive table-responsive advance-btn-table">
                                                <table id="tblUserDetails" class="table compact table-hover table-striped table-bordered nowrap ng-scope" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>EMP Name</th>
                                                            <th>Designation</th>
                                                            <th>Department</th>
                                                            <th>Joining Date</th>
                                                            <th>Date Of Birth</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="Detail in FirstAuthDetail">

                                                            <td class="ng-binding">{{Detail.FirstName}} {{Detail.MiddleName}} {{Detail.LastName}}</td>
                                                            <td class="ng-binding">{{Detail.Designation}}</td>
                                                            <td class="ng-binding">{{Detail.Department}}</td>
                                                            <td class="ng-binding">{{Detail.JoiningDate}}</td>
                                                            <td class="ng-binding">{{Detail.DateofBirth}} </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>



                                        <div class="col-md-4 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="TypeOfApproval=='Double'">
                                            <label class="control-label">Second Approval Authority<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSecondApprovalAuthority")
                                            </div>
                                        </div>


                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="TypeOfApproval=='Double'">
                                            <div class="datatable-responsive table-responsive advance-btn-table">
                                                <table id="tblUserDetails" class="table compact table-hover table-striped table-bordered nowrap ng-scope" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>EMP Name</th>
                                                            <th>Designation</th>
                                                            <th>Department</th>
                                                            <th>Joining Date</th>
                                                            <th>Date Of Birth</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="Detail in SeconedAuthDetail">

                                                            <td class="ng-binding">{{Detail.FirstName}} {{Detail.MiddleName}} {{Detail.LastName}}</td>
                                                            <td class="ng-binding">{{Detail.Designation}}</td>
                                                            <td class="ng-binding">{{Detail.Department}}</td>
                                                            <td class="ng-binding">{{Detail.JoiningDate}}</td>
                                                            <td class="ng-binding">{{Detail.DateofBirth}} </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>



                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                            @*@Html.Partial("Search")*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>

<script>
    $('#txtAttendanceDate').attr('max', moment(new Date()).format('YYYY-MM-DD'))
    $('#ddlDepartment').removeClass('validate');
</script>
<script src='https://boomtownroi.github.io/boomstrap/js/boomstrap.min.js'></script>
<script src='https://boomtownroi.github.io/boomstrap/js/boomstrap-angular.min.js'></script>


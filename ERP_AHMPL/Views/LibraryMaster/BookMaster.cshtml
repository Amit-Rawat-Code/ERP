
@{
    ViewBag.Title = "BookMaster";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<style>
    a.fa-download {
        float: right;
        background: #484848;
        color: #fff;
        border-radius: 4px;
        padding: 4px 12px;
        margin-top: 5px;
    }

        a.fa-download:before {
            display: none;
        }

    .checkbox, .radio {
        padding-top: 7px;
        padding-bottom: 0px;
        min-height: 27px;
        margin-top: 0;
        margin-bottom: 0px;
    }

    .pull-left.section-title {
        font-size: 17px;
        padding: 5px 0px;
        color: #212121;
    }
</style>
<style>


    .checkbox, .radio {
        padding-top: 7px;
        padding-bottom: 0px;
        min-height: 27px;
        margin-top: 0;
        margin-bottom: 0px;
    }

    .pull-left.section-title {
        font-size: 17px;
        padding: 5px 0px;
        color: #212121;
    }

    .filter.pull-right.dashboard-filter table {
        margin: 0;
    }

    .section-title-filter {
        padding: 10px 0px;
        display: table;
    }

    .card h4 {
        font-size: 20px;
        margin-bottom: 0px;
        font-weight: 400;
        color: #fff;
    }

    .card {
        border: 1px solid #484848;
        text-align: center;
        padding: 20px;
        border-radius: 0px;
        transition: all ease-in .5s;
        margin-bottom: 20px;
        color: #fff;
        border-radius: 8px;
        -webkit-box-shadow: 0 1px 11px 0 rgb(136, 136, 136);
        box-shadow: 0 1px 11px 0 rgb(136, 136, 136);
    }

    /*    .card p {
            padding: 20px 0px 0px;
            font-size: 20px;
            color: #fff;
        }*/
    .dataTables_scrollBody {
        overflow: scroll !important;
        height: 400px;
    }

    .card-box-count .card a {
        display: inline-block;
        border-radius: 50%;
        background: #ffff;
        width: 100px;
        height: 100px;
        line-height: 100px;
        margin-top: 10px;
        font-size: 20px;
        -webkit-box-shadow: 0 1px 11px 0 rgb(136 136 136);
        box-shadow: 0 1px 11px 0 rgb(136 136 136);
        text-decoration: underline;
    }

    .card-box-count .card p {
        display: inline-block;
        border-radius: 50%;
        background: #ffff;
        width: 100px;
        height: 100px;
        line-height: 100px;
        margin-top: 10px;
        font-size: 20px;
        -webkit-box-shadow: 0 1px 11px 0 rgb(136 136 136);
        box-shadow: 0 1px 11px 0 rgb(136 136 136);
        color: #000;
    }

    .search-box {
        width: 30%;
        float: right;
    }

        .search-box label {
            float: left;
            margin-right: 10px;
            padding-top: 4px;
            font-size: 14px;
            color: #000;
        }

        .search-box input {
            width: 70%;
            float: right;
        }

    @@media(max-width:991px) {
        .search-box {
            width: 100%;
            float: right;
        }

            .search-box input {
                width: 72%;
                float: right;
            }
    }
</style>
<style>
    .table-scroll thead,
    .table-scroll thead th {
        position: -webkit-sticky;
        position: sticky;
        top: 0;
        background: #fff;
        color: #000 !important;
        z-index: 4;
        padding: 4px 6px !important;
        font-weight: 400 !important;
    }

    .table-scroll tfoot td {
        position: -webkit-sticky;
        position: sticky;
        bottom: 0;
        background: #fff;
        color: #000 !important;
        z-index: 4;
        padding: 4px 6px !important;
        font-weight: 400 !important;
    }
</style>
<script src="~/Scripts/myjslib/BookMasterController.js?Ver=@ViewBag.Version"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.8.1/xlsx.full.min.js"></script>
<script src="http://oss.sheetjs.com/js-xlsx/jszip.js"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Book Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Library</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Book Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Book Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtName", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "BMName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Edition</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtEdition", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "Edition" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Edition Type</label>
                                            <div class="input-box">
                                                <select id="ddlEditionType" class="select2 form-control" ng-init="GetEditionTypeLibList();" ng-model="EditionType">
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in EditionTypeLibList" value="{{x.Code}}">{{x.Name}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Publisher Year</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPublisherYear", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "PublisherYear" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Book Accessories</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlBookAccessoriesLib")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Author</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlAuthorLib")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Publisher</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlPublisherLib")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Group</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSubjectGroupLib")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Subject</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSubjectLib")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Topic</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtTopic", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "Topic" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Category</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlCategoryLib")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Series / Volume</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtSeries", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "Series" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Book Cover Photo<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <input id="fuBookCoverPhoto" type="file" name="file" class="dropify" data-max-file-size-preview="3M" onchange="angular.element(this).scope().SelectImage(this, '#imgBookCoverPhoto', 'BookCoverPhotoM')" />
                                                <img id="imgBookCoverPhoto" ng-model="BookCoverPhotoM" style="display:none;" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Book PDf<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <input id="fuBookPDf" type="file" name="file" class="dropify" data-max-file-size-preview="3M" onchange="angular.element(this).scope().SelectImage(this, '#imgBookPDf', 'BookPDfM')" />
                                                <img id="imgBookPDf" ng-model="BookPDfM" style="display:none;" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 no-padding">
                                            <fieldset>
                                                <legend style="width: auto;">Excel Entry Of Books Detail</legend>
                                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                    @* <h5 class="form-panel-heading">Excel Entry Of Books Detail</h5>*@
                                                    <a class="fa-download" href="{{ExcelPath}}" target="_blank">
                                                        Sample Format For Bulk Uploading&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <i class="fa fa-download" aria-hidden="true"></i>
                                                    </a>
                                                </div>
                                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Select Excel File</label>
                                                    <div class="input-box">
                                                        <input accept=".xlsx,.xls" onchange="angular.element(document).scope().loadFile(this.files)" onclick="this.value = null;" ng-model="fileUpload" id="fileUpload" type="file" name="fileUpload" class="form-control clear" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Show Excel Records</label>
                                                    <div class="input-box">
                                                        <input type="button" class="form-control btn-success" value="Show Excel Records" ng-click="ShowExcelRecords($event)" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Upload Excel Records</label>
                                                    <div class="input-box">
                                                        <input type="button" class="form-control btn-success" value="Upload Excel Records" ng-click="UploadExcelRecords()" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <style>
                                                    progress {
                                                        text-align: center;
                                                        height: 1.5em;
                                                        width: 100%;
                                                        -webkit-appearance: none;
                                                        border: none;
                                                        /* Set the progressbar to relative */
                                                        position: relative;
                                                    }

                                                        progress:before {
                                                            content: attr(data-label);
                                                            font-size: 0.8em;
                                                            vertical-align: 0;
                                                            /*Position text over the progress bar */
                                                            position: absolute;
                                                            left: 0;
                                                            right: 0;
                                                            padding-top: 2px;
                                                        }

                                                        progress::-webkit-progress-bar {
                                                            background-color: #c9c9c9;
                                                        }

                                                        progress::-webkit-progress-value {
                                                            background-color: #7cc4ff;
                                                        }

                                                        progress::-moz-progress-bar {
                                                            background-color: #7cc4ff;
                                                        }
                                                </style>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                </div>
                                                <div ng-if="ProgressValue>0" class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                    <progress id="file" ng-model="ProgressValue" value="{{ProgressValue}}"
                                                              max="100" style="width: 100%;height: 26px;" data-label="{{ProgressValue}} %"> {{ProgressValue}}% </progress>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                </div>
                                            </fieldset>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 no-padding">
                                            <div ng-if="FilteredExcelList.length>0">
                                                <div style="width:100%; display:inline-block;">
                                                    <div class="search-box">
                                                        <label>Search Here</label>
                                                        <input type="text" ng-model="Search" class="form-control" placeholder="search" />
                                                    </div>
                                                </div>

                                                <div class="table-scroll">
                                                    <table id="example2" class="table table-striped table-bordered compact" style="width: 100%">
                                                        <thead>
                                                            <tr>
                                                                <th>SrNo</th>
                                                                <th>BookName</th>
                                                                <th>EditionType</th>
                                                                <th>AuthorName</th>
                                                                <th>PublisherName</th>
                                                                <th>Group</th>
                                                                <th>Subject</th>
                                                                <th>Category</th>
                                                                <th>Volume</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="m in FilteredExcelList|filter:Search| limitTo:totalDisplayed" style="background-color:{{m.color}}">
                                                                <td>
                                                                    {{m.SrNo}}
                                                                    @*{{$index+1}}*@
                                                                    @*<input type="hidden" ng-model="StockExcelList[$index].SrNo" />*@
                                                                </td>
                                                                <td>{{m.BookName}}</td>
                                                                <td>{{m.EditionType}}</td>
                                                                <td>{{m.AuthorName}}</td>
                                                                <td>{{m.PublisherName}}</td>
                                                                <td>{{m.Group}}</td>
                                                                <td>{{m.Subject}}</td>
                                                                <td>{{m.Category}}</td>
                                                                <td>{{m.Volume}}</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>

                                                </div>
                                                <style>
                                                    .cust-btn {
                                                        background-color: #fff;
                                                        color: #f10404;
                                                        border: none;
                                                        font-weight: 600;
                                                    }

                                                    .cust-span {
                                                        color: black !important;
                                                        font-weight: 500;
                                                    }

                                                    .cust-exist {
                                                        color: red !important;
                                                        font-weight: 500;
                                                    }
                                                </style>
                                                <div style="margin-top:10px">
                                                    <span class="cust-span">Record Showing: <span ng-bind="(totalDisplayed<=FilteredExcelList.length)?totalDisplayed:(FilteredExcelList.length)"></span></span><span class="cust-span"> Out of: {{FilteredExcelList.length}};</span>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e97b51'}).length>0" style="color: #e97b51">Existing Record : {{(StockExcelList | filter:{color:'#e97b51'}).length}};</span>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e5bccd'}).length>0" style="color: #e5bccd"> Unmatchecd Record : {{(StockExcelList | filter:{color:'#e5bccd'}).length}}; </span>
                                                    <span ng-if="Message2.length>0"><b>{{Message2}} Records Found Unmatched</b></span>
                                                    <button ng-if="FilteredExcelList.length>500" type="button" class="cust-btn pull-right" value="Load More" ng-click="LoadMore()">Load More...</button>
                                                </div>
                                                <div style="margin:10px 0px 10px 0px">
                                                    <style>
                                                        .dotExist {
                                                            height: 12px;
                                                            width: 12px;
                                                            background-color: #e97b51;
                                                            border-radius: 50%;
                                                            display: inline-block;
                                                        }

                                                        .dotUnmatched {
                                                            height: 12px;
                                                            width: 12px;
                                                            background-color: #e5bccd;
                                                            border-radius: 50%;
                                                            display: inline-block;
                                                        }
                                                    </style>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e97b51'}).length>0">Existing Record Color Symbol </span>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e97b51'}).length>0" class="dotExist"></span>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e5bccd'}).length>0">Unmatchecd Record Color Symbol </span>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e5bccd'}).length>0" class="dotUnmatched"></span>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <button type="button" class="form-control btn-primary" value="ALLRecord" ng-click="ShowALL()">Show ALLRecord</button>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <button type="button" class="form-control btn-success" value="CorrerctRecord" ng-click="ShowCorrerct()">Show Non-Existing Record</button>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <button type="button" class="form-control btn-danger" value="ExistingRecord" ng-click="ShowRed()">Show Existing Record</button>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <button type="button" class="form-control btn-warning" value="UmatchedRecord" ng-click="ShowUnmatched()">Show Unmatched Record</button>
                                                </div>

                                            </div>
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                    <!-- Row -->
                </div>
            </div>
        </div>
    </div>
</div>
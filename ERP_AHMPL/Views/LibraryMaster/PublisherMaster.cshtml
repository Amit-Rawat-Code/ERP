
@{
    ViewBag.Title = "PublisherMaster";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<style>
    .form-panel-heading {
        top: 0 !important;
        padding: 0 !important;
        font-size: 16px !important;
    }
    a.fa-download {
        float: right;
        background: #484848;
        color: #fff;
        border-radius: 4px;
        padding: 4px 12px;
        margin-top: 5px;
    }

        a.fa-download:before {
            display: none;
        }

    .search-box {
        width: 30%;
        float: right;
    }

        .search-box label {
            float: left;
            margin-right: 10px;
            padding-top: 4px;
            font-size: 14px;
            color: #000;
        }

        .search-box input {
            width: 70%;
            float: right;
        }

    @@media(max-width:991px) {
        .search-box {
            width: 100%;
            float: right;
        }

            .search-box input {
                width: 72%;
                float: right;
            }
    }
</style>
<script src="~/Scripts/myjslib/PublisherMasterController.js?Ver=@ViewBag.Version"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.8.1/xlsx.full.min.js"></script>
<script src="http://oss.sheetjs.com/js-xlsx/jszip.js"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Publisher Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Library</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Publisher Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtName", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "PName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Address</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtAddress", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "PAddress" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Country</label>
                                            <div class="input-box">
                                                <select id="ddlCountry" class="select2 form-control" ng-model="CountryCode" ng-init="GetCountry();"
                                                        ng-change="GetState(CountryCode)">
                                                    <option value="">Select Country</option>
                                                    <option ng-repeat="x in Countrylist" value="{{x.Code}}">{{x.CountryName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">State</label>
                                            <div class="input-box">
                                                <select id="ddlState" class="select2 form-control" ng-model="StateCode"
                                                        ng-change="GetCity(StateCode)">
                                                    <option value="">Select State</option>
                                                    <option ng-repeat="x in Statelist" value="{{x.Code}}">{{x.StateName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">City</label>
                                            <div class="input-box">
                                                <select id="ddlCity" class="select2 form-control" ng-model="CityCode" ng-change="ddl_CityChange()">
                                                    <option value="">Select City</option>
                                                    <option ng-repeat="x in Citylist" value="{{x.Code}}">{{x.CityName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Pin code</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPinCode", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "PinCode", @maxlength = 6, @onblur = "validatePhoneNo('#txtPinCode','PC')" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Contact No.</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPhoneNo", "", new { @class = "form-control clear", @placeholder = "", @maxlength = 15, @ng_model = "PhoneNo" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Mobile No.</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtMobileNo", "", new { @class = "form-control clear", @placeholder = "", @maxlength = 10, @ng_model = "MobileNo", @onblur = "validatePhoneNo('#txtMobileNo','MN')" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 no-padding">
                                            <fieldset>
                                                <legend style="width: auto;">Excel Entry Of Books Detail</legend>
                                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                    @*<h5 class="form-panel-heading">Excel Entry Of Books Detail</h5>*@
                                                    <a class="fa-download" href="{{ExcelPath}}" target="_blank">
                                                        Sample Format For Bulk Uploading&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <i class="fa fa-download" aria-hidden="true"></i>
                                                    </a>
                                                </div>
                                                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Select Excel File</label>
                                                    <div class="input-box">
                                                        <input accept=".xlsx,.xls" onchange="angular.element(document).scope().loadFile(this.files)" onclick="this.value=null;" ng-model="fileUpload" id="fileUpload" type="file" name="fileUpload" class="form-control clear" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Show Excel Records</label>
                                                    <div class="input-box">
                                                        <input type="button" class="form-control btn-success" value="Show Excel Records" ng-click="ShowExcelRecords()" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Upload Excel Records</label>
                                                    <div class="input-box">
                                                        <input type="button" class="form-control btn-success" value="Upload Excel Records" ng-click="UploadExcelRecords()" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <style>
                                                    progress {
                                                        text-align: center;
                                                        height: 1.5em;
                                                        width: 100%;
                                                        -webkit-appearance: none;
                                                        border: none;
                                                        /* Set the progressbar to relative */
                                                        position: relative;
                                                    }

                                                        progress:before {
                                                            content: attr(data-label);
                                                            font-size: 0.8em;
                                                            vertical-align: 0;
                                                            /*Position text over the progress bar */
                                                            position: absolute;
                                                            left: 0;
                                                            right: 0;
                                                            padding-top: 2px;
                                                        }

                                                        progress::-webkit-progress-bar {
                                                            background-color: #c9c9c9;
                                                        }

                                                        progress::-webkit-progress-value {
                                                            background-color: #7cc4ff;
                                                        }

                                                        progress::-moz-progress-bar {
                                                            background-color: #7cc4ff;
                                                        }
                                                </style>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                </div>
                                                <div ng-if="ProgressValue>0" class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                    <progress id="file" ng-model="ProgressValue" value="{{ProgressValue}}"
                                                              max="100" style="width: 100%;height: 26px;" data-label="{{ProgressValue}} %"> {{ProgressValue}}% </progress>
                                                </div>
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                </div>
                                            </fieldset>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 no-padding">
                                            <div ng-if="FilteredExcelList.length>0">
                                                <div style="width:100%; display:inline-block;">
                                                    <div class="search-box">
                                                        <label>Search Here</label>
                                                        <input type="text" ng-model="Search" class="form-control" placeholder="search" />
                                                    </div>
                                                </div>
                                                <div class="table-scroll">
                                                    <table id="example2" class="table table-striped table-bordered compact" style="width: 100%">
                                                        <thead>
                                                            <tr>
                                                                <th>SrNo</th>
                                                                <th>PublisherName</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="m in FilteredExcelList|filter:Search| limitTo:totalDisplayed" style="background-color:{{m.color}}">
                                                                <td>
                                                                    {{m.SrNo}}
                                                                </td>
                                                                <td>{{m.PublisherName}}</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <style>
                                                    .cust-btn {
                                                        background-color: #fff;
                                                        color: #f10404;
                                                        border: none;
                                                        font-weight: 600;
                                                    }

                                                    .cust-span {
                                                        color: black !important;
                                                        font-weight: 500;
                                                    }

                                                    .cust-exist {
                                                        color: red !important;
                                                        font-weight: 500;
                                                    }
                                                </style>
                                                <div style="margin-top:10px">
                                                    <span class="cust-span">Record Showing: <span ng-bind="(totalDisplayed<=FilteredExcelList.length)?totalDisplayed:(FilteredExcelList.length)"></span></span><span class="cust-span"> Out of: {{FilteredExcelList.length}};</span>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e97b51'}).length>0" style="color: #e97b51">Existing Record : {{(StockExcelList | filter:{color:'#e97b51'}).length}};</span>
                                                    <button ng-if="FilteredExcelList.length>500" type="button" class="cust-btn pull-right" value="Load More" ng-click="LoadMore()">Load More...</button>
                                                </div>
                                                <div style="margin:10px 0px 10px 0px">
                                                    <style>
                                                        .dotExist {
                                                            height: 12px;
                                                            width: 12px;
                                                            background-color: #e97b51;
                                                            border-radius: 50%;
                                                            display: inline-block;
                                                        }

                                                        .dotUnmatched {
                                                            height: 12px;
                                                            width: 12px;
                                                            background-color: #e5bccd;
                                                            border-radius: 50%;
                                                            display: inline-block;
                                                        }
                                                    </style>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e97b51'}).length>0">Existing Record Color Symbol </span>
                                                    <span ng-if="(StockExcelList | filter:{color:'#e97b51'}).length>0" class="dotExist"></span>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <button type="button" class="form-control btn-primary" value="ALLRecord" ng-click="ShowALL()">Show ALLRecord</button>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <button type="button" class="form-control btn-success" value="CorrerctRecord" ng-click="ShowCorrerct()">Show Non-Existing Record</button>
                                                </div>
                                                <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <button type="button" class="form-control btn-danger" value="ExistingRecord" ng-click="ShowRed()">Show Existing Record</button>
                                                </div>
                                            </div>
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

@{
    ViewBag.Title = "PrintBarCode";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}


<style>
    .div-disabled {
        pointer-events: none;
        opacity: 0.5;
        background: #CCC;
    }
</style>
<style>
    .table-scroll {
        height: 400px;
        overflow-y: auto;
        float: left;
        width: 100%;
        text-align: center;
    }

        .table-scroll thead,
        .table-scroll thead th {
            position: -webkit-sticky;
            position: sticky;
            top: 0;
            background: #fff;
            color: #000 !important;
            z-index: 4;
            padding: 4px 6px !important;
            font-weight: 400 !important;
        }

        .table-scroll tfoot td {
            position: -webkit-sticky;
            position: sticky;
            bottom: 0;
            background: #fff;
            color: #000 !important;
            z-index: 4;
            padding: 4px 6px !important;
            font-weight: 400 !important;
        }
</style>
<script src="~/Scripts/myjslib/PrintBarCodeLibController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<input type="hidden" ng-model="hfStudentId" id="StudentId" name="StudentId" value="" />

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Print BarCode</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Library</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Print BarCode</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                    <div class="section-toggle">
                                        <div class="col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Print Mode<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <div class="radio radio-primary radio-box">
                                                    @Html.RadioButton("IsMemberType", "Accession", new { @ng_model = "PrintTypeM", @ng_change = "PrintType()" })
                                                    <label for="IsMemberType">Accession Wise</label>
                                                </div>
                                                <div class="radio radio-primary radio-box">
                                                    @Html.RadioButton("IsMemberType", "NewStock", new { @ng_model = "PrintTypeM", @ng_change = "PrintType()" })
                                                    <label for="IsMemberType">New Stock</label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">From Accession<span class="vd_red"></span></label>
                                            @Html.Partial("FromTxtDropDown")
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">To Accession<span class="vd_red"></span></label>
                                            @Html.Partial("ToTxtDropDown")
                                        </div>
                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">&nbsp;</label>
                                            <div class="input-box">
                                                <button type="button" value="Search" class="btn2 btn-common btn-3 btn-3d pe-7s-search" ng-model="Search" ng-click="SearchRecord()">
                                                    <span class="triangle-box" title="Search"></span>
                                                    <span>Search </span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding report-box" id="TabAddHeight" TabAddHeight="41">
                                <div class="arrow-container animated fadeInDown filter-toggle " ng-click="FilterToggle()">
                                    <div class="arrow-2">
                                        <i class="fa fa-angle-down"></i>
                                    </div>
                                    <div class="arrow-1 animated hinge infinite zoomIn"></div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 table-scroll">
                                    <table class="table compact table-striped table-bordered nowrap dataTable mgbt-xs-0 fixTableHead" ng-if="AccessionDetailList.length>0">
                                        <thead>
                                            <tr>
                                                <th class="a-width-col">Sr.No.</th>
                                                <th>Book Name</th>
                                                <th>AuthorName</th>
                                                <th>Publisher</th>
                                                <th>AccessionNo</th>
                                                <th>
                                                    <div ng-click="ddlCheckAll('AccessionDetailList')">Check All,</div>
                                                    <div ng-click="ddlUnCheckAll('AccessionDetailList')">Uncheck All</div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="AL in AccessionDetailList">
                                                <td>{{$index+1}}</td>
                                                <td>{{AL.BookName}}</td>
                                                <td>{{AL.AuthorName}}</td>
                                                <td>{{AL.Publisher}}</td>
                                                <td>{{AL.AccessionID}}</td>
                                                <td>
                                                    <div class="">
                                                        <input ng-model="AL.chk" type="checkbox" value="{{AL.AccessionID}}" ng-click="" />
                                                        <label for=""></label>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table> 
                                    <table class="table compact table-striped table-bordered nowrap dataTable mgbt-xs-0 fixTableHead" ng-if="AccessionDetailList.length==0">
                                        <tbody>
                                            <tr>
                                                <th style="text-align:center">No Record Found !</th>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgtp-24 mgbt-xs-15" ng-hide="AccessionDetailList.length==0">
                                    <button id="btnGenBarCode" type="button" value="GenBarCode" class="btn2 btn-common btn-3 btn-3d pe-7s-print"
                                            name="GenBarCodeButton" ng-model="GenBarCode" ng-click="GenerateBarCode()">
                                        <span class="triangle-box" title="Generate BarCode"></span>
                                        <span>Generate BarCode </span>
                                    </button>
                                </div>
                            </div>

                                @*@Html.Partial("AccessionReport")*@

                                <div id="Export" class="table-scroll">
                                    <div style="width:100%; float:left;">
                                        <table style="width:100%;text-align:center">
                                            <tr class="pagebr" ng-repeat="apl in AccessionPrintList1" load-barcode style="page-break-after:always">
                                                <td style="width:50%">
                                                    <svg class="barcode"
                                                         jsbarcode-format="code128"
                                                         jsbarcode-value="{{apl.Col1}}"
                                                         jsbarcode-textmargin="0"
                                                         jsbarcode-fontoptions="bold"
                                                         jsbarcode-fontSize="18"
                                                         jsbarcode-marginTop={{$index==0?'30':'38'}}
                                                         jsbarcode-width="2"
                                                         jsbarcode-height="30">
                                                    </svg>
                                                </td>
                                                <td style="width:50%">
                                                    <svg ng-if="apl.Col2!=''" class="barcode"
                                                         jsbarcode-format="code128"
                                                         jsbarcode-value="{{apl.Col2}}"
                                                         jsbarcode-textmargin="0"
                                                         jsbarcode-fontoptions="bold"
                                                         jsbarcode-fontSize="18"
                                                         jsbarcode-marginTop={{$index==0?'30':'38'}}
                                                         jsbarcode-width="2"
                                                         jsbarcode-height="30">
                                                    </svg>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 col-xs-12 mgtp-24 mgbt-xs-15" ng-hide="AccessionDetailList.length==0">
                                    <button id="btnPrint" type="button" value="Print" class="btn2 btn-common btn-3 btn-3d pe-7s-print"
                                            name="printButton" ng-model="Print" ng-click="PrintPreview()">
                                        <span class="triangle-box" title="Print"></span>
                                        <span>Print </span>
                                    </button>
                                </div>
                            </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

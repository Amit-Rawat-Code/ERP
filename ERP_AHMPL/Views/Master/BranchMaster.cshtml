
@{
    ViewBag.Title = "Branch Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/BranchMasterController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Branch Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Enquiry</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Branch Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">School<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSchool")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Branch Code<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("BranchCode", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "BranchCode" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">School Code<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("DisplayCode", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "DisplayCodes", @maxlength = "6" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Branch Url (without http://)<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtBranchUrl", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "BranchUrl" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Branch Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("BranchName", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "BranchName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Branch Address<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("BranchAddress", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "BranchAddress" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Display Order<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("DisplayOrder", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "DisplayOrder" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">IsActive<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Upload Branch Logo<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <input id="logo" type="file" ng-model="BranchLogo" class="form-control" onchange="angular.element(this).scope().SelectFile(this,'BranchLogo')" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Upload Background Image<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <input id="BackgroundImage" type="file" ng-model="BackgroundImage" class="form-control" onchange="angular.element(this).scope().SelectFile(this,'BackgroundImage')" />                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>
@{
    ViewBag.Title = "School Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/SchoolMasterController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">School Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Enquiry</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>School Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Society<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSociety")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">School Code<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("SchoolCodes", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "SchoolCodes" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">School Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("SchoolName", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "SchoolNames" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">School Address<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("SchoolAddress", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "SAddress" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Display Order<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("DisplayOrder", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "DisplayOrder" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">School Type<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <div class="radio radio-primary radio-box">
                                                    <input type="radio" name="select" ng-model="Is" value="4">
                                                    <label for="PrimaryNo_1"> Is HO </label>
                                                </div>
                                                <div class="radio radio-primary radio-box">
                                                    <input type="radio" name="select" ng-model="Is" value="1">
                                                    <label for="PrimaryNo_1"> Is Society </label>
                                                </div>
                                                <div class="radio radio-primary radio-box">
                                                    <input type="radio" name="select" ng-model="Is" value="2">
                                                    <label for="PrimaryNo_1"> Is School </label>
                                                </div>
                                                <div class="radio radio-primary radio-box">
                                                    <input type="radio" name="select" ng-model="Is" value="3">
                                                    <label for="PrimaryNo_1"> Is College </label>
                                                </div>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>




                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">IsActive<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>




























}

<style>
    .feepaydetail {
        padding: 20px 20px;
        background-color: #fff;
        -webkit-border-radius: 10px;
        border-radius: 10px;
        -webkit-box-shadow: 0 10px 30px 0 #0003;
        box-shadow: 0 10px 30px 0 #0003;
        margin-bottom: 40px;
        border-left: 10px solid #cf525a;
        text-align: left;
        display: inline-block;
        width: 100%;
    }

        .feepaydetail small {
            float: right;
            font-size: 22px;
            color: #5c8d55;
        }

        .feepaydetail h2 {
            font-size: 20px;
            display: block;
            padding-bottom: 0;
            color: #37445b;
            line-height: 18px;
        }

            .feepaydetail h2 span {
                float: right;
            }



    .paydetail {
        width: 100%;
        float: left;
        margin-top: 20px;
    }

        .paydetail strong {
            color: #000;
            font-size: 22px;
        }

        .paydetail .btnremove {
            border-radius: 30px;
            padding: 10px 20px;
            color: #fff;
            background: #fc3f3d;
            border: none;
            float: right;
            cursor: pointer;
        }

        .paydetail .btnpay {
            border-radius: 30px;
            padding: 10px 30px;
            color: #fff;
            background: #2c87f9;
            border: none;
            float: right;
            cursor: pointer;
        }

    .styled-checkbox {
        height: 22px;
        width: 30px;
        float: right;
        margin-top: 0;
        margin-right: 10px;
    }

    .paydatailr {
        padding: 10px 10px;
        background-color: #fff;
        -webkit-border-radius: 10px;
        border-radius: 10px;
        -webkit-box-shadow: 0 10px 30px 0 #0003;
        box-shadow: 0 10px 30px 0 #0003;
        margin-bottom: 40px;
        border: 2px solid #cf525a;
        text-align: center;
        display: inline-block;
        width: 100%;
    }

        .paydatailr strong {
            color: #003984;
            font-size: 22px;
            display: block;
        }

        .paydatailr .btnpay {
            border-radius: 30px;
            padding: 10px 30px;
            color: #fff;
            background: #2c87f9;
            border: none;
            cursor: pointer;
            display: inline-block;
        }

        .paydatailr span {
            display: block;
            color: #000;
            font-size: 18px;
        }

    .balance-academic {
        float: left;
        width: 100%;
    }

        .balance-academic strong {
            color: #587cb6;
            font-size: 22px;
            margin-right: 5px;
        }

        .balance-academic p {
            color: #000;
        }

        .balance-academic span {
            color: #e24944;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .balance-academic .btnpay {
            border-radius: 30px;
            padding: 10px 40px;
            color: #fff;
            background: #3ba158;
            border: none;
            cursor: pointer;
            display: inline-block;
            font-size: 17px;
        }
</style>



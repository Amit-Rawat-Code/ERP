@{
    ViewBag.Title = "Test Payment";
    ViewBag.TitleList = "Payment List";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<style>
   


</style>
<script src="~/Scripts/myjslib/PaymentController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset" ng-init="ShowStudentFeeCard();" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Fee Pay</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Fee</span></li>
                <li><span>Pay</span></li>
                <li class="active"><span>Fee Pay</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="feepay-auto">
                    <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                        <div class="refresh-container">
                            <div class="preloader">
                                <div class="circles-1">
                                    <div class="circles-1-center"></div>
                                    <div class="circles-1"></div>
                                    <div class="circles-1"></div>
                                    <div class="circles-1"></div>
                                    <div class="circles-1"></div>
                                    <div class="circles-1"></div>
                                    <div class="circles-1"></div>
                                </div>
                            </div>
                        </div>
                        <div class="panel-wrapper">
                            <div class="panel-body">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                    <div class="collapse in">
                                        <form id="user-form">
                                            <div id="hdngetstu" style="display:none"></div>
                                            <div class="section-toggle">
                                           
                                                <div id="exTab1" class="refreshcontainer">
                                                    <ul class="nav nav-pills">
                                                        <li class="active-new1">
                                                            <a href="#1a" data-toggle="tab">Fee Pay</a>
                                                        </li>
                                                        <li class="active-new">
                                                            <a href="#2a" data-toggle="tab">Refresh</a>
                                                        </li>
                                                    </ul>

                                                    <div class="tab-content clearfix">
                                                        <div class="tab-pane active" id="1a">
                                                            <div class="row">
                                                                <div class="col-lg-12" ng-repeat="feedetails in StudentFeeDetails">
                                                                    <div class="feepaydetail">
                                                                        <h2>
                                                                            <span ng-model="feedetails.InstallmentName" ng-bind="feedetails.InstallmentName"></span>
                                                                            <span>
                                                                                <input class="styled-checkbox" type="checkbox" value="value1" ng-model="feedetails.Chk"
                                                                                       ng-if="feedetails.FeeStatus!='Paid'" ng-init="feedetails.Chk=false">
                                                                            </span>
                                                                        </h2>
                                                                        <p>DUE DATE - <span ng-model="feedetails.DueOn" ng-bind="feedetails.DueOn"></span></p>
                                                                        <div class="paydetail">
                                                                            <strong>Fee Amount: <i class="fa fa-inr" aria-hidden="true"></i> <span ng-model="feedetails.PayableAmt" ng-bind="feedetails.PayableAmt"></span></strong>
                                                                            <strong>Paid Amount: <i class="fa fa-inr" aria-hidden="true"></i> <span ng-model="feedetails.FeeRect" ng-bind="feedetails.FeeRect"></span></strong>
                                                                            @*<strong>Payble Amount: <i class="fa fa-inr" aria-hidden="true"></i> <span ng-model="feedetails.Balance" ng-bind="feedetails.Balance=feedetails.PayableAmt-feedetails.FeeRect"></span></strong>*@
                                                                            <strong>Payble Amount: <i class="fa fa-inr" aria-hidden="true"></i> <span ng-model="feedetails.Balance" ng-bind="feedetails.Balance=1.00"></span></strong>
                                                                            <small><span ng-model="feedetails.FeeStatus" ng-bind="feedetails.FeeStatus"></span></small>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-12">
                                                                <div class="balance-academic">
                                                                    <div class="row">
                                                                        <div class="col-lg-8">
                                                                            <strong><i class="fa fa-inr" aria-hidden="true"></i> <span ng-model="paymentRequest.amount" ng-bind="paymentRequest.amount=Sumoflist('StudentFeeDetails','Balance',{'Chk':true},'2');">{{paymentRequest.amount}}</span></strong>
                                                                            <p>TOTAL PAYABLE</p>
                                                                        </div>
                                                                        <div class="col-lg-4">
                                                                            @*<input type="button" ng-model="btnClass" ng-click="HDFCPayment();" ng-disabled="HDFCPaymentdisabled" class="btn {{btnClass}}" value="Checkout" />*@
                                                                            <button type="button" value="pay" class="btnpay" ng-model="btnClass" ng-click="HDFCPayment();" ng-disabled="btndisabled" ng-if="paymentRequest.amount>0">PAY NOW</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="tab-pane active-div" id="2a">
                                                            <div class="row">
                                                                <div class="col-lg-12" ng-repeat="paymentHistory in PaymentHistory">
                                                                    <div class="feepaydetail">
                                                                        <div class="col-lg-8">
                                                                            <strong>Ref. No.:<span ng-model="paymentHistory.reference_no">{{paymentHistory.reference_no}}</span></strong>
                                                                            <strong>OrderId:<span ng-model="paymentHistory.order_no">{{paymentHistory.order_no}}</span></strong>
                                                                            <strong>Amount:<span ng-model="paymentHistory.amount">{{paymentHistory.amount}}</span></strong>
                                                                        </div>
                                                                        <div class="col-lg-4">
                                                                            <button type="button" value="varify" class="btnvarify" ng-model="btnClass" ng-click="HDFCVarify(paymentHistory);">varify</button>
                                                                        </div>
                                                                        <div class="col-lg-12" style="color:black !important">
                                                                            <strong>Result:</strong> 
                                                                            <span>{{hdfcResponseBystatusApi}}</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                      
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding report-box">
                                    <div class="arrow-container animated fadeInDown filter-toggle " ng-click="FilterToggle()">
                                        <div class="arrow-2">
                                            <i class="fa fa-angle-down"></i>
                                        </div>
                                        <div class="arrow-1 animated hinge infinite zoomIn"></div>
                                    </div>
                                    @Html.Partial("GeneralReportGrid")
                                </div>
                            </div>
                        </div>
                    </div>



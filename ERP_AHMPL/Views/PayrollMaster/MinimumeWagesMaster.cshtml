
@{
    ViewBag.Title = "MinimumeWagesMaster";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/ClassWiseSubjectWiseBookController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="app-content  my-3">
    <div class="side-app">
        <div class="autohide-scroll autoheightset">
            <div class="br-pageheader">
                <!-- Title -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
                    <h5 class="txt-dark">Minimume Wages Master</h5>
                </div>
                <!-- Breadcrumb -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                    <ol class="breadcrumb">
                        <li><span>Payroll</span></li>
                        <li class="active"><span>Minimume Wages Master</span></li>
                    </ol>
                </div>
            </div>
            <div class="br-pagebody">
                <div class="">
                    <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                    <label class="control-label">Date<span class="vd_red">*</span></label>
                                    <div class="input-box">
                                        <input class="form-control" id="txtDate" max="{{endDate}}" min="{{startDate}}" name="txtToDate" ng-model="Date" type="date" value="" />
                                        <div class="text-box-msg-r">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                    <label class="control-label">Skilled<span class="vd_red">*</span></label>
                                    <div class="input-box">
                                        @Html.TextBox("txtSkilled", "", new { @class = "form-control clear validate textOnly", @placeholder = "", @ng_model = "Skilled" })
                                        <div class="text-box-msg-r">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                    <label class="control-label">Semi-Skilled<span class="vd_red">*</span></label>
                                    <div class="input-box">
                                        @Html.TextBox("txtSemiSkilled", "", new { @class = "form-control clear validate textOnly", @placeholder = "", @ng_model = "SemiSkilled" })
                                        <div class="text-box-msg-r">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                    <label class="control-label">Un-Skilled<span class="vd_red">*</span></label>
                                    <div class="input-box">
                                        @Html.TextBox("txtUnSkilled", "", new { @class = "form-control clear validate textOnly", @placeholder = "", @ng_model = "UnSkilled" })
                                        <div class="text-box-msg-r">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                    <label class="control-label">Active</label>
                                    <div class="input-box">
                                        @Html.TextBox("txtUnSkilled", "", new { @class = "form-control clear validate textOnly", @placeholder = "", @ng_model = "UnSkilled" })
                                        <div class="text-box-msg-r">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 mgtp-xs-15 ">
                                    @Html.Partial("ActionView")
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>
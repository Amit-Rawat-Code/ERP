
@{
    ViewBag.Title = "Registration Forms Receive Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/RegistrationFormsReceiveMasterController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Registration Forms Receive Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Registration</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Registration Forms Receive Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Type of Registration Form <span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlRegistrationFeeHead")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Date<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txttodayDate", "", new { @class = "form-control clear validate", @type = "date", @placeholder = "", @ng_model = "TodayDate", @ng_init = "SetMaxMinDate()" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Registration Form (Reg.No.) Series</label>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Prefix:<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtRegNoPrefix", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "RegNoPrefix", ng_disabled = "!Process" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">From:<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFormNoStart", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "FormNoStart", ng_disabled = "!Process" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">To:<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFormNoEnd", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "FormNoEnd", ng_disabled = "!Process" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Sufix:<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtRegNoSufix", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "RegNoSufix" ,ng_disabled="!Process"})
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label"><span class="vd_red"></span></label>
                                            <div class="input-box">
                                                <button id="btnprev" ng-if="Process" class="btn btn-primary pull-left" ng-click="GenerateRegNoTable();" > Process <i class="fa fa-long-arrow-right" aria-hidden="true"></i></button>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-cloak ng-if="RegNoTable.length>0" ng-init="BindStatus();">
                                            <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>S.No.</th>
                                                        <th>Reg. No. </th>
                                                        <th>Status</th>
                                                        <th>Remark</th>

                                                    </tr>
                                                </thead>
                                                <tbody>

                                                    <tr ng-repeat="RN in RegNoTable">
                                                        <td ng-model="RN.Srno" ng-init="RN.Srno=($index+1)">{{RN.Srno}}</td>
                                                        <td ng-model="RN.RegNo">{{RN.RegNo}}</td>
                                                        <td>
                                                            <select id="ddlTDSDeductee" class="select2 form-control" ng-model="RN.Status" 
                                                                    ng-disabled="RN.IsEdit==0">
                                                                <option value="">Select</option>
                                                                <option ng-repeat="SL in StatusList" value="{{SL.StatusId}}">{{SL.Status}}</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <input id="txtRemark" type="text" class="form-control clear"  ng-model="RN.Remark"  />

                                                        </td>
                                                    </tr>




                                                </tbody>

                                            </table>
                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

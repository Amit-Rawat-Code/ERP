
@{
    ViewBag.Title = "Registration Form Sale Entry";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/RegistrationFormSaleEntryController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<input type="hidden" ng-model="EnquiryTransID" id="EnquiryTransID" name="EnquiryTransID" value="" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Registration Form Sale Entry</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Registration Form Sale Entry</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-sm-12">
                                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15 btn1-nM3-1">

                                                    <div class="input-box">
                                                        <div class="radio radio-primary radio-box">
                                                            <input ng-change="IsAgainstEnquiryDirectChange();" type="radio" id="AgainstEnquiry" ng-model="IsAgainstEnquiry" value="1" class="ng-valid ng-not-empty ng-dirty ng-touched" name="EnquiryType">
                                                            <label for="PrimaryNo_1">Against Enquiry</label>
                                                        </div>
                                                        <div class="radio radio-primary radio-box" ng-hide="true">
                                                            <input ng-change="IsAgainstEnquiryDirectChange();" type="radio" id="Direct" ng-model="IsAgainstEnquiry" value="0" class="ng-valid ng-not-empty ng-dirty ng-valid-parse ng-touched" name="EnquiryType">
                                                            <label for="WhatsAppNo_1">Direct</label>
                                                        </div>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Session<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        @Html.Partial("ddlSession")
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Form Sale Type<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        @Html.DropDownList("ddlFormSaleType", new List<SelectListItem>{
                                                              new SelectListItem{Text="Select", Value=""},
                                                              new SelectListItem{Text="Offline", Value="Offline"},
                                                              new SelectListItem{Text="Online", Value="Online"}
                                                          },
                                                              new { @class = "select2 form-control validate", @ng_model = "FormSaleType", @ng_init = "FormSaleType='Offline'" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1 search-feild">
                                                    <div class="input-box">
                                                        @Html.TextBox("txtSearch", "", new { @class = "form-control", @placeholder = "Enquiry No./Student Name/Mobile No.", @ng_model = "$parent.SearchBox", @ng_disabled = "Searchdisabled", @autocomplete = "off" })
                                                        <div class="text-box-msg-r">
                                                        </div>

                                                        <button id="btnSave" type="button" value="Search" class="Srch-btn" name="saveButton" ng-model="Saves"
                                                                ng-init="Saves='Search'" ng-click="SearchStudentsDetail();"
                                                                ng-disabled="Searchdisabled">

                                                            <span id="btnSavetxt" ng-bind="Saves">Search</span>

                                                        </button>
                                                    </div>
                                                    <label class="text text-danger" ng-click="ClearItems()"><i class="fa fa-times" aria-hidden="true"></i>Clear</label>



                                                    <div ng-if="items.length>0" class="searchbox ng-scope" style=" width: calc(100% - 30px);">
                                                        <table class="table compact table-hover table-striped table-bordered nowrap  dataTable" style="margin: 0px !important;">
                                                            <thead>
                                                                <tr>
                                                                    <th>Enquiry No</th>
                                                                    <th>Student Name</th>
                                                                    <th>DOB</th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="item in items">
                                                                    <td>{{item.PVNo}}</td>
                                                                    <td>{{item.StudentFirstName}} {{item.StudentMiddleName}} {{item.StudentLastName}}</td>
                                                                    <td>{{item.DateOfBirth}}</td>
                                                                    <td>
                                                                        <button class="btn btn-dark" ng-click="SearchStudentDetail(item.TransID);"> Get Details</button>

                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>







                                                    @*<ul>
                                                            <li role="presentation" style="border:solid;" ng-repeat="item in items"
                                                                class="">
                                                                <table>
                                                                    <tr>
                                                                        <td>
                                                                            <div class="main-title">
                                                                                Enquiry No :- {{item.PVNo}}| Student Name :- {{item.StudentFirstName}} {{item.StudentMiddleName}} {{item.StudentLastName}}
                                                                            </div>
                                                                            <div class="sub-title">DOB :- {{item.DateOfBirth}}</div>
                                                                        </td>
                                                                        <td class="text-right" style="vertical-align: middle;width: 130px;">
                                                                            <a class="btn btn-link " ng-click="SearchStudentDetail(item.TransID);"> Get Details</a>
                                                                        </td>
                                                                    </tr>
                                                                </table>

                                                            </li>
                                                        </ul>*@
                                                </div>

                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-12">
                                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Class<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        @Html.Partial("ddlClass")
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Stream</label>
                                                    <div class="input-box">
                                                        @Html.Partial("ddlStream")
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Board</label>
                                                    <div class="input-box">
                                                        @Html.Partial("ddlBoards")
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Reg.No.<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtRegNo", "", new { @class = "form-control validate", @placeholder = "", @ng_model = "RegNo", ng_disabled = "Save=='Edit'" })
                                                        @*@Html.Partial("ddlSession")*@
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                    <label class="control-label">Date<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        <input id="txtDateofEnquiry" type="date" class="form-control clear validate" placeholder=""
                                                               ng-model="Date" max="{{endDate}}" min="{{startDate}}" />
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-panel">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <h5 class="form-panel-heading">Student Details<span class="vd_red"></span></h5>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">First Name<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtStudentFirstName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "StudentFirstName" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Middle Name</label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtStudentMiddleName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "StudentMiddleName" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Last Name</label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtStudentLastName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "StudentLastName" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Date of birth<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <input id="txtDateofEnquiry" type="date" class="form-control clear validate" placeholder=""
                                                           ng-model="DateOfBirth" />
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Gender<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlGender")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Father Name<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtFatherName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "FatherName" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Category<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlCategory")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Email(Student's)<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtStudentEmail", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "StudentEmail" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Email(Parent's)<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtParentEmail", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "ParentEmail" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Guardian's Email<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtGuardianEmail", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "GuardianEmail" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            @*This is Contact Area*@
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 ">
                                                <div class="phone-number-choice">
                                                    <label class="control-label">Student Mobile No.<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtStudentContact", "",
                                                       new { @class = "form-control clear {{PrimaryNo=='1' || WhatsAppNo=='1'?'validate':''}}", @placeholder = "", @ng_model = "StudentContact", @maxlength = "10", @allow_only_numbers = "" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                    <div class="input-box type-choice">
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" id="PrimaryNo_1" ng-model="PrimaryNo" value="1">
                                                            <label for="PrimaryNo_1"> <i class="icon-mobile-phone"></i> </label>
                                                        </div>
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" id="WhatsAppNo_1" ng-model="WhatsAppNo" value="1">
                                                            <label for="WhatsAppNo_1"><i class="fa fa-whatsapp" aria-hidden="true"></i></label>
                                                        </div>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <div class="phone-number-choice">
                                                    <label class="control-label">Father Mobile No.<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtFatherContact", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "FatherContact", @maxlength = "10", @allow_only_numbers = "" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                    <div class="input-box type-choice">
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" id="PrimaryNo_2" ng-model="PrimaryNo" value="2">
                                                            <label for="PrimaryNo_1"> <i class="icon-mobile-phone"></i> </label>
                                                        </div>
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" id="WhatsAppNo_2" ng-model="WhatsAppNo" value="2">
                                                            <label for="WhatsAppNo_1"><i class="fa fa-whatsapp" aria-hidden="true"></i></label>
                                                        </div>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <div class="phone-number-choice">
                                                    <label class="control-label">Mother Mobile No.<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtMotherContact", "",
                                                       new { @class = "form-control clear {{PrimaryNo=='3' || WhatsAppNo=='3'?'validate':''}}", @placeholder = "", @ng_model = "MotherContact", @maxlength = "10", @allow_only_numbers = "" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                    <div class="input-box type-choice">
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" id="PrimaryNo_3" ng-model="PrimaryNo" value="3">
                                                            <label for="PrimaryNo_1"> <i class="icon-mobile-phone"></i> </label>
                                                        </div>
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" id="WhatsAppNo_3" ng-model="WhatsAppNo" value="3">
                                                            <label for="WhatsAppNo_1"><i class="fa fa-whatsapp" aria-hidden="true"></i></label>
                                                        </div>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <div class="phone-number-choice">
                                                    <label class="control-label">Guardian/Visitor Mobile No.<span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        @Html.TextBox("txtVisitorContact", "",
                                                       new { @class = "form-control clear {{PrimaryNo=='4' || WhatsAppNo=='4'?'validate':''}}", @placeholder = "", @ng_model = "GuardianContact", @maxlength = "10", @allow_only_numbers = "" })
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                    <div class="input-box type-choice">
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" id="PrimaryNo_4" ng-model="PrimaryNo" value="4">
                                                            <label for="PrimaryNo_1"> <i class="icon-mobile-phone"></i> </label>
                                                        </div>
                                                        <div class="radio radio-primary radio-box">
                                                            <input type="radio" id="WhatsAppNo_4" ng-model="WhatsAppNo" value="4">
                                                            <label for="WhatsAppNo_1"><i class="fa fa-whatsapp" aria-hidden="true"></i></label>
                                                        </div>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            @*This is Contact Area*@
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12  mgbt-xs-15">
                                                <label class="control-label">State<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlState")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12  mgbt-xs-15">
                                                <label class="control-label">City<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlCity")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Address<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtAddress", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Address" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">City Area<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlCityArea")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Sub Area<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtSubArea", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "SubArea" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Pin Code<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtPinCode", "", new { @class = "form-control clear numberOnly", @placeholder = "", @ng_model = "PinCode" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Occupation<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtOccupation", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Occupation" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Reference<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtReference", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Reference" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Remark<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtRemark", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Remark" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="form-panel">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <h5 class="form-panel-heading">Payment Details<span class="vd_red"></span></h5>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Registration Amount<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <label ng-model="Amount" ng-bind="Amount" class="form-control" ng-init="Amount=0"
                                                           style="line-height: 17px !important;"></label>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Discount<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtDiscount", "", new { @class = "form-control clear textOnly", @placeholder = "", ng_change = "GetNetAmount()", @ng_model = "Discount", @ng_init = "Discount=0" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Net. Amount<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <label ng-model="NetAmount" ng-bind="NetAmount" ng-init="GetNetAmount()"
                                                           class="form-control" style="line-height: 17px !important;"></label>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Discount Approved By/Remark<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtSaleRemark", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "SaleRemark" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                @Html.Partial("IsChkWithPayModeddl")
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Payment Reference No.<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtPaymentRefrenceNo", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "PaymentRefrenceNo" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                @Html.Partial("RegistrationReceipt")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>


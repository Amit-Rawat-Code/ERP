
@{
    ViewBag.Title = "Registration Form Sale Entry Online";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/RegistrationFormSaleEntryOnlineController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Registration Form Sale Entry (online)</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Registration Form Sale Entry (online)</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Class<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlClass")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Amount</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtAmount", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "Amount" ,@ng_readonly="true"})
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <h5>Student Details<span class="vd_red"></span></h5>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">First Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFirstName", "", new { @class = "form-control clear textOnly validate", @placeholder = "", @ng_model = "StudentFirstName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Middle Name</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtMiddleName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "StudentMiddleName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Last Name</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtLastName", "", new { @class = "form-control clear textOnly", @placeholder = "", @ng_model = "StudentLastName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Parent Email<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtEmail", "", new { @class = "form-control clear textOnly validate", @placeholder = "", @ng_model = "ParentEmail" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Father Contact<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFatherContact", "", new { @class = "form-control clear textOnly validate", @placeholder = "", @ng_model = "FatherContact" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                       
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <button id="btnSave" type="button" value="Pay Now" class="btn-me btn-primary hvr-float-shadow ng-pristine"  name="saveButton" ng-click="SaveRecord()" ng-model="Save" >

                                                <span id="btnSavetxt" class="ng-binding">Pay Now</span>
                                            </button>
                                        </div>


                                      

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

<script>
    $('#ddlCityArea').removeClass('validate');
    $('#ddlGender').removeClass('validate');
    $('#ddlCollegeBranch').removeClass('validate');
</script>

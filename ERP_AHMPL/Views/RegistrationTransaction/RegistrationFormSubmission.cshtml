                                                    <a class="image-wrapper pic-edit-btn" href="#">
                                                        <label class="edit glyphicon glyphicon-pencil" for="changeCover" title="Change cover"></label>
                                                        <input type="file" id="fuStudentPhoto" data-max-file-size-preview="1M"
                                                               onchange="angular.element(this).scope().SelectFile(this, 'StudentPhoto')"
                                                               accept="image/*" />

                                                    </a>
                                                    
                                                </div>
                                            </div>

                                        </div>

                                        <div class="row">
                                            
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

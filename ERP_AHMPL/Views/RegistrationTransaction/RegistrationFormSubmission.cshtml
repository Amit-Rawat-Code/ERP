                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-4 col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Board<span class="vd_red"></span></label>
                                                        <div class="input-box">
                                                            @Html.Partial("ddlBoards")

@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/authorization.js?Ver=@ViewBag.Version"></script>
<link href="~/Content/plugins/assets/fonts/feather-icon/feather-icon.css" rel="stylesheet" />
<button id="btnSave" type="button" value="Save" class="btn-me btn-primary hvr-float-shadow" name="saveButton" ng-model="Save"
        ng-init="Save='Save'" ng-click="CheckSavePermission();SaveRecord()" ng-disabled="disableAdd" @*ng-show="visibleAdd"*@>

    <span id="btnSavetxt" ng-bind="Save">Save</span>
    <i data-feather="edit"></i>
</button>

<button id="btnSearch" type="button" value="Search" class="btn-me btn-success  hvr-float-shadow" name="searchButton" data-toggle="collapse" data-target="#CollapseSearchTableList" aria-expanded="false" aria-controls="CollapseSearchTableList"
        ng-model="Search" ng-click="CheckSearchPermission();SearchRecord()" ng-disabled="disableSearch" @*ng-show="visibleSearch"*@>
    Search
    <i data-feather="search"></i>
</button>
<button id="btnClear" type="button" value="Clear" class="btn-me btn-info hvr-float-shadow"
        name="clearButton" ng-model="Clear" ng-disabled="disableClear" ng-click="ClearControl()" @*ng-show="visibleClear"*@>
    Clear
    <i data-feather="refresh-cw"></i>
</button>
<script src="~/Content/plugins/assets/fonts/feather-icon/icons/feather-icon/feather.min.js"></script>
<script src="~/Content/plugins/assets/fonts/feather-icon/icons/feather-icon/feather-icon.js"></script>
<script src="~/Content/plugins/assets/fonts/feather-icon/icons/feather-icon/feather-icon-clipart.js"></script>

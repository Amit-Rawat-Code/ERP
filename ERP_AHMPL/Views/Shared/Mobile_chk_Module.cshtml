<div class="" ng-init="GetMobileModules();">
    <div class="input-box">
        <div class="checkbox checkbox-primary check-box">
            <input id="chkAllModule" type="checkbox" ng-model="chkAllModule" ng-bind="chkAllModule=(selectedModuleCount==ModulesList.length?true:false)" ng-change="AllModule();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
            <label for="chkAllModule">Select All</label>
        </div>
        <div class="text-box-msg-r2" style="font-weight: 500;">
            Total Selection: <label ng-model="selectedModuleCount" ng-bind="selectedModuleCount=(ModulesList | filter:{'IsActive' : 'true'}).length" class="ng-pristine ng-untouched ng-valid ng-binding ng-not-empty"></label>
        </div>
        <div class="input-box" style="width: 100%;background: #484848;position: relative;float: left;color: #fff;">
            <div class="checkbox checkbox-primary check-box-head">
               Module
            </div>
        </div>
    </div>
</div>
<div class="" style="position:relative;">
    <div class="slimScrollDiv-height3" id="slimScrollDiv-height2">
        <table class="table compact table-hover table-striped table-bordered  dataTable t-mgtb-n">
            <tbody>
                <tr ng-repeat="XL in ModulesList" ng-if="ModulesList.length>0">
                    <td class="srno">
                        <div class="checkbox checkbox-primary check-box chech-box-mp-n">
                            <input type="checkbox" ng-model="XL.IsActive" />
                            <label for=""> </label>
                        </div>
                    </td>
                    <td style="float: left;display:none ">{{XL.ModuleId}}</td>
                    <td> {{XL.ModuleName}}</td>
                </tr>
            </tbody>
        </table>
    </div>

</div>




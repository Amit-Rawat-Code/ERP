<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
    <div class="collapse in">
        <div class="table-heading-box">

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                <div class="datatable-responsive table-responsive">
                    <table class="table compact table-hover table-striped table-bordered nowrap">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="chkAll" ng-model="chkAll" ng-click="CheckAll()" /></th>
                                <th>Class</th>
                                <th>Monday</th>
                                <th>Tuesday</th>
                                <th>Wednesday</th>
                                <th>Thursday</th>
                                <th>Friday</th>
                                <th>Saturday</th>
                                <th>Sunday</th>
                            </tr>
                        </thead>
                        <tbody ng-init="LoadClasses()">
                            <tr ng-repeat="class in PeriodWeekDayClasses">
                                <td>
                                    <input type="checkbox" id="chkClass" ng-model="chk[class.ClassId]"
                                           ng-init="chk[class.ClassId]=false" ng-click="CheckAll(class.ClassId)" />
                                </td>
                                <td><lable ng-bind="class.ClassName"></lable></td>
                                <td>
                                    <input type="checkbox" id="chkMonday" ng-model="chkMonday[class.ClassId]"
                                           ng-init="chkMonday[class.ClassId]=false" ng-click="chkClick(class.ClassId)" />
                                </td>
                                <td>
                                    <input type="checkbox" id="chkTuesday" ng-model="chkTuesday[class.ClassId]"
                                           ng-init="chkTuesday[class.ClassId]=false" ng-click="chkClick(class.ClassId)" />
                                </td>
                                <td>
                                    <input type="checkbox" id="chkWednesday" ng-model="chkWednesday[class.ClassId]"
                                           ng-init="chkWednesday[class.ClassId]=false" ng-click="chkClick(class.ClassId)" />
                                </td>
                                <td>
                                    <input type="checkbox" id="chkThursday" ng-model="chkThursday[class.ClassId]"
                                           ng-init="chkThursday[class.ClassId]=false" ng-click="chkClick(class.ClassId)" />
                                </td>
                                <td>
                                    <input type="checkbox" id="chkFriday" ng-model="chkFriday[class.ClassId]"
                                           ng-init="chkFriday[class.ClassId]=false" ng-click="chkClick(class.ClassId)" />
                                </td>
                                <td>
                                    <input type="checkbox" id="chkSaturday" ng-model="chkSaturday[class.ClassId]"
                                           ng-init="chkSaturday[class.ClassId]=false" ng-click="chkClick(class.ClassId)" />
                                </td>
                                <td>
                                    <input type="checkbox" id="chkSunday" ng-model="chkSunday[class.ClassId]"
                                           ng-init="chkSunday[class.ClassId]=false" ng-click="chkClick(class.ClassId)" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    * {
        margin: 0px;
        padding: 0px;
    }

    .container {
        width: 1000px;
        margin: auto;
    }

    .header-address {
        width: 100%;
        text-align: center;
        font-family: Arial;
        font-size: 14px;
        color: #000;
        font-weight: bold;
    }

    .progress-report {
        margin: 10px auto 0;
        width: 250px;
        border: solid 1px #000;
        padding: 5px 0;
        border-bottom: none;
    }

        .progress-report span {
            display: block;
        }

    .progress-report2 {
        width: 100%;
        float: left;
        border: solid 1px #000;
    }

        .progress-report2 table {
            width: 100%;
            border-collapse: collapse;
        }

        .progress-report2 td, .progress-report2 th {
            padding: 5px;
            text-align: left;
            font-size: 14px;
            font-family: Arial;
        }

    .learning-skills {
        width: 100%;
        float: left;
        background: #000;
        text-align: center;
        color: #fff;
        padding: 5px 0;
        font-family: Arial;
        margin: 5px 0;
        font-size: 16px;
        font-weight: bold;
    }

    .facet-container {
        width: 100%;
        float: left;
    }

        .facet-container .right {
            float: right;
            width: 50%;
        }

        .facet-container .left {
            float: left;
            width: 50%;
        }


    .facet-list {
        list-style-type: none;
        margin: 0;
        padding: 0;
        background: #eee;
        width: 100%;
    }

        .facet-list li {
            font-size: 1.2em;
            width: 100%;
        }

    .box-left {
        width: 49.5%;
        /* float: left;*/
    }

    .box-right {
        width: 49.5%;
        /*float: right;*/
    }

    .facet-container table {
        width: 100%;
        border-collapse: collapse;
    }



    .facet-container td {
        border: 1px solid #000;
        text-align: left;
        font-size: 14px;
        padding: 8px;
        font-family: Arial;
    }
</style>

<div id="ExportDiv" @*style="display:none;"*@ ng-cloak>
    <div style="width:100%; float:left;">
        <div class="header-address">
            (ADDRESS: 10/441 Khalasi Line,Kanpur-208002)(AFILIATION NO.:2131767)<br />
            (WEBSITE: www.allenhousekhalasiline.com)(Ph.:9648561155)
            <div class="progress-report" >
                Progress Report
                <span>{{ex.ExamGroupName}}</span>
                <span>Academic Session :{{academicSession}}</span>
            </div>

            <table class="table-FWH">
                <tbody>
                    <tr>
                        <td class="T-VA-T H1P">
                            <div id="ReportHeader" ng-bind-html="ReportHeader"></div>
                        </td>
                    </tr>
                </tbody>
            </table>


</div>
        <div class="progress-report2">
            <table>
                <tbody>
                    <tr>
                        <td>
                            <table>
                                <tbody>
                                    <tr>
                                        <td><strong>Name :</strong></td>
                                        <td>{{StudentDetail.StudentName}}</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Father's Name :</strong></td>
                                        <td>{{StudentDetail.FatherName}}</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Mother's Name :</strong></td>
                                        <td>{{StudentDetail.MotherName}}</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Address :</strong></td>
                                        <td>{{StudentDetail.ResidenceAddress}}</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Contact No :</strong></td>
                                        <td>{{StudentDetail.Mobile}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                        <td>
                            <table>
                                <tbody>
                                    <tr>
                                        <td><strong>Class & Sec :</strong></td>
                                        <td>{{StudentDetail.ClassName}}</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Roll No. :</strong></td>
                                        <td>{{StudentDetail.RegNo}}</td>
                                    </tr>
                                    <tr>
                                        <td><strong>D.O.B :</strong></td>
                                        <td>{{StudentDetail.DOB_Print}}</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Scholar NO. :</strong></td>
                                        <td>{{StudentDetail.AdmissionNo}}</td>
                                    </tr>


                                </tbody>
                            </table>
                        </td>
                        <td style="width:150px;"><div style="border:solid 1px #000; height:140px; width:100%; background:#ccc;">&nbsp;</div></td>
                    </tr>
                </tbody>
            </table>
        </div>

        @*<div class="learning-skills">
            </div>*@

    </div>
    <div class="facet-container">
        <div class="box-left" ng-repeat="objComp in ReportList" ng-if="objComp.DisplayOrder==1">
            {{objComp.ComponentName}}
            <table ng-repeat="obj_sub in SubjectList" width="100%">
                <thead>
                    <tr>
                        <td>
                            {{obj_sub.SRNO}}-{{obj_sub.SubjectName}}
                        </td>
                        <td ng-repeat="ex in ExamList">{{ex.ExamName}}</td>
                    </tr>
                </thead>
                <tbody ng-repeat="g1 in obj_sub.sgm">
                    <tr style="color:cadetblue">
                        <td>{{g1.SkillGroupName}}</td>
                        <td ng-repeat="ex in ExamList"></td>
                    </tr>
                    <tr style="color:pink" ng-repeat="g2 in g1.snm">
                        <td>{{g2.SkillName}}</td>
                        <td ng-repeat="ex in ExamList"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>


    @*<div style="width:100%;">
            <div class="progress-report2">
                <table>
                    <tbody>
                        <tr>
                            <td width="50"><strong>Name:</strong></td>
                            <td>{{StudentDetail.StudentName}}</td>
                            <td width="100"><strong>Class & Sec.:</strong></td>
                            <td>{{StudentDetail.ClassName}}</td>
                            <td width="80"><strong>Roll No.:</strong></td>
                            <td>{{StudentDetail.RegNo}}</td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>*@
    <div class="facet-container">
        <div class="box-left" ng-repeat="objComp in ReportList" ng-if="objComp.DisplayOrder==2">
            {{objComp.ComponentName}}
            @*{{SubjectListSC}}*@
            <table >
                <thead>
                    @*{{ExamList}}*@
                    <tr>
                        <td>Subjects</td>
                        <td ng-repeat="ex in ExamList">{{ex.ExamName}}</td>
                    </tr>
                </thead>
                <tbody ng-repeat="obj_sub in SubjectListSC">
                    <tr>
                        <td>{{obj_sub.SubjectName}}</td>
                        <td ng-repeat="ex in ExamList"></td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>

    @*<div class="facet-container">
        <div class="box-left" ng-repeat="objComp in ReportList" ng-if="objComp.DisplayOrder==3">
            {{objComp.ComponentName}}
            <div id="app" style="border:solid 1px #000; padding:0 5px;">
                <graph-bar :width="480"
                           :height="242"
                           :axis-min="0"
                           :axis-max="100"
                           :labels="[ 'ENG', 'HIN', 'MATHS', 'EVS','COMP.SCL' ]"
                           :values="values">

                </graph-bar>
            </div>
        </div>
    </div>*@

    <div class="facet-container">
        <div class="box-left" ng-repeat="objComp in ReportList" ng-if="objComp.DisplayOrder==4">
            {{objComp.ComponentName}}
            @*{{CoSkillList}}*@
            <table>
                <thead>
                    <tr>
                        <td></td>
                        <td ng-repeat="ex in ExamList">{{ex.ExamName}}</td>
                    </tr>
                </thead>
                <tbody ng-repeat="obj_coskill in CoSkillList">
                    <tr>
                        <th style="background:#000; color:#fff;" colspan="{{ExamList.length+1}}">{{obj_coskill.SkillGroupName}}</th>                        
                    </tr>
                    <tr ng-repeat="g1 in obj_coskill.snm">
                        <td>{{g1.SkillName}}</td>
                        <td ng-repeat="ex in ExamList"></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="box-left" ng-repeat="objComp in ReportList" ng-if="objComp.DisplayOrder==5">
            {{objComp.ComponentName}}
            @*{{LearningList}}*@
            <table>
                <thead>
                    <tr>
                        <td></td>
                        <td ng-repeat="ex in ExamList">{{ex.ExamName}}</td>
                    </tr>
                </thead>
                <tbody ng-repeat="obj_lskill in LearningList">
                    <tr>
                        <th style="background:#000; color:#fff;" colspan="{{ExamList.length+1}}">{{obj_lskill.SkillGroupName}}</th>
                    </tr>
                    <tr ng-repeat="g1 in obj_lskill.snm">
                        <td>{{g1.SkillName}}</td>
                        <td ng-repeat="ex in ExamList"></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="box-left" ng-repeat="objComp in ReportList" ng-if="objComp.DisplayOrder==6">
            {{objComp.ComponentName}}
            <table>
                <tbody class="attendance">
                    @*<tr style="background:#000; color:#fff;">
                            <td colspan="3" style="text-align:center;"></td>
                        </tr>*@
                    <tr>
                        <td style="text-align:center;"><strong>PA1</strong></td>
                        <td style="text-align:center;"><strong>PA2</strong></td>
                        <td style="text-align:center;"><strong>Total<br /> Attendance</strong></td>
                    </tr>
                    <tr>
                        <td width="150" style="text-align:center;">76/80</td>
                        <td style="text-align:center;">36/43</td>
                        <td style="text-align:center;">184/220</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="facet-container">
        @*{{GradeList}}*@
        <div class="box-right" ng-repeat="objComp in ReportList" ng-if="objComp.DisplayOrder==7">
            {{objComp.ComponentName}}
            <table ng-repeat="obj_grade in GradeList">
                <tbody>
                    <tr>
                        <th style="background:#000; color:#fff;" colspan="3">{{obj_grade.SRNO}} Grading Scale for {{obj_grade.SkillTypeName}}</th>
                    </tr>
                    <tr ng-repeat="g1 in obj_grade.sgm">
                        <td>{{g1.GradeName}}</td>
                        <td>{{g1.GradeDescription}}</td>
                        <td ng-show="g1.LowerLimit>0">{{g1.LowerLimit}}-{{g1.UpperLimit}}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="box-right" ng-repeat="objComp in ReportList" ng-if="objComp.DisplayOrder==8">
            {{objComp.ComponentName}}
            <table>
                <tbody>
                    @*<tr style="background:#000; color:#fff;">
                            <td style="text-align:center;"></td>
                        </tr>*@
                    <tr>
                        <td><strong>PERIODIC ASSESSMENT-I</strong></td>
                    </tr>
                    <tr>
                        <td>Good performance in the assessmennts.Needs to be more active in all the co-curricular activities.</td>
                    </tr>
                    <tr>
                        <td><strong>PERIODIC ASSESSMENT-II</strong></td>
                    </tr>
                    <tr>
                        <td>Praiseworthy performance in academics as well as well as co-curriculars.Should keep it up.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="footer-principal">
        <span>Class Teacher</span>
        <span>Principal</span>
    </div>
</div>
<script src='https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js'></script>

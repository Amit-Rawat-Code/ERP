
<script src="@Url.Content("~/Scripts/jspdf.min.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/html2canvas.js")"></script>
@*<style>
    .text-message{
        white-space: normal;
    }
    
</style>*@
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
    <div class="collapse" id="CollapseSearchTableList">
        <div class="table-heading-box">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                @Html.Partial("_printingTool")
                @*<div class="print-menu-box">
                    <div class="input-box">
                        <div class="pull-left inline-block mr-15 dt-buttons">
                            <div class="checkbox checkbox-primary check-box">
                                <input id="chkBranding" class="clear" ng-model="ShowBranding" type="checkbox" ng-init="ShowBranding=true" />
                                <label for="chkBranding">Branding</label>
                            </div>
                            <div class="checkbox checkbox-primary check-box">
                                <input id="chkTitle" class="clear" ng-model="ShowTitle" type="checkbox" ng-init="ShowTitle=true" />
                                <label for="chkTitle">Title</label>
                            </div>
                            <div class="checkbox checkbox-primary check-box">
                                <input id="chkCaption" class="clear" ng-model="ShowCaption" type="checkbox" ng-init="ShowCaption=true" />
                                <label for="chkCaption">Caption</label>
                            </div>
                        </div>
                    </div>
                    <div class="pull-left inline-block mr-15 dt-buttons">
                        <button class="dt-button buttons-pdf buttons-html5" tabindex="0" type="button" title="PDF"
                                ng-click="Export('pdf')">
                            <span>PDF</span>
                        </button>
                        <button class="dt-button buttons-print" tabindex="0" type="button" title="Print"
                                ng-click="Export('print')">
                            <span>Print</span>
                        </button>
                    </div>
                    <select id="ddlDocSize" class="pull-left inline-block mr-15"
                            ng-model="DocSize">
                        <option value="a4">A4</option>
                        <option value="a3">A3</option>
                    </select>
                    <select id="ddlDocOrientation" class="pull-left inline-block mr-15"
                            ng-model="DocOrientation">
                        <option value="portrait">Portrait</option>
                        <option value="landscape">Landscape</option>
                    </select>
                    <select id="ddlFonts" class="pull-left inline-block mr-15"
                            ng-model="FontSize">
                        <option value="8">8</option>
                        <option value="9">9</option>
                        <option value="10">10</option>
                        <option value="11">11</option>
                        <option value="12">12</option>
                        <option value="13">13</option>
                        <option value="14">14</option>
                    </select>
                </div>*@
            </div>
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="{{DocSize}} {{DocOrientation}}">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding" id="ExportDiv">

                        <div id="SetPageMargin">
                            <div class="col-612" ng-repeat="(index,val) in keys" ng-if="keys.length>0">
                                <div class="me-col-12" ng-init="GetReportHeaderUsingCategory('General Report')" ng-if="ShowBranding">
                                    <div id="ReportHeader" ng-bind-html="ReportHeader"></div>
                                </div>
                                <div class="me-col-12 dt-print-view" ng-if="ShowTitle">
                                    <h1>@ViewBag.Title</h1>
                                </div>
                                <table class="table-p-0 compact table-bordered nowrap mb-0">
                                    <caption style="caption-side:center"
                                             ng-if="ShowCaption?($parent.RepeatHeader==1?true:(index==0?true:false)):false">
                                        <div id="FilterTitle">
                                            <span class="filter" ng-model="$parent.FilterMsg"
                                                  ng-bind-html="trustAsHtml(FilterMsg)"></span>
                                        </div>
                                    </caption>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <table class="table compact nowrap no-b mb-0">
                                                    <tbody>
                                                        <tr>
                                                            <td colspan="4">
                                                                <h6 class="text-center" ng-model="BodyHeaderTitle">
                                                                {{BodyHeaderTitle}}</h6>
                                                            </td>
                                                        </tr>

                                                        <tr ng-repeat="tr in tblbody|filter:{FilterCol:val}" ng-model="rowindex"
                                                            ng-init="rowindex=$index">
                                                            <td>
                                                                <div class="col-63" ng-repeat="th in tblheader"
                                                                     style="font-size:{{FontSize}}px !important;">
                                                                    <b>{{th.HeaderText}}</b>: {{th.IsAmountCol=='Yes'?Formatter(tr[th.HeaderValue]):tr[th.HeaderValue]}}
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>

                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <table class="table compact nowrap no-b mb-0">
                                                    <tbody>
                                                        <tr>
                                                            <td colspan="2" class="text-message">
                                                                <div class="col-612" ng-bind-html="trustAsHtml(NoticeMessage)"></div>
                                                                <div class="col-62 text-left">
                                                                    <br />
                                                                    <br />
                                                                    <br />
                                                                    <b ng-model="LeftFooterText">{{LeftFooterText}}</b>
                                                                    {{LeftFooterValue}}
                                                                </div>
                                                                <div class="col-62 text-right">
                                                                    <br />
                                                                    <br />
                                                                    <br />
                                                                    <b class="pad-r-30" ng-model="RightFooterText">{{RightFooterText}}
                                                                    </b>{{RightFooterValue}}
                                                                </div>
                                                            </td>
                                                        </tr>

                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div class="cut-page-line" ng-if="tblbody.length>1">
                                    <i class="icofont-cut"></i>
                                </div>
                            </div>
                            <table class="table-p-0 " ng-if="keys.length==0">
                                <tbody>
                                    <tr>
                                        <td>
                                            <div class="me-col-12" ng-init="GetReportHeaderUsingCategory('General Report')" 
                                                 ng-if="ShowBranding">
                                                <div id="ReportHeader" ng-bind-html="ReportHeader"></div>
                                            </div>
                                            <div class="me-col-12 dt-print-view" ng-if="ShowTitle">
                                                <h1>@ViewBag.Title</h1>
                                            </div>
                                            <table class="table compact table-hover table-striped table-bordered nowrap fee-card">
                                                <caption style="caption-side:top" ng-if="ShowCaption">
                                                    <div id="FilterTitle">
                                                        <span class="filter" ng-model="$parent.FilterMsg"
                                                              ng-bind-html="trustAsHtml(FilterMsg)"></span>
                                                    </div>
                                                </caption>
                                                <caption style="caption-side:top">
                                                    <div>
                                                        <span class="text-message" ng-model="TextMessage" ng-bind="TextMessage"></span>
                                                    </div>
                                                </caption>
                                                <thead>
                                                    <tr>
                                                        <th ng-repeat="th in tblheader" width={{th.Width}}
                                                            style="text-align:{{th.TextAlign==null?'Left':th.TextAlign}};font-size:{{FontSize}}px !important;">
                                                            <span ng-bind="th.HeaderText"></span>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="tr in tblbody" ng-model="rowindex" ng-init="rowindex=$index">
                                                        <td ng-repeat="th in tblheader"
                                                            style="font-size:{{FontSize}}px !important;text-align:{{th.TextAlign==null?'Left':th.TextAlign}};">
                                                            <span ng-if="th.HeaderValue=='Id'" ng-bind="rowindex+1"></span>
                                                            <span ng-if="th.HeaderValue!='Id'" 
                                                                  ng-bind-html="trustAsHtml(Replace(tr[th.HeaderValue],'$'))">
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr ng-if="tblbody.length==0">
                                                        <td style="text-align:center" colspan="{{tblheader.length}}">
                                                            Sorry No Record Found...
                                                        </td>
                                                    </tr>
                                                </tbody>
                                                <tfoot ng-if="tblbody.length>0 && showtblfooter==1">
                                                    <tr>
                                                        <td ng-repeat="(key,val) in tblfootermain" class="total-t-b"
                                                            style="text-align:right; font-size:{{FontSize}}px !important;">
                                                            <span ng-bind="Formatter(val)"></span>
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table-p-0 page-b-before-a" ng-if="tblbodySummary.length>0">
                                <tbody>
                                    <tr>
                                        <td>
                                            <table class="table compact table-hover table-striped table-bordered nowrap fee-card ">
                                                <thead>
                                                    <tr ng-repeat="theadRow in tblheaderSummary">
                                                        <th ng-repeat="th in theadRow" width={{th.Width}} colspan={{th.ColSpan==null?1:th.ColSpan}}
                                                            style="font-size:{{FontSize}}px !important;text-align:{{th.TextAlign==null?'Left':th.TextAlign}}"><span ng-bind="th.HeaderText"></span></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="tr in tblbodySummary" ng-model="rowindex" ng-init="rowindex=$index">
                                                        <td ng-repeat="th in tblheaderSummary[headerIndex]"
                                                            style="font-size:{{FontSize}}px !important;text-align:{{th.TextAlign==null?'Left':th.TextAlign}}">
                                                            <span ng-bind="th.HeaderValue=='Id'?rowindex+1:tr[th.HeaderValue]"></span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                                <tfoot>
                                                    <tr ng-repeat="tfootRow in tblfooterSummary">
                                                        <td ng-repeat="td in tfootRow" colspan={{td.ColSpan==null?1:td.ColSpan}} class="total-t-b"
                                                            style="font-size:{{FontSize}}px !important;text-align:{{td.TextAlign==null?'Left':td.TextAlign}};">
                                                            <span ng-bind="Formatter(td.FooterText)"></span>
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>









<style>
    body{font-family:Arial; font-size:13px; font-weight:normal;}
    * {
        margin: 0px;
        padding: 0px;
    }

    .margin-bt-15 {
        margin-bottom: 15px;
    }

    .fee-recipt {
        width:33.33%;
        float: left;
        box-sizing: border-box;
        padding: 5px;
    }

        .fee-recipt .table-adm {
            width: 100%;
            font-size: 14px;
            color: #000;
            font-family: initial;
            border-collapse: collapse;
        }

        .fee-recipt > table.table-adm {
            border: 1px solid #000;
        }

    .table-adm-row td {
        padding: 5px;
    }

    .CollegeName {
        font-size: 20px;
        background: #000000;
        display: inline-block;
        margin: 0 auto;
        line-height: 30px;
        border-radius: 8px;
        color: #fff;
        padding: 0px 30px;
    }

    .CollegeName1 {
        font-size: 16px;
    }

    .bodered-class th {
        background: #000;
        padding: 5px;
        color: #fff;
    }

    .bodered-class tr, .bodered-class td, .bodered-class th {
        border: 1px solid #000;
    }

    .fee-recipt-border-spacing {
        padding: 5px;
    }

    .fee-recipt-border-spacing {
        padding: 5px;
        border: 1px solid #000;
    }
    .repeat-section1 {
        width: 100%;
        page-break-after: always;
        page-break-before: always;
    }

        .repeat-section1 > tbody > tr > td {
            width: 33.33%;
            padding: 5px;
        }

        .repeat-section1 .table-adm1 {
            border: solid 1px #000;
            width: 100%;
            float: left;
            padding: 5px;
        }
</style>

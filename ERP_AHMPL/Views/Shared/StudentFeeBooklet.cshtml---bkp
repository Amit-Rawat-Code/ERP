                                                </td>
                                                <td style="text-align:right; border-left:solid 1px #000;">
                                                    {{fb.PayableAmt}}
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <table class="table-adm table-adm-row ">
                                        <tbody>
                                            <tr>
                                                <td style="text-align:center;">
                                                    @*<img src="https://www.pikpng.com/pngl/b/416-4169510_signature-sticker-signature-png-for-picsart-edit-clipart.png" alt="sign" style="height:50px;object-fit:contain;">*@
                                                    <div>Cashier</div>
                                                </td>
                                                <td style="text-align:center;">
                                                    @*<img src="https://www.pikpng.com/pngl/b/41    6-4169510_signature-sticker-signature-png-for-picsart-edit-clipart.png" alt="sign" style="height:50px;object-fit:contain;">*@
                                                    <div>Depositor</div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <table class="table-adm table-adm-row" style="border:solid 1px #000; margin-bottom:5px;">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    Bank Details:
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <table class="table-adm table-adm-row bodered-class" style="border:solid 1px #000;">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    Bank Name : <span>{{BankName}}</span>
                                                </td>

                                            </tr>
                                            <tr>
                                                <td>
                                                    Account No : <span>{{AccountNo}}</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    IFSC Code : <span>{{IfscCode}}</span>
                                                </td>

                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
        </tbody>
    </table>

</div>



<script src="~/scripts/myjslib/UnitMenuDetailController.js"></script>
<style>
    tr.select-layout-row td {
        padding: 5px 0px;
        color: #000;
    }
        tr.select-layout-row td button {
            padding: 7.5px 20px;
            margin: 0px 5px;
            width: 200px;
            background: #484848;
            color: #fff;
            border: 1px solid #484848;
        }
    </style>

<style>

    ul#tblLayoutParts {
        display: table;
        margin: 0 auto;
        width: 100%;
    }
    ul#tblLayoutParts li {
            width: 20%;
            float: left;
            padding: 5px 5px;
    }
        ul#tblLayoutParts li button {
            width: 100%;
            height: 40px;
            border-radius: 40px 40px 40px 40px;
            color: #fff;
            border: 0;
            font-size: 16px;
            border: 1px solid #a8a8a9;
            -webkit-box-shadow: 0 1px 11px 0 rgb(0 0 0 / 12%);
            box-shadow: 0 1px 11px 0 rgb(152 153 155);
            line-height: 27px;
        }
        ul#tblLayoutParts li:nth-child(1) button {
            background: #b73dd0;
        }
        ul#tblLayoutParts li:nth-child(2) button {
            background: #8c46db;
        }
        ul#tblLayoutParts li:nth-child(3) button {
            background: #37b4ed;
        }
        ul#tblLayoutParts li:nth-child(4) button {
            background: #e58602;
        }
        ul#tblLayoutParts li:nth-child(5) button {
            background: #43ab01;
        }
        ul#tblLayoutParts li button svg.load {
            float: left;
        }
        @@media only screen and (max-width: 1270px) {
                ul#tblLayoutParts li{
                width: 25%;
                }
               }
        @@media only screen and (max-width: 980px) {
                ul#tblLayoutParts li{
               width: 33.33%;
            }

            }
        @@media only screen and (max-width: 768px) {
                ul#tblLayoutParts li{
                width: 50%;
            }

            }
    @@media only screen and (max-width: 480px) {
        ul#tblLayoutParts li {
            width: 100%;
        }
    }





</style>


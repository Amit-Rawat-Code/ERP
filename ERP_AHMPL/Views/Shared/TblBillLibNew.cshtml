    <div class="input-box">
        <style>
        </style>
        <style>
            .input-icons {
                color: #01090c;
                font-size: 15px;
                line-height: 35px;
                position: absolute;
                top: 1px;
                background: #d6d6d6;
                text-align: center;
                width: 31px;
                left: unset !important;
                right: 1px;
                height: 28px;
                border-left: 1px solid #484848;
            }

            .down-arrow {
                border: solid black;
                border-width: 0 2px 2px 0px;
                display: inline-block;
                padding: 2px;
                transform: rotate(45deg);
                -webkit-transform: rotate(45deg);
                margin: 0px 0px 4px 0px;
            }

            div.scrollmenu {
                /*width:300px;*/
                overflow: auto;
                max-height: 300px;
                /*z-index: 99999;*/
            }

            table thead tr th {
                /* Important */
                position: sticky;
                top: 0;
            }

            element.style {
            }

            #FeeStuListOnOff {
                display: none;
            }

            div.scrollmenu {
                /* width: 300px; */
                overflow: auto;
                max-height: 300px;
                /* z-index: 99999; */
            }

            .DropdownInInput {
                position: absolute;
                z-index: 30;
                width: 100%;
                left: 0px;
                background: #fff;
                box-shadow: 2px 2px 5px #d6d6d6;
            }
        </style>

        <input type="text" id="txtStudent" class="form-control clear"
        ng-model="SearchBillText" ng-click="SearchStudents()"
        ng-blur="HideStudentList();txtStudent_blur();" autocomplete="off" ng-disabled="disabledBill"
        ng-init="disabledBill=false;GetBillNoList(7)" placeholder="{{hideloader?'Please Wait...':'Select Bill No.'}}" />
        <div class="input-icons" ng-model="hideloader" ng-show="hideloader" ng-cloak>
            <i class="fa fa-circle-o-notch fa-spin icon"></i>
        </div>
        <div class="input-icons" ng-click="Save=='Edit'?'':SearchStudents();" ng-hide="hideloader" ng-cloak>
            <i class="down-arrow"></i>
        </div>
        <div id="FeeStuListOnOff" class="DropdownInInput scrollmenu" width="javascript:$('#txtStudent').width()" onclick="event2();">

            <table id="myDropdown" class="table compact table-hover table-striped table-bordered nowrap fee-card header-fixed">
                <thead>
                    <tr>
                        <th width="5px"></th>
                        <th width="30%">Bill No.</th>
                        <th width="30%">Bill Date</th>
                        <th width="35%">Vender Name</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="bill in BillList|filter:SearchBillText"
                        ng-click="setBillNoLib(bill);" >
                        <td>
                            <div class="radio radio-primary table-radio">
                                <input ng-model="$parent.TransID" type="radio" value="{{bill.TransID}}" />
                                <label for=""></label>
                            </div>
                        </td>
                        <td>{{bill.BillNo}}</td>
                        <td>{{bill.BillDate}}</td>
                        <td>{{bill.VendorName}}</td>
                    </tr>
                </tbody>
            </table>

        </div>
        <div class="text-box-msg-r">
        </div>
    </div>



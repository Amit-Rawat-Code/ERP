
<div class="input-box">
    <style>
    </style>
    <style>
        .input-icons {
            color: #01090c;
            font-size: 15px;
            line-height: 35px;
            position: absolute;
            top: 1px;
            background: #d6d6d6;
            text-align: center;
            width: 31px;
            left: unset !important;
            right: 1px;
            height: 28px;
            border-left: 1px solid #484848;
        }

        .down-arrow {
            border: solid black;
            border-width: 0 2px 2px 0px;
            display: inline-block;
            padding: 2px;
            transform: rotate(45deg);
            -webkit-transform: rotate(45deg);
            margin: 0px 0px 4px 0px;
        }

        div.scrollmenu {
            /*width:300px;*/
            overflow: auto;
            max-height: 300px;
            /*z-index: 99999;*/
        }

        table thead tr th {
            /* Important */
            position: sticky;
            top: 0;
        }

        element.style {
        }

        #EmpListOnOff {
            display: none;
        }

        div.scrollmenu {
            /* width: 300px; */
            overflow: auto;
            max-height: 300px;
            /* z-index: 99999; */
        }

        .DropdownInInput {
            position: absolute;
            z-index: 30;
            width: 100%;
            left: 0px;
            /*background: #fff;
                box-shadow: 2px 2px 5px #d6d6d6;*/
        }
    </style>

    <input type="text" id="txtStudent" class="form-control clear"
           ng-model="SearchEmployeeText" ng-click="ShowCollapsedList('EmpListOnOff')"
           ng-blur="HideExpandList('EmpListOnOff');txtStudent_blur();" ng-keyup="ClearTextDropDownEmp();" autocomplete="off" ng-disabled="disabledSearch" ng-init="disabledSearch=false;GetAllEmployees(9)" />
    <div class="input-icons" ng-click="Save=='Edit'?'':ShowCollapsedList('EmpListOnOff');" ng-hide="hideloader" ng-cloak>
        <i class="down-arrow"></i>
    </div>
    <div id="EmpListOnOff" class="DropdownInInput scrollmenu" width="javascript:$('#txtStudent').width()" ng-click="GetBookDetails();" onclick="event2();">

        <table id="myDropdown" class="table compact table-hover table-striped table-bordered nowrap fee-card header-fixed">
            <thead>
                <tr>
                    <th width="5px"></th>
                    <th width="20%">Employee</th>
                    <th width="15%">Employee ID</th>
                    <th width="15%">Father Name</th>
                    <th width="15%">DepartmentName</th>
                    <th width="10%">DesignationName</th>
                    <th width="10%">Contact No.</th>
                    <th width="10%">Joining Date </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="emp in EmployeeList|filter:SearchEmployeeText|filter:{'EmployeeId':$scope.EmployeeId }"
                    ng-click="setEmployeeNameLib(emp)">
                    <td>
                        <div class="radio radio-primary table-radio">
                            <input ng-model="$parent.EmployeeCode" type="radio" value="{{emp.EmployeeCode}}" ng-disabled="!emp.IsActive" />
                            <label for=""></label>
                        </div>
                    </td>
                    <td>{{emp.EmployeeName}}</td>
                    <td>{{emp.EmployeeId}}</td>
                    <td>{{emp.FatherName}}</td>
                    <td>{{emp.DepartmentName}}</td>
                    <td>{{emp.DesignationName}}</td>
                    <td>{{emp.ContactNo}}</td>
                    <td>{{emp.JoiningDate}}</td>
                </tr>
            </tbody>
        </table>

    </div>
    <div class="text-box-msg-r">
    </div>
</div>
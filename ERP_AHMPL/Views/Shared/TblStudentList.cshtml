<style>
    .input-icons {
        color: #01090c;
        font-size: 15px;
        line-height: 35px;
        position: absolute;
        top: 1px;
        left: 95%;
        background: #d6d6d6;
        text-align: center;
        width: 31px;
        height: 28.4px;
    }

    .down-arrow {
        border: solid black;
        border-width: 0 2px 2px 0px;
        display: inline-block;
        padding: 2px;
        transform: rotate(45deg);
        -webkit-transform: rotate(45deg);
        margin: 0px 0px 4px 0px;
    }

    div.scrollmenu {
        /*width:300px;*/
        overflow: auto;
        max-height: 300px;
        /*z-index: 99999;*/
    }

    table thead tr th {
        /* Important */
        position: sticky;
        top: 0;
    }
</style>

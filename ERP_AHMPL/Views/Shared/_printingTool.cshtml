<div class="print-menu-box">
    <div class="input-box">
        <div class="pull-left inline-block mr-15 dt-buttons">
            <div class="checkbox checkbox-primary check-box">
                <input id="chkBranding" class="clear" ng-model="ShowBranding" type="checkbox" ng-init="ShowBranding=true" />
                <label for="chkBranding">Header</label>
            </div>
            <div class="checkbox checkbox-primary check-box">
                <input id="chkTitle" class="clear" ng-model="ShowTitle" type="checkbox" ng-init="ShowTitle=true" />
                <label for="chkTitle">Title</label>
            </div>
            <div class="checkbox checkbox-primary check-box">
                <input id="chkCaption" class="clear" ng-model="ShowCaption" type="checkbox" ng-init="ShowCaption=true" />
                <label for="chkCaption">Caption</label>
            </div>
        </div>
    </div>
    <div class="pull-left inline-block mr-15 dt-buttons">
        @*<button class="dt-button buttons-pdf buttons-html5" tabindex="0" type="button" title="PDF"
                ng-click="Export('pdf')">
            <span>PDF</span>
        </button>*@
        <button class="dt-button buttons-print" tabindex="0" type="button" title="Print"
                ng-click="Export('print')">
            <span>Print</span>
        </button>
    </div>
    <select id="ddlDocSize" class="pull-left inline-block mr-15"
            ng-model="DocSize">
        <option value="a4">A4</option>
        <option value="a3">A3</option>
    </select>
    <select id="ddlDocOrientation" class="pull-left inline-block mr-15"
            ng-model="DocOrientation">
        <option value="portrait">Portrait</option>
        <option value="landscape">Landscape</option>
    </select>
    <select id="ddlFonts" class="pull-left inline-block mr-15"
            ng-model="FontSize">
        <option value="8">8</option>
        <option value="9">9</option>
        <option value="10">10</option>
        <option value="11">11</option>
        <option value="12">12</option>
        <option value="13">13</option>
        <option value="14">14</option>
    </select>
</div>

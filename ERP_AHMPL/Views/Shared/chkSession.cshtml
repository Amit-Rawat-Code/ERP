<div class="">
    <div class="input-box">
        <div class="checkbox checkbox-primary check-box">
            <input type="checkbox" ng-model="chkAllSession" ng-bind="chkAllSession=(selectedSessionCount==ListedSessions.length?true:false)" ng-change="AllSession();" class="ng-pristine ng-valid ng-binding ng-not-empty ng-touched">
            <label>Select All<span class="vd_red">*</span></label>
        </div>
        <div class="text-box-msg-r2" style="font-size: 10px;font-weight: 500;">
            Total Selection: <label ng-model="selectedSessionCount" ng-bind="selectedSessionCount=(ListedSessions | filter:{'IsActive' : 'true'}).length" class="ng-pristine ng-untouched ng-valid ng-binding ng-not-empty"></label>
        </div>
        <div class="input-box" style="width:100%; background:#206596; position:relative; float:left; color:#fff;">
            <div class="checkbox checkbox-primary check-box-head">
                Session
            </div>
        </div>
    </div>
</div>
<div class="" style="position:relative;">
    <div class="slimScrollDiv-height3" id="slimScrollDiv-height2">


        <table class="table compact table-hover table-striped table-bordered nowrap dataTable t-mgtb-n">
            <tbody>
                <tr ng-repeat="XL in ListedSessions">
                    <td class="srno">
                        <div class="checkbox checkbox-primary check-box chech-box-mp-n">
                            <input type="checkbox" ng-model="XL.IsActive" />
                            <label for=""> </label>
                        </div>
                    </td>
                    <td style="float: left;display:none ">{{XL.SessionId}}</td>
                    <td> {{XL.SessionName}}</td>
                </tr>
            </tbody>
        </table>
    </div>

</div>
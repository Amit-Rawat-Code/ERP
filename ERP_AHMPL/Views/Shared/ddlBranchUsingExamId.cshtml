<select id="ddlBranchExamId" class="select2 form-control validate"
        ng-init="GetBranchUsingId(8);disableBranch=false"
        ng-model="studentDetails.BranchId" ng-disabled="disableBranch">
    <option value="">Select Branch</option>
    <option ng-repeat="branch in Branchs" value="{{branch.BranchId}}" ng-disabled="!branch.IsActive">{{branch.BranchName}}</option>
</select>

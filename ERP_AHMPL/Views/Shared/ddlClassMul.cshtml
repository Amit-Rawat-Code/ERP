<div id="ddlClassMul" class="input-box chk-validate " ng-init="GetClasses();">
    <div class="toggle-ddl" id="openClassList"
         ng-init="ToogleDDL('openClassList','openClassList')">
        @*btn-validate*@
        <button class='btn btn-primary select-btn'
                data-ng-click='openClassList=!openClassList'
                ng-bind="GetCount(ClassList,'Select Class')">
            Select Class
        </button>
        @*btn-validate*@
        <button class='btn btn-primary dropdown-toggle select-btn-sub'
                data-ng-click='openClassList=!openClassList'>
            <span class='fa fa-chevron-down'></span>
        </button>
        <div ng-show="openClassList" class="ddlMultiple" ng-cloak>
            <div ng-click="ddlCheckAll('ClassList')">
                Check All
                <span class="btn-counts-right">Total Count: {{ClassList.length}}</span>
            </div>
            <div ng-click="ddlUnCheckAll('ClassList')">Uncheck All</div>
            <hr style="margin:0px !important" />
            <div ng-repeat="cl in ClassList">
                <input type="checkbox" ng-model="cl.chk" ng-value="cl.Code" ng-disabled="!cl.IsActive"
                       ng-change="ddlClass_Change(cl);" />
                {{cl.ClassName}}
                @*   <br />{{cl.TransId}}*@
            </div>
        </div>
    </div>

</div>
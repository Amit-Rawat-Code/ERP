<select id="ddlCountry" class="select2 form-control validate" ng-model="CountryCode" ng-init="GetCountry();"
        ng-change="GetState(CountryCode)">
    <option value="">Select Country</option>
    <option ng-repeat="x in Countrylist" value="{{x.Code}}">{{x.CountryName}}</option>
</select>



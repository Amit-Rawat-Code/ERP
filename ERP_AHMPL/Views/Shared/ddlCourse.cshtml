<select id="ddlCourse" class="select2 form-control validate" ng-model="studentDetails.CourseId"
        ng-init="GetCourses();"
        ng-change="GetClasses(studentDetails.CourseId);">
    <option value="">Select Course</option>
    <option ng-repeat="course in Courses" value="{{course.CourseId}}" ng-disabled="!course.IsActive">{{course.CourseName}}</option>
</select>


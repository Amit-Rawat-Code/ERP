<select id="ddlEmployee" class="select2 form-control validate" ng-model="$parent.FirstAuthEmployeeCode" ng-change="GetFirstAuthDetail($parent.FirstAuthEmployeeCode)">
    <option value="">Select Employee</option>
    <option ng-repeat="Employee in FirstEmployeesList" value="{{Employee.EmployeeCode}}" ng-disabled="!Employee.IsActive">{{Employee.FirstName}} {{Employee.MiddleName}} {{Employee.LastName}}</option>
</select>
 @*ng-init="GetEmployees();"*@
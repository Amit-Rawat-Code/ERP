<select id="ddlGender" class="select2 form-control validate" ng-model="Gender"
        ng-init="GetGender();">
    <option value="">Select Gender</option>
    <option ng-repeat="gender in GenderList" value="{{gender.Gender}}" >{{gender.Gender}}</option>
</select>



<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-cloak>

    <div class="collapse" id="CollapseSearchTableList">
        <div class="table-heading-box">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                @Html.Partial("_printingTool1")
            </div>
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="{{DocSize}} {{DocOrientation}}">

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding" id="ExportDiv">
                        <div id="SetPageMargin">
                            <div class="me-col-12" ng-init="GetReportHeaderUsingCategory('General Report')">
                                <div id="ReportHeader" ng-bind-html="ReportHeader"></div>
                            </div>
                            <div class="me-col-12 dt-print-view">
                                <h1>@ViewBag.Title</h1>
                                <br />
                            </div>
                            <table class="table compact table-hover table-bordered nowrap ">
                                <caption>
                                    <span style="font-weight: 600;">From Date : </span>
                                    <span>{{FromDate | date:'dd-MMM-yyyy'}}</span>
                                    <span style="font-weight: 600;">&nbsp;To Date : </span>
                                    <span>{{ToDate | date:'dd-MMM-yyyy'}}</span>
                                </caption>
                                <thead>
                                    <tr>
                                        <th colspan="4" style="text-align:center!important;">Income</th>
                                        <th colspan="2" style="text-align:center!important;">Expenditure</th>
                                    </tr>
                                    <tr>
                                        <th>Name</th>
                                        <th style="text-align:right;">Opening Bal</th>
                                        <th style="text-align:right;">Amt.</th>
                                        <th style="text-align:right;">Total</th>
                                        <th>Name</th>
                                        <th style="text-align:right;">Amt.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="IE in IncomeExpenditureList">
                                        <td>{{IE.IncomeHead}}</td>
                                        <td style="text-align:right;">{{ConvertToTwoDecimalPoint(IE.IOpeningBal)}}</td>
                                        <td style="text-align:right;">{{ConvertToTwoDecimalPoint(IE.IAmt)}}</td>
                                        <td style="text-align:right;">{{ConvertToTwoDecimalPoint(IE.Total)}}</td>
                                        <td>{{IE.ExpensesHead}}</td>
                                        <td style="text-align:right;">{{ConvertToTwoDecimalPoint(IE.EAmt)}}</td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr style="text-align:right ;font-weight:600">
                                        <td>Total :</td>
                                        <td>{{(Sumoflist('IncomeExpenditureList','IOpeningBal',null,null))}}</td>
                                        <td>{{(Sumoflist('IncomeExpenditureList','IAmt',null,null))}}</td>
                                        <td>{{(Sumoflist('IncomeExpenditureList','Total',null,null))}}</td>
                                        <td></td>
                                        <td>{{(Sumoflist('IncomeExpenditureList','EAmt',null,null))}}</td>
                                    </tr>
                                    <tr style="text-align:right ;font-weight:600">
                                        <td colspan="3">Bal :</td>
                                        <td>{{ConvertToTwoDecimalPoint((Sumoflist('IncomeExpenditureList','Total',null,null))-(Sumoflist('IncomeExpenditureList','EAmt',null,null)))}}</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="input-box chk-validate">
    <div class="toggle-ddl" id="openSections"
         ng-init="GetAllSections();ToogleDDL('openSections','openSections')">
        @*btn-validate*@
        <button class='btn btn-primary select-btn'
                data-ng-click='openSections=!openSections'
                ng-bind="GetCount(Sections,'Select Class')">
            Select Class
        </button>
        @*btn-validate*@
        <button class='btn btn-primary dropdown-toggle select-btn-sub'
                data-ng-click='openSections=!openSections'>
            <span class='fa fa-chevron-down'></span>
        </button>
        <div ng-show="openSections" class="ddlMultiple" ng-cloak>
            <div ng-click="ddlCheckAll('Sections');ddlopenSectionsCheckAll_click();">
                Check All
                <span class="btn-counts-right">Total Count: {{Sections.length}}</span>
            </div>
            <div ng-click="ddlUnCheckAll('Sections');ddlopenSectionsUnCheckAll_click();">Uncheck All</div>
            <hr style="margin:0px !important" />
            <div ng-repeat="sl in Sections">
                <input type="checkbox" ng-model="sl.chk" ng-value="sl.Code" ng-init="sl.chk=true"
                       ng-change="ddlopenSections_Change(sl);" ng-disabled="sl.disabled" ng-show="sl.IsActive && sl.ClassIsActive" />
                {{sl.ClassName}}-{{sl.SectionName}}
            </div>
        </div>
    </div>
</div>

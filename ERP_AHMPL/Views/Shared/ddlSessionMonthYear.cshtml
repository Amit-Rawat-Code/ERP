<select id="ddlSessionYear" name="Year" autocomplete='address-level2' class="select2 form-control validate"
        ng-model="SessionYear" ng-init="GetSessionYear()" ng-change="ddlsessionyear_change()">
    <option value="">Select MonthYear</option>
    <option ng-repeat="year in SessionYears" value="{{year.MonthYear}}">{{year.MonthYear}}</option>
</select>

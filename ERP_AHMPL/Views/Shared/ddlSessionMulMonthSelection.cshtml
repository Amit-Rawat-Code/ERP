
<select id="ddlSessionMonth" multiple autocomplete='address-level2' class="select2 form-control validate"
        ng-model="SessionMonth" extra-settings="dropdownSetting" checkboxes="true">
    <option value="">Select Month</option>
    <option ng-repeat="month in SessionMonths|filter:{'Year':SessionYear}" ng-value="month.Month">{{month.Month}}</option>
</select>




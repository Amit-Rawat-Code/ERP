<select id="ddlSessionYear" name="Year" autocomplete='address-level2' class="select2 form-control validate"
        ng-model="SessionYear" ng-init="GetSessionYear()" ng-change="GetSessionMonth()">
    <option value="">Select Year</option>
    <option ng-repeat="year in SessionYears | unique: 'Year'" ng-value="year.Year">{{year.Year}}</option>
</select>

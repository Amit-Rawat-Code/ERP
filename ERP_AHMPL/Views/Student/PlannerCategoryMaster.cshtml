
@{
    ViewBag.Title = "PlannerPlanner CategoryMaster";
    ViewBag.TitleList = "Planner Category Master List";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script>
    $(document).ready(function () {


        $('#btnSave').click(function () {
            if (isValidate()) {
                var collectionobj = {};
                collectionobj.PlannerCategoryId = $('#Id').text();
                collectionobj.PlannerCategoryName = $('#txtPlannerCategoryName').val();
                collectionobj.PlannerCategoryColour = $('#txtPlannerCategoryColour').val();
                collectionobj.IsActive = $('#ddlIsActive option:selected').val();
                collectionobj.SessionId = sessionId;
                collectionobj.FYId = fyId;
                collectionobj.SchoolCode = schoolCode;
                collectionobj.BranchCode = branchCode;
                collectionobj.CreatedBy = JSON.parse(userid);
                collectionobj.UpdatedBy = JSON.parse(userid);

                var path = "";
                if ($('#btnSavetxt').text() == "Save") {
                    path = '@Url.Action("InsertPlannerCategoryMaster", "Student")';
                }
                else {
                    path = '@Url.Action("EditPlannerCategoryMaster", "Student")';
                }

                $.ajax({
                    url: path,
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: '{obj:' + JSON.stringify(collectionobj) + '}',
                    datatype: "json",
                    success: function (response) {
                        clearControl();
                        showMsgBox(response);
                    }
                });
            }
        });
        /*Search Button Click Event*/
        $("#btnSearch").click(function () {
            $('#collapseinputbox').attr('class', 'collapse in');
            $('#CollapseSearchTableList').attr('class', 'collapse');
            started();
        });
        function started() {
            
            var collectionobj = {};
                collectionobj.Action = 4;
                collectionobj.PlannerCategoryId = $('#Id').text();
                collectionobj.SessionId = sessionId;
                collectionobj.SchoolCode = schoolCode;
                collectionobj.BranchCode = branchCode;
         $.ajax({
                url: "@Url.Action("PlannerCategoryMasterList", "Student")",
                data: '{obj:' + JSON.stringify(collectionobj) + '}',
                type: "POST",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    loadData(data);
                },
                error: function () {
                    alert("Failed! Please try again.");
                }
            });
    };
      
        /*Delete Button Click Event*/
        $('#btnDelete').click(function () {
            deleteConfirmbox("Do you want to delete this record?", deleteRecord);
        });
        function deleteRecord() {
            var collectionobj = {};
                collectionobj.SessionId = sessionId;
                collectionobj.PlannerCategoryId = $('#Id').text();
                collectionobj.UpdatedBy = JSON.parse(userid);

                $.ajax({
                    url: '@Url.Action("DeletePlannerCategory", "Student")',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: '{obj:' + JSON.stringify(collectionobj) + '}',
                    datatype: "json",
                    success: function (response) {
                        clearControl();
                        showMsgBox(response);
                    }
                });
        };
      

        $('#btnClear').click(function () {
            
            clearConfirmbox("Do you want to clear fields?", clearControl);
        });

        /*Refresh Search Table Record*/
        $(document).on("click", ".RefreshSearchTable", function (e) {
            
            var panelToRefresh = $(this).closest('.panel').find('.refresh-container');
            var dataToRefresh = $(this).closest('.panel').find('.panel-wrapper');
            var loadingAnim = panelToRefresh.find('.loading-progress');
            panelToRefresh.show();
            setTimeout(function () {
                loadingAnim.addClass('la-animate');
            }, 100);
            started();
            return false;
        });
    });

    function loadData(data) {
        // Here we will format & load/show data
        var tblheader =
        [
            { "Header": "Id", "Width": "40px" },
            { "Header": "Planner Category", "Width": "100%" },
            { "Header": "Colour", "Width": "100%" },
            { "Header": "Active", "Width": "100%" }

        ];

        var tblrows = [];
        $.each(data, function (i, val) {
            var rowObj = {};
            rowObj["Id"] = val.PlannerCategoryId;
            rowObj["PlannerCategoryName"] = val.PlannerCategoryName;
            rowObj["PlannerCategoryColour"] = val.PlannerCategoryColour;
            rowObj["IsActive"] = (val.IsActive == true ? 'Yes' : 'No');

            tblrows.push(rowObj);
        });
        loadDataTable(tblheader, tblrows)
    };

    function datatable() {

        var table = $('#example').DataTable();

        // Apply the search
        table.columns().every(function () {
            var that = this;
            $('input', this.footer()).on('keyup change', function () {
                if (that.search() !== this.value) {
                    that.search('^' + this.value, true, false).draw();
                }
            });
        });


        $('#example tbody').on('dblclick', 'tr', function () {

            var row = table.row(this).data();
            var index = $(this).index();
            var value = $('#hdId_' + index + '').val();

            $("#example > tr").click(function () {
                $(this).toggleClass("active");
            });

            $('#Id').text(value);
            $('#txtPlannerCategoryName').val(row[1]);
            $('#txtPlannerCategoryColour').val(row[2]);
            $('#ddlIsActive').val(row[3] == "Yes" ? "True" : "False");


            $('#btnSave').val("Edit");
            $('#btnSavetxt').text("Edit");
            $('#btnDelete').attr("disabled", false);

            //collapse box
            $('#collapseinputbox').fadeIn();
            $('#CollapseSearchTableList').fadeOut();

            $('#txtPlannerCategoryColour').focus();

        });

        $('#example tbody').on('click', 'td', function () {
            var tfootinput = $('#example tfoot tr th input');
            tfootinput[$(this).index()].focus();
        });

        var colourColIndex;
        $.each($('#example thead tr th'), function () {
            var th = $(this);
            var colour = th.text();
            if (colour == 'Colour') {
                colourColIndex = $(this).index();
            };
        });

        //$('#example tbody tr td:nth-child(' + colourColIndex + ')').css("background-color", "red");

        $.each($('#example tbody tr td:nth-child(' + (colourColIndex+1) + ')'), function () {
            var td = $(this);
            var span = $('<span  style="background-color: #' + td.text() + ';float: right;width: 18px;">&nbsp;</span>');
            td.append(span);
        });

        $('.refresh-container').fadeOut(2000);
    }

</script>

<input type="hidden" id="Id" name="Id" value="" />

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Planner Category Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><span>Administrator</span></li>
                <li class="active"><span>Planner Category Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Planner Category Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPlannerCategoryName", "", new { @class = "form-control clear validate", @placeholder = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Planner Category Colour<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPlannerCategoryColour", "", new { @class = "form-control colorpicker validate", @placeholder = "", @value = "#7ab2fa" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn3-nM3-3 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("Search")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>





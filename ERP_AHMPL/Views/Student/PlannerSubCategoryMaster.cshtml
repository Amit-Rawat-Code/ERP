
@{
    ViewBag.Title = "PlannerPlanner CategoryMaster";
    Layout = "~/Views/Common/_CommonLayout.cshtml";
}

<script>
    $(document).ready(function () {

        
        $('#btnSave').click(function () {
            if (isValidate()) {
                var collectionobj = {};
                collectionobj.PlannerCategoryId = $('#Id').text();
                collectionobj.PlannerCategoryName = $('#txtPlannerCategoryName').val();
                collectionobj.PlannerCategoryColour = $('#txtPlannerCategoryColour').val();
                collectionobj.IsActive = $('#ddlIsActive option:selected').val();
                collectionobj.SessionId = sessionId;
                collectionobj.FYId = fyId;
                collectionobj.SchoolCode = schoolCode;
                collectionobj.BranchCode = branchCode;
                collectionobj.CreatedBy = JSON.parse(userid);
                collectionobj.UpdatedBy = JSON.parse(userid);

                var path = "";
                if ($('#btnSave').val() == "Save") {
                    path = '@Url.Action("InsertPlannerCategoryMaster", "Student")';
                }
                else {
                    path = '@Url.Action("EditPlannerCategoryMaster", "Student")';
                }

                $.ajax({
                    url: path,
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: '{obj:' + JSON.stringify(collectionobj) + '}',
                    datatype: "json",
                    success: function (response) {
                        clearControl();
                        showMsgBox(response);
                    }
                });
            }
        });
        // This is for Get All Data
        $("#btnSearch").click(function () {

            $.ajax({
                url: "@Url.Action("PlannerCategoryMasterList", "Student")",
                data: '{schoolcode:' + JSON.stringify(schoolCode) + ',branchcode:' + JSON.stringify(branchCode) + ',sessionId:' + JSON.stringify(sessionId) + '}',
                type: "POST",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    loadData(data);
                },
                error: function () {
                    alert("Failed! Please try again.");
                }
            });

        });

        $('#btnDelete').click(function () {
            if (confirm("Do you want to delete this record?")) {
                var collectionobj = {};
                collectionobj.SessionId = sessionId;
                collectionobj.PlannerCategoryId = $('#Id').text();
                collectionobj.UpdatedBy = JSON.parse(userid);

                $.ajax({
                    url: '@Url.Action("DeletePlannerCategory", "Student")',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: '{obj:' + JSON.stringify(collectionobj) + '}',
                    datatype: "json",
                    success: function (response) {
                        clearControl();
                        showMsgBox(response);
                    }
                });
            }
        });

        $('#btnClear').click(function () {
            if (confirm("Do you want to clear fields?")) {
                clearControl();
            }
        });
    });

    function loadData(data) {
        // Here we will format & load/show data
        var tblheader =
        [
            { "Header": "Id", "Width": "40px" },
            { "Header": "Planner Category", "Width": "100px" },
            { "Header": "Colour", "Width": "80px" },
            { "Header": "Active", "Width": "80px" }

        ];

        var tblrows = [];
        $.each(data, function (i, val) {
            var rowObj = {};
            rowObj["Id"] = val.PlannerCategoryId;
            rowObj["PlannerCategoryName"] = val.PlannerCategoryName;
            rowObj["PlannerCategoryColour"] = val.PlannerCategoryColour;
            rowObj["IsActive"] = (val.IsActive == true ? 'Yes' : 'No');

            tblrows.push(rowObj);
        });
        loadDataTable(tblheader, tblrows)
    };

    function datatable() {

        var table = $('#example').DataTable();

        // Apply the search
        table.columns().every(function () {
            var that = this;
            $('input', this.footer()).on('keyup change', function () {
                if (that.search() !== this.value) {
                    that.search('^' + this.value, true, false).draw();
                }
            });
        });


        $('#example tbody').on('dblclick', 'tr', function () {

            var row = table.row(this).data();
            var index = $(this).index();
            var value = $('#hdId_' + index + '').val();

            $('#Id').text(value);
            $('#txtPlannerCategoryName').val(row[1]);
            $('#txtPlannerCategoryColour').val(row[2]);
            $('#ddlIsActive').val(row[3] == "Yes" ? 1 : 0);


            $('#simplemodal-close').click();
            $('#btnSave').val("Edit");
            $('#btnDelete').attr("disabled", false);

            $('#txtPlannerCategoryColour').focus();

        });

        $('#example tbody').on('click', 'td', function () {
            var tfootinput = $('#example tfoot tr th input');
            tfootinput[$(this).index()].focus();
        });

        var colourColIndex;
        $.each($('#example thead tr th'), function () {
            var th = $(this);
            var colour = th.text();
            if (colour == 'Colour') {
                colourColIndex = $(this).index();
            };
        });

        //$('#example tbody tr td:nth-child(' + colourColIndex + ')').css("background-color", "red");

        $.each($('#example tbody tr td:nth-child(' + (colourColIndex+1) + ')'), function () {
            var td = $(this);
            var span = $('<span  style="background-color: #' + td.text() + ';float: right;width: 18px;">&nbsp;</span>');
            td.append(span);
        });

        $("#close").on('click', function () {
            $("#modal").hide(500);
        });
    }

</script>
@*<h2>Planner Category Master</h2>*@
<input type="hidden" id="Id" name="Id" value="" />
<div class="col-md-7 margin-top-8">
    <section class="widget">
        <div class="body">
            <form id="user-form" class="form-horizontal form-label-left">
                <fieldset>
                    <legend class="section"><i class="fa fa-user"></i> Planner Category Master <small> edit Planner Category master</small></legend>
                    <div class="form-group">
                        <label class="control-label col-sm-4" for="prefix">Category Name<span class="required">*</span></label>
                        <div class="col-sm-4">
                            @Html.TextBox("txtPlannerCategoryName", "", new { @class = "form-control clear validate", @placeholder = "Planner Category Name" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-sm-4" for="prefix">Category Colour<span class="required">*</span></label>
                        <div class="col-sm-4">
                            @Html.TextBox("txtPlannerCategoryColour", "", new { @class = "form-control jscolor validate", @placeholder = "Planner Category Colour" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="state" class="control-label col-sm-4">Is Active<span class="required">*</span></label>
                        <div class="col-sm-4">
                            @Html.Partial("ddlActive")
                        </div>
                    </div>
                </fieldset>
                <div class="form-actions">
                    <div class="row">
                        @Html.Partial("ActionView")
                    </div>
                </div>
            </form>
        </div>
        <div>
            @Html.Partial("Search")
        </div>
    </section>
</div>




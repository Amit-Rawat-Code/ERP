                                                                </div>
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>


                                                        </div>
                                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15"
                                                             ng-if="OptionalSubjectList.length>0">
                                                            <label class="control-label">Optional Subject</label>
                                                            <div class="input-box">
                                                                @Html.Partial("chkOptionalSubject")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Active<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlActive")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Fee Type</label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlFeeType")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15" ng-if="FeeStructure.length>0">
                                                            <label class="control-label">
                                                                Fee Structure<span class="vd_red"></span>
                                                            </label>
                                                            <div class="input-box">
                                                                <div class="datatable-responsive table-responsive advance-btn-table">
                                                                    <table class="table compact table-hover table-striped table-bordered
                                                                        nowrap dataTable">
                                                                        <tr>
                                                                            <th>Sr.No.</th>
                                                                            <th>
                                                                                <input type="checkbox" ng-model="$parent.chkAll"
                                                                                       ng-init="$parent.chkAll=false"
                                                                                       ng-change="CheckAllCheck();" />
                                                                            </th>
                                                                            <th>Fee</th>
                                                                            <th>Fee Type</th>
                                                                            <th style="text-align:right">(₹) Fee Amount</th>
                                                                            <th style="text-align:right">(%) Fee Disc</th>
                                                                            <th style="text-align:right">(₹) Fee Disc</th>
                                                                            <th style="text-align:center">Remark</th>
                                                                        </tr>
                                                                        <tr ng-repeat="feestructure in FeeStructure">
                                                                            <td>{{$index+1}}</td>
                                                                            <td>
                                                                                <input type="checkbox" ng-model="chk[feestructure.FeeCode]"
                                                                                       ng-init="chk[feestructure.FeeCode]
                                                                                   =feestructure.isAlloted"
                                                                                       ng-click="UnCheckChkAll();" />
                                                                            </td>
                                                                            <td>{{feestructure.Name}}</td>
                                                                            <td>{{feestructure.FeeType}}</td>
                                                                            <td ng-model="FeeAmt[feestructure.FeeCode]"
                                                                                ng-init="FeeAmt[feestructure.FeeCode]=feestructure.FeeAmt">

                                                                                <input style="text-align:right" type="text"
                                                                                       ng-model="feestructure.FeeAmt"
                                                                                       ng-value="feestructure.FeeAmt"
                                                                                       @*ng-disabled="true"*@
                                                                                       class="form-control t-input" />
                                                                            </td>
                                                                            <td>
                                                                                <input style="text-align:right"
                                                                                       ng-model="feestructure.DisPer" type="text"
                                                                                       ng-value="feestructure.DisPer"
                                                                                       ng-change="feestructure.DisPer=
                                                                                   numbersOnly(feestructure.DisPer);
                                                                                   CalculateFeeAmount(
                                                                                   FeeAmt[feestructure.FeeCode],
                                                                                   feestructure.DisPer,$index)"
                                                                                       class="form-control t-input"
                                                                                       ng-disabled="chk[feestructure.FeeCode]==false?true:false" />
                                                                            </td>
                                                                            <td>
                                                                                <input style="text-align:right"
                                                                                       ng-model="feestructure.DisAmt" type="text"
                                                                                       class="form-control t-input"
                                                                                       ng-value="feestructure.DisAmt" ng-disabled="true" />
                                                                            </td>
                                                                            <td>
                                                                                <input ng-model="feestructure.Remarks" type="text"
                                                                                       class="form-control t-input"
                                                                                       ng-value="feestructure.Remarks" ng-disabled="chk[feestructure.FeeCode]==false?true:false" />
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td></td>
                                                                            <td></td>
                                                                            <td></td>
                                                                            <td>Total</td>
                                                                            <td ng-model="TotalAmount" style="text-align:right">
                                                                                {{Formatter(TotalAmount)}}
                                                                            </td>
                                                                            <td></td>
                                                                            <td></td>
                                                                            <td></td>
                                                                        </tr>
                                                                    </table>

                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @*Tab Box 4*@

                                                    <div class="tab-pane" id="tab4">
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Student Photo<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                <input id="fuStudentPhoto" type="file" name="file" class="dropify" data-max-file-size-preview="3M" onchange="angular.element(this).scope().SelectImage(this, '#imgStudentPhoto', 'StudentPhoto')" />
                                                                <img id="imgStudentPhoto" ng-model="studentDetails.StudentPhoto" style="display:none;" />
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Photo<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                <input id="fuFatherPhoto" type="file" name="file" class="dropify" data-max-file-size-preview="3M" onchange="angular.element(this).scope().SelectImage(this, '#imgFatherPhoto', 'FatherPhoto')" />
                                                                <img id="imgFatherPhoto" ng-model="studentDetails.FatherPhoto" style="display:none;" />
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Mother Photo<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                <input id="fuMotherPhoto" type="file" name="file" class="dropify" data-max-file-size-preview="3M" onchange="angular.element(this).scope().SelectImage(this, '#imgMotherPhoto', 'MotherPhoto')" />
                                                                <img id="imgMotherPhoto" ng-model="studentDetails.MotherPhoto" style="display:none;" />
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Group Photo<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                <input id="fuGroupPhoto" type="file" name="file" class="dropify" data-max-file-size-preview="3M" onchange="angular.element(this).scope().SelectImage(this, '#imgGroupPhoto', 'GroupPhoto')" />
                                                                <img id="imgGroupPhoto" ng-model="studentDetails.GroupPhoto" style="display:none;" />
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Guardian Photo<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                <input id="fuGuardianPhoto" type="file" name="file" class="dropify" data-max-file-size-preview="3M" onchange="angular.element(this).scope().SelectImage(this, '#imgGuardianPhoto', 'GuardianPhoto')" />
                                                                <img id="imgGuardianPhoto" ng-model="studentDetails.GuardianPhoto" style="display:none;" />
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>



                                                    </div>

                                                    @*Tab Box 5*@

                                                    <div class="tab-pane" id="tab5">
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Previos School<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtPrvSchool", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.PrvSchool" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Previos Board<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtPrvBoard", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.PrvBoard" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Previos Class<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtPrvClass", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.PrvClass" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Previos RollNo<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtPrvRollNo", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.PrvRollNo" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Previos Enrollment<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtPrvEnrollment", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.PrvEnrollment" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Max Marks<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtMaxMarks", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.MaxMarks" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Obtain Marks<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtObtainMarks", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.ObtainMarks" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">

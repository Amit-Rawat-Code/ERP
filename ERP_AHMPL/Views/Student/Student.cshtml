@{
    ViewBag.Title = "Student Registartion/Updation";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
@*<meta http-equiv="Cache-Control" content="no-cache" />*@
<script src="~/Scripts/myjslib/studentRegistrationController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="studentDetails.StudentCode" />

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Registration Form</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Student</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Registration Form</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper collapse in ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Admission Form No.<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtAdmissionFormNo", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.AdmissionFormNo" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">
                                                Serial No.
                                                <span class="vd_red font-10 text-bold">(serial no. should be numeric)</span>
                                            </label>
                                            <div class="input-box">
                                                @Html.TextBox("txtRegistrationNo", "", new
                                           {
                                               @class = "form-control",
                                               @placeholder = "",
                                               @ng_model = "studentDetails.RegistrationNo",
                                               @ng_change = "studentDetails.RegistrationNo=numbersOnly(studentDetails.RegistrationNo)"
                                           })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-if="isAutometic">
                                            <label class="control-label">Reg.No./Std.Id<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtStudentId", "", new
                                           {
                                               @class = "form-control",
                                               @placeholder = "",
                                               @ng_model = "studentDetails.StudentId"
                                           })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                        <div id="wizard" class="form-wizard wizard">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                                <ul class="wizard-navigation nav-justified steps">
                                                    <li id="li1">
                                                        <a href="#tab1" data-toggle="tab" id="a1">
                                                            <span class="number">1</span>
                                                            <span class="title">General Details</span>
                                                        </a>
                                                    </li>
                                                    <li id="li2">
                                                        <a href="#tab2" data-toggle="tab" id="a2">
                                                            <span class="number">2</span>
                                                            <span class="title">Family Details</span>
                                                        </a>
                                                    </li>
                                                    <li id="li3">
                                                        <a href="#tab3" data-toggle="tab" id="a3">
                                                            <span class="number">3</span>
                                                            <span class="title">Official Details</span>
                                                        </a>
                                                    </li>
                                                    <li id="li4">
                                                        <a href="#tab4" data-toggle="tab" id="a4">
                                                            <span class="number">4</span>
                                                            <span class="title">Photos</span>
                                                        </a>
                                                    </li>
                                                    <li id="li5">
                                                        <a href="#tab5" data-toggle="tab" id="a5">
                                                            <span class="number">5</span>
                                                            <span class="title">Previous Details</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                                <div id="bar" class="progress progress-xs mgtp-xs-20">
                                                    <div class="progress-bar progress-bar-striped active"></div>
                                                </div>

                                            </div>
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                                <div class="tab-content">
                                                    @*Tab Box 1*@

                                                    <div class="tab-pane" id="tab1">
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">First Name<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtFirstName", "", new { @class = "form-control clear validate", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.FirstName" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Middle Name</label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtMiddelName", "", new { @class = "form-control", @placeholder = "", autocomplete = "name", @ng_model = "studentDetails.MiddelName" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Last Name<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtLastName", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.LastName" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Date of Birth<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtDateofBirth", "", new { @class = "form-control clear", @placeholder = "", @type = "Date", @ng_model = "studentDetails.DateofBirth" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Age on Date<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtAgeonDate", "", new { @class = "form-control", @placeholder = "", @type = "Date", @ng_model = "studentDetails.AgeonDate", @ng_init = "studentDetails.AgeonDate=BindAgeonDate();" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Gender<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlGender")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">E-mail ID<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtEmail", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "email", @onblur = "validateEmail('#txtEmail')", @ng_model = "studentDetails.Email", @ng_value = "studentDetails.Email" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Mobile No.<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtMobileNo", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "tel-national", @onblur = "validatePhoneNo('#txtMobileNo')", @ng_model = "studentDetails.MobileNo", @ng_value = "studentDetails.MobileNo", @maxlength = "10" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Mother Tongue<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtMotherTongue", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.MotherTongue" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Nationality<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlNationality")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Religion<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlReligion")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Category<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlCategory")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Caste<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlCaste")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Aadhaar No.<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtAadhaarNo", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.AadhaarNo", @aadhaar = "aadhaar" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Blood Group<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlBloodGroup")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Vision<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtVision", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.Vision" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Height<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtHeight", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.Height" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Weight<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtWeight", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.Weight" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Dental Hygiene<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtDentalHygiene", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.DentalHygiene" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Oral Hygiene<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtOralHygiene", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.OralHygiene" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Identification Mark<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtIdentificationMark", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.IdentificationMark" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Specific Ailment<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtSpecificAilment", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.SpecificAilment" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Physically Disabled<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                <div class="radio radio-primary radio-box">
                                                                    @Html.RadioButton("IsPhysicallyDisabled", true, false, new { @ng_model = "studentDetails.IsPhysicallyDisabled" })
                                                                    <label for="IsPhysicallyDisabled">Yes</label>
                                                                </div>
                                                                <div class="radio radio-primary radio-box">
                                                                    @Html.RadioButton("IsPhysicallyDisabled", false, true, new { @ng_model = "studentDetails.IsPhysicallyDisabled", @ng_init = "studentDetails.IsPhysicallyDisabled='False'" })
                                                                    <label for="IsPhysicallyDisabled">No</label>
                                                                </div>

                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 input-visible-isnotphysicallydisabled-hide">
                                                            <label class="control-label">Name of Disability<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtNameofDisability", "", new { @class = "form-control", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.NameofDisability" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 input-visible-isnotphysicallydisabled-hide">
                                                            <label class="control-label">Certificate No.<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtCertificateNo", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.CertificateNo" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 input-visible-isnotphysicallydisabled-hide">
                                                            <label class="control-label">Issued By<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtIssuedBY", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.IssuedBY" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 input-visible-isnotphysicallydisabled-hide">
                                                            <label class="control-label">Disability Details<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtDisabilityDetails", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.DisabilityDetails" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    @*Tab Box 2*@

                                                    <div class="tab-pane" id="tab2">
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Name<span class="vd_red">*</span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtFatherName", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "studentDetails.FatherName" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Occupation<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlFatherOccupation")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Occupation Type<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtFatherOccupationType", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.FatherOccupationType" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Designation<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtFatherDesignation", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.FatherDesignation" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Qualification<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtFatherQualification", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.FatherQualification" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Annual Income<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtFatherAnnualIncome", "", new { @class = "form-control", @placeholder = "", @ng_model = "studentDetails.FatherAnnualIncome" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Nationality<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.Partial("ddlFatherNationality")
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father E-mail<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtFatherEmail", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "email", @onblur = "validateEmail('#txtFatherEmail')", @ng_model = "studentDetails.FatherEmail" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Office Address<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextArea("txtFatherOfficeAddress", "", new { @class = "form-control", @rows = "1", @placeholder = "", @autocomplete = "street-address", @ng_model = "studentDetails.FatherOfficeAddress" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <label class="control-label">Father Contact No.<span class="vd_red"></span></label>
                                                            <div class="input-box">
                                                                @Html.TextBox("txtFatherContactNo", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "tel-national", @onblur = "validatePhoneNo('#txtFatherContactNo')", @ng_model = "studentDetails.FatherContactNo", @maxlength = "10", @ng_change = "studentDetails.CorrespondanceMobileNo=studentDetails.FatherContactNo" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">

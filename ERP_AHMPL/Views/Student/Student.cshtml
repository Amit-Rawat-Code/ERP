                                                            <div class="input-box">
                                                                @Html.TextBox("txtObPercentage", "", new { @class = "form-control clear", @placeholder = "", @autocomplete = "name", @ng_model = "studentDetails.ObPercentage" })
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="description ml mr mt-n-md">
                                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                                            <ul class="pager wizard">
                                                                <li class="previous">
                                                                    <button id="btnprev" class="btn btn-primary pull-left"><i class="fa fa-caret-left"></i> Previous</button>
                                                                </li>
                                                                <li class="next">
                                                                    <button class="btn btn-primary pull-right">Next <i class="fa fa-caret-right"></i></button>
                                                                </li>
                                                                <li class="finish" style="display: none">
                                                                    @*<button ng-click="RegisterStudent();" class="btn btn-success pull-right">Finish <i class="fa fa-check"></i></button>*@

                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-center">
                                        @Html.Partial("ActionView")
                                    </div>

                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                    @Html.Partial("SearchAngularJs")
                                </div>
                            </div>

                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .input-visible-isphysicallydisabled-show {
        display: block !important;
    }

    .input-visible-isnotphysicallydisabled-hide {
        display: none !important;
    }
</style>
<script>
    $('#ddlStream').addClass('validate');
    $('#ddlFeeType').removeClass('validate');
    $('#ddlHouse').removeClass('validate');

    $('#ddlParmanentCountry').removeClass('validate');
    $('#ddlParmanentState').removeClass('validate');
    $('#ddlParmanentCity').removeClass('validate');

    $('#ddlLocalCountry').removeClass('validate');
    $('#ddlLocalState').removeClass('validate');
    $('#ddlLocalCity').removeClass('validate');

    $('#ddlGuardianCountry').removeClass('validate');
    $('#ddlGuardianState').removeClass('validate');
    $('#ddlGuardianCity').removeClass('validate');
</script>



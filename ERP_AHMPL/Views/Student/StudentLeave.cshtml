
@{
    ViewBag.Title = "StudentLeave";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

 
<script src="~/Scripts/myjslib/StudentLeaveController.js?Ver=@ViewBag.Version"></script>
 
<input type="hidden" id="hdnLeaveId" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Student Leave</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><span>Student</span></li>
                <li class="active"><span>Student Leave</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form"> 
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Start Event from<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                         
                                             @Html.TextBox("txtStartDate", "", new { @type = "date", @ng_Model = "StartDate", @class = "form-control clear validate" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">End Till<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                           @Html.TextBox("txtEndDate", "", new { @type = "date",@ng_Model = "EndDate",@class = "form-control clear validate", @placeholder = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                         </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive") 
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8 col-sm-8 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Leave Reason<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <textarea name="editor" id="txtLeaveReson" style="height:90px"   ng-model="LeaveReason" class="form-control clear" rows="1"></textarea>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                    

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>
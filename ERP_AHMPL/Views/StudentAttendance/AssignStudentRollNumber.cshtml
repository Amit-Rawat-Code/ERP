
@{
    ViewBag.Title = "Assign Student Roll Number";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}


<script src="~/scripts/myjslib/AssignStudentRollNumberController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-2 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">@ViewBag.Title</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><a href="#"><span>Exam</span></a></li>
                <li><a href="#"><span>Master</span></a></li>
                <li class="active"><span>@ViewBag.Title</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 no-padding">
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Class With Sections<span class="vd_red">*</span></label>
                                                <div class="form-group">
                                                    <select id="ddlClassSection" class="select2 form-control" ng-model="AllClassSection" ng-init="GetAllClassesWithSections();" ng-change="ddlClass_Change();">
                                                        <option value="">Select Class With Sections</option>
                                                        <option ng-repeat="cl in AllClassSectionList" value="{{cl.Code}}" ng-disabled="!cl.IsActive">{{cl.ClassSectionName}}</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Order By<span class="vd_red"></span></label>
                                                <div class="form-group">
                                                    <select id="ddlTeacher" class="select2 form-control" ng-model="OrderBy" ng-init="1" ng-change="Order_Change()">
                                                        <option value="">Select</option>
                                                        <option value="1">Name</option>
                                                        <option value="2">Date Of Admission</option>
                                                    </select>
                                                </div>
                                            </div>
                                            

                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            <table id="example2" class="table table-striped table-bordered compact" style="width:100%" ng-if="StudentList.length>0">
                                                <thead>
                                                    <tr>
                                                        <th>S.No.</th>
                                                        <th>Student Id</th>
                                                        <th>Student Name</th>
                                                        <th>Admission Number</th>
                                                        <th>Father Name</th>
                                                        <th>Old Roll Number</th>
                                                        <th>New Roll Number</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="student in StudentList">
                                                        <td ng-bind="student.Srno=($index+1)"></td>
                                                        <td>{{student.StudentID}}</td>
                                                        <td>{{student.StudentName}}</td>
                                                        <td>{{student.AdmissionNo}}</td>
                                                        <td>{{student.FatherName}}</td>
                                                        <td>{{student.NewRollNo}}</td>
                                                        <td>{{student.RollNo}}</td>
                                                       
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                <label class="control-label"><span class="vd_red"></span></label>
                                <div class="input-box">
                                    <button id="btnprev" class="btn btn-primary center" ng-click="SaveRecord()"> Assign Roll Number  <i class="fa fa-long-arrow-right"></i></button>
                                    <div class="text-box-msg-r">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- Row -->
    </div>
</div>


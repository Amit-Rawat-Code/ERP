
@{
    ViewBag.Title = "StudentAttendanceSubjectWise";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/StudentAttendanceSubjectWiseController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" id="Id" name="hfId" value="" />
<input type="hidden" id="hfVoucherNo" name="VoucherNo" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Student Attendance Subject Wise</h5>
        </div>
        <!-- Breadcrumb -->
          <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Attendance</span></li>
                <li><span>Student</span></li>
                
                <li class="active"><span>Student Attendance Subject Wise</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                       
                                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 no-padding ">
                                            <div class="col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Attendance Date<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.TextBox("txtAttendanceDate", "", new { @class = "form-control clear validate ", @type = "date", @ng_model = "AttendanceDate", @ng_change = "BlanckDetails()", @max = "{{endDate}}", @min = "{{startDate}}" })
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Class<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlClassUsingId")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Section<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlSectionUsingId")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Subject<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlSubjectUsingId")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Period<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <select id="ddlPeriod" class="select2 form-control validate" ng-model="PeriodCode" ng-disabled="disablePeriod">
                                                        <option value="">Select Period</option>
                                                        <option ng-repeat="period in PeriodsList" value="{{period.PeriodCode}}">{{period.PeriodName}}</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="col-md-8 col-sm-12 col-xs-12 no-padding ">
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 mgtp-24">
                                                @Html.Partial("TableSubjectwiseStudentAttendanceList")
                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 mgtp-24 ">

                                                @Html.Partial("ActionView")

                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("Search")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>

<script>
    $('#ddlSection').addClass('validate');
</script>

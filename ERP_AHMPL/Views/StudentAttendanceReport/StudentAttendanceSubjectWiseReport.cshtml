
@{
    ViewBag.Title = "StudentAttendanceSubjectWiseReport";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/scripts/myjslib/StudentAttendanceSubjectWiseReportController.js"></script>
<script src="https://cdn.rawgit.com/harvesthq/chosen/gh-pages/chosen.jquery.min.js"></script>
<link href="https://cdn.rawgit.com/harvesthq/chosen/gh-pages/chosen.min.css" rel="stylesheet" />


<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark"> @ViewBag.Title</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Attendance</span></li>
                <li><span>Report</span></li>
                <li class="active"><span>@ViewBag.Title</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                    <div class="collapse in">
                                        <form id="user-form">
                                            <div class="section-toggle">
                                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2" style="padding-top:14px; padding-left:0px"></div>
                                                <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8" style="padding-top:14px; padding-left:0px">
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="padding-top:14px; padding-left:0px">
                                                        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2" style="padding-top:14px; padding-left:0px">
                                                            <label class="control-label">Class<span class="vd_red">*</span></label>
                                                        </div>
                                                        <div class="col-lg-10 col-md-10 col-sm-10 col-xs-10" style="padding-top:14px; padding-left:0px;">
                                                            
                                                                @Html.Partial("ddlClassWithSectionMultiple")
                                                            
                                                        </div>


                                                        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2" style="padding-top:14px; padding-left:0px">
                                                            <label class="control-label">Section<span class="vd_red">*</span></label>
                                                        </div>
                                                        <div class="col-lg-10 col-md-10 col-sm-10 col-xs-10" style="padding-top:14px; padding-left:0px">
                                                            <div class="input-group input-daterange" id="fromToDate" calendar ng-model="fromToDate">
                                                                <input class="form-control validate" id="txtFromDate" max="{{endDate}}" min="{{startDate}}" name="txtFromDate" ng-init="SetMaxMinDate()" ng-model="FromDate" type="date" value="">
                                                                <span class="input-group-addon">to</span>
                                                                <input type="date" class="form-control input-sm" ng-model="ToDate">
                                                            </div>
                                                        </div>

                                                        </div>
                                                        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2" style="padding-top:14px; padding-left:0px"></div>
                                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                                        </div>
                                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="padding-top:14px; padding-left:0px">
                                                            <div class="col-md-4 col-sm-6 col-xs-12 btn3-nM3-3 mgbt-xs-15">
                                                                @Html.Partial("ActionSearch")
                                                            </div>
                                                        </div>
                                                    </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding report-box" id="TabAddHeight" TabAddHeight="41">
                                    <div class="arrow-container animated fadeInDown filter-toggle " ng-click="FilterToggle()">
                                        <div class="arrow-2">
                                            <i class="fa fa-angle-down"></i>
                                        </div>
                                        <div class="arrow-1 animated hinge infinite zoomIn"></div>
                                    </div>
                                    @Html.Partial("GeneralReportGrid")
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.full.min.js"></script>
<script>
    $(".chosen-select").chosen({
  no_results_text: "Oops, nothing found!"
})
</script>


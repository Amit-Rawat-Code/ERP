
@{
    ViewBag.Title = "TEST";
    ViewBag.TitleList = "TEST";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/TestAmitController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Generate Assignment</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><span>Time Table</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Generate Assignment</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper">
                        <div class="panel-body" ng-cloak>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Shift<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlShift" class="select2 form-control validate" ng-disabled="isShiftDisabled" ng-init="GetShifts();isShiftDisabled=false" ng-model="ShiftCode" ng-change="GetClassUsingShift();"
                                                        >
                                                    <option value="">Select Shift</option>
                                                    <option ng-repeat="shift in Shifts" value="{{shift.ShiftCode}}">{{shift.ShiftWithTime}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Class<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlClass" class="select2 form-control validate" ng-disabled="isClassDisabled" ng-init="isClassDisabled=false" ng-model="ClassCode" ng-change="ddlClass_Change();" >
                                                    <option value="">Select Class</option>
                                                    <option ng-repeat="cl in ClassList" value="{{cl.Code}}"
                                                            ng-disabled="!cl.IsActive">
                                                        {{cl.ClassName}}
                                                    </option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Section<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlSection" class="select2 form-control" ng-model="SectionCode" ng-disabled="isSectionDisabled" ng-init="isSectionDisabled=false" >
                                                    <option value="">Select Section</option>
                                                    <option ng-repeat="section in Sections" value="{{section.Code}}"
                                                            ng-disabled="!section.IsActive">
                                                        {{section.SectionName}}
                                                    </option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Branch<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlBranch")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Give Input<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input id="txtGotInput" type="text" class="form-control clear " ng-disabled="isGotInputDisabled" ng-init="isGotInputDisabled=false" ng-model="GotInput" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

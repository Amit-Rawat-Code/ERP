@{
    ViewBag.Title = "TicketDashBoardLevel1";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Scripts/myjslib/TicketDashboardLavel1Controller.js?Ver=@ViewBag.Version"></script>
<style>
    .section-title-filter {
        padding: 10px 0px;
        display: table;
    }
    .dataTables_scrollBody {
        overflow: scroll !important;
        height: 400px;
    }
    .panel-body {
        padding: 10px 15px;
        padding-top: 10px;
        padding-right: 15px;
        padding-bottom: 10px;
        padding-left: 15px;
        background: #fff;
    }
</style>
<style>
    .modal-body {
        position: inherit;
        padding: 20px;
        font-size: medium;
        margin-left: 20px;
    }
</style>

<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Level 1</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>DashBoard</span></li>
                <li class="active"><span>Ticket DashBoard Level-1</span></li>
            </ol>
        </div>
    </div>

    <div class="br-pagebody">
        <div class="panel-wrapper ">
            <div class="panel-body">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 section-title-filter">
                    <div class="pull-left section-title">
                        <h3> List of All Open Tickets</h3>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                    <div class="table-responsive" style=" width: 100%; overflow-y: hidden;">
                        <table id="example1" class="table table-striped table-bordered compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>S.No.</th>
                                    <th>SchoolCode</th>
                                    <th>Ticket No.</th>
                                    <th>Ticket Date</th>
                                    <th>Ticket Time</th>
                                    <th>User Name</th>
                                    <th>User Contact No.</th>
                                    <th>Module Name</th>
                                    <th>Page Type</th>
                                    <th>Page Name</th>
                                    <th>Attachment</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="obj1 in AllRaiseTicket_1 " enquiry-form-list>
                                    <td ng-bind="$index+1" align="center"></td>
                                    <td>{{obj1.DisplayCode}}</td>
                                    <td>{{obj1.PVNo}}</td>
                                    <td>{{obj1.VDate}}</td>
                                    <td>{{obj1.VTime}}</td>
                                    <td>{{obj1.ProfileName}}</td>
                                    <td>{{obj1.MobileNo}}</td>
                                    <td>{{obj1.ModuleName}}</td>
                                    <td>{{obj1.MenuName}}</td>
                                    <td>{{obj1.SubMenuName}}</td>
                                    <td ng-click="GetRaiseTicket_Attachments(obj1.TransID)"><a href="#" style="color:blue" data-toggle="modal" data-target="#showAttachment" ng-show="obj1.TotalAttachment>0">{{obj1.TotalAttachment}} Attachment</a></td>
                                    <td>{{obj1.TicketStatusName}}</td>
                                    <td><input type="button" class="btn btn-default" value="View" ng-click="RedirectTransID(obj1.TransID)" @*ng-disabled="{{obj1.Status}}==4"*@ /></td>
                                </tr>
                                <tr ng-if="AllRaiseTicket_1.length==0"><td colspan="13" class="text-center">No Record Found</td></tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td><input type="text" class="form-control" placeholder="S.No." /></td>
                                    <td><input type="text" class="form-control" placeholder="Name of School/College" /></td>
                                    <td><input type="text" class="form-control" placeholder="Ticket No." /></td>
                                    <td><input type="text" class="form-control" placeholder="Ticket Date" /></td>
                                    <td><input type="text" class="form-control" placeholder="Ticket Time" /></td>
                                    <td><input type="text" class="form-control" placeholder="User Name" /></td>
                                    <td><input type="text" class="form-control" placeholder="User Contact No." /></td>
                                    <td><input type="text" class="form-control" placeholder="Module Name" /></td>
                                    <td><input type="text" class="form-control" placeholder="Page Type" /></td>
                                    <td><input type="text" class="form-control" placeholder="Page Name" /></td>
                                    <td><input type="text" class="form-control" placeholder="Attachment" /></td>
                                    <td><input type="text" class="form-control" placeholder="Status" /></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 section-title-filter">
                    <div class="pull-left section-title">
                        <h3> List of All Reopen Tickets</h3>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">

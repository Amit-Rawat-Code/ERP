                                    <td><input type="text" class="form-control" placeholder="Ticket No." /></td>
                                    <td><input type="text" class="form-control" placeholder="Ticket Date" /></td>
                                    <td><input type="text" class="form-control" placeholder="Ticket Time" /></td>
                                    <td><input type="text" class="form-control" placeholder="User Name" /></td>
                                    <td><input type="text" class="form-control" placeholder="User Contact No." /></td>
                                    <td><input type="text" class="form-control" placeholder="Module Name" /></td>
                                    <td><input type="text" class="form-control" placeholder="Page Type" /></td>
                                    <td><input type="text" class="form-control" placeholder="Page Name" /></td>
                                    <td><input type="text" class="form-control" placeholder="Attachment" /></td>
                                    <td><input type="text" class="form-control" placeholder="Status" /></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 section-title-filter">
                    <div class="pull-left section-title">
                        <h3> List of All Closed Tickets</h3>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                    <div class="table-responsive" style=" width: 100%; overflow-y: hidden;">
                        <table id="example3" class="table table-striped table-bordered compact" style="width:100%">
                            <thead>
                                <tr>
                                    <th>S.No.</th>
                                    <th>SchoolCode</th>
                                    <th>Ticket No.</th>
                                    <th>Ticket Date</th>
                                    <th>Ticket Time</th>
                                    <th>User Name</th>
                                    <th>User Contact No.</th>
                                    <th>Module Name</th>
                                    <th>Page Type</th>
                                    <th>Page Name</th>
                                    <th>Attachment</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="obj4 in AllRaiseTicket_4 " enquiry-today-follow-ups-list>
                                    <td ng-bind="$index+1" align="center"></td>
                                    <td>{{obj4.DisplayCode}}</td>

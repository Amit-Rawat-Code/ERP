                                    <td><input type="button" class="btn btn-default" value="View" ng-click="RedirectTransID(obj3.TransID)" /></td>
                                </tr>
                                <tr ng-if="AllRaiseTicket_3.length==0"><td colspan="13" class="text-center">No Record Found</td></tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td><input type="text" class="form-control" placeholder="S.No." /></td>

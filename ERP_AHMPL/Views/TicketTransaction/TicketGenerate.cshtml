@{
    ViewBag.Title = "TicketGenerate";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/Content/ckfinder/ckfinder.js"></script>
<script src="//cdn.ckeditor.com/4.16.1/full/ckeditor.js"></script>

<script type="text/javascript">
    $(function () {
        CKEDITOR.replace("EnglishEditor", { customConfig: "/Content/ckeditor/config1.js", toolbar: 'MA' });
    })
</script>

<style>
    .modal-body {
        position: inherit;
        padding: 20px;
        font-size: medium;
        margin-left: 20px;
    }
</style>

<style>
    .multi-attachment-input-box-popup input[type="file"] {
        z-index: -1;
        position: absolute;
        opacity: 0;
    }
    .multi-attachment-input-box-popup .attachment-input-box-s .input-group-addon {
        height: 30px;
    }
    .multi-attachment-input-box-popup:hover {
        position: static;
        box-shadow: none;
    }
    
</style>

<style>
    .section-title-filter {
        padding: 10px 0px;
        display: table;
    }
    .dataTables_scrollBody {
        overflow: scroll !important;
        height: 400px;
    }
</style>

<script src="~/Scripts/myjslib/TicketGenerateController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />

<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
         @*Title*@ 
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n">
            <h5 class="txt-dark">Ticket Genearate</h5>
        </div>
         @*Breadcrumb*@ 
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Ticket</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Ticket Generate</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <div class="row">
                                        <div class="col-md-12 col-sm-12 col-xs-12 ticket-genrating-tab">
                                            <ul class="nav nav-tabs">
                                                <li class="active"><a data-toggle="tab" href="#home">Ticket Generate</a></li>
                                                <li><a data-toggle="tab" href="#menu1">Check Ticket Status</a></li>                                               
                                            </ul>

                                            <div class="tab-content">
                                                <div id="home" class="tab-pane fade active in">
                                                    <div class="ticket-generate-main">
                                                        <div class="row">
                                                            <div class="col-md-12 col-sm-12 col-xs-12">
                                                                <div class="form-group">
                                                                    <label class="control-label control-label-1">Ticket Type<span class="vd_red">*</span></label>
                                                                    <select id="ddlTicket" class="select2 form-control clear validate" ng-model="TicketType" ng-init="GetTicketType();">
                                                                        <option value="">Select Ticket Type</option>
                                                                        <option ng-repeat="TL in TicketList" value="{{TL.ID}}">{{TL.TicketTypeName}}</option>
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-12 col-sm-12 col-xs-12">
                                                                <div class="form-group">
                                                                    <label class="control-label">Module Name<span class="vd_red">*</span></label>
                                                                    <select id="ddlModules" class="select2 form-control validate" ng-model="ModuleId" ng-init="GetModules();" ng-change="GetMenuList()">
                                                                        <option value="">Select Module</option>
                                                                        <option ng-repeat="ml in ModulesList" value="{{ml.ModuleId}}">{{ml.ModuleName}}</option>
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-12 col-sm-12 col-xs-12">
                                                                <div class="form-group">
                                                                    <label class="control-label">Page Type<span class="vd_red">*</span></label>
                                                                    <select id="ddlMenu" class="select2 form-control clear validate" ng-model="MenuId" ng-change="GetSubMenuList()">
                                                                        <option value="">Select Page Type</option>
                                                                        <option ng-repeat="Menu in MenuList" value="{{Menu.MenuId}}">{{Menu.MenuName}}</option>
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-12 col-sm-12 col-xs-12">
                                                                <div class="form-group">
                                                                    <label class="control-label">Page Name<span class="vd_red">*</span></label>
                                                                    <select id="ddlSubMenu" class="select2 form-control clear validate" ng-model="SubMenuId">
                                                                        <option value="">Select Page Name</option>
                                                                        <option ng-repeat="SubMenu in SubMenuList" value="{{SubMenu.SubMenuId}}">{{SubMenu.SubMenuName}}</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                                <div id="product-tab">
                                                                    <div class="resp-tabs-container">
                                                                        <div class="resp-tab-content" aria-labelledby="tab_item-0">
                                                                            <label class="control-label">Please Describe Your Views<span class="vd_red">*</span></label>
                                                                            <div class="col-information">
                                                                                @Html.TextBox("EnglishEditor", "", new { @id = "EnglishEditor", @class = "form-control clear", @ng_model = "EnglishEditor" })
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            
                                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                                                <div class="col-md-12 col-sm-6 col-xs-12 mgbt-xs-15">
                                                                    <label class="control-label" style="display:initial;">Attachment <span style="float:right; font-size:10px;" title="Upload Only [.jpg|.jpeg|.png|.bmp|.pdf] Files & File Size Limit is 10 MB(In Total)">Instruction</span></label>
                                                                    <div class="input-box input-box-me max-h-114" ng-init="AddRow()">
                                                                        <div class="multi-attachment-input-box-popup">
                                                                            <div class="attachment-input-box-s ng-scope" ng-repeat="attachment in Attachments">
                                                                                <div class="input-group-addon ng-scope" ng-if="attachment.Name!='preview'"><i class="icofont-upload-alt"></i></div>
                                                                                <input type="file" ng-click="SetIndex($index)" id=file{{$index}} upload-files multiple>
                                                                                <label for=file{{$index}} class="form-control-attachment input-padding" ng-model="attachment.FileName">{{attachment.name==undefined?'Upload Image':attachment.name}}</label>

                                                                                <div class="input-group-btn input-group-btn-d">
                                                                                    <input type="submit" class="btn-dec ng-scope" value="-" ng-click="RemoveRow($index)" ng-if="Attachments.length>0 &amp;&amp; Attachments.length!=1">
                                                                                    <input type="submit" class="btn-add ng-scope" value="+" ng-click="AddRow()" ng-if="$index==Attachments.length-1">
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="text-box-msg-r">
                                                                            <input type="hidden" id="pdfAttachment" autocomplete="off">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-8 col-sm-6 col-xs-12 ">
                                                                @Html.Partial("ActionSave")
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div id="menu1" class="tab-pane fade" ng-click="GetAllRaiseTicket();">    
                                                   <div class="br-pagebody">
                                                        <div class="panel-wrapper ">
                                                            <div class="panel-body">
                                                                @*<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 section-title-filter">
                                                                    <div class="pull-left section-title">
                                                                        <h3>List of All Raised Ticket</h3>
                                                                    </div>
                                                                </div>*@

                                                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                                                    <div class="table-responsive" style=" width: 100%; overflow-y: hidden;">
                                                                        <table id="example1" class="table table-striped table-bordered compact" style="width:100%">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th>S.No.</th>                                                                                        
                                                                                    <th>Ticket No</th>
                                                                                    <th>Ticket Date</th>
                                                                                    <th>Ticket Time</th>
                                                                                    <th>Module Name</th>
                                                                                    <th>Page Type</th>
                                                                                    <th>Page Name</th>
                                                                                    <th style="min-width:200px;">Description</th>
                                                                                    <th>Attachment</th>
                                                                                    <th>Status</th>
                                                                                    <th>Action</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                <tr ng-repeat="obj in AllRaiseTicket"  enquiry-form-list>                                                                                      
                                                                                    <td ng-bind="$index+1" align="center" style="vertical-align:top;"></td>                                                                                        
                                                                                    <td style="vertical-align:top;">{{obj.PVNo}}</td>
                                                                                    <td style="vertical-align:top;">{{obj.VDate}}</td>
                                                                                    <td style="vertical-align:top;">{{obj.VTime}}</td>
                                                                                    <td style="vertical-align:top;">{{obj.ModuleName}}</td>
                                                                                    <td style="vertical-align:top;">{{obj.MenuName}}</td>
                                                                                    <td style="vertical-align:top;">{{obj.SubMenuName}}</td>
                                                                                    <td ng-bind-html="trustAsHtml(obj.Description)" class="td-table"></td>                                                                                        
                                                                                    <td ng-click="GetRaiseTicket_Attachments(obj.TransID)" style="vertical-align:top;"><a href="#" style="color:blue" data-toggle="modal" data-target="#showAttachment" ng-show="obj.TotalAttachment>0">{{obj.TotalAttachment}} Attachment</a></td>
                                                                                    <td style="vertical-align:top;">{{obj.TicketStatusName}}</td>
                                                                                    <td style="vertical-align:top;"><input type="button" class="btn btn-default" value="View" ng-click="RedirectTransID(obj.TransID)" ng-disabled="{{obj.Status}}==1"/></td>
                                                                                </tr>
                                                                                <tr ng-if="AllRaiseTicket.length==0"><td colspan="11" class="text-center">Record Not Found</td></tr>
                                                                            </tbody>
                                                                            <tfoot>
                                                                                <tr>
                                                                                    <td><input type="text" class="form-control" placeholder="S.No." /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Ticket No" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Ticket Date" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Ticket Time" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Module Name" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Page Type" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Page Name" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Description" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Attachment" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Status" /></td>
                                                                                    <td><input type="text" class="form-control" placeholder="Action" /></td>
                                                                                </tr>
                                                                            </tfoot>
                                                                        </table>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>                                                   
                                                </div>
                                            </div>
                                        </div>
                                    </div>    
                                </div>
                                @Html.Partial("SearchAngularJs")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row -->
        </div>
    </div>
</div>

<div class="modal fade" id="showAttachment" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Attachment List</h4>
            </div>
            <div class="modal-body">             
                <ul style="list-style-type:square" data-ng-repeat="ob1 in RaiseTicket_Attachment">
                    <li><a href="{{ob1.FilePath}}" style="color:blue" download>{{ob1.FileName}}</a></li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="tooltip">
    Instruction
    <span class="tooltiptext">Upload Only [.jpg|.jpeg|.png|.bmp|.pdf]. Uploaded File Size Limit in 10 MB(Total)</span>
</div>
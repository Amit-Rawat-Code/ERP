
@{
    ViewBag.Title = "ClassWiseSubjectTopicConceptsMaster";
    ViewBag.TitleList = "ClassWiseSubjectTopicConceptsMaster";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/ClassWiseSubjectTopicConceptsMasterController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Class Wise Subject Topic Concepts Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Enquiry</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Class Wise Subject Topic Concepts Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 ">
                                                <label class="control-label">Class<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlClass")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 ">
                                                <label class="control-label">Subject<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <select id="ddlSubject" class="select2 form-control clear validate" ng-model="Subject">
                                                        <option value="">Select---</option>
                                                        <option value="">Select---</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 ">
                                                <label class="control-label">Topic/Chapter<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <select id="ddlTopicChapter" class="select2 form-control clear " ng-model="TopicChapter">
                                                        <option value="">Select---</option>
                                                        <option value="">Select---</option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 ">
                                                <label class="control-label">Active<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlClass")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Attachment<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <div class="dropify-loader"></div>
                                                    <input id="fuStudentPhoto" type="file" class="dropify" data-max-file-size-preview="3M" ng-model="NoticeImage" upload-files>
                                                    <img id="imgStudentPhoto" style="display:none;">
                                                    {{NoticeImage}}
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-12">
                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Sub Topic / Concept</th>
                                                            <th>No.Of Periods</th>
                                                            <th>Description</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>1</td>
                                                            <td>Grammar</td>
                                                            <td>2</td>
                                                            <td>Lesson 3 objectives</td>
                                                        </tr>
                                                        <tr>
                                                            <td>2</td>
                                                            <td>Reading</td>
                                                            <td>1</td>
                                                            <td>Lesson 4 objectives</td>
                                                        </tr>
                                                    </tbody>
                                                </table>



                                            </div>
                                            <div class="col-sm-12">
                                                <label class="control-label">Subtopic / Concept Parameters<span class="vd_red"></span></label>
                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Parameter Name</th>
                                                            <th>Sub Parameter</th>
                                                            <th>Select</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>1</td>
                                                            <td>Goal</td>
                                                            <td>Learning Objectives</td>
                                                            <td>
                                                                <div class="checkbox checkbox-success text-center">
                                                                    <input type="checkbox" ng-model="XL.chk" class="toggle-vis"
                                                                           ng-click="CreateFinalStudentList(XL,XL.StudentCode,XL.chk);" />
                                                                    <label for=""> </label>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                       
                                                    </tbody>
                                                </table>



                                            </div>
                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                @Html.Partial("ActionView")
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>


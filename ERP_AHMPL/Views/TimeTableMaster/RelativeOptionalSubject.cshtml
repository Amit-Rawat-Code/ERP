@{
    ViewBag.Title = "Relative Optional Subject";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/RelativeOptionalSubjectController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Relative Optional Subject</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Enquiry</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Relative Optional Subject</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                <label class="control-label">Class<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlClass")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                <label class="control-label">Section<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlSection")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                <label class="control-label">Branch<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlBranch")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                <label class="control-label">Stream<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlStream")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                <label class="control-label">Subject<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <select id="ddlOptionalSubjects" class="select2 form-control validate"
                                                            ng-model="OptionalSubjectCode">
                                                        <option value="">Select Optional Subject</option>
                                                        <option ng-repeat="subject in OptionalSubjects" ng-model="OptionalSubjectName"
                                                                value="{{subject.SubjectCode}}">
                                                            {{subject.SubjectName}}
                                                        </option>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                <label class="control-label">Relative Subject<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <label ng-repeat="subject in RelativeOptionalSubjects">
                                                        <input type="hidden" value="{{subject.SubjectCode}}" />
                                                        <input type="hidden" value="{{subject.SubjectName}}" />
                                                        <input type="checkbox" id="{{subject.SubjectCode}}" value="{{subject.SubjectCode}}" ng-model="RelativeOptionalSubjectName"
                                                               ng-change="AddtoCart('#{{subject.SubjectCode}}','#ddlOptionalSubjects','{{subject.SubjectCode}}','{{subject.SubjectName}}')" />
                                                        {{subject.SubjectName}}
                                                    </label>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>



                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlActive")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                @Html.Partial("ActionView")
                                            </div>
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                                <table class="table compact table-hover table-striped table-bordered nowrap"
                                                       ng-if="RelativeSubjects.length>0">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Subject</th>
                                                            <th>Relative Subject</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="obj in RelativeSubjects">
                                                            <td ng-bind="obj.Srno=($index+1)"></td>
                                                            @*<td>                                                              
                                                                <input type="hidden" value="{{obj.SubjectCode}}" />
                                                                <input type="hidden" value="{{obj.RelativeSubjectCode}}" />
                                                            </td>*@
                                                            <td>{{obj.SubjectName}}</td>
                                                            <td>{{obj.RelativeSubjectName}}</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>










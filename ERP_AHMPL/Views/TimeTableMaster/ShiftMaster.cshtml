@{
    ViewBag.Title = "Shift Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/ShiftMasterController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Shift Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>TimeTable </span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Shift Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">

                                    <form id="user-form">
                                        <div class="row">


                                            <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Shift Name<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <input class="form-control clear textOnly ng-pristine ng-valid ng-empty ng-touched" id="txtShiftName" name="ShiftName" ng-model="ShiftName" placeholder="" type="text">
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>

                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">From Time<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <input id="txtFromTime" type="time" class="form-control clear validate" 
                                                           ng-model="FromTime"  />

                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">To Time<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    <input id="txtToTime" type="time" class="form-control clear validate" 
                                                           ng-model="ToTime" />
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12 mgbt-xs-15">
                                                <label class="control-label">Is Active<span class="vd_red"></span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlActive")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                @Html.Partial("ActionView")
                                            </div>


                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>




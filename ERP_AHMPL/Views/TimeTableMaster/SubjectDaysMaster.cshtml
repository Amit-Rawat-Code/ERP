@{
    ViewBag.Title = "Subject Days Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/subjectDaysMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Subject Days Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12 ">
            <ol class="breadcrumb">
                <li><span>Time Table</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Subject Days Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Class<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlClass")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Section<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlSection")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Branch<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlBranch")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Stream<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlStream")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12">
                                            <div class="datatable-responsive table-responsive">
                                                <table class="table compact table-hover table-striped table-bordered nowrap " ng-if="SubjectDays.length>0">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Subject</th>
                                                            <th>All Without Sunday</th>
                                                            <th class="text-center">All With Sunday</th>
                                                            <th class="text-center">Monday</th>
                                                            <th class="text-center">Tuesday</th>
                                                            <th class="text-center">Wednesday</th>
                                                            <th class="text-center">Thursday</th>
                                                            <th class="text-center">Friday</th>
                                                            <th class="text-center">Saturday</th>
                                                            <th class="text-center">Sunday</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="subjectday in SubjectDays">
                                                            <td>
                                                                {{$index+1}}
                                                                <input id="hfSubjectId" type="hidden"
                                                                       ng-model="SubjectId" value="{{subjectday.SubjectCode}}" />
                                                            </td>
                                                            <td>{{subjectday.SubjectName}}</td>
                                                            <td class="table-check-box">
                                                                @*<div class="checkbox checkbox-primary check-box table-check">
                                                                    *@
                                                                    @Html.CheckBox("chkWOS", false, new
                                                                    {
                                                                    @class = "form-control",
                                                                    @ng_model = "chkWOS",
                                                                    @ng_click = "fnChkWOS($index)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@
                                                            </td>
                                                            <td class="table-check-box">
                                                                @*   <div class="checkbox checkbox-primary check-box table-check">
                                                                    *@

                                                                    @Html.CheckBox("chkWS", false, new
                                                                    {
                                                                    @class = "form-control",
                                                                    @ng_model = "chkWS",
                                                                    @ng_click = "fnChkWS($index)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@

                                                            </td>
                                                            <td class="table-check-box">
                                                                @*<div class="checkbox checkbox-primary check-box table-check">
                                                                    *@
                                                                    @Html.CheckBox("chkMonday", false, new
                                                                    {
                                                                    @class = "form-control validate",
                                                                    @ng_checked = "(subjectday.Monday=='Yes'?true:false)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@

                                                            </td>
                                                            <td class="table-check-box">
                                                                @*<div class="checkbox checkbox-primary check-box table-check">
                                                                    *@
                                                                    @Html.CheckBox("chkTuesday", false, new
                                                                    {
                                                                    @class = "form-control validate",
                                                                    @ng_checked = "(subjectday.Tuesday=='Yes'?true:false)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@
                                                            </td>
                                                            <td class="table-check-box">
                                                                @*<div class="checkbox checkbox-primary check-box table-check">
                                                                    *@
                                                                    @Html.CheckBox("chkWednesday", false, new
                                                                    {
                                                                    @class = "form-control validate",
                                                                    @ng_checked = "(subjectday.Wednesday=='Yes'?true:false)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@

                                                            </td>
                                                            <td class="table-check-box">
                                                                @*<div class="checkbox checkbox-primary check-box table-check">
                                                                    *@
                                                                    @Html.CheckBox("chkThursday", false, new
                                                                    {
                                                                    @class = "form-control validate",
                                                                    @ng_checked = "(subjectday.Thursday=='Yes'?true:false)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@

                                                            </td>
                                                            <td class="table-check-box">
                                                                @*<div class="checkbox checkbox-primary check-box table-check">
                                                                    *@
                                                                    @Html.CheckBox("chkFriday", false, new
                                                                    {
                                                                    @class = "form-control validate",
                                                                    @ng_checked = "(subjectday.Friday=='Yes'?true:false)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@

                                                            </td>
                                                            <td class="table-check-box">
                                                                @*<div class="checkbox checkbox-primary check-box table-check">
                                                                    *@
                                                                    @Html.CheckBox("chkSaturday", false, new
                                                                    {
                                                                    @class = "form-control validate",
                                                                    @ng_checked = "(subjectday.Saturday=='Yes'?true:false)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@

                                                            </td>
                                                            <td class="table-check-box">
                                                                @*<div class="checkbox checkbox-primary check-box table-check">
                                                                    *@
                                                                    @Html.CheckBox("chkSunday", false, new
                                                                    {
                                                                    @class = "form-control validate",
                                                                    @ng_checked = "(subjectday.Sunday=='Yes'?true:false)"
                                                                    })
                                                                    <label for=""></label>
                                                                    @*
                                                                </div>*@

                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





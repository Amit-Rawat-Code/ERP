@{
    ViewBag.Title = "Replace Teacher";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/ReplaceTeacherController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Replace Teacher</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Time Table</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Replace Teacher</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 mgbt-xs-15">
                                                <label class="control-label">Shift<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    @Html.Partial("ddlShift")
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                <label class="control-label">Teacher<span class="vd_red">*</span></label>
                                                <div class="input-box">
                                                    <select id="ddlReplaceFromEmployeeName" class="select2 form-control clear validate" ng-model="ReplaceFromEmployeeCode" ng-change="ddlReplaceFromEmployee_Change();">
                                                        <option value="">Select </option>
                                                        <optgroup ng-repeat="x in TeacherList" 
                                                                  label="{{$index+1}}.{{x.EmployeeName}}{{'-'+x.ContactNo}}">
                                                            <option value="{{x.EmployeeCode}}">
                                                                {{x.EmployeeName}}{{'-'+x.EmployeeId}}
                                                            </option>
                                                        </optgroup>
                                                    </select>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-12 col-md-12 col-xs-12 col-lg-12 mgbt-xs-15">
                                                <div class="datatable-responsive table-responsive fixTableHead">
                                                    <table id="example2" class="table table-striped table-bordered compact " style="width:100%">
                                                        <thead>
                                                            <tr>
                                                                <th>Sr. No</th>
                                                                <th>Class</th>
                                                                <th>Section</th>
                                                                <th>Allotted Subjects</th>
                                                                <th>Period</th>
                                                                <th>WeekDay</th>
                                                                <th>
                                                                    <div class="checkbox checkbox-success text-center" style="padding-left: 0px">
                                                                        <input type="checkbox" ng-model="chkAll" ng-click="CheckUncheckChk()" />
                                                                        <label for=""> </label>
                                                                    </div>
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr ng-repeat="obj in TeacherSubjectList">
                                                                <td ng-bind="obj.Srno=($index+1)"></td>
                                                                <td>{{obj.ClassName}}</td>
                                                                <td>{{obj.SectionName}}</td>
                                                                <td>{{obj.SubjectName}}</td>
                                                                <td>{{obj.PeriodName}}</td>
                                                                <td>{{obj.WeekDayName}}</td>
                                                                <td>
                                                                    <div class="checkbox checkbox-success text-center" style="padding-left: 0px">
                                                                        <input type="checkbox" ng-checked="obj.chk" class="toggle-vis" ng-click="" ng-model="obj.chk" />
                                                                        <label for=""> </label>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                    <label class="control-label"><span class="vd_red"></span></label>
                                                    <div class="input-box">
                                                        <button id="btnShowEmployee" type="button" value="Show Teacher"
                                                                class="btn2 btn-common btn-3 btn-3d pe-7s-search"
                                                                ng-model="Search" ng-click="btn_SearchClick();">
                                                            <span class="triangle-box" title="Search"></span>
                                                            <span>Get Free Teachers</span>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 mgbt-xs-15 pull-right">
                                                    <label class="control-label">Replace To Free Teachers<span class="vd_red">*</span></label>
                                                    <div class="input-box">
                                                        <select id="ddlReplaceToEmployeeName" class="select2 form-control clear validate" ng-model="ReplaceToEmployeeCode">
                                                            <option value="">Select </option>
                                                            <optgroup ng-repeat="x in ReplaceToEmployeeTeacherList"
                                                                      label="{{$index+1}}.{{x.EmployeeName}}{{'-'+x.ContactNo}}">
                                                                <option value="{{x.EmployeeCode}}">
                                                                    {{x.EmployeeName}}{{'-'+x.EmployeeId}}
                                                                </option>
                                                            </optgroup>
                                                            @*<option ng-repeat="x in ReplaceToEmployeeTeacherList" value="{{x.EmployeeCode}}">
                                                                {{$index+1}}.{{x.EmployeeName}}{{'-'+x.EmployeeId}}
                                                            </option>*@
                                                        </select>
                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                                    @Html.Partial("ActionView")
                                                </div>
                                            </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>



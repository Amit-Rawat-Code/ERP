<style>
    .fee-deposit-box-profile .profile-header {
        padding: 10px;
        position: relative;
        height: 67px;
        background-size: cover;
    }

        .fee-deposit-box-profile .profile-header .profile-pic {
            margin: 0 auto;
            float: none;
            position: absolute;
        }

    .fee-deposit-box-profile .profile-header {
        padding: 10px;
        background: url(../Content/img/fee-deposit-profile.png);
        background-position: center center;
    }

    .fee-deposit-box-profile .profile-data {
        background: #fff;
        padding-top: 60px;
    }

    .fee-deposit-box-profile .profile-header .profile-pic {
        box-shadow: 0px 5px 12px 0px #999a9b, 0px 0px 0px 0px rgb(139 140 141);
        border: 5px solid #ffffff;
    }

    .profile-box-fee-deposit span.icon i {
        color: #484848;
    }

    lable.feild-title {
        position: absolute;
        left: 35px;
        top: 0px;
        font-weight: 500;
        color: #ffffff;
        font-size: 12px;
        height: 29px;
        line-height: 30px;
        padding-left: 15px;
        width: 114px;
        border-radius: 0px 20px 20px 0px;
        background-position: center center;
        background: #484848;
    }
</style>
<style>
    .input-icons {
        color: #01090c;
        font-size: 15px;
        line-height: 35px;
        position: absolute;
        top: 1px;
        background: #d6d6d6;
        text-align: center;
        width: 31px;
        left: unset !important;
        right: 1px;
        height: 28px;
        border-left: 1px solid #484848;
    }

    .down-arrow {
        border: solid black;
        border-width: 0 2px 2px 0px;
        display: inline-block;
        padding: 2px;
        transform: rotate(45deg);
        -webkit-transform: rotate(45deg);
        margin: 0px 0px 4px 0px;
    }

    div.scrollmenu {
        /*width:300px;*/
        overflow: auto;
        max-height: 300px;
        /*z-index: 99999;*/
    }

    table thead tr th {
        /* Important */
        position: sticky;
        top: 0;
    }
</style>

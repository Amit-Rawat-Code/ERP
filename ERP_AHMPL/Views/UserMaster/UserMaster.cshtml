
@{
    ViewBag.Title = "User Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/UserMasterController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset"  ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">User Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>User Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Profile Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtProfileName", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "Name" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Email</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtEmail", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "$parent.EmailId", @validate_email_id = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Mobile No.<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtMobileNo", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "$parent.MobileNo", @validate_mobile_no = "" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">User ID/User Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtUserName", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "UserName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-show="Save=='Edit'">
                                            <label class="control-label">Password<span class="vd_red"></span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtPassword", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "Password" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">User Type<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlUserType")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlActive")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Session<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlSession" autocomplete='address-level2' class="select2 form-control validate"
                                                        ng-model="SessionId" ng-init="GetSessionUserWise()" ng-change="ddl_ChangeSession()">
                                                    <option value="">Select Session</option>
                                                    <option ng-repeat="sl in SessionList" value="{{sl.SessionId}}">{{sl.SessionName}}</option>
                                                </select>
                                            </div>
                                            <div class="text-box-msg-r">
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 col-lg-12 mgbt-xs-15">
                                            <div class="input-box">
                                                <div class="checkbox checkbox-primary check-box">
                                                    <input type="checkbox" ng-model="chkAllBranch" ng-bind="chkAllBranch=(selectedBranchCount==AssociatedBranches.length?true:false)" ng-change="AllBranch();" class="ng-pristine ng-valid ng-binding ng-touched ng-untouched ng-empty">
                                                    <label>Select All<span class="vd_red">*</span></label>
                                                </div>
                                                <div class="text-box-msg-r2" style="font-weight: 500;">
                                                    Total Selection: <label ng-model="selectedBranchCount" ng-bind="selectedBranchCount=(AssociatedBranches | filter:{'IsActive' : 'true'}).length" class="ng-pristine ng-untouched ng-valid ng-binding ng-not-empty"></label>
                                                </div>

                                            </div>

                                            <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>S.No.</th>
                                                        <th>Entities</th>
                                                        <th class="text-center">Select</th>
                                                        <th class="text-center">Default</th>


                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="XL in AssociatedBranches">
                                                        <td>{{$index+1}}.</td>
                                                        <td>{{XL.Entity}}</td>
                                                        <td>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" ng-model="XL.IsActive" class="toggle-vis"
                                                                       ng-change="XL.IsDefault=(XL.IsActive==false?false:'')"
                                                                       data-column="16" ng-checked="XL.IsActive">
                                                                <label class=""></label>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="input-box">
                                                                <div class="checkbox checkbox-success text-center">
                                                                    <input type="checkbox" ng-model="XL.IsDefault" class="toggle-vis"
                                                                           ng-disabled="!XL.IsActive"
                                                                           ng-change="UncheckAll(XL,XL.IsDefault)">
                                                                    @*<input type="radio" id="PrimaryNo_{{$index+1}}"
                                                                        ng-model="XL.IsDefault" ng-disabled="!XL.IsActive">*@
                                                                    <label for="PrimaryNo_{{$index+1}}"> </label>
                                                                </div>
                                                                <div class="text-box-msg-r">
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>




                                                </tbody>

                                            </table>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>




@{
    ViewBag.Title = "Mobile Role Assignment";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/UserMobileRoleAssignmentsController.js?Ver=@ViewBag.Version"></script>

<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Mobile Role Assignments</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>User</span></li>
                <li><span>Transaction</span></li>
                <li class="active"><span>Mobile Role Assignments</span></li>
            </ol>
        </div>

    </div>

    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Mobile User Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddl_Mobile_User")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 col-lg-12 mgbt-xs-15">
                                            <div class="table-responsive">
                                                <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                    <thead>
                                                        <tr>
                                                            <th>S.No.</th>
                                                            <th>Role</th>
                                                            <th class="text-right">
                                                                <div class="checkbox check-box checkbox-success">
                                                                    @*checkbox checkbox-success*@
                                                                    <input type="checkbox" class="toggle-vis" data-column="1" checked="">
                                                                    <label>Selection</label>
                                                                </div>
                                                            </th>
                                                            
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="role in RolesList">
                                                            <td ng-bind="$index+1"></td>
                                                            <td>{{role.RoleName}}{{' ('+role.LevelName+')'}}</td>
                                                            <td>
                                                                <div class="checkbox checkbox-success text-center">
                                                                    <input type="checkbox" class="toggle-vis" data-column="16" ng-model="role.IsSelected" checked="">
                                                                    <label class=""></label>
                                                                </div>
                                                            </td>
                                                            
                                                        </tr>


                                                    </tbody>

                                                </table>
                                            </div>
                                        </div>
                                        <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>

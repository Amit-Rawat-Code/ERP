
@{
    ViewBag.Title = "Back Date Entry Permission";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/BackDateEntryPermissionController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Back Data Entry Permission</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Back Data Entry Permission</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Role</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlRoles")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Module</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlModules")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">User Name</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlUser")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 col-lg-12 mgbt-xs-15">

                                            <table id="example2" class="table table-striped table-bordered compact" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>S.No.</th>
                                                        <th>Module</th>
                                                        <th>Menu Name</th>
                                                        <th>Type</th>
                                                        <th >No.of Days</th>
                                                        <th >From Date</th>
                                                        <th >To Date</th>
                                                        <th>Expiry Date & Time</th>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="sml in SubMenuesList">
                                                        <td ng-bind="sml.Srno=($index+1)"></td>
                                                        <td>{{sml.ModuleName}}</td>
                                                        <td>{{sml.MenuName}}</td>
                                                        <td>@Html.Partial("ddlDaysDateType")</td>
                                                        <td><input type="number"class="form-control validate" ng-model="sml.DaysInNumber" ng-if="sml.DateType=='NumberOfDays'" /></td>
                                                        <td><input type="date" class="form-control validate"  ng-model="sml.FromDate"  ng-init="sml.FromDate=ConvertDate(sml.FromDate)" ng-if="sml.DateType=='DateRange'" /></td>
                                                        <td ><input type="date" class="form-control validate" ng-model="sml.ToDate" ng-init="sml.ToDate=ConvertDate(sml.ToDate)" ng-if="sml.DateType=='DateRange'" /></td>
                                                        <td><input type="datetime-local" class="form-control validate" ng-model="sml.ExpiryDateTime" ng-init="sml.ExpiryDateTime=ConvertDate(sml.ExpiryDateTime)" ng-if="sml.DateType" /></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>



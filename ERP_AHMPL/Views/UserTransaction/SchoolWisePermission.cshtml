
@{
    ViewBag.Title = "School Wise Permission";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/UserPermissionSchoolWiseController.js?Ver=@ViewBag.Version"></script>

<input type="hidden" ng-model="hfId" id="Id" name="Id" value="" />
<div class="autohide-scroll autoheightset" ng-cloak>
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">School Wise Permission</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>School Wise Permission</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">


                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">User Name</label>
                                            <div class="input-box">
                                                @Html.Partial("ddlUser")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Module<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlModules" class="select2 form-control validate" ng-model="ModuleId"
                                                        ng-change="ddl_ModulesChange()">
                                                    <option value="">Select Module</option>
                                                    <option ng-repeat="ml in ModulesList" value="{{ml.ModuleId}}">
                                                        {{ml.ModuleName}}
                                                    </option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">School<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.Partial("ddlUserSchoolBranch")
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 col-lg-12 mgbt-xs-15">
                                            @Html.Partial("tblUserDetails")
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 col-lg-12 mgbt-xs-15" ng-if="NavMenuList.length>0">

                                            <table id="example2" class="table table-striped table-bordered compact" style="width:100%" 
                                                   >
                                                <thead>
                                                    <tr>
                                                        <th>S.No.</th>
                                                        <th>Module</th>
                                                        <th>Menu </th>
                                                        <th>Sub Menu</th>
                                                        <th>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" class="toggle-vis" data-column="2" 
                                                                     ng-model="chkAdd" ng-change="CheckUnCheckAll('IsAdd',chkAdd)">
                                                                <label class="">Add</label>
                                                            </div>
                                                        </th>
                                                        <th>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" class="toggle-vis" data-column="2"
                                                                      ng-model="chkEdit"   ng-change="CheckUnCheckAll('IsEdit',chkEdit)">
                                                                <label class="">Edit</label>
                                                            </div>
                                                        </th>
                                                        <th>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" class="toggle-vis" data-column="2"
                                                                       ng-model="chkDelete"  ng-change="CheckUnCheckAll('IsDelete',chkDelete)">
                                                                <label class="">Delete</label>
                                                            </div>
                                                        </th>
                                                        <th>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" class="toggle-vis" data-column="2"
                                                                       ng-model="chkPrint"  ng-change="CheckUnCheckAll('IsPrint',chkPrint)">
                                                                <label class="">Print</label>
                                                            </div>
                                                        </th>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                    <tr ng-repeat="sml in NavMenuList">
                                                        <td ng-bind="sml.Srno=($index+1)"></td>
                                                        <td>{{sml.ModuleName}}</td>
                                                        <td>{{sml.MenuName}}</td>
                                                        <td>{{sml.SubMenuName}}</td>

                                                        <td>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" class="toggle-vis" ng-model="sml.IsAdd" 
                                                                       ng-change="chkChange()">
                                                                <label class=""></label>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" class="toggle-vis" ng-model="sml.IsEdit"
                                                                        ng-change="chkChange()">
                                                                <label class=""></label>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" class="toggle-vis" ng-model="sml.IsDelete"
                                                                        ng-change="chkChange()">
                                                                <label class=""></label>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="checkbox checkbox-success text-center">
                                                                <input type="checkbox" class="toggle-vis" ng-model="sml.IsPrint"
                                                                        ng-change="chkChange()">
                                                                <label class=""></label>
                                                            </div>
                                                        </td>
                                                    </tr>





                                                </tbody>

                                            </table>
                                        </div>
                                        <div class="col-md-8 col-sm-12 col-xs-12 mgbt-xs-15 btn1-nM3-1">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
</div>


